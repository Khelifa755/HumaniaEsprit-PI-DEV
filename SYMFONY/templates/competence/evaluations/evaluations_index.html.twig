	.card-info{flex:1;min-width:0}

	/* Titre + badges */
	.card-title-row{display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;margin-bottom:.22rem}
	.card-title{font-size:.9rem;font-weight:800;color:var(--g900);letter-spacing:-.015em;line-height:1.25}

	/* Status badges */
	.badge{
	  font-size:.6rem;font-weight:800;padding:3px 8px;
	  border-radius:20px;letter-spacing:.02em;
	  display:inline-flex;align-items:center;gap:3px;
	}

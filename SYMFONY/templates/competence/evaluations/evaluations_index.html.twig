	  flex:1;display:flex;flex-direction:column;align-items:center;
	  padding:.75rem .4rem;gap:.18rem;
	}
	.det-qs-div{width:1px;background:#E5E7EB;align-self:stretch;margin:.4rem 0}
	.det-qs-icon{font-size:1.1rem;line-height:1}
	.det-qs-val{font-size:.88rem;font-weight:800;color:#111827;line-height:1}
	.det-qs-lbl{font-size:.62rem;color:#9CA3AF;font-weight:600;text-transform:uppercase;letter-spacing:.04em}
	/* Body sections */
	.det-body{padding:1rem 1.25rem 1.25rem;display:flex;flex-direction:column;gap:.85rem}
	.det-section{}
	.det-section-title{
	  font-size:.68rem;font-weight:800;color:#9CA3AF;text-transform:uppercase;
	  letter-spacing:.08em;display:flex;align-items:center;gap:.4rem;margin-bottom:.45rem;
	}
	.det-section-val{font-size:.88rem;font-weight:600;color:#374151}

{% extends 'base.html.twig' %}
{% block title %}Évaluations de Compétences – Humania
{% endblock %}

{% block body %}
{# ══ Calculs XP ══════════════════════════════════════════════════════════════ #}
{% set nb_passed   = evals|filter(e => e.my_statut == 'passed')|length %}
{% set nb_failed   = evals|filter(e => e.my_statut == 'failed')|length %}
{% set nb_total    = evals|length %}
{% set nb_open     = evals|filter(e => e.access_state == 'accessible' and e.my_statut == 'not_taken')|length %}
{% set nb_pending  = evals|filter(e => e.my_statut == 'not_taken' and e.access_state == 'accessible')|length %}
{% set nb_inprog   = evals|filter(e => e.my_statut == 'in_progress')|length %}
{% set nb_expired  = evals|filter(e => e.access_state == 'expired')|length %}
{% set xp_val      = nb_passed * 100 + nb_failed * 20 %}
{% set xp_level    = (xp_val / 200)|round(0,'floor') + 1 %}
{% set xp_in_level = xp_val % 200 %}
{% set xp_pct      = xp_in_level > 0 ? (xp_in_level / 200 * 100)|round : 0 %}

<div
	class="ev-wrapper">

	{# ══ HERO HEADER ══════════════════════════════════════════════════════════ #}
	<div class="ev-hero">
		<div>
			<div class="ev-hero-tag">
				<span></span>
				COMPÉTENCES</div>
			<h1 class="ev-hero-title">Évaluations de Compétences</h1>
			<p class="ev-hero-sub">Passez vos évaluations · Suivez votre progression · Montez en niveau</p>
		</div>
		<div class="ev-hero-actions">
			<button class="btn-hero-icon" onclick="openDrawer('calDrawer')" title="Calendrier des évaluations">
				<i class="fa-solid fa-calendar-days"></i>
			</button>
			<button class="btn-hero-icon btn-hero-niveau" onclick="openDrawer('progDrawer')" title="Ma progression">
				<i class="fa-solid fa-trophy"></i>
				<span class="niveau-badge">Niv.{{ xp_level }}</span>
			</button>
			{% if isAdmin %}
				<button class="btn-new-eval" onclick="openNewModal()">
					<i class="fa-solid fa-plus"></i>
					Nouvelle Évaluation
				</button>
			{% endif %}
		</div>
	</div>

	{# ══ FLASH ════════════════════════════════════════════════════════════════ #}
	{% for msg in app.flashes('success') %}
		<div class="flash-ok">{{ msg }}</div>
	{% endfor %}
	{% for msg in app.flashes('error')   %}
		<div class="flash-err">{{ msg }}</div>
	{% endfor %}

	{# ══ STAT CARDS ══════════════════════════════════════════════════════════ #}
	<div class="ev-stats">
		<div class="stat-card" style="--accent:#6366F1">
			<div class="stat-icon-wrap" style="background:#EEF2FF">
				<i class="fa-solid fa-lock-open" style="color:#6366F1;font-size:1rem"></i>
			</div>
			<div class="stat-content">
				<div class="stat-num">{{ stats.accessible }}</div>
				<div class="stat-lbl">Ouvertes</div>
			</div>
			<div class="stat-trend" style="color:#6366F1">Disponibles</div>
		</div>
		<div class="stat-card" style="--accent:#F59E0B">
			<div class="stat-icon-wrap" style="background:#FEF3C7">
				<i class="fa-solid fa-clock" style="color:#D97706;font-size:1rem"></i>
			</div>
			<div class="stat-content">
				<div class="stat-num">{{ stats.pending }}</div>
				<div class="stat-lbl">À passer</div>
			</div>
			<div class="stat-trend" style="color:#D97706">En attente</div>
		</div>
		<div class="stat-card" style="--accent:#10B981">
			<div class="stat-icon-wrap" style="background:#D1FAE5">
				<i class="fa-solid fa-circle-check" style="color:#059669;font-size:1rem"></i>
			</div>
			<div class="stat-content">
				<div class="stat-num">{{ stats.ceMonth }}</div>
				<div class="stat-lbl">Ce mois</div>
			</div>
			<div class="stat-trend" style="color:#059669">Réussies</div>
		</div>
		<div class="stat-card" style="--accent:#F59E0B">
			<div class="stat-icon-wrap" style="background:#FEF9C3">
				<i class="fa-solid fa-star" style="color:#CA8A04;font-size:1rem"></i>
			</div>
			<div class="stat-content">
				<div class="stat-num" style="color:#F59E0B">{{ stats.avgScore }}</div>
				<div class="stat-lbl">Score moyen</div>
			</div>
			<div class="stat-trend" style="color:#CA8A04">Moyenne</div>
		</div>
	</div>

	{# ══ LAYOUT FULL WIDTH ════════════════════════════════════════════════════ #}
	<div
		class="ev-main-full">

		{# ── Barre de filtres redesignée ── #}
		<div
			class="ev-filterbar-wrap">
			{# Ligne 1 : search + boutons droite #}
			<div class="ev-filterbar-top">
				<div class="search-wrap">
					<i class="fa-solid fa-magnifying-glass si-fa"></i>
					<input type="text" id="searchInput" value="{{ search }}" placeholder="Rechercher une évaluation, une compétence…" class="search-input" oninput="filterCards()">
					{% if search %}
						<button class="search-clear" onclick="document.getElementById('searchInput').value='';filterCards()" title="Effacer">
							<i class="fa-solid fa-xmark"></i>
						</button>
					{% endif %}
				</div>

				{# Panneau de filtres masqué (toggle) #}
				<div id="filterPanel" class="filter-panel" style="display:none">
					<select id="statutSel" class="filter-sel" onchange="filterCards()">
						<option value="">Tous les statuts</option>
						<option value="accessible" {{ filterStat == 'accessible' ? 'selected' : '' }}>Accessible</option>
						<option value="locked" {{ filterStat == 'locked' ? 'selected' : '' }}>Verrouillée</option>
						<option value="not_yet" {{ filterStat == 'not_yet' ? 'selected' : '' }}>Pas encore ouverte</option>
						<option value="expired" {{ filterStat == 'expired' ? 'selected' : '' }}>Expirée</option>
						<option value="passed" {{ filterStat == 'passed' ? 'selected' : '' }}>Réussie</option>
						<option value="failed" {{ filterStat == 'failed' ? 'selected' : '' }}>Échouée</option>
					</select>
					<select id="typeSel" class="filter-sel" onchange="filterCards()">
						<option value="">Tous les types</option>
						{% for t in ['QCM','Pratique','Oral','Projet','Auto-évaluation'] %}
							<option value="{{ t }}" {{ filterType == t ? 'selected' : '' }}>{{ t }}</option>
						{% endfor %}
					</select>
					<button type="button" class="btn-filter-apply" onclick="submitFilter()">Appliquer</button>
					{% if search or filterStat or filterType %}
						<a href="{{ path('evaluations_index') }}" class="btn-reset">
							<i class="fa-solid fa-xmark"></i>
							Réinitialiser
						</a>
					{% endif %}
				</div>

				<div class="ev-filterbar-actions">
					<button type="button" class="btn-filtres" onclick="toggleFilterPanel()" id="btnFiltres">
						<i class="fa-solid fa-sliders"></i>
						Filtres
						{% if filterStat or filterType %}
							<span class="filter-active-dot"></span>
						{% endif %}
					</button>
					<div class="ev-view-toggle">
						<button class="view-btn active" id="btnGrid" onclick="setView('grid')" title="Vue grille">
							<i class="fa-solid fa-grip"></i>
						</button>
						<button class="view-btn" id="btnList" onclick="setView('list')" title="Vue liste">
							<i class="fa-solid fa-list"></i>
						</button>
					</div>
				</div>
			</div>

			{# Ligne 2 : tabs #}
			<div class="ev-tabs-row">
				<div class="ev-tabs">
					<button class="ev-tab active" data-tab="all" onclick="switchTab(this,'all')">
						Toutes
						<span class="tab-count">{{ evals|length }}</span>
					</button>
					<button class="ev-tab" data-tab="pending" onclick="switchTab(this,'pending')">
						À passer
						<span class="tab-count">{{ nb_pending }}</span>
					</button>
					<button class="ev-tab" data-tab="inprog" onclick="switchTab(this,'inprog')">
						En cours
						<span class="tab-count">{{ nb_inprog }}</span>
					</button>
					<button class="ev-tab" data-tab="passed" onclick="switchTab(this,'passed')">
						Réussies
						<span class="tab-count tab-count-green">{{ nb_passed }}</span>
					</button>
					<button class="ev-tab" data-tab="expired" onclick="switchTab(this,'expired')">
						Expirées
						<span class="tab-count tab-count-gray">{{ nb_expired }}</span>
					</button>
				</div>
			</div>
		</div>

		{# ── Section title ── #}
		<div class="ev-section-title">
			<i class="fa-solid fa-clipboard-list" style="color:#6366F1"></i>
			Campagnes d'Évaluation
		</div>

		{% if evals|length == 0 %}
			<div class="ev-empty">
				<i class="fa-solid fa-clipboard-list" style="font-size:2.5rem;color:#D1D5DB;margin-bottom:.75rem;display:block"></i>
				<p>Aucune évaluation ne correspond à vos critères.</p>
			</div>
		{% else %}

			<div class="ev-cards-grid" id="evCardsGrid">

				{% for ev in evals %}
					{% set accent    = ev.my_statut == 'passed' ? '#10B981' : (ev.my_statut == 'failed' ? '#EF4444' : (ev.access_state == 'accessible' ? '#6366F1' : (ev.access_state == 'locked_level' ? '#F59E0B' : '#9CA3AF'))) %}
					{% set accentBg  = ev.my_statut == 'passed' ? '#ECFDF5' : (ev.my_statut == 'failed' ? '#FEF2F2' : (ev.access_state == 'accessible' ? '#EEF2FF' : (ev.access_state == 'locked_level' ? '#FEF3C7' : '#F3F4F6'))) %}
					{% set typeFA    = ev.type == 'QCM' ? 'fa-file-pen' : (ev.type == 'Pratique' ? 'fa-screwdriver-wrench' : (ev.type == 'Oral' ? 'fa-microphone' : (ev.type == 'Projet' ? 'fa-diagram-project' : 'fa-mirror'))) %}
					{% set diffColor = ev.difficulte == 'FACILE' ? '#10B981' : (ev.difficulte == 'DIFFICILE' ? '#EF4444' : '#6366F1') %}
					{% set tabVal    = ev.my_statut == 'passed' ? 'passed' : (ev.access_state == 'expired' ? 'expired' : (ev.my_statut == 'in_progress' ? 'inprog' : (ev.access_state == 'accessible' and ev.my_statut == 'not_taken' ? 'pending' : 'all'))) %}

					<div class="eval-card" style="--acc:{{ accent }};--acc-bg:{{ accentBg }}" data-tab="{{ tabVal }}" data-title="{{ ev.titre|lower ?: ev.formation_titre|lower }}" data-statut="{{ ev.access_state }}" data-mystat="{{ ev.my_statut }}" data-type="{{ ev.type }}">
						<div class="card-strip" style="background:linear-gradient(90deg,{{ accent }},color-mix(in srgb,{{ accent }} 55%,white))"></div>
						{# ── Card header : icon + title + status badge ── #}
						<div class="card-main">
							<div class="card-icon-wrap" style="background:{{ accentBg }}">
								<i class="fa-solid {{ typeFA }}" style="color:{{ accent }};font-size:1rem"></i>
							</div>
							<div class="card-info" style="flex:1;min-width:0">
								<div class="card-title-row">
									<span class="card-title">{{ ev.titre ?: ev.formation_titre }}</span>
								</div>
								<div class="card-sub-row">
									<span class="type-chip">{{ ev.type }}</span>
									<span class="diff-dot" style="background:{{ diffColor }}"></span>
									<span class="diff-lbl" style="color:{{ diffColor }}">{{ ev.difficulte }}</span>
								</div>
							</div>
							{# Donut + meta à droite #}
							<div class="card-right">
								<div class="donut-wrap">
									<svg viewbox="0 0 36 36" class="donut-svg">
										<circle cx="18" cy="18" r="15.9" fill="none" stroke="#F1F5F9" stroke-width="3.8"/>
										<circle cx="18" cy="18" r="15.9" fill="none" stroke="{{ accent }}" stroke-width="3.8" stroke-dasharray="{{ ev.pct_done }},100" stroke-dashoffset="25" stroke-linecap="round"/>
									</svg>
									<span class="donut-pct">{{ ev.pct_done }}%</span>
								</div>
							</div>
						</div>

						{# ── Card body : infos uniformes ── #}
						<div class="card-body-uniform">
							{# Formation #}
							<div class="cbu-row">
								<i class="fa-solid fa-book-open cbu-icon"></i>
								<span class="cbu-val text-truncate">{{ ev.formation_titre }}</span>
							</div>
							{# Durée + Score requis #}
							<div class="cbu-row">
								<i class="fa-solid fa-stopwatch cbu-icon"></i>
								<span class="cbu-val">{{ ev.duree }} min</span>
								<span class="cbu-sep">·</span>
								<i class="fa-solid fa-bullseye cbu-icon"></i>
								<span class="cbu-val">{{ ev.score_requis }}%</span>
							</div>
							{# Période (toujours affiché, placeholder si absent) #}
							<div class="cbu-row">
								<i class="fa-regular fa-calendar cbu-icon"></i>
								{% if ev.eval_debut %}
									<span class="cbu-val">{{ ev.eval_debut|date('d M') }} → {{ ev.eval_fin|date('d M') }}</span>
									{% if ev.date_status == 'expired' %}
										<span class="date-chip chip-exp" style="margin-left:auto">Fermée depuis {{ ((date()|date('U') - date(ev.eval_fin)|date('U')) / 86400)|abs|round }}j</span>
									{% elseif ev.date_status == 'not_yet' %}
										<span class="date-chip chip-soon" style="margin-left:auto">Dans {{ ((date(ev.eval_debut)|date('U') - date()|date('U')) / 86400)|round }}j</span>
									{% endif %}
								{% else %}
									<span class="cbu-val cbu-empty">—</span>
								{% endif %}
							</div>
							{# Statut badge + participants #}
							<div class="cbu-row">
								{% if ev.my_statut == 'passed' %}
									<span class="badge badge-passed"><i class="fa-solid fa-check"></i> Réussi</span>
								{% elseif ev.my_statut == 'failed' %}
									<span class="badge badge-failed"><i class="fa-solid fa-xmark"></i> Échoué</span>
								{% elseif ev.access_state == 'accessible' %}
									<span class="badge badge-accessible"><i class="fa-solid fa-lock-open"></i> Accessible</span>
								{% elseif ev.access_state == 'locked_level' %}
									<span class="badge badge-locked"><i class="fa-solid fa-lock"></i> Verrouillée</span>
								{% elseif ev.access_state == 'not_yet' %}
									<span class="badge badge-notyet"><i class="fa-solid fa-hourglass-half"></i> Bientôt</span>
								{% else %}
									<span class="badge badge-expired"><i class="fa-solid fa-ban"></i> Expirée</span>
								{% endif %}
								<span class="cbu-sep"></span>
								<span class="part-info" style="margin-left:auto">
									<i class="fa-solid fa-users fa-xs"></i> {{ ev.nb_done }}/{{ ev.nb_part }}
								</span>
							</div>
							{# Score bar (si déjà passé) #}
							{% if ev.my_statut != 'not_taken' and ev.my_score > 0 %}
								<div class="score-row">
									<span class="score-bar-wrap">
										<span class="score-bar-fill" style="width:{{ ev.my_score }}%;background:{{ ev.my_statut == 'passed' ? '#10B981' : '#EF4444' }}"></span>
									</span>
									<span class="score-txt" style="color:{{ ev.my_statut == 'passed' ? '#059669' : '#DC2626' }}">{{ ev.my_score }}%</span>
								</div>
							{% else %}
								<div class="score-row score-row-empty"></div>
							{% endif %}
						</div>

						<div class="prog-strip-wrap">
							<div class="prog-strip-fill" style="width:{{ ev.pct_done }}%;background:{{ accent }}"></div>
						</div>

						<div class="card-footer">
							{# ── Une seule ligne : action principale + détails + admin icônes ── #}
							<div class="footer-row footer-row-unified">
								{# Bouton principal #}
								{% if ev.access_state == 'locked_level' %}
									<button class="btn-main btn-locked" disabled>
										<i class="fa-solid fa-lock"></i> Niv.{{ ev.niveau_requis }} requis
									</button>
								{% elseif ev.access_state == 'not_yet' %}
									<button class="btn-main btn-notyet" disabled>
										<i class="fa-solid fa-hourglass-half"></i> Dispo. {{ ev.eval_debut|date('d/m') }}
									</button>
								{% elseif ev.access_state == 'expired' %}
									<button class="btn-main btn-expired" disabled>
										<i class="fa-solid fa-ban"></i> Expirée
									</button>
								{% elseif ev.my_statut == 'failed' %}
									<button class="btn-main btn-retry" onclick="openQuiz({{ ev.id }}, '{{ ev.titre|e('html_attr') }}')">
										<i class="fa-solid fa-rotate-right"></i> Repasser
									</button>
								{% elseif ev.my_statut == 'passed' %}
									<button class="btn-main btn-results" onclick="openDetails({{ ev.id }})">
										<i class="fa-solid fa-chart-simple"></i> Résultats
									</button>
								{% else %}
									<button class="btn-main btn-pass" style="background:linear-gradient(135deg,{{ accent }},color-mix(in srgb,{{ accent }} 70%,#7C3AED))" onclick="openQuiz({{ ev.id }}, '{{ ev.titre|e('html_attr') }}')">
										<i class="fa-solid fa-play"></i> Commencer
									</button>
								{% endif %}

								{# Détails #}
								<button class="btn-details" onclick="openDetails({{ ev.id }})" title="Détails">
									<i class="fa-solid fa-eye"></i> Détails
								</button>

								{# Admin : icônes uniquement #}
								{% if is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
									<div class="footer-admin-icons">
										<button type="button" class="btn-icon-adm btn-icon-edit" onclick="openEditModal({{ ev.id }}, {{ ev|json_encode }})" title="Modifier">
											<i class="fa-solid fa-pen"></i>
										</button>
										<form method="post" action="{{ path('evaluations_toggle', {id: ev.id}) }}" style="display:contents">
											{% if ev.statut_eval == 'INACTIVE' %}
												<button type="submit" class="btn-icon-adm btn-icon-activate" title="Réactiver">
													<i class="fa-solid fa-circle-check"></i>
												</button>
											{% else %}
												<button type="submit" class="btn-icon-adm btn-icon-deactivate" title="Désactiver">
													<i class="fa-solid fa-circle-minus"></i>
												</button>
											{% endif %}
										</form>
										<button type="button" class="btn-icon-adm btn-icon-danger" title="Supprimer" onclick="openConfirmDelete('{{ path('evaluations_delete', {id: ev.id}) }}', '{{ (ev.titre ?: ev.formation_titre)|e('html_attr') }}')">
											<i class="fa-solid fa-trash"></i>
										</button>
									</div>
								{% endif %}
							</div>
						</div>
					</div>
				{% endfor %}

			</div>
		{% endif %}
	</div>
</div>


{# ══ DRAWER — Calendrier ═════════════════════════════════════════════════════#}
<div class="drawer-overlay" id="calDrawer" onclick="if(event.target===this)closeDrawer('calDrawer')">
	<div class="drawer-panel">
		<div class="drawer-head">
			<div class="drawer-head-icon" style="background:#EEF2FF;color:#6366F1">
				<i class="fa-solid fa-calendar-days"></i>
			</div>
			<div>
				<div class="drawer-head-title">Calendrier</div>
				<div class="drawer-head-sub">Planning de vos évaluations</div>
			</div>
			<button class="drawer-close" onclick="closeDrawer('calDrawer')">
				<i class="fa-solid fa-xmark"></i>
			</button>
		</div>
		<div class="drawer-body">
			<div class="side-card" id="calCard">
				<div class="side-card-head">
					<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
					<span class="side-card-title" id="calMonthLabel"></span>
					<div style="flex:1"></div>
					<button class="cal-nav" onclick="calPrev()">‹</button>
					<button class="cal-nav cal-today" onclick="calToday()">Aujourd'hui</button>
					<button class="cal-nav" onclick="calNext()">›</button>
				</div>
				<div id="calBody"></div>
				<div class="cal-legend">
					<span class="leg-item">
						<span class="leg-dot" style="background:#6366F1"></span>Accessible</span>
					<span class="leg-item">
						<span class="leg-dot" style="background:#F59E0B"></span>Bientôt</span>
					<span class="leg-item">
						<span class="leg-dot" style="background:#10B981"></span>Réussie</span>
					<span class="leg-item">
						<span class="leg-dot" style="background:#EF4444"></span>Échouée</span>
					<span class="leg-item">
						<span class="leg-dot" style="background:#9CA3AF"></span>Expirée</span>
				</div>
			</div>
		</div>
	</div>
</div>

{# ══ DRAWER — Ma Progression ══════════════════════════════════════════════════#}
<div class="drawer-overlay" id="progDrawer" onclick="if(event.target===this)closeDrawer('progDrawer')">
	<div class="drawer-panel">
		<div class="drawer-head">
			<div class="drawer-head-icon" style="background:#FEF3C7;color:#D97706">
				<i class="fa-solid fa-trophy"></i>
			</div>
			<div>
				<div class="drawer-head-title">Ma Progression</div>
				<div class="drawer-head-sub">Niveau, badges et derniers résultats</div>
			</div>
			<button class="drawer-close" onclick="closeDrawer('progDrawer')">
				<i class="fa-solid fa-xmark"></i>
			</button>
		</div>
		<div class="drawer-body">
			{% set xp_in_level = xp_val % 200 %}
			{% set xp_pct      = xp_in_level > 0 ? (xp_in_level / 200 * 100)|round : 0 %}
			<div
				class="xp-card-new" style="margin-top:1rem">

				{# Header avec avatar animé #}
				<div class="xpc-header">
					<div class="xpc-stars"></div>
					<div class="xpc-orbit">
						<div class="xpc-planet">
							<span class="xpc-level-num">{{ xp_level }}</span>
						</div>
						<div class="xpc-ring xpc-ring1"></div>
						<div class="xpc-ring xpc-ring2"></div>
					</div>
					<div class="xpc-header-text">
						<div class="xpc-title">Ma Progression</div>
						<div class="xpc-subtitle">{{ xp_val }}
							XP · Niveau
							{{ xp_level }}</div>
					</div>
					<div class="xpc-flame-badge">
						{% if nb_passed >= 5 %}🔥 Expert{% elseif nb_passed >= 3 %}⚡ Confirmé{% elseif nb_passed >= 1 %}✨ Débutant{% else %}🌱 Novice
						{% endif %}
					</div>
				</div>

				{# XP Bar segmentée stylée #}
				<div class="xpc-bar-zone">
					<div class="xpc-bar-labels">
						<span class="xpc-bar-lbl-left">{{ xp_in_level }}
							XP</span>
						<span class="xpc-bar-lbl-right">→ Niv.{{ xp_level + 1 }}
							dans
							{{ 200 - xp_in_level }}
							XP</span>
					</div>
					<div class="xpc-bar-track">
						<div class="xpc-bar-fill" data-pct="{{ xp_pct }}" style="width:{{ xp_pct }}%">
							<div class="xpc-bar-shine"></div>
						</div>
						{% for seg in range(1, 9) %}
							<div class="xpc-seg-mark" style="left:{{ seg * 10 }}%"></div>
						{% endfor %}
					</div>
					<div class="xpc-bar-total">{{ xp_val }}
						/
						{{ xp_level * 200 }}
						XP total</div>
				</div>

				{# Stats trio #}
				<div class="xpc-stats">
					<div class="xpc-stat xpc-stat-win">
						<div class="xpc-stat-icon">🏆</div>
						<div class="xpc-stat-num">{{ nb_passed }}</div>
						<div class="xpc-stat-lbl">Réussies</div>
						<div class="xpc-stat-xp">+{{ nb_passed * 100 }}
							XP</div>
					</div>
					<div class="xpc-divider"></div>
					<div class="xpc-stat xpc-stat-fail">
						<div class="xpc-stat-icon">💪</div>
						<div class="xpc-stat-num">{{ nb_failed }}</div>
						<div class="xpc-stat-lbl">Tentées</div>
						<div class="xpc-stat-xp">+{{ nb_failed * 20 }}
							XP</div>
					</div>
					<div class="xpc-divider"></div>
					<div class="xpc-stat xpc-stat-open">
						<div class="xpc-stat-icon">🎯</div>
						<div class="xpc-stat-num">{{ nb_open }}</div>
						<div class="xpc-stat-lbl">Disponibles</div>
						<div class="xpc-stat-xp">À saisir</div>
					</div>
				</div>

				{# Badges hexagonaux #}
				<div class="xpc-badges-zone">
					<div class="xpc-badges-title">BADGES</div>
					<div class="xpc-badges-row">
						<div class="xpc-badge-hex {{ nb_passed >= 1 ? 'badge-unlocked badge-bronze' : 'badge-locked' }}" title="1ère réussite">
							<div class="hex-inner">
								<span class="hex-icon">🏅</span>
								<span class="hex-name">Débutant</span>
								{% if nb_passed < 1 %}
									<span class="hex-lock">🔒</span>
								{% endif %}
							</div>
						</div>
						<div class="xpc-badge-hex {{ nb_passed >= 3 ? 'badge-unlocked badge-silver' : 'badge-locked' }}" title="3 réussites">
							<div class="hex-inner">
								<span class="hex-icon">🥈</span>
								<span class="hex-name">Confirmé</span>
								{% if nb_passed < 3 %}
									<span class="hex-lock">🔒</span>
								{% endif %}
							</div>
						</div>
						<div class="xpc-badge-hex {{ nb_passed >= 5 ? 'badge-unlocked badge-gold' : 'badge-locked' }}" title="5 réussites">
							<div class="hex-inner">
								<span class="hex-icon">🥇</span>
								<span class="hex-name">Expert</span>
								{% if nb_passed < 5 %}
									<span class="hex-lock">🔒</span>
								{% endif %}
							</div>
						</div>
						<div class="xpc-badge-hex {{ xp_level >= 5 ? 'badge-unlocked badge-diamond' : 'badge-locked' }}" title="Niv.5 atteint">
							<div class="hex-inner">
								<span class="hex-icon">💎</span>
								<span class="hex-name">Élite</span>
								{% if xp_level < 5 %}
									<span class="hex-lock">🔒</span>
								{% endif %}
							</div>
						</div>
					</div>
				</div>

			</div>

			{# ════ À VENIR ════ #}
			{% if upcoming|length > 0 %}
				<div class="side-card" style="margin-top:1rem">
					<div class="side-card-head">
						<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.2"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10"/></svg>
						<span class="side-card-title">Prochaines ouvertures</span>
						<span class="side-badge-count">{{ upcoming|slice(0,4)|length }}</span>
					</div>
					<div class="upcoming-list">
						{% for ev in upcoming|slice(0,4) %}
							{% set dc = ev.difficulte == 'DIFFICILE' ? '#EF4444' : (ev.difficulte == 'FACILE' ? '#10B981' : '#6366F1') %}
							<div class="upcoming-row">
								<div class="upcoming-icon" style="background:{{ dc }}18;color:{{ dc }}">
									{{ ev.type == 'QCM' ? '📝' : (ev.type == 'Pratique' ? '🔧' : (ev.type == 'Oral' ? '🎤' : '📋')) }}
								</div>
								<div class="upcoming-info">
									<span class="upcoming-title">{{ ev.titre ?: ev.formation_titre }}</span>
									<span class="upcoming-meta">⏱
										{{ ev.duree }}min · 🎯
										{{ ev.score_requis }}%</span>
								</div>
								<span class="upcoming-diff" style="color:{{ dc }}">{{ ev.difficulte }}</span>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}

			{# ════ HISTORIQUE ════ #}
			{% if history|length > 0 %}
				<div class="side-card" style="margin-top:1rem">
					<div class="side-card-head">
						<svg width="14" height="14" viewbox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.2"><polyline points="22,12 18,12 15,21 9,3 6,12 2,12"/></svg>
						<span class="side-card-title">Mes derniers résultats</span>
					</div>
					<div class="hist-list">
						{% for h in history %}
							{% set hc = h.statut == 'passed' ? '#059669' : '#DC2626' %}
							{% set hb = h.statut == 'passed' ? '#D1FAE5' : '#FEE2E2' %}
							<div class="hist-row">
								<div class="hist-badge" style="background:{{ hb }};color:{{ hc }}">{{ h.statut == 'passed' ? '✓' : '✗' }}</div>
								<div class="hist-info">
									<span class="hist-title">{{ h.titre ?: h.formation_titre }}</span>
									<span class="hist-date">{{ h.datePassage ? h.datePassage|date('d/m/Y') : '' }}</span>
								</div>
								<span class="hist-score" style="background:{{ hb }};color:{{ hc }}">{{ h.score_pct }}%</span>
							</div>
						{% endfor %}
					</div>
				</div>
			{% endif %}
		</div>
	</div>
</div>

{# ══ MODAL — Nouvelle évaluation ════════════════════════════════════════════ #}
<div id="modalNew" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeNewModal()">
	<div class="modal-box modal-lg">
		<div class="modal-head">
			<h3 class="modal-title">➕ Nouvelle Évaluation</h3>
			<button class="modal-close" onclick="closeNewModal()">✕</button>
		</div>
		<form method="post" action="{{ path('evaluations_new') }}" class="modal-form" onsubmit="return validateForm(this)" novalidate>
			<div class="mf-row">
				<div class="mf-group" style="grid-column:1/-1">
					<label class="mf-lbl">Titre
						<span class="req">*</span>
					</label>
					<input type="text" name="titre" class="mf-input" required placeholder="Ex: Évaluation Angular Avancé" oninput="validateField(this)">
					<span class="error-msg" style="display:none"></span>
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Type</label>
					<select name="type" class="mf-input" id="new_type">
						{% for t in ['QCM','Pratique','Oral','Projet','Auto-évaluation'] %}
							<option>{{ t }}</option>
						{% endfor %}
					</select>
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Difficulté</label>
					<select name="difficulte" class="mf-input" id="new_diff" onchange="autoDiff(this.value)">
						<option value="FACILE">🟢 FACILE</option>
						<option value="MOYEN" selected>🔵 MOYEN</option>
						<option value="DIFFICILE">🔴 DIFFICILE</option>
					</select>
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Session (Formation)
						<span class="req">*</span>
					</label>
					<select name="session_id" class="mf-input" required oninput="validateField(this)">
						{% for s in sessions %}
							<option value="{{ s.id }}">{{ s.titre }}</option>
						{% endfor %}

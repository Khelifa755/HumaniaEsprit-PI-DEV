	/* ══ Confirm delete modal ════════════════════════════════════════════════ */
	.modal-confirm-box{
	  width:380px;max-width:92vw;border-radius:20px;padding:0;overflow:hidden;
	  box-shadow:0 24px 60px rgba(0,0,0,.18);
	}
	.confirm-icon-wrap{
	  background:linear-gradient(135deg,#FEF2F2,#FFF7ED);
	  display:flex;justify-content:center;padding:1.75rem 0 1.25rem;
	}
	.confirm-icon{
	  width:60px;height:60px;border-radius:50%;
	  background:linear-gradient(135deg,#FEE2E2,#FECACA);
	  border:3px solid #FCA5A5;
	  display:flex;align-items:center;justify-content:center;
	  font-size:1.6rem;color:#DC2626;
	  box-shadow:0 4px 16px rgba(239,68,68,.25);
	}

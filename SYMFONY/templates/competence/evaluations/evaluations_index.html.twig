	.sel-comp-tag{
	  background:#EEF2FF;color:#4F46E5;font-size:.68rem;font-weight:700;
	  padding:2px 8px;border-radius:20px;white-space:nowrap;
	}
	
	/* ── Quiz result redesigned ── */
	.quiz-result-new{display:flex;flex-direction:column;gap:1rem;padding:.5rem}
	.qrn-badge{
	  text-align:center;padding:1.5rem 1rem;border-radius:16px;
	  position:relative;overflow:hidden;
	}
	.qrn-badge::before{
	  content:'';position:absolute;inset:0;
	  background:repeating-linear-gradient(45deg,transparent,transparent 10px,rgba(255,255,255,.04) 10px,rgba(255,255,255,.04) 11px);
	}
	.qrn-pass{background:linear-gradient(135deg,#064E3B,#059669);box-shadow:0 8px 24px rgba(5,150,105,.3)}
	.qrn-fail{background:linear-gradient(135deg,#7F1D1D,#DC2626);box-shadow:0 8px 24px rgba(220,38,38,.25)}
	.qrn-emoji{font-size:2.5rem;margin-bottom:.4rem}
	.qrn-score{font-size:3rem;font-weight:900;color:white;line-height:1;letter-spacing:-.04em}
	.qrn-pct{font-size:1.2rem;font-weight:600;opacity:.8}
	.qrn-label{font-size:.9rem;font-weight:800;color:rgba(255,255,255,.85);margin-top:.25rem;text-transform:uppercase;letter-spacing:.08em}
	.qrn-stats{
	  display:flex;align-items:center;background:var(--g50);border-radius:12px;
	  border:1px solid var(--g200);overflow:hidden;
	}
	.qrn-stat{flex:1;text-align:center;padding:.6rem .4rem}
	.qrn-stat-num{display:block;font-size:1.4rem;font-weight:800}
	.qrn-stat-lbl{display:block;font-size:.62rem;color:var(--g500);font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-top:1px}
	.qrn-divider{width:1px;background:var(--g200);align-self:stretch;margin:.3rem 0}
	
	/* Level changes */
	.qrn-levels-title{font-size:.72rem;font-weight:800;color:var(--g500);text-transform:uppercase;letter-spacing:.07em}
	.quiz-levels-changed{display:flex;flex-direction:column;gap:.5rem}
	.level-change-row{
	  display:flex;align-items:center;gap:.6rem;
	  background:var(--g50);border-radius:10px;padding:.55rem .75rem;
	  border:1px solid var(--g200);
	}
	.lc-name{font-size:.75rem;font-weight:700;color:var(--g900);min-width:80px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
	.lc-bars{display:flex;align-items:center;gap:.4rem;flex:1}
	.lc-bar-wrap{flex:1;height:7px;background:var(--g200);border-radius:99px;overflow:hidden}

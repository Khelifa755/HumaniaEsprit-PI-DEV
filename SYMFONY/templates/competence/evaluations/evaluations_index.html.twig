	// ── Quiz ──────────────────────────────────────────────────────────────────
	let currentEvalId = null;
	async function openQuiz(id, title) {
	  currentEvalId = id;
	  document.getElementById('quiz_title').textContent = '📝 ' + title;
	  document.getElementById('quizBody').innerHTML = '<p style="color:#9CA3AF;text-align:center;padding:2rem">Chargement…</p>';
	  document.getElementById('modalQuiz').style.display = 'flex';
	
	  const res  = await fetch(`/evaluations/${id}/questions`);
	  const data = await res.json();
	
	  if (!data.questions || data.questions.length === 0) {
	    document.getElementById('quizBody').innerHTML = `
	      <div style="text-align:center;padding:2rem;color:#9CA3AF">
	        <div style="font-size:2rem;margin-bottom:.5rem">📋</div>
	        <p>Aucune question disponible pour cette évaluation.</p>
	      </div>`;
	    return;
	  }
	
	  let html = `<div class="quiz-info">⏱ ${data.eval.duree} min · 🎯 Score requis : ${data.eval.score_requis}%</div>
	    <form id="quizForm" class="quiz-form">`;
	  data.questions.forEach((q, i) => {
	    html += `<div class="quiz-q">
	      <div class="q-num">Q${i+1} / ${data.questions.length}</div>
	      <div class="q-text">${q.question}</div>
	      <div class="q-opts">`;
	    ['a','b','c','d'].forEach(opt => {
	      if (q['option_'+opt]) html += `<label class="q-opt">
	        <input type="radio" name="answers[${q.id}]" value="${opt.toUpperCase()}">
	        <span class="opt-letter">${opt.toUpperCase()}</span> ${q['option_'+opt]}
	      </label>`;
	    });
	    html += `</div></div>`;
	  });
	  html += `<div style="text-align:center;margin-top:1.5rem">
	    <button type="button" class="btn-submit-quiz" onclick="submitQuiz()">✅ Soumettre l'évaluation</button>
	  </div></form>`;
	  document.getElementById('quizBody').innerHTML = html;
	}
	
	async function submitQuiz() {
	  const form = document.getElementById('quizForm');
	  const fd   = new FormData(form);
	  const res  = await fetch(`/evaluations/${currentEvalId}/submit`, {method:'POST', body:fd});
	  const data = await res.json();
	  if (!data.ok) { alert('Erreur'); return; }
	
	  const gc = data.passed ? '#059669' : '#DC2626';
	  const gb = data.passed ? '#D1FAE5' : '#FEE2E2';
	
	  // Build level changes section
	  let levelsHtml = '';
	  if (data.updatedLevels && data.updatedLevels.length > 0) {
	    levelsHtml = `<div class="quiz-levels-changed">`;
	    data.updatedLevels.forEach(lv => {
	      const dir = lv.delta > 0 ? 'up' : 'down';
	      const lc = lv.delta > 0 ? '#059669' : '#DC2626';
	      const lb = lv.delta > 0 ? '#ECFDF5' : '#FEF2F2';
	      const arrow = lv.delta > 0 ? '▲' : '▼';
	      const pctOld = Math.round(lv.old_level / lv.max_level * 100);
	      const pctNew = Math.round(lv.new_level / lv.max_level * 100);
	      levelsHtml += `
	        <div class="level-change-row">
	          <div class="lc-name">${lv.libelle}</div>
	          <div class="lc-bars">
	            <div class="lc-bar-wrap">
	              <div class="lc-bar" style="width:${pctOld}%;background:#D1D5DB"></div>
	            </div>
	            <span class="lc-arrow ${dir === 'up' ? 'lc-up' : 'lc-down'}">${arrow}</span>
	            <div class="lc-bar-wrap">
	              <div class="lc-bar lc-bar-new" style="width:${pctNew}%;background:${lc}"></div>
	            </div>
	          </div>
	          <div class="lc-delta" style="background:${lb};color:${lc}">${lv.delta > 0 ? '+' : ''}${lv.delta} niv.</div>
	        </div>`;
	    });
	    levelsHtml += `</div>`;
	  }
	
	  let html = `
	  <div class="quiz-result-new">
	    <div class="qrn-badge ${data.passed ? 'qrn-pass' : 'qrn-fail'}">
	      <div class="qrn-emoji">${data.passed ? '🎉' : '😤'}</div>
	      <div class="qrn-score">${data.score}<span class="qrn-pct">%</span></div>
	      <div class="qrn-label">${data.passed ? 'Réussi !' : 'Échoué'}</div>
	    </div>
	    <div class="qrn-stats">
	      <div class="qrn-stat">
	        <span class="qrn-stat-num" style="color:#059669">${data.correct}</span>
	        <span class="qrn-stat-lbl">Correctes</span>
	      </div>
	      <div class="qrn-divider"></div>
	      <div class="qrn-stat">
	        <span class="qrn-stat-num" style="color:#DC2626">${data.total - data.correct}</span>
	        <span class="qrn-stat-lbl">Incorrectes</span>
	      </div>
	      <div class="qrn-divider"></div>
	      <div class="qrn-stat">
	        <span class="qrn-stat-num" style="color:#F59E0B">${data.total}</span>
	        <span class="qrn-stat-lbl">Total</span>
	      </div>
	    </div>
	    ${levelsHtml ? `<div class="qrn-levels-title">📊 Impact sur vos compétences</div>${levelsHtml}` : ''}
	    <div class="qrn-msg ${data.passed ? 'qrn-msg-pass' : 'qrn-msg-fail'}">
	      ${data.passed ? '✅ Excellent travail ! Vos niveaux ont été mis à jour.' : '💪 Continuez à vous entraîner. Repassez quand vous êtes prêt(e) !'}
	    </div>
	  </div>
	  <div style="text-align:center;margin-top:1rem">
	    <button class="btn-cancel" onclick="closeQuiz();location.reload()">Fermer &amp; actualiser</button>
	  </div>`;
	  document.getElementById('quizBody').innerHTML = html;
	}
	
	// ── Modal Edit ────────────────────────────────────────────────────────────
	function openEditModal(id, ev) {

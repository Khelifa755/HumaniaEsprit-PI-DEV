	  font-size:.78rem;color:#9CA3AF;margin:0;line-height:1.5;
	}
	.confirm-actions{
	  display:flex;gap:.75rem;padding:1rem 1.5rem 1.5rem;
	}
	.confirm-btn-cancel{
	  flex:1;padding:.7rem;border-radius:10px;border:1.5px solid #E5E7EB;
	  background:white;color:#374151;font-size:.85rem;font-weight:700;
	  cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:.4rem;
	}
	.confirm-btn-cancel:hover{background:#F9FAFB;border-color:#D1D5DB}
	.confirm-btn-delete{
	  flex:1;padding:.7rem;border-radius:10px;border:none;
	  background:linear-gradient(135deg,#DC2626,#B91C1C);
	  color:white;font-size:.85rem;font-weight:700;
	  cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:.4rem;
	  box-shadow:0 4px 12px rgba(220,38,38,.35);
	}

	.btn-adm-danger:hover{background:#FEF2F2;border-color:#EF4444}

	.ev-empty{text-align:center;padding:4rem;background:white;border-radius:20px;border:2px dashed #E2E8F0;color:#94A3B8}
	
	/* ── Side panel ── */
	.side-card{
	  background:white;border-radius:18px;
	  border:1px solid rgba(0,0,0,.07);overflow:hidden;
	  box-shadow:0 2px 14px rgba(0,0,0,.06);
	}
	.side-card-head{
	  display:flex;align-items:center;gap:.5rem;
	  padding:.85rem 1rem;
	  border-bottom:1px solid var(--g100);
	  background:linear-gradient(to bottom,#FAFBFF,white);
	}
	.side-card-title{font-size:.84rem;font-weight:800;color:var(--g900)}
	
	/* ── Calendrier redesigné ── */
	.cal-nav{
	  background:var(--g100);border:none;border-radius:9px;
	  padding:4px 11px;font-size:.86rem;font-weight:700;
	  cursor:pointer;color:#374151;transition:all .15s;
	}
	.cal-nav:hover{background:var(--g200);transform:scale(1.05)}
	.cal-today{
	  font-size:.68rem;background:linear-gradient(135deg,#EEF2FF,#E0E7FF);
	  color:#4F46E5;font-weight:700;border:1px solid #C7D2FE;
	  padding:4px 10px;border-radius:9px;
	}
	.cal-two-months{display:flex;flex-direction:column}
	.cal-month-block{padding:.75rem .9rem}
	.cal-month-block:first-child{
	  border-bottom:1px dashed #E2E8F0;
	  background:linear-gradient(to bottom,#FAFBFF,white);
	}
	.cal-month-title{
	  font-size:.72rem;font-weight:800;color:var(--g900);
	  text-align:center;margin-bottom:.55rem;letter-spacing:.05em;
	  text-transform:uppercase;
	}
	.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px}
	.cal-day-lbl{
	  text-align:center;font-size:.6rem;font-weight:700;
	  color:#A0AEC0;padding:2px 0;letter-spacing:.04em;
	}
	.cal-day{
	  display:flex;flex-direction:column;align-items:center;
	  justify-content:center;height:26px;border-radius:8px;
	  font-size:.68rem;color:#374151;cursor:default;position:relative;gap:1px;
	  transition:background .12s;
	}
	.cal-day:hover{background:var(--g100)}
	.cal-today-cell{
	  background:linear-gradient(135deg,#4F46E5,#6366F1) !important;
	  color:white;font-weight:900;border-radius:10px;
	  box-shadow:0 2px 10px rgba(79,70,229,.4);
	}
	.cal-has-eval{cursor:pointer;font-weight:700}
	.cal-dot{width:5px;height:5px;border-radius:50%;box-shadow:0 0 3px currentColor}
	
	/* Events liste redesignée — 3 événements */
	.cal-events{
	  border-top:1px solid var(--g100);
	  padding:.4rem .6rem .5rem;
	  display:flex;flex-direction:column;gap:4px;
	}
	.cal-event-row{
	  display:flex;align-items:center;gap:.5rem;
	  padding:.28rem .4rem;border-radius:8px;
	  background:var(--g50);border:1px solid var(--g100);
	  transition:background .12s;
	}
	.cal-event-row:hover{background:var(--g100)}
	.cal-event-dot{
	  width:8px;height:8px;border-radius:50%;flex-shrink:0;
	  box-shadow:0 0 4px currentColor;
	}
	.cal-event-title{
	  display:block;font-size:.67rem;font-weight:700;
	  color:var(--g900);white-space:nowrap;overflow:hidden;
	  text-overflow:ellipsis;flex:1;
	}
	.cal-event-meta{
	  display:block;font-size:.58rem;color:var(--g500);
	  white-space:nowrap;flex-shrink:0;
	}
	
	.cal-legend{
	  display:flex;gap:.5rem;flex-wrap:wrap;
	  padding:.5rem .9rem .7rem;border-top:1px solid var(--g100);
	  background:linear-gradient(to bottom,white,#F8F9FC);
	}
	.leg-item{display:flex;align-items:center;gap:4px;font-size:.63rem;color:var(--g500)}
	.leg-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0;box-shadow:0 0 3px currentColor}
	
	/* ── Tip card ── */
	.tip-card{position:relative;overflow:hidden;background:linear-gradient(135deg,#4F46E5 0%,#7C3AED 100%) !important;border-color:transparent !important}
	.tip-bg-decor{position:absolute;right:-20px;top:-20px;width:120px;height:120px;border-radius:50%;background:rgba(255,255,255,.06);pointer-events:none}
	.tip-bg-decor::after{content:'';position:absolute;right:-40px;bottom:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,.04)}
	.tip-inner{position:relative;z-index:1;padding:1rem 1rem .9rem}
	.tip-icon-wrap{width:36px;height:36px;border-radius:10px;background:rgba(255,255,255,.18);display:flex;align-items:center;justify-content:center;margin-bottom:.6rem}
	.tip-label{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.7);margin-bottom:.4rem}
	.tip-text{font-size:.8rem;font-weight:500;color:white;line-height:1.55;margin-bottom:.85rem}
	.tip-progress-wrap{display:flex;flex-direction:column;gap:.35rem}
	.tip-progress-track{height:5px;background:rgba(255,255,255,.2);border-radius:99px;overflow:hidden}
	.tip-progress-fill{height:100%;background:rgba(255,255,255,.85);border-radius:99px;width:0;transition:width .8s cubic-bezier(.4,0,.2,1)}
	.tip-progress-label{font-size:.62rem;color:rgba(255,255,255,.65);font-weight:500}
	
	/* ── XP Progression widget ── */
	.xp-card{background:white;border-radius:14px;border:1px solid var(--g200);overflow:hidden}
	.xp-header{display:flex;align-items:center;gap:.7rem;padding:.9rem 1rem .7rem;background:linear-gradient(135deg,#0f0e17 0%,#1e1b4b 100%);position:relative;overflow:hidden}
	.xp-header::before{content:'';position:absolute;right:-18px;top:-18px;width:90px;height:90px;border-radius:50%;background:rgba(99,102,241,.15)}
	.xp-header::after{content:'';position:absolute;left:40%;bottom:-22px;width:70px;height:70px;border-radius:50%;background:rgba(139,92,246,.1)}
	.xp-avatar{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,#6366F1,#8B5CF6);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 12px rgba(99,102,241,.4)}
	.xp-title-block{flex:1;min-width:0;position:relative;z-index:1}
	.xp-title{font-size:.82rem;font-weight:800;color:white;letter-spacing:.01em}
	.xp-subtitle{font-size:.66rem;color:rgba(255,255,255,.55);margin-top:1px}
	.xp-level-badge{background:linear-gradient(135deg,#F59E0B,#F97316);color:white;font-size:.68rem;font-weight:800;padding:4px 10px;border-radius:20px;box-shadow:0 2px 8px rgba(245,158,11,.4);flex-shrink:0;position:relative;z-index:1}
	
	.xp-bar-section{padding:.75rem 1rem .6rem;border-bottom:1px solid var(--g100)}
	.xp-bar-labels{display:flex;justify-content:space-between;font-size:.66rem;color:var(--g500);margin-bottom:.4rem;font-weight:600}
	.xp-bar-val{color:var(--p);font-weight:800}
	.xp-bar-track{height:10px;background:#EEF2FF;border-radius:99px;overflow:hidden;position:relative}
	.xp-bar-fill{height:100%;border-radius:99px;background:linear-gradient(to right,#6366F1,#8B5CF6,#A78BFA);transition:width 1.2s cubic-bezier(.4,0,.2,1);position:relative}
	.xp-bar-fill::after{content:'';position:absolute;top:0;right:0;bottom:0;width:30px;background:linear-gradient(to right,transparent,rgba(255,255,255,.4));border-radius:99px;animation:xp-shimmer 2s infinite}
	@keyframes xp-shimmer{0%,100%{opacity:0}50%{opacity:1}}
	.xp-bar-next{font-size:.62rem;color:var(--g500);margin-top:.35rem;font-style:italic}
	
	.xp-stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-bottom:1px solid var(--g100)}
	.xp-stat{padding:.6rem .5rem;text-align:center;border-right:1px solid var(--g100)}
	.xp-stat:last-child{border-right:none}
	.xp-stat-num{font-size:1.3rem;font-weight:800;color:var(--g900);line-height:1}
	.xp-stat-lbl{font-size:.62rem;color:var(--g500);margin:.1rem 0;font-weight:500}
	.xp-stat-xp{font-size:.6rem;font-weight:700;padding:2px 6px;border-radius:20px;display:inline-block}
	.xp-stat-green .xp-stat-num{color:#059669}
	.xp-stat-green .xp-stat-xp{background:#D1FAE5;color:#059669}
	.xp-stat-red .xp-stat-num{color:#DC2626}
	.xp-stat-red .xp-stat-xp{background:#FEE2E2;color:#DC2626}
	.xp-stat-blue .xp-stat-num{color:#4F46E5}
	.xp-stat-blue .xp-stat-xp{background:#EEF2FF;color:#4F46E5}
	
	.xp-trophies{padding:.7rem 1rem .85rem}
	.xp-trophies-label{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em;color:var(--g500);margin-bottom:.55rem}
	.xp-trophies-row{display:flex;gap:.5rem;justify-content:space-between}
	.xp-trophy{display:flex;flex-direction:column;align-items:center;gap:.25rem;flex:1;padding:.45rem .2rem;border-radius:10px;border:1.5px solid var(--g200);transition:all .2s;cursor:default}
	.xp-trophy.unlocked{background:linear-gradient(135deg,#FFFBEB,#FEF3C7);border-color:#FCD34D;box-shadow:0 2px 8px rgba(245,158,11,.15)}
	.xp-trophy.locked{opacity:.35;filter:grayscale(1)}
	.xp-trophy span:first-child{font-size:1.1rem}
	.trophy-name{font-size:.56rem;font-weight:700;color:var(--g500);text-align:center;line-height:1.2}
	.xp-trophy.unlocked .trophy-name{color:#92400E}
	
	/* ── Upcoming & History ── */
	.side-badge-count{background:#6366F1;color:white;font-size:.62rem;font-weight:800;padding:2px 7px;border-radius:10px;margin-left:auto}
	.upcoming-list{padding:.35rem .5rem .5rem}
	.upcoming-row{display:flex;align-items:center;gap:.55rem;padding:.45rem .5rem;border-bottom:1px solid var(--g50)}
	.upcoming-row:last-child{border-bottom:none}
	.upcoming-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:.85rem;flex-shrink:0}
	.upcoming-info{flex:1;min-width:0}
	.upcoming-title{display:block;font-size:.72rem;font-weight:700;color:var(--g900);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
	.upcoming-meta{display:block;font-size:.62rem;color:var(--g500)}
	.upcoming-diff{font-size:.6rem;font-weight:800;flex-shrink:0}
	.hist-list{padding:.4rem .25rem}
	.hist-row{display:flex;align-items:center;gap:.65rem;padding:.45rem .65rem;border-bottom:1px solid var(--g50)}
	.hist-badge{width:24px;height:24px;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:800;flex-shrink:0}
	.hist-info{flex:1;min-width:0}
	.hist-title{display:block;font-size:.74rem;font-weight:600;color:var(--g900);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
	.hist-date{font-size:.62rem;color:var(--g500)}
	.hist-score{font-size:.74rem;font-weight:800;padding:3px 9px;border-radius:7px;flex-shrink:0}
	
	/* ── Modals ── */
	.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:center;justify-content:center;padding:1rem}
	.modal-box{background:white;border-radius:18px;width:100%;max-width:500px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);animation:modalIn .2s ease}
	.modal-lg{max-width:680px}
	@keyframes modalIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
	.modal-head{display:flex;justify-content:space-between;align-items:center;padding:1.1rem 1.4rem;border-bottom:1px solid var(--g100);position:sticky;top:0;background:white;z-index:1}
	.modal-title{font-size:1rem;font-weight:800;color:var(--g900);margin:0}
	.modal-close{background:none;border:none;font-size:1rem;cursor:pointer;color:var(--g500);padding:4px 8px;border-radius:6px}
	.modal-close:hover{background:var(--g100)}
	.modal-form{padding:1.1rem 1.4rem}
	.mf-row{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}
	.mf-group{display:flex;flex-direction:column;gap:4px}
	.mf-lbl{font-size:.68rem;font-weight:800;color:var(--g500);text-transform:uppercase;letter-spacing:.05em}
	.mf-input{padding:8px 11px;border:1.5px solid var(--g200);border-radius:8px;font-size:.86rem;outline:none;transition:border-color .15s}
	.mf-input:focus{border-color:var(--p);box-shadow:0 0 0 3px #4F46E518}
	.mf-input-error{border-color:#DC2626!important;background:#FEF2F2}
	.error-msg{display:none;font-size:.72rem;color:#DC2626;font-weight:600;margin-top:3px}
	.req{color:#DC2626}
	.modal-footer{display:flex;justify-content:flex-end;gap:.65rem;padding-top:1rem;border-top:1px solid var(--g100);margin-top:.5rem}
	.btn-cancel{padding:8px 16px;border-radius:8px;background:var(--g100);color:var(--g500);font-weight:700;border:none;cursor:pointer;font-size:.86rem}
	.btn-save{padding:8px 20px;border-radius:8px;background:var(--p);color:white;font-weight:700;border:none;cursor:pointer;font-size:.86rem}
	
	/* ── Details ── */
	.det-grid{display:flex;flex-direction:column;gap:.4rem}
	.det-row{display:flex;justify-content:space-between;align-items:center;padding:.35rem 0;border-bottom:1px solid var(--g50);font-size:.86rem}
	.det-lbl{color:var(--g500);font-size:.75rem;font-weight:600}
	
	/* ── Quiz ── */
	.quiz-info{background:#EEF2FF;color:#4F46E5;font-size:.8rem;font-weight:700;padding:.55rem .9rem;border-radius:8px;margin-bottom:1.1rem}
	.quiz-form{display:flex;flex-direction:column;gap:1.1rem}
	.q-num{font-size:.65rem;font-weight:800;color:var(--g500);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem}
	.q-text{font-size:.88rem;font-weight:700;color:var(--g900);margin-bottom:.5rem;line-height:1.4}
	.q-opts{display:flex;flex-direction:column;gap:.3rem}
	.q-opt{display:flex;align-items:center;gap:.5rem;font-size:.82rem;color:#374151;cursor:pointer;padding:.3rem .5rem;border-radius:7px;border:1px solid transparent;transition:background .15s}
	.q-opt:hover{background:#F5F3FF;border-color:#C4B5FD}
	.q-opt input{accent-color:#6366F1}
	.opt-letter{font-weight:800;color:#6366F1;min-width:16px}
	.btn-submit-quiz{padding:10px 28px;border-radius:11px;border:none;background:#6366F1;color:white;font-weight:700;font-size:.88rem;cursor:pointer}
	.btn-submit-quiz:hover{background:#4F46E5}
	.quiz-result{padding:1.75rem;border-radius:12px;border:2px solid;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.35rem}
	.qr-score{font-size:2.5rem;font-weight:800;line-height:1}
	.qr-detail{font-size:.88rem;font-weight:600}
	.qr-delta{font-size:.82rem;font-weight:700;background:white;padding:4px 12px;border-radius:20px}
	.qr-msg{font-size:.8rem;color:#6B7280}
	
	/* ══ XP PROGRESSION — Redesign ultra créatif ══ */
	.xp-card-new{
	  background:white;border-radius:22px;
	  border:1px solid rgba(99,102,241,.15);
	  overflow:hidden;
	  box-shadow:0 8px 32px rgba(99,102,241,.12),0 2px 8px rgba(0,0,0,.06);
	}
	
	/* ── Header amélioré ── */
	.xpc-header{
	  padding:1.4rem 1.2rem 1.1rem;
	  background:linear-gradient(135deg,#0D0829 0%,#1E1060 40%,#0F2D5A 80%,#0A1628 100%);
	  display:flex;align-items:center;gap:.9rem;position:relative;overflow:hidden;
	}
	/* Particules lumineuses */
	.xpc-header::before{
	  content:'';position:absolute;right:-20px;top:-20px;
	  width:160px;height:160px;border-radius:50%;
	  background:radial-gradient(circle,rgba(139,92,246,.35) 0%,rgba(99,102,241,.15) 50%,transparent 70%);
	}
	.xpc-header::after{
	  content:'';position:absolute;left:25%;bottom:-30px;
	  width:100px;height:100px;border-radius:50%;
	  background:radial-gradient(circle,rgba(59,130,246,.25),transparent 70%);
	}
	/* Étoiles décoratives */
	.xpc-stars{
	  position:absolute;inset:0;pointer-events:none;
	  background-image:
	    radial-gradient(1.5px 1.5px at 15% 20%, rgba(255,255,255,.6) 0%, transparent 100%),
	    radial-gradient(1px 1px at 70% 35%, rgba(255,255,255,.5) 0%, transparent 100%),
	    radial-gradient(1.5px 1.5px at 40% 70%, rgba(255,255,255,.4) 0%, transparent 100%),
	    radial-gradient(1px 1px at 85% 60%, rgba(255,255,255,.6) 0%, transparent 100%),
	    radial-gradient(1px 1px at 55% 15%, rgba(255,255,255,.5) 0%, transparent 100%),
	    radial-gradient(1px 1px at 25% 80%, rgba(255,255,255,.35) 0%, transparent 100%);
	}
	
	/* Orbite planétaire */
	.xpc-orbit{
	  position:relative;width:64px;height:64px;flex-shrink:0;
	  animation:xpc-orbit-float 5s ease-in-out infinite;z-index:2;
	}
	@keyframes xpc-orbit-float{
	  0%,100%{transform:translateY(0) rotate(0deg)}
	  50%{transform:translateY(-5px) rotate(3deg)}
	}
	.xpc-planet{
	  width:64px;height:64px;border-radius:50%;
	  background:linear-gradient(135deg,#7C3AED 0%,#4F46E5 50%,#3B82F6 100%);
	  display:flex;align-items:center;justify-content:center;
	  box-shadow:
	    0 0 0 3px rgba(139,92,246,.4),
	    0 0 0 7px rgba(139,92,246,.12),
	    0 0 30px rgba(79,70,229,.55);
	  z-index:2;position:relative;
	}
	.xpc-level-num{
	  font-size:1.5rem;font-weight:900;color:white;
	  letter-spacing:-.06em;
	  text-shadow:0 2px 8px rgba(0,0,0,.3);
	}
	.xpc-ring{
	  position:absolute;border-radius:50%;
	  top:50%;left:50%;transform:translate(-50%,-50%);
	}
	.xpc-ring1{
	  width:80px;height:80px;
	  border:1.5px dashed rgba(139,92,246,.35);
	  animation:xpc-spin1 8s linear infinite;
	}
	.xpc-ring2{
	  width:96px;height:96px;
	  border:1px solid rgba(99,102,241,.2);
	  animation:xpc-spin2 14s linear infinite reverse;
	}
	@keyframes xpc-spin1{to{transform:translate(-50%,-50%) rotate(360deg)}}
	@keyframes xpc-spin2{to{transform:translate(-50%,-50%) rotate(360deg)}}
	
	.xpc-header-text{flex:1;min-width:0;position:relative;z-index:2}
	.xpc-title{
	  font-size:.92rem;font-weight:900;color:white;
	  letter-spacing:.02em;margin-bottom:2px;
	}
	.xpc-subtitle{
	  font-size:.72rem;
	  color:rgba(255,255,255,.55);
	  font-weight:500;
	}
	.xpc-flame-badge{
	  font-size:.7rem;font-weight:800;
	  padding:5px 12px;border-radius:20px;
	  background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(255,255,255,.08));
	  color:white;
	  border:1px solid rgba(255,255,255,.2);
	  flex-shrink:0;position:relative;z-index:2;
	  white-space:nowrap;backdrop-filter:blur(6px);
	  box-shadow:0 2px 12px rgba(0,0,0,.2);
	}
	
	/* ── XP Bar redesignée ── */
	.xpc-bar-zone{
	  padding:.9rem 1.1rem .75rem;
	  border-bottom:1px solid var(--g100);
	  background:linear-gradient(to bottom,#FAFBFF,white);
	}
	.xpc-bar-labels{
	  display:flex;justify-content:space-between;
	  font-size:.69rem;margin-bottom:.5rem;font-weight:600;
	}
	.xpc-bar-lbl-left{color:#4F46E5;font-weight:800}
	.xpc-bar-lbl-right{color:var(--g500)}
	.xpc-bar-track{
	  height:14px;
	  background:linear-gradient(to right,#F0F0FF,#EEF2FF);
	  border-radius:99px;overflow:hidden;position:relative;
	  box-shadow:inset 0 2px 6px rgba(99,102,241,.12),inset 0 1px 3px rgba(0,0,0,.06);
	  border:1px solid rgba(99,102,241,.1);
	}
	.xpc-bar-fill{
	  height:100%;border-radius:99px;
	  background:linear-gradient(90deg,#A78BFA,#818CF8,#6366F1,#4F46E5);
	  position:relative;transition:width 1.4s cubic-bezier(.4,0,.2,1);
	  box-shadow:0 0 14px rgba(99,102,241,.6),inset 0 1px 2px rgba(255,255,255,.25);
	}
	.xpc-bar-shine{
	  position:absolute;top:0;left:0;right:0;height:55%;
	  background:linear-gradient(to bottom,rgba(255,255,255,.4),transparent);
	  border-radius:99px;
	}
	/* Animation pulse sur la barre */
	.xpc-bar-fill::after{
	  content:'';position:absolute;top:0;right:-2px;bottom:0;width:6px;
	  background:rgba(255,255,255,.7);border-radius:50%;
	  box-shadow:0 0 8px 3px rgba(255,255,255,.4);
	  animation:xpc-pulse 2s ease-in-out infinite;
	}
	@keyframes xpc-pulse{0%,100%{opacity:.6;transform:scaleX(1)}50%{opacity:1;transform:scaleX(1.5)}}
	.xpc-seg-mark{position:absolute;top:50%;transform:translateY(-50%);width:1px;height:7px;background:rgba(255,255,255,.35)}
	.xpc-bar-total{font-size:.63rem;color:var(--g500);margin-top:.35rem;text-align:right;font-weight:500}
	
	/* ── Stats trio ── */
	.xpc-stats{
	  display:flex;align-items:stretch;
	  background:linear-gradient(to bottom,white,#FAFBFF);
	  border-bottom:1px solid var(--g100);
	}
	.xpc-stat{
	  flex:1;display:flex;flex-direction:column;
	  align-items:center;padding:.7rem .4rem;gap:.22rem;
	  transition:background .15s;cursor:default;

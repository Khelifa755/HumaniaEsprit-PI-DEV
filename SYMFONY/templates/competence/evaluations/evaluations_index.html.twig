	.xpc-stat-fail .xpc-stat-num{color:#D97706}
	.xpc-stat-fail .xpc-stat-xp{background:linear-gradient(135deg,#FFF7ED,#FEF3C7);color:#D97706;border:1px solid #FDE68A}
	.xpc-stat-open .xpc-stat-num{color:#4F46E5}
	.xpc-stat-open .xpc-stat-xp{background:linear-gradient(135deg,#EEF2FF,#E0E7FF);color:#4F46E5;border:1px solid #A5B4FC}
	.xpc-divider{width:1px;background:linear-gradient(to bottom,transparent,var(--g200),transparent);flex-shrink:0;align-self:stretch;margin:.3rem 0}
	
	/* ── Badges ── */
	.xpc-badges-zone{padding:.9rem 1.1rem 1.1rem;background:linear-gradient(to bottom,#FAFBFF,white)}
	.xpc-badges-title{
	  font-size:.62rem;font-weight:900;text-transform:uppercase;
	  letter-spacing:.14em;color:var(--g500);margin-bottom:.7rem;
	  display:flex;align-items:center;gap:.4rem;
	}
	.xpc-badges-title::after{content:'';flex:1;height:1px;background:var(--g100)}
	.xpc-badges-row{display:flex;gap:.55rem;justify-content:space-between}
	.xpc-badge-hex{
	  flex:1;padding:.6rem .3rem;border-radius:14px;
	  border:1.5px solid var(--g200);
	  display:flex;flex-direction:column;align-items:center;
	  cursor:default;transition:all .22s cubic-bezier(.34,1.56,.64,1);
	  position:relative;overflow:hidden;
	}
	.xpc-badge-hex:hover:not(.badge-locked){
	  transform:translateY(-3px) scale(1.06);
	  box-shadow:0 6px 20px rgba(0,0,0,.12);
	}
	.hex-inner{display:flex;flex-direction:column;align-items:center;gap:.22rem}
	.hex-icon{font-size:1.4rem;line-height:1;filter:drop-shadow(0 2px 4px rgba(0,0,0,.15))}
	.hex-name{font-size:.59rem;font-weight:800;text-align:center;color:var(--g500);letter-spacing:.02em}
	.hex-lock{position:absolute;top:3px;right:5px;font-size:.56rem;opacity:.5}
	
	/* Badge states */
	.badge-locked{
	  background:linear-gradient(135deg,#F8FAFC,#F1F5F9);
	  opacity:.5;filter:grayscale(.85);
	}
	.badge-unlocked{animation:badge-pop .5s cubic-bezier(.34,1.56,.64,1)}
	@keyframes badge-pop{from{transform:scale(.75);opacity:.3}to{transform:scale(1);opacity:1}}
	.badge-bronze{
	  background:linear-gradient(135deg,#FEF9EE,#FEF3C7,#FDE68A);
	  border-color:#F59E0B;
	  box-shadow:0 2px 12px rgba(245,158,11,.25);
	}
	.badge-bronze .hex-name{color:#92400E}
	.badge-silver{
	  background:linear-gradient(135deg,#F8FAFC,#F1F5F9,#E2E8F0);
	  border-color:#94A3B8;
	  box-shadow:0 2px 12px rgba(148,163,184,.3);
	}
	.badge-silver .hex-name{color:#475569}
	.badge-gold{
	  background:linear-gradient(135deg,#FFFEF0,#FFFBEB,#FDE68A);
	  border-color:#EAB308;
	  box-shadow:0 2px 14px rgba(234,179,8,.35);
	}
	.badge-gold::before{
	  content:'✦';position:absolute;top:3px;left:5px;
	  font-size:.55rem;color:#EAB30888;
	}
	.badge-gold .hex-name{color:#713F12}
	.badge-diamond{
	  background:linear-gradient(135deg,#F0F9FF,#EFF6FF,#DBEAFE);
	  border-color:#60A5FA;
	  box-shadow:0 2px 14px rgba(96,165,250,.35);
	}
	.badge-diamond .hex-name{color:#1E40AF}
	
	/* ── Multi-competence selector ── */
	.multi-comp-wrap{background:var(--g50);border:1.5px solid var(--g200);border-radius:10px;overflow:hidden}
	.multi-comp-search{padding:.5rem .5rem 0}
	.multi-comp-list{
	  max-height:150px;overflow-y:auto;display:flex;flex-direction:column;gap:1px;
	  padding:.3rem .5rem;

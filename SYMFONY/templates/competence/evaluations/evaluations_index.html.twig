							<input type="text" id="compSearchInput" placeholder="🔍 Rechercher une compétence…" oninput="filterCompList()" class="mf-input" style="margin-bottom:.5rem">
						</div>
						<div class="multi-comp-list" id="compCheckList">
							{% for c in competences %}
								<label class="comp-check-item">
									<input type="checkbox" name="extra_competence_ids[]" value="{{ c.id }}" class="comp-checkbox">
									<span class="comp-check-dot" style="background:#6366F1"></span>
									<span class="comp-check-name">{{ c.libelle }}</span>
									<span class="comp-check-max">max
										{{ c.niveauMax }}</span>
								</label>
							{% endfor %}
						</div>
						<div class="multi-comp-selected" id="selectedCompsPreview">Aucune compétence supplémentaire sélectionnée</div>
					</div>
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Durée (min)</label>
					<input type="number" name="duree" class="mf-input" value="30" min="5" max="180">
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Score requis (%)</label>
					<input type="number" name="score_requis" id="new_score" class="mf-input" value="70" min="50" max="100">
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Niveau requis
						<span style="font-weight:400;color:#9CA3AF;text-transform:none;letter-spacing:0">(pour débloquer)</span>
					</label>
					<input type="number" name="niveau_requis" id="new_niveau_requis" class="mf-input" value="0" min="0" max="5">
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Niveaux si réussi</label>
					<input type="number" name="niveau_succes" id="new_ok" class="mf-input" value="1" min="0" max="5">
				</div>
				<div class="mf-group">
					<label class="mf-lbl">Niveaux si échoué</label>
					<input type="number" name="niveau_echec" id="new_ko" class="mf-input" value="-1" min="-5" max="0">
				</div>
				<div class="mf-group">
					<label class="mf-lbl">📅 Ouverture</label>
					<input type="date" name="dateDebut" class="mf-input" value="{{ 'now'|date('Y-m-d') }}">
				</div>
				<div class="mf-group">
					<label class="mf-lbl">📅 Clôture</label>
					<input type="date" name="dateFin" class="mf-input" value="{{ '+7 days'|date('Y-m-d') }}">
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn-cancel" onclick="closeNewModal()">Annuler</button>
				<button type="submit" class="btn-save">✅ Créer</button>
			</div>
		</form>
	</div>
</div>


	// ── 3-dots dropdown ──────────────────────────────────────────────────────
	function toggleMore(btn) {
	  const wrap = btn.closest('.card-more-wrap');
	  const isOpen = wrap.classList.contains('open');
	  closeAllMore();
	  if (!isOpen) wrap.classList.add('open');

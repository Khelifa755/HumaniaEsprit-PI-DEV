<script>
	// ── Calendrier ────────────────────────────────────────────────────────────
	const calEvals = {{ calendarEvals|raw }};
	let calDate = new Date();
	calDate.setDate(1);
	
	function renderOneMonth(y, m, todayTs) {
	  const monthNames = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
	  const days = new Date(y, m+1, 0).getDate();
	  let dow = new Date(y, m, 1).getDay(); if (dow === 0) dow = 7;
	  const evalMap = {};
	  calEvals.forEach(ev => {
	    if (!ev.eval_debut || !ev.eval_fin) return;
	    const ds = new Date(ev.eval_debut), de = new Date(ev.eval_fin);
	    for (let d = 1; d <= days; d++) {
	      const t = new Date(y, m, d).getTime();
	      if (t >= ds.getTime() && t <= de.getTime()) {
	        if (!evalMap[d]) evalMap[d] = [];
	        evalMap[d].push(ev);
	      }
	    }
	  });
	  const dayLabels = ['L','M','M','J','V','S','D'];
	  let html = `<div class="cal-month-block">
	    <div class="cal-month-title">${monthNames[m]} ${y}</div>
	    <div class="cal-grid">`;
	  dayLabels.forEach(l => html += `<div class="cal-day-lbl">${l}</div>`);
	  for (let i = 1; i < dow; i++) html += '<div></div>';
	  for (let d = 1; d <= days; d++) {
	    const isToday = new Date(y,m,d).getTime() === todayTs;
	    const hasEval = evalMap[d] && evalMap[d].length > 0;
	    const color = hasEval ? getCalColor(evalMap[d][0]) : 'transparent';
	    const title = hasEval ? (evalMap[d][0].titre || evalMap[d][0].formation_titre) : '';
	    html += `<div class="cal-day ${isToday?'cal-today-cell':''} ${hasEval?'cal-has-eval':''}"
	      title="${title}" style="${hasEval?'outline:2px solid '+color+';outline-offset:-1px':''}">
	      <span>${d}</span>
	      ${hasEval ? `<span class="cal-dot" style="background:${color}"></span>` : ''}
	    </div>`;
	  }
	  html += '</div>';
	  const monthEvs = calEvals.filter(ev => {
	    if (!ev.eval_debut || !ev.eval_fin) return false;
	    const ds = new Date(ev.eval_debut), de = new Date(ev.eval_fin);
	    return new Date(y,m,1) <= de && new Date(y,m+1,0) >= ds;
	  });
	  if (monthEvs.length > 0) {
	    html += '<div class="cal-events">';
	    monthEvs.slice(0,3).forEach(ev => {
	      const c = getCalColor(ev);
	      const dates = `${ev.eval_debut?.slice(5,10).replace('-','/')} → ${ev.eval_fin?.slice(5,10).replace('-','/')}`;
	      html += `<div class="cal-event-row">
	        <span class="cal-event-dot" style="background:${c};color:${c}"></span>
	        <span class="cal-event-title">${ev.titre || ev.formation_titre}</span>
	        <span class="cal-event-meta">${dates}</span>
	      </div>`;
	    });
	    if (monthEvs.length > 3) {
	      html += `<div style="font-size:.6rem;color:#9CA3AF;text-align:center;padding:.15rem 0">+${monthEvs.length-3} autres</div>`;
	    }
	    html += '</div>';
	  }
	  html += '</div>';
	  return html;
	}
	
	function calRender() {
	  const monthNames = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
	  const y = calDate.getFullYear(), m = calDate.getMonth();
	  const today = new Date(); today.setHours(0,0,0,0);
	  const y2 = m === 11 ? y+1 : y, m2 = m === 11 ? 0 : m+1;
	  document.getElementById('calMonthLabel').textContent = monthNames[m] + ' – ' + monthNames[m2];
	  document.getElementById('calBody').innerHTML =
	    '<div class="cal-two-months">' +
	    renderOneMonth(y, m, today.getTime()) +
	    renderOneMonth(y2, m2, today.getTime()) +
	    '</div>';
	}
	
	// ── XP bar animation (new widget) ────────────────────────────────────────────
	document.addEventListener('DOMContentLoaded', () => {
	  const fill = document.querySelector('.xpc-bar-fill');
	  if (fill) {
	    const pct = fill.dataset.pct || 0;
	    fill.style.width = '0%';
	    setTimeout(() => { fill.style.transition = 'width 1.4s cubic-bezier(.4,0,.2,1)'; fill.style.width = pct + '%'; }, 300);
	  }
	});
	
	// ── Multi-competence checkbox filter ────────────────────────────────────────
	function filterCompList() {
	  const q = document.getElementById('compSearchInput')?.value.toLowerCase() || '';
	  document.querySelectorAll('#compCheckList .comp-check-item').forEach(item => {
	    const name = item.querySelector('.comp-check-name')?.textContent.toLowerCase() || '';
	    item.style.display = name.includes(q) ? '' : 'none';
	  });
	}
	
	// ── Update selected comps preview ──────────────────────────────────────────
	document.addEventListener('change', e => {
	  if (e.target.classList.contains('comp-checkbox')) {
	    const preview = document.getElementById('selectedCompsPreview');
	    if (!preview) return;
	    const checked = Array.from(document.querySelectorAll('.comp-checkbox:checked'));
	    if (checked.length === 0) {
	      preview.textContent = 'Aucune compétence supplémentaire sélectionnée';
	      preview.classList.remove('has-selected');
	    } else {
	      preview.innerHTML = checked.map(cb => {
	        const name = cb.closest('.comp-check-item')?.querySelector('.comp-check-name')?.textContent || '';
	        return `<span class="sel-comp-tag">${name}</span>`;
	      }).join('');
	      preview.classList.add('has-selected');
	    }
	  }
	});
	
	
	function getCalColor(ev) {
	  if (ev.my_statut === 'passed')     return '#10B981';
	  if (ev.my_statut === 'failed')     return '#EF4444';
	  if (ev.access_state === 'expired') return '#9CA3AF';
	  if (ev.access_state === 'not_yet') return '#F59E0B';
	  return '#6366F1';
	}
	function calPrev()  { calDate.setMonth(calDate.getMonth()-1); calRender(); }
	function calNext()  { calDate.setMonth(calDate.getMonth()+1); calRender(); }
	function calToday() { calDate = new Date(); calDate.setDate(1); calRender(); }
	calRender();
	
	// ── Drawers ─────────────────────────────────────────────────────────────────
	function openDrawer(id) {
	  document.getElementById(id).classList.add('open');
	  document.body.style.overflow = 'hidden';
	  if (id === 'calDrawer') calRender();
	}
	function closeDrawer(id) {
	  document.getElementById(id).classList.remove('open');
	  document.body.style.overflow = '';
	}
	document.addEventListener('keydown', e => {
	  if (e.key === 'Escape') {
	    closeDrawer('calDrawer');
	    closeDrawer('progDrawer');
	  }
	});
	
	// ── Tab switching ────────────────────────────────────────────────────────────
	let currentTab = 'all';
	function switchTab(btn, tab) {
	  currentTab = tab;
	  document.querySelectorAll('.ev-tab').forEach(b => b.classList.remove('active'));
	  btn.classList.add('active');
	  filterCards();
	}
	
	// ── View toggle ─────────────────────────────────────────────────────────────
	function setView(v) {
	  const grid = document.getElementById('evCardsGrid');
	  if (!grid) return;
	  if (v === 'list') {
	    grid.classList.add('list-view');
	    document.getElementById('btnList').classList.add('active');
	    document.getElementById('btnGrid').classList.remove('active');
	  } else {
	    grid.classList.remove('list-view');
	    document.getElementById('btnGrid').classList.add('active');
	    document.getElementById('btnList').classList.remove('active');
	  }
	}
	
	// ── Filter cards (client-side) ───────────────────────────────────────────────
	function filterCards() {
	  const q      = (document.getElementById('searchInput')?.value || '').toLowerCase();
	  const statut = document.getElementById('statutSel')?.value || '';
	  const type   = document.getElementById('typeSel')?.value || '';
	  let visible  = 0;
	  document.querySelectorAll('#evCardsGrid .eval-card').forEach(card => {
	    const matchTab    = currentTab === 'all' || card.dataset.tab === currentTab;
	    const matchSearch = !q || (card.dataset.title || '').includes(q);
	    const matchStatut = !statut || card.dataset.statut === statut || card.dataset.mystat === statut;
	    const matchType   = !type || card.dataset.type === type;
	    const show = matchTab && matchSearch && matchStatut && matchType;
	    card.style.display = show ? '' : 'none';
	    if (show) visible++;
	  });
	}
	
	function submitFilter() {
	  const q      = document.getElementById('searchInput')?.value || '';
	  const statut = document.getElementById('statutSel')?.value || '';
	  const type   = document.getElementById('typeSel')?.value || '';
	  const url    = new URL(window.location.href);
	  if (q)      url.searchParams.set('search', q);      else url.searchParams.delete('search');
	  if (statut) url.searchParams.set('statut', statut); else url.searchParams.delete('statut');
	  if (type)   url.searchParams.set('type', type);     else url.searchParams.delete('type');
	  window.location = url.toString();
	}
	
	// ── Difficulté auto-remplissage ───────────────────────────────────────────
	function autoDiff(v) {
	  const m = {FACILE:{s:60,ok:1,ko:-1},MOYEN:{s:70,ok:2,ko:-1},DIFFICILE:{s:80,ok:3,ko:-2}};
	  const d = m[v]; if (!d) return;
	  document.getElementById('new_score').value = d.s;
	  document.getElementById('new_ok').value    = d.ok;
	  document.getElementById('new_ko').value    = d.ko;
	}
	

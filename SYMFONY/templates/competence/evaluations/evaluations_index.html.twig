	.comp-check-item{
	  display:flex;align-items:center;gap:.5rem;padding:.3rem .4rem;
	  border-radius:7px;cursor:pointer;font-size:.82rem;color:#374151;
	  transition:background .12s;
	}
	.comp-check-item:hover{background:white}
	.comp-check-item input{accent-color:#6366F1;flex-shrink:0}
	.comp-check-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0}
	.comp-check-name{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

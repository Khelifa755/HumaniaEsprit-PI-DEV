	.det-impact-ko{background:#FEF2F2;border:1px solid #FCA5A5}
	.det-impact-label{font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em;
	  color:#6B7280}
	.det-impact-ok .det-impact-label{color:#065F46}
	.det-impact-ko .det-impact-label{color:#991B1B}
	.det-impact-val{font-size:1rem;font-weight:900}
	.det-impact-ok .det-impact-val{color:#059669}
	.det-impact-ko .det-impact-val{color:#DC2626}
	/* Score bar */
	.det-score-block{display:flex;align-items:center;gap:.75rem}

	.lc-down{color:#DC2626}
	.lc-delta{font-size:.68rem;font-weight:800;padding:3px 9px;border-radius:20px;flex-shrink:0;white-space:nowrap}
	
	.qrn-msg{padding:.65rem .9rem;border-radius:10px;font-size:.82rem;font-weight:600;text-align:center}
	.qrn-msg-pass{background:#ECFDF5;color:#065F46;border:1px solid #6EE7B7}
	.qrn-msg-fail{background:#FEF3C7;color:#92400E;border:1px solid #FCD34D}
	
	/* ══ Unified footer row ══════════════════════════════════════════════════ */
	.footer-row-unified{
	  display:flex;align-items:center;gap:.4rem;flex-wrap:nowrap;
	}
	.footer-row-unified .btn-main{flex:1;min-width:0}

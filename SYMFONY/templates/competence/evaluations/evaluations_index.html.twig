	.xpc-stat-icon{font-size:1.25rem;line-height:1;filter:drop-shadow(0 2px 4px rgba(0,0,0,.15))}
	.xpc-stat-num{font-size:1.5rem;font-weight:900;line-height:1;letter-spacing:-.04em}
	.xpc-stat-lbl{
	  font-size:.6rem;color:var(--g500);font-weight:700;
	  text-transform:uppercase;letter-spacing:.06em;

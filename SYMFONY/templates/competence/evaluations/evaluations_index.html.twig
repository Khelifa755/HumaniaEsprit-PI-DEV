	  font-size:.78rem;cursor:pointer;transition:all .15s;flex-shrink:0;
	  background:transparent;
	}
	.btn-icon-edit{border-color:#C7D2FE;color:#6366F1}
	.btn-icon-edit:hover{background:#EEF2FF;border-color:#6366F1}

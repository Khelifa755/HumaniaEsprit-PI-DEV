	.det-comp-block{display:flex;flex-direction:column;gap:.3rem}
	.det-comp-name{font-size:.85rem;font-weight:700;color:#374151}
	.det-comp-dots{display:flex;align-items:center;gap:.35rem}
	.det-dot{width:12px;height:12px;border-radius:50%;flex-shrink:0}

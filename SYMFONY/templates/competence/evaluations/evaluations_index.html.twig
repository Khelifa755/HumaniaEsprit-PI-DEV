	.ev-hero-tag{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--p);margin-bottom:6px;display:flex;align-items:center;gap:6px}
	.ev-hero-tag::before{content:'';width:18px;height:2px;background:var(--p);border-radius:2px}
	.ev-hero-title{font-size:2rem;font-weight:800;color:var(--g900);margin:0;letter-spacing:-.02em}
	.ev-hero-sub{color:var(--g500);font-size:.88rem;margin:4px 0 0}
	.btn-new-eval{background:linear-gradient(135deg,#4F46E5,#7C3AED);color:white;border:none;padding:11px 22px;border-radius:12px;font-weight:700;font-size:.88rem;cursor:pointer;box-shadow:0 4px 14px rgba(79,70,229,.3);display:flex;align-items:center;gap:7px;transition:all .2s}
	.btn-new-eval:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(79,70,229,.4)}
	.flash-ok{background:#D1FAE5;color:#065F46;padding:11px 16px;border-radius:10px;font-weight:600;margin-bottom:1rem;font-size:.88rem}
	.flash-err{background:#FEE2E2;color:#991B1B;padding:11px 16px;border-radius:10px;font-weight:600;margin-bottom:1rem;font-size:.88rem}
	
	/* ── Stats Cards ── */
	.ev-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.9rem;margin-bottom:1.5rem}
	.stat-card{
	  background:white;border-radius:18px;
	  border:1px solid rgba(0,0,0,.06);
	  padding:1.1rem 1.2rem;display:flex;align-items:center;gap:.9rem;
	  box-shadow:0 2px 12px rgba(0,0,0,.05),0 0 0 0 var(--accent);
	  border-top:4px solid var(--accent);
	  transition:transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .22s ease;
	  position:relative;overflow:hidden;
	}
	.stat-card::after{
	  content:'';position:absolute;right:-15px;bottom:-15px;
	  width:70px;height:70px;border-radius:50%;
	  background:radial-gradient(circle,color-mix(in srgb,var(--accent) 10%,transparent),transparent 70%);
	}
	.stat-card:hover{transform:translateY(-3px) scale(1.02);box-shadow:0 8px 24px rgba(0,0,0,.1),0 0 0 2px var(--accent)22}
	.stat-icon-wrap{width:40px;height:40px;border-radius:11px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
	.stat-content{flex:1;min-width:0}
	.stat-num{font-size:1.75rem;font-weight:800;color:var(--g900);line-height:1}
	.stat-lbl{font-size:.72rem;color:var(--g500);margin-top:2px;font-weight:500}
	.stat-trend{font-size:.68rem;font-weight:700;white-space:nowrap;opacity:.85}
	
	/* ── Layout ── */
	.ev-main-full{width:100%}
  
/* ══ FILTER BAR REDESIGNÉE ══ */
.ev-filterbar-wrap{
  background:white;border-radius:16px;
  border:1px solid var(--g200);
  box-shadow:0 1px 8px rgba(0,0,0,.05);
  margin-bottom:1rem;
  overflow:hidden;
}
.ev-filterbar-top{
  display:flex;align-items:center;gap:.75rem;
  padding:.75rem 1rem;
}
.search-wrap{position:relative;flex:1;min-width:0}
.si-fa{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#9CA3AF;font-size:.82rem;pointer-events:none}
.search-input{
  width:100%;padding:9px 12px 9px 36px;
  border:1.5px solid var(--g200);border-radius:10px;
  font-size:.88rem;outline:none;transition:all .2s;
  background:#FAFBFC;color:var(--g900);
}
.search-input:focus{
  border-color:#6366F1;
  box-shadow:0 0 0 3px rgba(99,102,241,.1);
  background:white;
}
.search-clear{
  position:absolute;right:10px;top:50%;transform:translateY(-50%);
  background:none;border:none;color:#9CA3AF;cursor:pointer;
  font-size:.8rem;padding:2px 4px;border-radius:4px;
}
.search-clear:hover{color:var(--g900);background:var(--g100)}

/* Panneau filtres dépliable */
.filter-panel{
  display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;
  padding:.6rem 1rem .75rem;
  border-top:1px dashed var(--g200);
  background:var(--g50);
  animation:filterSlide .18s ease;
}
@keyframes filterSlide{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:translateY(0)}}
.filter-sel{
  padding:7px 10px;border:1.5px solid var(--g200);border-radius:9px;
  font-size:.84rem;min-width:140px;outline:none;
  transition:border-color .15s;background:white;color:var(--g900);
}
.filter-sel:focus{border-color:#6366F1}
.btn-filter-apply{
  padding:7px 16px;border-radius:9px;border:none;
  background:#6366F1;color:white;font-weight:700;font-size:.84rem;
  cursor:pointer;transition:background .15s;
}
.btn-filter-apply:hover{background:#4F46E5}
.btn-reset{
  padding:7px 12px;border-radius:9px;text-decoration:none;
  color:#EF4444;background:#FEF2F2;font-size:.82rem;font-weight:600;
  border:1px solid #FCA5A5;transition:all .15s;
}
.btn-reset:hover{background:#FEE2E2}

/* Actions droite */
.ev-filterbar-actions{display:flex;align-items:center;gap:.5rem;flex-shrink:0}

/* Bouton Filtres */
.btn-filtres{
  position:relative;
  display:flex;align-items:center;gap:.45rem;
  padding:8px 16px;border-radius:10px;
  border:1.5px solid var(--g200);background:white;
  color:var(--g900);font-size:.84rem;font-weight:700;
  cursor:pointer;transition:all .2s;white-space:nowrap;
}
.btn-filtres:hover,.btn-filtres.active{
  border-color:#6366F1;color:#6366F1;
  background:#EEF2FF;
}
.btn-filtres i{font-size:.82rem}
.filter-active-dot{
  position:absolute;top:-4px;right:-4px;
  width:8px;height:8px;border-radius:50%;
  background:#6366F1;border:2px solid white;
}

/* View toggle */
.ev-view-toggle{display:flex;gap:2px;border:1.5px solid var(--g200);border-radius:10px;overflow:hidden;background:white}
.view-btn{width:36px;height:36px;border:none;background:transparent;color:var(--g500);cursor:pointer;font-size:.85rem;display:flex;align-items:center;justify-content:center;transition:all .15s}
.view-btn.active{background:#6366F1;color:white}
.view-btn:hover:not(.active){background:var(--g100)}

/* ── Tabs row ── */
.ev-tabs-row{
  display:flex;align-items:center;
  padding:.5rem 1rem .6rem;
  border-top:1px solid var(--g100);
  background:white;
}
.ev-tabs{display:flex;gap:2px;flex-wrap:wrap}
.ev-tab{
  padding:7px 16px;border-radius:20px;border:none;
  background:transparent;font-size:.84rem;font-weight:600;
  color:var(--g500);cursor:pointer;
  display:flex;align-items:center;gap:6px;
  transition:all .18s;white-space:nowrap;
}
.ev-tab.active{background:#6366F1;color:white;box-shadow:0 2px 10px rgba(99,102,241,.3)}
.ev-tab:hover:not(.active){background:var(--g100);color:var(--g900)}
.tab-count{
  font-size:.68rem;font-weight:800;padding:2px 7px;
  border-radius:20px;background:rgba(255,255,255,.25);
  min-width:20px;text-align:center;
}
.ev-tab:not(.active) .tab-count{background:var(--g100);color:var(--g500)}
.tab-count-green{background:#ECFDF5!important;color:#059669!important}
.ev-tab.active .tab-count-green,.ev-tab.active .tab-count-gray{background:rgba(255,255,255,.25)!important;color:rgba(255,255,255,.9)!important}
.tab-count-gray{background:#F3F4F6!important;color:#6B7280!important}
	
	/* ── Cards grid (3 cols) ── */
	.ev-cards-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.1rem;overflow:visible}
	.ev-cards-grid.list-view{grid-template-columns:1fr}
	.ev-cards-grid.list-view .card-right{display:flex}
	
	/* ── Hero actions ── */
	.ev-hero-actions{display:flex;align-items:center;gap:.6rem}
	.btn-hero-icon{position:relative;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:12px;border:1.5px solid #E5E7EB;background:white;color:#6366F1;font-size:1.05rem;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.06);transition:all .2s;flex-shrink:0}
	.btn-hero-icon:hover{background:#EEF2FF;border-color:#6366F1;transform:translateY(-2px);box-shadow:0 6px 16px rgba(99,102,241,.2)}
	.btn-hero-niveau{color:#F59E0B;border-color:#FDE68A;background:#FFFBEB}
	.btn-hero-niveau:hover{background:#FEF3C7;border-color:#F59E0B;box-shadow:0 6px 16px rgba(245,158,11,.2)}
	.niveau-badge{position:absolute;top:-7px;right:-8px;background:linear-gradient(135deg,#F59E0B,#D97706);color:white;font-size:.55rem;font-weight:800;padding:2px 5px;border-radius:20px;border:1.5px solid white;white-space:nowrap;letter-spacing:.01em;line-height:1.2}
	
	/* ── btn-results ── */
	.btn-results{background:#ECFDF5;color:#059669;border:1.5px solid #6EE7B7}
	
	/* ── Drawers ── */
	.drawer-overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:900;opacity:0;pointer-events:none;transition:opacity .25s;backdrop-filter:blur(2px)}
	.drawer-overlay.open{opacity:1;pointer-events:all}
	.drawer-panel{position:absolute;right:0;top:0;bottom:0;width:380px;background:white;box-shadow:-8px 0 40px rgba(0,0,0,.15);transform:translateX(100%);transition:transform .3s cubic-bezier(.4,0,.2,1);overflow-y:auto;display:flex;flex-direction:column}
	.drawer-overlay.open .drawer-panel{transform:translateX(0)}
	.drawer-head{display:flex;align-items:center;gap:.75rem;padding:1.1rem 1.2rem;border-bottom:1px solid var(--g100);position:sticky;top:0;background:white;z-index:1;flex-shrink:0}
	.drawer-head-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0}
	.drawer-head-title{font-size:.95rem;font-weight:800;color:var(--g900)}
	.drawer-head-sub{font-size:.72rem;color:var(--g500);margin-top:1px}
	.drawer-close{margin-left:auto;width:32px;height:32px;border:none;border-radius:8px;background:var(--g100);color:var(--g500);cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:.85rem;transition:all .15s;flex-shrink:0}
	.drawer-close:hover{background:var(--g200);color:var(--g900)}
	.drawer-body{padding:1rem;flex:1;overflow-y:auto}
	.drawer-body .side-card{margin-top:0}
	.drawer-body .xp-card-new{margin-top:0}
	
	/* ── Hero tag ── */
	.ev-hero-tag{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--p);margin-bottom:6px;display:flex;align-items:center;gap:6px}
	.ev-hero-tag span{display:inline-block;width:18px;height:2px;background:var(--p);border-radius:2px}
	
	/* ── Filtres ── */
	/* ev-filters replaced by ev-filters-bar */
	.search-wrap{position:relative;flex:1;min-width:200px}
	.si{position:absolute;left:11px;top:50%;transform:translateY(-50%);font-size:.85rem}
	.search-input{width:100%;padding:8px 12px 8px 32px;border:1.5px solid var(--g200);border-radius:8px;font-size:.86rem;outline:none;transition:border-color .15s}
	.search-input:focus{border-color:var(--p);box-shadow:0 0 0 3px #4F46E518}
	.filter-sel{padding:8px 10px;border:1.5px solid var(--g200);border-radius:8px;font-size:.85rem;min-width:145px;outline:none;transition:border-color .15s}
	.filter-sel:focus{border-color:var(--p)}
	.btn-filter{padding:8px 14px;border-radius:8px;border:none;background:var(--p);color:white;font-weight:700;font-size:.84rem;cursor:pointer;transition:background .15s}
	.btn-filter:hover{background:#4338CA}
	.btn-reset{padding:8px 10px;border-radius:8px;text-decoration:none;color:var(--g500);background:var(--g100);font-size:.82rem;font-weight:600}
	
	/* ── Section title ── */
	.ev-section-title{font-size:.92rem;font-weight:800;color:var(--g900);display:flex;align-items:center;gap:.5rem;margin-bottom:.9rem;padding-bottom:.5rem;border-bottom:2px solid var(--g100)}
	
	/* ══ EVAL CARDS ══ */
	.eval-card{
	  background:white;
	  border-radius:20px;
	  border:1px solid rgba(0,0,0,.07);
	  overflow:hidden;
	  box-shadow:0 1px 4px rgba(0,0,0,.04),0 4px 16px rgba(0,0,0,.06);
	  transition:transform .22s cubic-bezier(.34,1.56,.64,1),box-shadow .25s ease,border-color .2s ease;
	  position:relative;
	}
	.eval-card:hover{
	  transform:translateY(-5px);
	  box-shadow:0 8px 28px rgba(0,0,0,.11),0 0 0 2px var(--acc,#6366F1)44;
	  border-color:var(--acc,#6366F1)55;
	}

	/* Strip top */
	.card-strip{height:3px;box-shadow:0 1px 6px var(--acc,#6366F1)44}

	/* Body */
	.card-main{display:flex;align-items:flex-start;gap:.85rem;padding:.95rem 1.1rem .65rem}

	/* Icône */
	.card-icon-wrap{
	  width:44px;height:44px;border-radius:13px;
	  display:flex;align-items:center;justify-content:center;flex-shrink:0;
	  border:1.5px solid color-mix(in srgb,var(--acc,#6366F1) 18%,transparent);
	  box-shadow:0 2px 8px var(--acc,#6366F1)18;
	  transition:transform .22s cubic-bezier(.34,1.56,.64,1);
	}

	.det-score-num{font-size:1rem;font-weight:900;flex-shrink:0;min-width:40px;text-align:right}
	/* Participants */
	.det-part-row{
	  display:flex;align-items:center;gap:.45rem;
	  font-size:.78rem;color:#9CA3AF;font-weight:500;

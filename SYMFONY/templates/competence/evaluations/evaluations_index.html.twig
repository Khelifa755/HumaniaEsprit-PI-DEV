	/* card-main simplified */
	.card-main{display:flex;align-items:flex-start;gap:.75rem;padding:.9rem 1rem .5rem}
	.card-info{flex:1;min-width:0}
	.card-title-row{display:flex;align-items:flex-start;gap:.4rem;flex-wrap:wrap;margin-bottom:.25rem}
	.card-title{font-size:.92rem;font-weight:700;color:#111827;line-height:1.3;flex:1;min-width:0}
	.card-sub-row{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap}

	/* ══ Redesigned Details Modal ═══════════════════════════════════════════ */
	.modal-details-box{

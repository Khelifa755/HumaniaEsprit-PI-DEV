/* Skill cells */
.skill-pill{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:14px;font-size:1.1rem;font-weight:800}
.pill-gap{outline:2px solid #FCA5A5}
.gap-badge{font-size:.68rem;font-weight:800;color:#DC2626;margin-top:2px}

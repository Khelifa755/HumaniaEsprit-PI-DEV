.mp-exam-inner { padding: 1.75rem 2rem; position: relative; z-index: 1; }

.mp-exam-header {
  display: flex; align-items: center; gap: 1rem;
  padding-bottom: 1.25rem; border-bottom: 1px solid var(--border); margin-bottom: 1.25rem;
  flex-wrap: wrap;
}
.mp-exam-trophy { font-size: 2.2rem; flex-shrink: 0; }
.mp-exam-header-text { flex: 1; min-width: 0; }
.mp-exam-title { font-size: 1.1rem; font-weight: 800; color: var(--ink); margin: 0 0 .2rem; }
.mp-exam-subtitle { font-size: .8rem; color: var(--ink2); margin: 0; }

/* Language toggle */
.mp-lang-toggle { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }
.mp-lang-label { font-size: .72rem; font-weight: 700; color: var(--ink2); }
.mp-lang-btns { display: flex; border: 1.5px solid var(--border); border-radius: 10px; overflow: hidden; }
.mp-lang-btn {
  display: flex; align-items: center; gap: 5px;
  padding: 6px 14px; border: none; background: white;
  font-size: .78rem; font-weight: 700; color: var(--ink2); cursor: pointer;
  transition: all .15s; border-radius: 0;
}
.mp-lang-btn + .mp-lang-btn { border-left: 1.5px solid var(--border); }
.mp-lang-btn.active { background: var(--accent); color: white; }
.mp-lang-btn:hover:not(.active) { background: var(--bg); }
.mp-lang-flag { font-size: .9rem; }

/* Exam info grid */
.mp-exam-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: .85rem; margin-bottom: 1.25rem;
}
.mp-exam-info-item {
  display: flex; align-items: flex-start; gap: .65rem;
  background: var(--bg); border-radius: 10px; padding: .85rem 1rem;
  border: 1px solid var(--border);
}
.ei-label { font-size: .82rem; font-weight: 700; color: var(--ink); }
.ei-sub   { font-size: .72rem; color: var(--ink3); margin-top: 1px; }

/* Last result */
.mp-last-result {
  display: flex; align-items: center; gap: .6rem;
  padding: .65rem 1rem; border-radius: 9px; border: 1px solid;
  margin-bottom: 1.25rem; font-size: .82rem;
}
.lr-passed { background: #F0FDF4; border-color: #BBF7D0; }
.lr-failed { background: #FEF2F2; border-color: #FECACA; }
.lr-icon { width: 22px; height: 22px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: .75rem; font-weight: 800; flex-shrink: 0; }
.lr-passed .lr-icon { background: #D1FAE5; color: #059669; }
.lr-failed .lr-icon { background: #FEE2E2; color: #DC2626; }
.lr-text { color: var(--ink2); }

/* CTA */
.mp-exam-cta { text-align: center; }
.mp-exam-launch-btn {
  display: inline-flex; align-items: center; gap: .65rem;
  padding: 14px 40px; border-radius: 14px; border: none;
  background: var(--accent); color: white;
  font-size: 1rem; font-weight: 800; cursor: pointer;
  transition: all .2s;
  box-shadow: 0 4px 20px color-mix(in srgb, var(--accent) 35%, transparent);
}
.mp-exam-launch-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 28px color-mix(in srgb, var(--accent) 45%, transparent); }
.mp-exam-launch-btn:disabled { opacity: .7; cursor: not-allowed; transform: none; }
.mp-exam-cta-note { font-size: .75rem; color: var(--ink3); margin-top: .65rem; }

/* ── EXAM INTERFACE ── */
.mp-exam-interface {
  background: white; border: 1px solid var(--border); border-radius: 16px;
  overflow: hidden; margin-top: 1rem;
}
.ei-topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: .85rem 1.25rem; background: var(--bg); border-bottom: 1px solid var(--border);
}
.ei-topbar-left { display: flex; align-items: center; gap: .5rem; }
.ei-title-sm { font-size: .8rem; font-weight: 700; color: var(--ink); }
.ei-separator { color: var(--ink3); font-size: .8rem; }
#ei-exam-title-bar { font-size: .8rem; color: var(--ink2); }
.ei-topbar-right { display: flex; align-items: center; gap: .65rem; }
.ei-progress-pill { font-size: .75rem; font-weight: 700; background: white; border: 1px solid var(--border); padding: 3px 10px; border-radius: 20px; color: var(--ink2); }
.ei-lang-badge { font-size: .72rem; font-weight: 700; background: #EEF2FF; color: #4F46E5; padding: 3px 10px; border-radius: 20px; }
.ei-close-btn { background: none; border: none; cursor: pointer; color: var(--ink3); padding: 4px; border-radius: 6px; display: flex; transition: all .12s; }
.ei-close-btn:hover { background: #FEF2F2; color: #DC2626; }
.ei-progress-bar { height: 4px; background: #f1f5f9; }
.ei-progress-fill { height: 100%; transition: width .4s; }
.ei-body { padding: 1.5rem; }

/* Questions */
.ei-questions-wrap { display: flex; flex-direction: column; gap: 1.5rem; }
.ei-question { background: var(--bg); border: 1px solid var(--border); border-radius: 12px; padding: 1.25rem; }
.ei-q-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
.ei-q-num { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--ink3); }
.ei-q-module { font-size: .65rem; color: var(--ink3); font-style: italic; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ei-q-text { font-size: .9rem; font-weight: 700; color: var(--ink); line-height: 1.45; margin-bottom: .85rem; }
.ei-q-opts { display: flex; flex-direction: column; gap: .4rem; }
.ei-opt {
  display: flex; align-items: center; gap: .65rem;
  padding: .65rem .85rem; border-radius: 9px; border: 1.5px solid var(--border);
  background: white; cursor: pointer; transition: all .12s;
}
.ei-opt:hover { border-color: #C7D2FE; background: #EEF2FF; }
.ei-opt.selected { border-color: #6366F1; background: #EEF2FF; }
.ei-opt-letter { font-size: .75rem; font-weight: 800; color: #6366F1; width: 20px; flex-shrink: 0; }
.ei-opt-text { font-size: .85rem; color: var(--ink); }

/* Submit section */
.ei-submit-section { display: flex; align-items: center; justify-content: space-between; padding-top: 1.5rem; border-top: 1px solid var(--border); margin-top: 1.5rem; }
.ei-answered-info { font-size: .82rem; color: var(--ink2); }
.ei-submit-btn {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 11px 28px; border-radius: 11px; border: none;
  background: var(--accent); color: white;
  font-size: .88rem; font-weight: 700; cursor: pointer; transition: all .15s;
}
.ei-submit-btn:hover { transform: translateY(-1px); opacity: .9; }
.ei-submit-btn:disabled { opacity: .6; cursor: not-allowed; transform: none; }

/* Result */
.ei-result {
  text-align: center; padding: 2.5rem 1.5rem;
  background: var(--rb); border: 1.5px solid var(--rbd); border-radius: 14px;
  display: flex; flex-direction: column; align-items: center; gap: .5rem;
}
.ei-result-icon { font-size: 3rem; }
.ei-result-score { font-size: 3rem; font-weight: 800; line-height: 1; }
.ei-result-detail { font-size: .88rem; font-weight: 600; color: var(--rc); }
.ei-result-title { font-size: 1.1rem; font-weight: 800; }
.ei-result-sub { font-size: .85rem; color: var(--ink2); max-width: 400px; }
.ei-result-delta { font-size: .8rem; font-weight: 700; padding: 5px 14px; border-radius: 20px; border: 1px solid; margin-top: .25rem; }
.ei-result-btns { display: flex; gap: .75rem; margin-top: .75rem; }
.ei-result-btn { padding: 10px 22px; border-radius: 10px; font-size: .85rem; font-weight: 700; cursor: pointer; transition: all .15s; }
.ei-btn-retake { background: transparent; border: 1.5px solid; }
.ei-btn-retake:hover { opacity: .8; }
.ei-btn-back { color: white; border: none; }
.ei-btn-back:hover { opacity: .88; }
.ei-error { color: #DC2626; background: #FEF2F2; border-radius: 10px; padding: 1rem; font-size: .85rem; }

/* ── COMPLETION BANNER ── */
.mp-completion-banner {
  display: flex; align-items: center; gap: 1.25rem;
  background: white; border: 2px solid var(--accent); border-radius: var(--radius);
  padding: 1.5rem; flex-wrap: wrap; margin-top: 1.5rem;
  box-shadow: 0 4px 20px color-mix(in srgb, var(--accent) 15%, transparent);
}
.completion-emoji { font-size: 2rem; flex-shrink: 0; }
.completion-text { flex: 1; min-width: 0; }
.completion-title { font-size: 1rem; font-weight: 800; color: var(--accent); }
.completion-sub   { font-size: .82rem; color: var(--ink2); margin-top: 2px; }
.completion-btn { padding: 10px 22px; border-radius: 10px; border: none; color: white; font-weight: 700; text-decoration: none; font-size: .85rem; transition: opacity .15s; }
.completion-btn:hover { opacity: .88; }

/* ── SPINNER ── */
.mp-spinner {
  width: 16px; height: 16px; border-radius: 50%;
  border: 2px solid #E2E8F0; border-top-color: #6366F1;
  animation: spin .7s linear infinite; flex-shrink: 0; display: inline-block;
}
.mp-spinner-red { border-top-color: #DC2626; }
.mp-spinner-white { border-color: rgba(255,255,255,.3); border-top-color: white; }
@keyframes spin { to { transform: rotate(360deg); } }

@media (max-width: 640px) {
  .mp-hero-body { flex-direction: column; }
  .mp-ring-wrap { align-self: center; }
  .mp-exam-grid { grid-template-columns: 1fr; }
  .mp-exam-header { flex-direction: column; align-items: flex-start; }
  .mp-yt-grid { grid-template-columns: 1fr 1fr; }
  .mp-modules { padding-left: 32px; }
  .mp-mod-node { left: -31px; }
  .mp-mod-line { left: -22px; }
  .ei-result-btns { flex-direction: column; width: 100%; }
}
</style>
{% endblock %}

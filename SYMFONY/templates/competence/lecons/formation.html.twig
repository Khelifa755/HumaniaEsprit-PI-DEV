{% extends 'base.html.twig' %}
{% block title %}{{ formation.titre }} – Mes Leçons{% endblock %}

{% block body %}

{% set catAccents = {
  'Technical Training':   '#2563EB',
  'Management Training':  '#059669',
  'Soft Skills':          '#7C3AED',
  'DevOps':               '#D97706',
  'Frontend':             '#0284C7',
  'Cloud':                '#4F46E5',
  'Soft Skills Avancées': '#DB2777',
  'Autre':                '#6B7280',
} %}
{% set cat    = formation.categorie ?? 'Autre' %}
{% set accent = catAccents[cat] ?? '#4F46E5' %}

<div class="mv-wrapper">

  {# ══ HEADER ══════════════════════════════════════════════════════════════ #}
  <div class="mv-header">
    <a href="{{ path('mes_lecons_index') }}" class="btn-back">← Mes Leçons</a>

    <div class="mv-title-row">
      <div>
        <div class="cat-badge-lg" style="background:{{ accent }}18;color:{{ accent }}">{{ cat }}</div>
        <h1 class="mv-title">{{ formation.titre }}</h1>
        {% if formation.formateur_nom %}
          <p class="mv-formateur">👤 {{ formation.formateur_nom }}
            {% if formation.typeFormation %}
              &nbsp;·&nbsp; {{ formation.typeFormation }}
            {% endif %}
          </p>
        {% endif %}
      </div>
      <div class="mv-progress-box">
        <div class="mv-prog-header">
          <span class="mv-prog-lbl">Progression</span>
          <span class="mv-prog-pct" style="color:{{ accent }}">{{ progress }}%</span>
        </div>
        <div class="mv-prog-track">
          <div class="mv-prog-fill" style="width:{{ progress }}%;background:{{ accent }}"></div>
        </div>
        <div class="mv-prog-meta">
          <span>☰ {{ doneMods }}/{{ totalMods }} modules</span>
          <span>⏱ {{ formation.duree }}h</span>
          {% if inscription %}
            <span class="mv-statut-badge {{ inscription.statut == 'Completed' ? 'badge-done' : 'badge-progress' }}">
              {{ inscription.statut }}
            </span>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  {# ══ MODULES LIST ════════════════════════════════════════════════════════ #}
  <div class="modules-list" id="modulesList">
    {% for mod in modules %}
      {% set isDone = mod.statut == 'completed' %}
      {% set isInProgress = mod.statut == 'in_progress' %}

      <div class="module-card {{ isDone ? 'mod-done' : '' }}" id="mod-{{ mod.id }}">

        {# ── En-tête module ── #}
        <div class="mod-header" onclick="toggleModule({{ mod.id }})">
          <div class="mod-left">
            <div class="mod-num" style="background:{{ isDone ? '#D1FAE5' : accent ~ '18' }};color:{{ isDone ? '#059669' : accent }}">
              {{ isDone ? '✓' : mod.ordre }}
            </div>
            <div class="mod-info">
              <div class="mod-title">{{ mod.titre }}</div>
              <div class="mod-meta">
                <span class="type-pill type-{{ mod.type_contenu|lower|replace({' ':'-'}) }}">
                  {% if mod.type_contenu|lower == 'video' %}▶{% elseif mod.type_contenu|lower in ['reading','lecture','cours'] %}📖{% elseif mod.type_contenu|lower == 'quiz' %}🧠{% elseif mod.type_contenu|lower == 'exercice' %}✏️{% else %}📄{% endif %}
                  {{ mod.type_contenu }}
                </span>
                {% if mod.duree_minutes %}
                  <span>⏱ {{ (mod.duree_minutes / 60)|round(1) }}h</span>
                {% endif %}
                {% if mod.score > 0 %}
                  <span class="score-chip" style="color:#2563EB;background:#DBEAFE">Quiz {{ mod.score }}%</span>
                {% endif %}
              </div>
            </div>
          </div>
          <div class="mod-right">
            {% if isDone %}
              <span class="status-done">✓ Terminé</span>
            {% elseif isInProgress %}
              <span class="status-progress">En cours</span>
            {% endif %}

            {# ── Bouton Ouvrir ── #}
            <a href="{{ path('mes_lecons_module_show', {id: mod.id}) }}"
               class="btn-open-module type-btn-{{ mod.type_contenu|lower|replace({' ':'-'}) }}"
               onclick="event.stopPropagation()"
               title="Ouvrir {{ mod.titre }}">
              {% if mod.type_contenu == 'video' %}
                ▶ Vidéo
              {% elseif mod.type_contenu in ['reading', 'cours', 'lecture'] %}
                📖 Lire
              {% elseif mod.type_contenu == 'quiz' %}
                🧠 Quiz
              {% elseif mod.type_contenu == 'exercice' %}
                ✏️ Exercice
              {% else %}
                ▶ Ouvrir
              {% endif %}
            </a>
          </div>
        </div>

        {# ── Contenu module (collapsible) ── #}
        <div class="mod-content" id="content-{{ mod.id }}" style="display:none">

          {% if mod.description %}
            <p class="mod-desc">{{ mod.description }}</p>
          {% endif %}

          {# ── VIDEO ── #}
          {% if mod.type_contenu == 'video' and mod.url_ressource %}
            <div class="video-wrap">
              {% if 'youtube' in mod.url_ressource or 'youtu.be' in mod.url_ressource %}
                {% set ytId = mod.url_ressource|replace({'https://youtu.be/': '', 'https://www.youtube.com/watch?v=': ''})|split('&')|first %}
                <iframe src="https://www.youtube.com/embed/{{ ytId }}"
                        frameborder="0" allowfullscreen class="video-iframe"></iframe>
              {% else %}
                <video controls class="video-player">
                  <source src="{{ mod.url_ressource }}">
                </video>
              {% endif %}
            </div>
          {% endif %}

          {# ── COURS / TEXTE ── #}
          {% if mod.contenu_texte %}
            <div class="contenu-text">{{ mod.contenu_texte|nl2br }}</div>
          {% endif %}

          {# ── QUIZ ── #}
          {% if mod.type_contenu == 'quiz' %}
            <div class="quiz-wrap" id="quiz-{{ mod.id }}">
              <p class="quiz-loading" id="quiz-load-{{ mod.id }}">Chargement du quiz…</p>
              <div id="quiz-body-{{ mod.id }}" style="display:none"></div>
              <button class="btn-start-quiz" onclick="loadQuiz({{ mod.id }})">🧠 Démarrer le Quiz</button>
            </div>
          {% endif %}

          {# ── SECTIONS ── #}
          {% if mod.sections|length > 0 %}
            <div class="sections-list">
              <div class="sections-title">📋 Contenu du module</div>
              {% for section in mod.sections %}
                <div class="section-row {{ section.statut == 'completed' ? 'section-done' : '' }}">
                  <span class="section-check">{{ section.statut == 'completed' ? '✓' : '○' }}</span>
                  <span class="section-name">{{ section.titre }}</span>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {# ── Actions ── #}
          <div class="mod-actions">
            {% if not isDone %}
              <button class="btn-complete"
                      style="background:{{ accent }}"
                      onclick="markComplete({{ mod.id }}, {{ mod.type_contenu == 'quiz' ? 1 : 0 }})">
                ✓ Marquer comme terminé
              </button>
            {% else %}
              <span class="already-done">✅ Module complété</span>
            {% endif %}
          </div>

        </div>
      </div>
    {% endfor %}
  </div>

  {# ══ BOUTONS FINAUX ══════════════════════════════════════════════════════ #}
  {% if progress >= 100 %}
    <div class="completion-banner" style="border-color:{{ accent }}">
      <span style="font-size:2rem">🎉</span>
      <div>
        <div style="font-weight:800;font-size:1.1rem;color:{{ accent }}">Formation terminée !</div>
        <div style="font-size:.88rem;color:#6B7280">Tous les modules ont été complétés.</div>
      </div>
      <a href="{{ path('mes_lecons_index') }}" class="btn-back-home" style="background:{{ accent }}">
        ← Retour à Mes Leçons
      </a>
    </div>
  {% endif %}

</div>

<script>
// ── Collapse/Expand modules ───────────────────────────────────────────────
function toggleModule(id) {
  const c = document.getElementById('content-' + id);
  const a = document.getElementById('arrow-' + id);
  if (c.style.display === 'none') {
    c.style.display = 'block';
    a.textContent = '▲';
    c.style.animation = 'fadeIn .2s ease';
  } else {
    c.style.display = 'none';
    a.textContent = '▼';
  }
}

// ── Mark complete ─────────────────────────────────────────────────────────
async function markComplete(moduleId, isQuiz) {
  const score = isQuiz ? parseInt(document.getElementById('quiz-score-' + moduleId)?.dataset.score || '0') : 0;
  const fd = new FormData();
  fd.append('score_quiz', score);
  const res  = await fetch(`/mes-lecons/module/${moduleId}/complete`, { method: 'POST', body: fd });
  const data = await res.json();
  if (data.ok) {
    // Mise à jour barre de progression
    document.querySelector('.mv-prog-fill').style.width = data.progress + '%';
    document.querySelector('.mv-prog-pct').textContent  = data.progress + '%';
    // Mettre à jour "X/Y modules"
    const metaSpans = document.querySelectorAll('.mv-prog-meta span');
    metaSpans.forEach(s => { if (s.textContent.includes('/')) {
      const total = s.textContent.split('/')[1].replace(' modules','').trim();
      const done  = Math.round(data.progress * parseInt(total) / 100);
      s.textContent = '☰ ' + done + '/' + total + ' modules';
    }});
    // Marquer le module visuellement
    const card = document.getElementById('mod-' + moduleId);
    card.classList.add('mod-done');
    const numEl = card.querySelector('.mod-num');
    numEl.style.background = '#D1FAE5';
    numEl.style.color      = '#059669';
    numEl.textContent      = '✓';
    // Remplacer badge statut
    const statusEl = card.querySelector('.mod-right .status-todo, .mod-right .status-progress');
    if (statusEl) statusEl.outerHTML = '<span class="status-done">✓ Terminé</span>';
    // Bouton ouvrir → vert
    const btnOpen = card.querySelector('.btn-open-module');
    if (btnOpen) btnOpen.style.background = '#059669';
    // Bouton interne
    const actions = card.querySelector('.mod-actions');
    if (actions) actions.innerHTML = '<span class="already-done">✅ Module complété</span>';
    if (data.progress >= 100) setTimeout(() => location.reload(), 1000);
  } else {
    alert('Erreur : ' + (data.error || 'inconnue'));
  }
}

// ── Quiz ──────────────────────────────────────────────────────────────────
async function loadQuiz(moduleId) {
  const body = document.getElementById('quiz-body-' + moduleId);
  const load = document.getElementById('quiz-load-' + moduleId);
  const btn  = document.querySelector(`#quiz-${moduleId} .btn-start-quiz`);
  if (btn) btn.style.display = 'none';
  load.textContent = 'Chargement…';
  load.style.display = 'block';

  const res  = await fetch(`/mes-lecons/module/${moduleId}/questions`);
  const data = await res.json();
  load.style.display = 'none';

  if (!data.questions || data.questions.length === 0) {
    body.innerHTML = '<p style="color:#9CA3AF">Aucune question disponible.</p>';
    body.style.display = 'block';
    return;
  }

  let html = '<form id="quiz-form-' + moduleId + '" class="quiz-form">';
  data.questions.forEach((q, i) => {
    html += `<div class="quiz-q">
      <div class="q-num">Q${i+1}</div>
      <div class="q-text">${q.question}</div>
      <div class="q-options">`;
    ['A','B','C','D'].forEach(opt => {
      const txt = q['option_' + opt.toLowerCase()];
      if (txt) {
        html += `<label class="q-opt">
          <input type="radio" name="answers[${q.id}]" value="${opt}"> ${opt}. ${txt}
        </label>`;
      }
    });
    html += `</div></div>`;
  });
  html += `<button type="button" class="btn-submit-quiz" onclick="submitQuiz(${moduleId})">✅ Soumettre</button></form>`;
  body.innerHTML = html;
  body.style.display = 'block';
}

async function submitQuiz(moduleId) {
  const form = document.getElementById('quiz-form-' + moduleId);
  const fd   = new FormData(form);
  const res  = await fetch(`/mes-lecons/module/${moduleId}/quiz`, { method: 'POST', body: fd });
  const data = await res.json();
  if (data.ok) {
    const body = document.getElementById('quiz-body-' + moduleId);
    const gc   = data.score >= 70 ? '#059669' : '#DC2626';
    const gb   = data.score >= 70 ? '#D1FAE5' : '#FEE2E2';
    body.innerHTML = `
      <div class="quiz-result" style="background:${gb};border-color:${gc}">
        <div style="font-size:2rem">${data.score >= 70 ? '🎉' : '😞'}</div>
        <div style="font-size:1.5rem;font-weight:800;color:${gc}">${data.score}%</div>
        <div style="color:${gc};font-weight:600">${data.correct}/${data.total} bonnes réponses</div>
        <div style="font-size:.85rem;color:#6B7280;margin-top:.25rem">${data.score >= 70 ? 'Félicitations !' : 'Réessayez pour améliorer votre score.'}</div>
      </div>
      <div id="quiz-score-${moduleId}" data-score="${data.score}" style="display:none"></div>`;
    if (data.score >= 70) markComplete(moduleId, 1);
  }
}

@keyframes fadeIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
</script>

<style>
:root{--p:#4F46E5;--g50:#F8FAFC;--g100:#F1F5F9;--g200:#E2E8F0;--g500:#64748B;--g900:#0F172A}
*{box-sizing:border-box}
.mv-wrapper{padding:2rem;max-width:900px;margin:0 auto}

/* Header */
.btn-back{color:var(--p);text-decoration:none;font-weight:600;font-size:.9rem;display:inline-block;margin-bottom:1.25rem}
.btn-back:hover{text-decoration:underline}
.mv-title-row{display:flex;justify-content:space-between;align-items:flex-start;gap:2rem;margin-bottom:2rem;flex-wrap:wrap}
.cat-badge-lg{display:inline-block;font-size:.78rem;font-weight:800;padding:4px 12px;border-radius:8px;margin-bottom:.5rem}
.mv-title{font-size:1.6rem;font-weight:800;color:var(--g900);margin:0 0 .25rem}
.mv-formateur{font-size:.85rem;color:var(--g500);margin:0}
.mv-progress-box{background:white;border-radius:14px;border:1px solid var(--g200);padding:1.25rem 1.5rem;min-width:240px;box-shadow:0 1px 6px rgba(0,0,0,.06)}
.mv-prog-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:.4rem}
.mv-prog-lbl{font-size:.8rem;color:var(--g500)}
.mv-prog-pct{font-size:1.2rem;font-weight:800}
.mv-prog-track{height:8px;background:var(--g100);border-radius:4px;overflow:hidden;margin-bottom:.5rem}
.mv-prog-fill{height:100%;border-radius:4px;transition:width .4s}
.mv-prog-meta{display:flex;gap:.75rem;font-size:.78rem;color:var(--g500);align-items:center;flex-wrap:wrap}
.mv-statut-badge{font-size:.7rem;font-weight:800;padding:2px 10px;border-radius:20px}
.badge-done{background:#D1FAE5;color:#059669}
.badge-progress{background:#DBEAFE;color:#2563EB}

/* Modules */
.modules-list{display:flex;flex-direction:column;gap:.75rem}
.module-card{background:white;border-radius:14px;border:1px solid var(--g200);overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.05)}
.module-card.mod-done{border-color:#BBF7D0}
.mod-header{display:flex;justify-content:space-between;align-items:center;padding:1rem 1.25rem;cursor:pointer;user-select:none}
.mod-header:hover{background:var(--g50)}
.mod-left{display:flex;align-items:center;gap:.85rem;flex:1;min-width:0}
.mod-num{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:.9rem;font-weight:800;flex-shrink:0}
.mod-info{min-width:0}
.mod-title{font-size:.95rem;font-weight:700;color:var(--g900)}
.mod-meta{display:flex;gap:.6rem;flex-wrap:wrap;font-size:.75rem;color:var(--g500);margin-top:3px;align-items:center}
.type-pill{font-size:.68rem;font-weight:700;padding:2px 8px;border-radius:20px;background:#F1F5F9;color:#475569}
.type-video{background:#DBEAFE;color:#2563EB}
.type-reading,.type-lecture,.type-cours{background:#D1FAE5;color:#059669}
.type-quiz{background:#EDE9FE;color:#7C3AED}
.type-exercice{background:#FEF3C7;color:#D97706}
.type-btn-video{background:#2563EB}
.type-btn-video:hover{background:#1D4ED8}
.type-btn-reading,.type-btn-lecture,.type-btn-cours{background:#059669}
.type-btn-reading:hover,.type-btn-lecture:hover,.type-btn-cours:hover{background:#047857}
.type-btn-quiz{background:#7C3AED}
.type-btn-quiz:hover{background:#6D28D9}
.type-btn-exercice{background:#D97706}
.type-btn-exercice:hover{background:#B45309}
.score-chip{font-size:.68rem;font-weight:700;padding:2px 8px;border-radius:20px}
.mod-right{display:flex;align-items:center;gap:.75rem;flex-shrink:0}
.status-done{font-size:.75rem;font-weight:700;color:#059669;background:#D1FAE5;padding:3px 10px;border-radius:20px}
.status-progress{font-size:.75rem;font-weight:700;color:#2563EB;background:#DBEAFE;padding:3px 10px;border-radius:20px}
/* status-todo removed */
/* toggle-arrow removed */
.btn-open-module{display:inline-flex;align-items:center;gap:.3rem;padding:6px 14px;border-radius:8px;background:#4F46E5;color:white;font-size:.75rem;font-weight:700;text-decoration:none;transition:background .15s,transform .1s;white-space:nowrap}
.btn-open-module:hover{background:#4338CA;transform:translateY(-1px)}
.mod-done .btn-open-module{background:#059669}
.mod-done .btn-open-module:hover{background:#047857}

/* Module content */
.mod-content{padding:1rem 1.25rem 1.25rem;border-top:1px solid var(--g100)}
.mod-desc{font-size:.88rem;color:#374151;line-height:1.6;margin:0 0 1rem}
.contenu-text{font-size:.88rem;color:#374151;line-height:1.7;background:var(--g50);border-radius:10px;padding:1rem;border-left:3px solid var(--p);margin-bottom:1rem}
.video-wrap{margin-bottom:1rem}
.video-iframe{width:100%;height:360px;border-radius:10px;border:none}
.video-player{width:100%;border-radius:10px;max-height:360px}

/* Sections */
.sections-list{margin-bottom:1rem}
.sections-title{font-size:.8rem;font-weight:700;color:var(--g500);text-transform:uppercase;margin-bottom:.5rem;letter-spacing:.05em}
.section-row{display:flex;align-items:center;gap:.6rem;padding:.4rem 0;border-bottom:1px solid var(--g100);font-size:.85rem;color:#374151}
.section-row.section-done{color:#059669}
.section-check{font-size:.9rem;font-weight:800;flex-shrink:0}
.section-name{}

/* Actions */
.mod-actions{display:flex;align-items:center;gap:.75rem;margin-top:.75rem;padding-top:.75rem;border-top:1px solid var(--g100)}
.btn-complete{padding:9px 22px;border-radius:10px;border:none;color:white;font-weight:700;cursor:pointer;font-size:.88rem}
.btn-complete:hover{opacity:.88}
.already-done{font-size:.85rem;color:#059669;font-weight:600}

/* Quiz */
.quiz-wrap{margin-bottom:1rem}
.quiz-loading{font-size:.85rem;color:var(--g500)}
.btn-start-quiz{padding:9px 20px;border-radius:10px;border:none;background:#4F46E5;color:white;font-weight:700;cursor:pointer;font-size:.88rem}
.quiz-form{display:flex;flex-direction:column;gap:1rem}
.quiz-q{}
.q-num{font-size:.72rem;font-weight:800;color:var(--g500);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.25rem}
.q-text{font-size:.9rem;font-weight:600;color:var(--g900);margin-bottom:.5rem}
.q-options{display:flex;flex-direction:column;gap:.35rem}
.q-opt{display:flex;align-items:center;gap:.5rem;font-size:.85rem;color:#374151;cursor:pointer;padding:.3rem 0}
.q-opt:hover{color:var(--p)}
.btn-submit-quiz{padding:10px 24px;border-radius:10px;border:none;background:#059669;color:white;font-weight:700;cursor:pointer;font-size:.9rem;align-self:flex-start}
.quiz-result{padding:1.5rem;border-radius:12px;border:2px solid;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.25rem;margin-bottom:1rem}

/* Completion banner */
.completion-banner{display:flex;align-items:center;gap:1.25rem;background:white;border:2px solid;border-radius:16px;padding:1.5rem;margin-top:1.5rem;flex-wrap:wrap}
.btn-back-home{padding:10px 22px;border-radius:10px;border:none;color:white;font-weight:700;text-decoration:none;font-size:.9rem}

@media(max-width:768px){.mv-title-row{flex-direction:column}.video-iframe{height:240px}}
</style>
{% endblock %}

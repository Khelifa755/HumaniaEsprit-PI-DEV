{% extends 'base.html.twig' %}
{% block title %}{{ module.titre }} – Mes Leçons{% endblock %}

{% block body %}

{% set typeIcons = {
  'video':    '🎥',
  'reading':  '📖',
  'lecture':  '📖',
  'cours':    '📖',
  'quiz':     '🧠',
  'exercice': '✏️',
  'exercise': '✏️',
} %}
{% set typeIcon = typeIcons[module.type_contenu|lower] ?? '📄' %}
{% set isExercice = module.type_contenu|trim|lower in ['exercice', 'exercise'] %}

<div class="ml-layout">

  {# ══ TOP BAR ═══════════════════════════════════════════════════════════════ #}
  <div class="ml-topbar">
    <a href="{{ path('module_progress_show', {id: module.formation_id}) }}" class="btn-back-top">← Retour</a>

    <div class="ml-topbar-center">
      <span class="ml-module-title">{{ module.titre }}</span>
      <span class="type-badge type-{{ module.type_contenu|lower }}">{{ typeIcon }} {{ module.type_contenu }}</span>
    </div>

    <div class="ml-topbar-right">
      <div class="ml-progress-pill">{{ progress }}% complété</div>
      {% if isCompleted %}
        <span class="btn-complete-done">✓ Terminé</span>
      {% else %}
        <button class="btn-terminate" id="btnTerminate" onclick="markComplete()">
          ✓ Terminer le module
        </button>
      {% endif %}
      <button class="btn-sidebar-toggle" id="btnSidebarToggle" onclick="toggleSidebar()" title="Afficher/Masquer la sidebar">
        <span id="sidebarToggleIcon">◀</span>
      </button>
    </div>
  </div>

  {# ══ PROGRESS BAR ══════════════════════════════════════════════════════════ #}
  <div class="ml-progress-bar-wrap">
    <div class="ml-progress-bar-fill" id="progressBarFill" style="width:{{ progress }}%"></div>
  </div>

  {# ══ MAIN CONTENT ══════════════════════════════════════════════════════════ #}
  <div class="ml-body">

    {# ── Contenu principal (gauche) ── #}
    <div class="ml-main" id="mlMain">

      {# ── VIDEO ── #}
      {% if module.type_contenu|lower == 'video' %}
        <div class="ml-video-wrap">
          {% if embedUrl %}
            <iframe src="{{ embedUrl }}" frameborder="0" allowfullscreen class="ml-video-iframe"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
            </iframe>
          {% elseif module.url_ressource %}
            <video controls class="ml-video-player">
              <source src="{{ module.url_ressource }}">
              Votre navigateur ne supporte pas la lecture vidéo.
            </video>
          {% else %}
            <div class="ml-no-content">🎥 Aucune vidéo disponible pour ce module.</div>
          {% endif %}
        </div>
      {% endif %}

      {# ══════════════════════════════════════════════════════════════════════
         ── EXERCICE LAYOUT (type = exercice OR exercise)
         Affichage intégré : énoncé en haut (jaune clair) + zone réponse en bas
         ══════════════════════════════════════════════════════════════════════ #}
      {% if isExercice %}

        {# ── Bannière d'intro exercice ── #}
        <div class="exo-intro-banner">
          <div class="exo-intro-left">
            <div class="exo-intro-icon-wrap">✏️</div>
            <div>
              <div class="exo-intro-title">Exercice pratique</div>
              <div class="exo-intro-sub">
                {% if module.duree_minutes %}⏱ {{ module.duree_minutes }} min estimé · {% endif %}
                Correction instantanée par IA · Groq LLaMA 3.3
              </div>
            </div>
          </div>
          <div class="exo-ai-badge">
            <span class="exo-ai-dot"></span>
            IA active
          </div>
        </div>

        {# ── ÉNONCÉ — fond jaune clair, scroll libre, TOUT visible ── #}
        {% if module.contenu_texte %}
          <div class="exo-enonce-card">
            <div class="exo-enonce-header">
              <span class="exo-enonce-header-icon">📋</span>
              <span>Énoncé de l'exercice</span>
              <div class="ml-lang-toggle" style="margin-left:auto">
                <span class="ml-lang-lbl">Langue :</span>
                <button class="lang-btn active" id="btnFR" onclick="switchLang('fr')">🇫🇷 FR</button>
                <button class="lang-btn"        id="btnEN" onclick="switchLang('en')">🇬🇧 EN</button>
              </div>
            </div>
            <div class="exo-enonce-body" id="courseContentFR">
              {{ module.contenu_texte|nl2br }}
            </div>
            <div class="exo-enonce-body" id="courseContentEN" style="display:none">
              <div class="ml-translating">Traduction en cours…</div>
            </div>
          </div>
        {% endif %}

        {# ── ZONE SOUMISSION RÉPONSE ── #}
        <div class="ml-exercice-wrap" id="exoResponseZone">
          <div class="exo-response-header">
            <div class="exo-response-header-left">
              <div class="exo-response-header-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </div>
              <div>
                <div class="exo-response-title">Votre réponse</div>
                <div class="exo-response-sub">Rédigez votre réponse ci-dessous puis soumettez pour correction IA</div>
              </div>
            </div>
          </div>

          <div class="ml-exo-response">
            <div id="exoErrorMsg" class="exo-error-msg" style="display:none;"></div>
            <div class="exo-textarea-wrap">
              <textarea id="exerciceResponse" class="ml-exo-textarea"
                        placeholder="Rédigez votre réponse complète ici…&#10;&#10;• Soyez précis et structuré&#10;• Répondez à toutes les parties de l'énoncé&#10;• Expliquez votre raisonnement"
                        rows="7"
                        oninput="updateCharCount(); hideError();"></textarea>
              <div class="exo-textarea-footer">
                <span class="exo-char-count" id="exoCharCount">0 caractère</span>
                <span class="exo-hint">↕ Redimensionnable · Correction IA en ~10–20s</span>
              </div>
            </div>
            <div class="exo-actions-row">
              <button class="btn-exo-clear" onclick="clearExercice()" title="Effacer">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3,6 5,6 21,6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
                Effacer
              </button>
              <button class="btn-submit-exo" id="btnSubmitExo" onclick="submitExercice()">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9"/></svg>
                <span id="submitExoTxt">Soumettre pour correction IA</span>
              </button>
            </div>
          </div>
        </div>

        {# ── FEEDBACK IA ── #}
        <div id="exoFeedback" style="display:none">

          {# Loader #}
          <div id="exoLoader" class="exo-loader-card" style="display:none">
            <div class="exo-loader-inner">
              <div class="exo-loader-spinner"></div>
              <div class="exo-loader-text">L'IA corrige votre réponse…</div>
              <div class="exo-loader-sub">Analyse en cours · environ 10–20 secondes</div>
            </div>
          </div>

          {# Résultat #}
          <div id="exoResult" class="exo-result-card" style="display:none">

            {# Score hero #}
            <div class="exo-score-hero" id="exoScoreHero">
              <div class="exo-score-circle-wrap">
                <svg class="exo-score-svg" viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="50" fill="none" stroke="rgba(255,255,255,0.15)" stroke-width="10"/>
                  <circle cx="60" cy="60" r="50" fill="none" stroke="white" stroke-width="10"
                          id="exoScoreArc"
                          stroke-dasharray="0 314"
                          stroke-dashoffset="78.5" stroke-linecap="round"/>
                </svg>
                <div class="exo-score-inner">
                  <span class="exo-score-val" id="exoScoreVal">0</span>
                  <span class="exo-score-label">/ 100</span>
                </div>
              </div>
              <div class="exo-score-info">
                <div class="exo-score-niveau" id="exoScoreNiveau">–</div>
                <div class="exo-score-msg" id="exoScoreMsg">–</div>
                <div class="exo-score-badges" id="exoScoreBadges"></div>
              </div>
            </div>

            {# Feedback body #}
            <div class="exo-feedback-body">
              <div class="exo-feedback-cols">
                <div class="exo-feedback-col exo-col-forts">
                  <div class="exo-col-head">
                    <span class="exo-col-icon" style="background:#D1FAE5;color:#059669">✓</span>
                    Points forts
                  </div>
                  <ul class="exo-points-list" id="exoForts"></ul>
                </div>
                <div class="exo-feedback-col exo-col-amelio">
                  <div class="exo-col-head">
                    <span class="exo-col-icon" style="background:#FEF3C7;color:#D97706">→</span>
                    À améliorer
                  </div>
                  <ul class="exo-points-list" id="exoAmelio"></ul>
                </div>
              </div>

              <div class="exo-correction-block">
                <div class="exo-correction-label">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                  Correction détaillée
                </div>
                <div class="exo-correction-text" id="exoCorrectionText"></div>
              </div>

              <div class="exo-conseil-block" id="exoConseilBlock" style="display:none">
                <div class="exo-conseil-icon">💡</div>
                <div>
                  <div class="exo-conseil-title">Conseil pour progresser</div>
                  <div class="exo-conseil-text" id="exoConseilText"></div>
                </div>
              </div>

              <div class="exo-post-actions">
                <button class="btn-exo-retry" onclick="retryExercice()">↺ Recommencer</button>
                {% if not isCompleted %}
                  <button class="btn-exo-validate" id="btnExoValidate" onclick="validateExercice()" style="display:none">✓ Valider le module</button>
                {% endif %}
                <button class="btn-exo-save-note" id="btnExoSaveNote" onclick="saveExoNote()" style="display:none">💾 Sauvegarder dans mes notes</button>
              </div>
            </div>
          </div>

        </div>{# /exoFeedback #}

      {% else %}
        {# ══ NON-EXERCICE : lecture / cours classique ══════════════════════ #}
        {% if module.contenu_texte %}
          <div class="ml-reading-wrap" id="readingContent">
            <div class="ml-reading-header">
              <div class="ml-reading-header-left">
                <div class="ml-reading-icon">📖</div>
                <div class="ml-reading-meta">
                  <div class="ml-reading-label">Contenu · Lecture</div>
                  {% if module.duree_minutes %}<div class="ml-reading-time">⏱ {{ module.duree_minutes }} min de lecture</div>{% endif %}
                </div>
              </div>
              <div class="ml-lang-toggle">
                <span class="ml-lang-lbl">Langue :</span>
                <button class="lang-btn active" id="btnFR" onclick="switchLang('fr')">🇫🇷 FR</button>
                <button class="lang-btn"        id="btnEN" onclick="switchLang('en')">🇬🇧 EN</button>
              </div>
            </div>
            <div class="ml-course-content" id="courseContentFR">
              {{ module.contenu_texte|nl2br }}
            </div>
            <div class="ml-course-content" id="courseContentEN" style="display:none">
              <div class="ml-translating">Traduction en cours…</div>
            </div>
          </div>
        {% endif %}
      {% endif %}

      {# ── QUIZ ── #}
      {% if module.type_contenu|lower == 'quiz' %}
        <div class="ml-quiz-wrap">
          {% if quizQuestions|length > 0 %}
            <div class="ml-quiz-header">
              <div class="quiz-icon">🧠</div>
              <div>
                <div class="quiz-title">{{ module.titre }}</div>
                <div class="quiz-subtitle">{{ quizQuestions|length }} questions · {{ module.duree_minutes }} min</div>
              </div>
            </div>
            <form id="quizForm" class="ml-quiz-form">
              {% for q in quizQuestions %}
                <div class="ml-q-card" id="q-card-{{ loop.index }}">
                  <div class="ml-q-num">Q{{ loop.index }}</div>
                  <div class="ml-q-text">{{ q.question }}</div>
                  <div class="ml-q-options">
                    {% for opt in ['A','B','C','D'] %}
                      {% set optKey = 'option_' ~ opt|lower %}
                      {% if attribute(q, optKey) is defined and attribute(q, optKey) %}
                        <label class="ml-q-opt" id="opt-{{ q.id }}-{{ opt }}">
                          <input type="radio" name="answers[{{ q.id }}]" value="{{ opt }}">
                          <span class="opt-letter">{{ opt }}</span>
                          <span class="opt-text">{{ attribute(q, optKey) }}</span>
                        </label>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
              <div class="ml-quiz-actions">
                <button type="button" class="btn-submit-quiz" onclick="submitQuiz()">✅ Soumettre le quiz</button>
              </div>
            </form>
            <div id="quizResult" style="display:none"></div>
          {% else %}
            <div class="ml-no-content">🧠 Aucune question disponible pour ce quiz.</div>
          {% endif %}
        </div>
      {% endif %}

      {# ── SECTIONS ── #}
      {% if sections|length > 0 %}
        <div class="ml-sections">
          <div class="ml-sections-title">📋 Sections du module</div>
          {% for section in sections %}
            <div class="ml-section-row {{ section.statut == 'completed' ? 'section-done' : '' }}">
              <span class="s-check">{{ section.statut == 'completed' ? '✓' : '○' }}</span>
              <div class="s-info">
                <div class="s-title">{{ section.titre }}</div>
                {% if section.description %}<div class="s-desc">{{ section.description }}</div>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

    </div>{# /ml-main #}

    {# ── Sidebar droite ── #}
    <div class="ml-sidebar" id="mlSidebar">
      <div class="sidebar-tabs">
        <button class="stab active" id="tabNotes"  onclick="showTab('notes')"><span class="stab-icon">📝</span> Notes</button>
        <button class="stab"        id="tabAI"     onclick="showTab('ai')"><span class="stab-icon">🤖</span> IA</button>
        <button class="stab"        id="tabVideos" onclick="showTab('videos')"><span class="stab-icon">▶</span> Vidéos</button>
      </div>

      {# ── Panel Notes ── #}
      <div class="spanel" id="panelNotes">
        <div class="panel-inner">
          <div class="notes-panel-title">
            <div class="notes-panel-title-icon">📝</div>
            Mes notes
          </div>
          <textarea id="txtNote" class="note-textarea" placeholder="Capturez vos idées, questions, remarques…"></textarea>
          <button class="btn-save-note" onclick="saveNote()"><span>💾</span> Enregistrer la note</button>
          <div class="notes-sep">Historique</div>
          <div class="notes-history" id="notesHistory">
            {% for note in notes %}
              <div class="note-item" id="note-{{ note.id }}">
                <div class="note-item-header">
                  <span class="note-date">{{ note.created_at|date('d/m/Y H:i') }}</span>
                  <div class="note-actions">
                    <button class="btn-expand-note" onclick="openNoteDetail({{ note.id }}, `{{ note.contenu|e('js') }}`, `{{ note.created_at|date('d/m/Y H:i') }}`)" title="Agrandir">⤢</button>
                    <button class="btn-delete-note" onclick="confirmDeleteNote({{ note.id }})" title="Supprimer">✕</button>
                  </div>
                </div>
                <div class="note-text">{{ note.contenu|replace({"**": "", "*": "", "+ ": "• ", "# ": ""})|slice(0, 100) }}{% if note.contenu|length > 100 %}…{% endif %}</div>
              </div>
            {% else %}
              <div class="notes-empty" id="notesEmpty">Aucune note pour ce module.</div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# ── Panel IA ── #}
      <div class="spanel" id="panelAI" style="display:none">
        <div class="ai-panel-header">
          <span class="ai-panel-icon">🤖</span>
          <div>
            <div class="ai-panel-title-text">Assistant IA</div>
            <div class="ai-panel-sub">Propulsé par Groq · LLaMA 3.3</div>
          </div>
        </div>
        <div class="panel-inner">
          <div class="ai-btns">
            <button class="btn-ai btn-ai-summary" onclick="callAI('summary')">
              <div class="btn-ai-icon">📋</div>
              <div class="btn-ai-label"><span class="btn-ai-label-main">Résumé du cours</span><span class="btn-ai-label-sub">Points clés structurés</span></div>
            </button>
            <button class="btn-ai btn-ai-explain" onclick="callAI('explain')">
              <div class="btn-ai-icon">💡</div>
              <div class="btn-ai-label"><span class="btn-ai-label-main">Expliquer les concepts</span><span class="btn-ai-label-sub">En termes simples</span></div>
            </button>
            <button class="btn-ai btn-ai-quiz" onclick="callAI('quiz')">
              <div class="btn-ai-icon">🧠</div>
              <div class="btn-ai-label"><span class="btn-ai-label-main">Générer un quiz</span><span class="btn-ai-label-sub">3 questions QCM interactives</span></div>
            </button>
          </div>
          <div id="aiStatus" class="ai-status" style="display:none">
            <span class="ai-spinner">⚙️</span> <span id="aiStatusText">Génération en cours…</span>
          </div>
          <div id="aiResponse" class="ai-response" style="display:none"></div>
          <button id="btnSaveAI" class="btn-save-ai" style="display:none" onclick="saveAIResult()"><span>💾</span> Sauvegarder dans mes notes</button>
        </div>
      </div>

      {# ── Panel Vidéos ── #}
      <div class="spanel" id="panelVideos" style="display:none">
        <div class="vid-panel-header">
          <span class="vid-panel-icon">▶</span>
          <div>
            <div class="vid-panel-title-text">Vidéos suggérées</div>
            <div class="vid-panel-sub">Via YouTube · Selon le sujet</div>
          </div>
        </div>
        <div class="panel-inner">
          <div id="videoStatus" class="vid-status" style="display:none">Recherche en cours…</div>
          <div id="videoResults" class="video-results"></div>
        </div>
      </div>

    </div>{# /ml-sidebar #}
  </div>{# /ml-body #}

  {# ══ NAVIGATION BAS ════════════════════════════════════════════════════════ #}
  <div class="ml-nav-bar">
    {% if prevModule %}
      <a href="{{ path('module_learner_show', {id: prevModule.id}) }}" class="btn-nav btn-prev">← Précédent</a>
    {% else %}
      <span class="btn-nav btn-nav-disabled">← Précédent</span>
    {% endif %}

    <div class="nav-hint">🎨 Sélectionne du texte pour surligner ou effacer</div>

    {% if nextModule %}
      <a href="{{ path('module_learner_show', {id: nextModule.id}) }}"
         class="btn-nav btn-next {{ not isCompleted ? 'btn-next-disabled' : '' }}"
         id="btnNext">Suivant →</a>
    {% else %}
      <a href="{{ path('module_progress_show', {id: module.formation_id}) }}" class="btn-nav btn-next">
        ✓ Terminer la formation
      </a>
    {% endif %}
  </div>

</div>{# /ml-layout #}

{# ══ FAB HIGHLIGHTS ══════════════════════════════════════════════════════════ #}
<button id="hlSaveBtn" class="hl-save-fab" onclick="hlSave()" title="Sauvegarder les surlignages">💾</button>

{# ══ MODALES ═════════════════════════════════════════════════════════════════ #}
<div id="confirmModal" class="confirm-overlay" style="display:none" onclick="if(event.target===this)closeConfirmModal()">
  <div class="confirm-box">
    <div class="confirm-icon">🗑️</div>
    <div class="confirm-title">Supprimer cette note ?</div>
    <div class="confirm-sub">Cette action est irréversible.</div>
    <div class="confirm-actions">
      <button class="confirm-btn-cancel" onclick="closeConfirmModal()">Annuler</button>
      <button class="confirm-btn-ok" onclick="doDeleteNote()">Supprimer</button>
    </div>
  </div>
</div>

<div id="noteDetailModal" class="confirm-overlay" style="display:none" onclick="if(event.target===this)closeNoteDetailModal()">
  <div class="note-detail-box">
    <div class="note-detail-header">
      <span class="note-detail-date" id="noteDetailDate"></span>
      <button class="notes-modal-close" onclick="closeNoteDetailModal()">✕</button>
    </div>
    <div class="note-detail-body" id="noteDetailText"></div>
  </div>
</div>

<script>
const MODULE_ID    = {{ module.id }};
const FORMATION_ID = {{ module.formation_id }};
const IS_COMPLETED = {{ isCompleted ? 'true' : 'false' }};
const IS_EXERCICE  = {{ isExercice ? 'true' : 'false' }};

// ── Sidebar toggle ────────────────────────────────────────────────────────
let sidebarOpen = true;
function toggleSidebar() {
  const sidebar = document.getElementById('mlSidebar');
  const icon    = document.getElementById('sidebarToggleIcon');
  sidebarOpen = !sidebarOpen;
  sidebar.style.display = sidebarOpen ? 'flex' : 'none';
  icon.textContent      = sidebarOpen ? '◀' : '▶';
}

// ── Tabs sidebar ──────────────────────────────────────────────────────────
function showTab(name) {
  ['Notes','AI','Videos'].forEach(t => {
    document.getElementById('panel' + t).style.display = 'none';
    document.getElementById('tab'   + t).classList.remove('active');
  });
  const idMap = { notes: 'Notes', ai: 'AI', videos: 'Videos' };
  const key = idMap[name] || (name.charAt(0).toUpperCase() + name.slice(1));
  document.getElementById('panel' + key).style.display = 'flex';
  document.getElementById('tab'   + key).classList.add('active');
  if (name === 'videos' && !videosLoaded) loadVideos();
}

// ── Mark complete ─────────────────────────────────────────────────────────
async function markComplete(score = 0) {
  const btn = document.getElementById('btnTerminate');
  if (btn) { btn.disabled = true; btn.textContent = '⏳ En cours…'; }
  const fd = new FormData();
  fd.append('score_quiz', score);
  try {
    const res  = await fetch(`/mes-lecons/module/${MODULE_ID}/complete`, { method: 'POST', body: fd });
    const data = await res.json();
    if (data.ok) {
      document.getElementById('progressBarFill').style.width = data.progress + '%';
      document.querySelector('.ml-progress-pill').textContent = data.progress + '% complété';
      if (btn) btn.outerHTML = '<span class="btn-complete-done">✓ Terminé</span>';
      const btnNext = document.getElementById('btnNext');
      if (btnNext) btnNext.classList.remove('btn-next-disabled');
    } else {
      if (btn) { btn.disabled = false; btn.textContent = '✓ Terminer le module'; }
      showError('Erreur : ' + (data.error || 'inconnue'));
    }
  } catch(e) {

// ── AI Quiz interactif ────────────────────────────────────────────────────
function renderAIQuiz(questions) {
  let html = '<div class="aiq-wrap"><div class="aiq-header">🧠 Quiz généré par IA <span class="aiq-count">' + questions.length + ' questions</span></div>';
  questions.forEach((q, i) => {
    html += `<div class="aiq-card" id="aiq-card-${i}"><div class="aiq-num">Q${i+1}</div><div class="aiq-text">${q.question}</div><div class="aiq-opts">`;
    Object.entries(q.options).forEach(([letter, text]) => {
      html += `<label class="aiq-opt" id="aiq-opt-${i}-${letter}"><input type="radio" name="aiq-${i}" value="${letter}" onchange="checkAIQAnswer(${i},'${letter}','${q.answer}')"><span class="aiq-letter">${letter}</span><span class="aiq-opttext">${text}</span></label>`;
    });
    html += `</div><div class="aiq-feedback" id="aiq-fb-${i}" style="display:none"></div></div>`;
  });
  html += '<div class="aiq-score" id="aiqScore" style="display:none"></div></div>';
  return html;
}

let aiqAnswered = {};
function checkAIQAnswer(idx, chosen, correct) {
  if (aiqAnswered[idx]) return;
  aiqAnswered[idx] = true;
  document.querySelectorAll(`input[name="aiq-${idx}"]`).forEach(r => r.disabled = true);
  const fb = document.getElementById(`aiq-fb-${idx}`);
  const chosenLabel  = document.getElementById(`aiq-opt-${idx}-${chosen}`);
  const correctLabel = document.getElementById(`aiq-opt-${idx}-${correct}`);
  if (chosen === correct) {
    chosenLabel.classList.add('aiq-correct');
    fb.innerHTML = '✅ Bonne réponse !';
    fb.className = 'aiq-feedback aiq-fb-ok';
  } else {
    chosenLabel.classList.add('aiq-wrong');
    correctLabel.classList.add('aiq-correct');
    fb.innerHTML = `❌ Mauvaise réponse. La bonne réponse est <strong>${correct}</strong>.`;
    fb.className = 'aiq-feedback aiq-fb-err';
  }
  fb.style.display = 'block';
  const total = document.querySelectorAll('[id^="aiq-card-"]').length;
  if (Object.keys(aiqAnswered).length === total) {
    const score = Math.round(Object.keys(aiqAnswered).reduce((acc, k) => {
      return acc + (document.querySelector(`#aiq-card-${k} .aiq-wrong`) === null ? 1 : 0);
    }, 0) / total * 100);
    const scoreEl = document.getElementById('aiqScore');
    scoreEl.style.display = 'block';
    scoreEl.innerHTML = score >= 70 ? `🎉 Score : <strong>${score}%</strong> — Excellent !` : `😞 Score : <strong>${score}%</strong> — Réessayez pour améliorer.`;
    scoreEl.className = 'aiq-score ' + (score >= 70 ? 'aiq-score-ok' : 'aiq-score-err');
  }
}

// ── Langue (FR/EN) ────────────────────────────────────────────────────────
let enTranslated = false;
function switchLang(lang) {
  const btnFR = document.getElementById('btnFR');
  const btnEN = document.getElementById('btnEN');
  if (btnFR) { btnFR.classList.toggle('active', lang === 'fr'); }
  if (btnEN) { btnEN.classList.toggle('active', lang === 'en'); }
  document.getElementById('courseContentFR').style.display = lang === 'fr' ? 'block' : 'none';
  document.getElementById('courseContentEN').style.display = lang === 'en' ? 'block' : 'none';
  if (lang === 'en' && !enTranslated) { enTranslated = true; translateFullContent(); }
}

async function translateChunk(text) {
  const encoded = encodeURIComponent(text);
  try {
    const r = await fetch(`https://api.mymemory.translated.net/get?q=${encoded}&langpair=fr|en&de=humania@rh.dev`);
    const d = await r.json();
    if (d.responseStatus === 200 && d.responseData?.translatedText) return d.responseData.translatedText;
    if (d.responseStatus === 429 || (d.responseData?.translatedText || '').startsWith('MYMEMORY WARNING')) return text;
    return d.responseData?.translatedText || text;
  } catch(e) { return text; }
}

async function translateFullContent() {
  const frEl = document.getElementById('courseContentFR');
  const enEl = document.getElementById('courseContentEN');
  enEl.innerHTML = '<div class="ml-translating">Traduction en cours…</div>';
  const fullText = frEl.innerText || frEl.textContent || '';
  if (!fullText.trim()) { enEl.innerHTML = frEl.innerHTML; return; }
  const CHUNK_SIZE = 450;
  const paragraphs = fullText.split(/\n+/);
  const chunks = [];
  let current = '';
  for (const p of paragraphs) {
    if (!p.trim()) continue;
    if ((current + '\n' + p).length > CHUNK_SIZE && current.length > 0) { chunks.push(current.trim()); current = p; }
    else { current = current ? current + '\n' + p : p; }
  }
  if (current.trim()) chunks.push(current.trim());
  if (chunks.length === 0) { enEl.innerHTML = frEl.innerHTML; return; }
  const translatedChunks = [];
  for (let i = 0; i < chunks.length; i++) {
    if (i > 0) await new Promise(r => setTimeout(r, 300));
    translatedChunks.push(await translateChunk(chunks[i]));
    enEl.innerHTML = translatedChunks.map(t => `<p style="margin-bottom:.75rem">${t.replace(/\n/g,'<br>')}</p>`).join('') +
      (i < chunks.length - 1 ? '<div class="ml-translating">Traduction en cours…</div>' : '');
  }
  enEl.innerHTML = translatedChunks.map(t => `<p style="margin-bottom:.75rem">${t.replace(/\n/g,'<br>')}</p>`).join('');
}


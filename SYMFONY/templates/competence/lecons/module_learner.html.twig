}

// ── AI ────────────────────────────────────────────────────────────────────
let currentAIText = '';
let currentAIAction = '';

async function callAI(action) {
  currentAIAction = action;
  currentAIText   = '';
  document.getElementById('btnSaveAI').style.display = 'none';
  const status   = document.getElementById('aiStatus');
  const response = document.getElementById('aiResponse');
  const labels   = { summary: 'Génération du résumé…', explain: 'Explication en cours…', quiz: 'Génération du quiz…' };
  document.getElementById('aiStatusText').textContent = labels[action] || 'Génération…';
  status.style.display   = 'block';
  response.style.display = 'none';
  const fd = new FormData();
  fd.append('action', action);
  try {
    const res  = await fetch(`/mes-lecons/module/${MODULE_ID}/ai`, { method: 'POST', body: fd });
    const data = await res.json();
    status.style.display   = 'none';
    response.style.display = 'block';
    if (data.ok) {
      currentAIText = data.result;
      if (action === 'quiz') {
        try {
          const questions = JSON.parse(data.result.trim());
          response.innerHTML = renderAIQuiz(questions);
          document.getElementById('btnSaveAI').style.display = 'none';
        } catch(parseErr) {
          response.innerHTML = `<div class="ai-result">${data.result.replace(/\n/g,'<br>')}</div>`;
          document.getElementById('btnSaveAI').style.display = 'block';
        }
      } else {
        const html = data.result
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
          .replace(/^### (.+)$/gm, '<div class="ai-h3">$1</div>')
          .replace(/^## (.+)$/gm,  '<div class="ai-h2">$1</div>')
          .replace(/^- (.+)$/gm,   '<div class="ai-li">• $1</div>')
          .replace(/\n/g, '<br>');
        response.innerHTML = `<div class="ai-result">${html}</div>`;
        document.getElementById('btnSaveAI').style.display = 'block';
      }
    } else {
      response.innerHTML = `<div class="ai-error">❌ ${data.error}</div>`;
    }
  } catch(e) {
    status.style.display   = 'none';
    response.style.display = 'block';
    response.innerHTML     = `<div class="ai-error">❌ Erreur réseau : ${e.message}</div>`;
  }
}


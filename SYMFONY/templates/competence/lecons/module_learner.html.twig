    const corrEl = document.getElementById('exoCorrectionText');
    if (corrEl) corrEl.textContent = data.correction || '–';

    if (data.conseil) {
      document.getElementById('exoConseilText').textContent = data.conseil;
      document.getElementById('exoConseilBlock').style.display = 'flex';

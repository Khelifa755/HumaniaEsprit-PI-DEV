    const badgesEl = document.getElementById('exoScoreBadges');
    if (badgesEl) {
      const badges = [];
      if (score >= 90) badges.push('🏆 Expert');
      else if (score >= 75) badges.push('⭐ Maîtrisé');
      else if (score >= 60) badges.push('✓ Validé');
      if (data.correct) badges.push('🎯 Réussi');
      badgesEl.innerHTML = badges.map(b => `<span class="exo-badge">${b}</span>`).join('');
    }

    const fortsEl = document.getElementById('exoForts');
    if (fortsEl) {
      fortsEl.innerHTML = (data.points_forts?.length)
        ? data.points_forts.map(p => `<li class="exo-point exo-point-fort">${p}</li>`).join('')
        : '<li class="exo-point" style="color:#9CA3AF;font-style:italic">Aucun point fort identifié.</li>';
    }

    const amelioEl = document.getElementById('exoAmelio');

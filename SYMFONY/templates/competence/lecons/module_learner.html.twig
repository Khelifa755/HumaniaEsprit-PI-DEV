    const circumf = 2 * Math.PI * 50;
    const dash    = (score / 100) * circumf;
    const arc     = document.getElementById('exoScoreArc');
    if (arc) {
      setTimeout(() => {
        arc.style.transition = 'stroke-dasharray 1s cubic-bezier(.4,0,.2,1)';
        arc.setAttribute('stroke-dasharray', dash + ' ' + circumf);
      }, 100);

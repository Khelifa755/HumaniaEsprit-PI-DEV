.exo-conseil-icon { font-size:1.2rem; flex-shrink:0; margin-top:1px; }
.exo-conseil-title { font-size:.72rem; font-weight:800; color:#065F46; text-transform:uppercase; letter-spacing:.07em; margin-bottom:.2rem; }
.exo-conseil-text { font-size:.85rem; color:#065F46; line-height:1.55; }

.exo-post-actions { display:flex; gap:.65rem; flex-wrap:wrap; padding-top:.75rem; border-top:1px solid var(--g100); }
.btn-exo-retry { display:flex; align-items:center; gap:.35rem; padding:9px 18px; border-radius:9px; border:1.5px solid var(--g200); background:white; color:var(--g700); font-size:.82rem; font-weight:700; cursor:pointer; transition:all .15s; }
.btn-exo-retry:hover { border-color:var(--p); color:var(--p); background:var(--p-light); }
.btn-exo-validate { display:none; align-items:center; gap:.35rem; padding:9px 18px; border-radius:9px; border:none; background:linear-gradient(135deg,#059669,#10B981); color:white; font-size:.82rem; font-weight:700; cursor:pointer; transition:all .15s; box-shadow:0 2px 8px rgba(5,150,105,.3); }
.btn-exo-validate:hover { transform:translateY(-1px); box-shadow:0 4px 14px rgba(5,150,105,.4); }
.btn-exo-save-note { display:none; align-items:center; gap:.35rem; padding:9px 18px; border-radius:9px; border:1.5px solid #C7D2FE; background:#EEF2FF; color:var(--p); font-size:.82rem; font-weight:700; cursor:pointer; transition:all .15s; }
.btn-exo-save-note:hover { background:var(--p); color:white; border-color:var(--p); }

.exo-error { padding:1.5rem; background:#FEF2F2; border:1px solid #FCA5A5; border-radius:12px; color:#DC2626; font-size:.88rem; display:flex; flex-direction:column; align-items:flex-start; gap:.5rem; }

/* ══ Lecture classique ══ */
.ml-reading-wrap { background:white; border-radius:var(--radius-lg); border:1px solid var(--g200); overflow:hidden; box-shadow:var(--shadow-sm); }
.ml-reading-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:.85rem 1.5rem;
  background:linear-gradient(135deg,var(--g50) 0%,#F5F3FF 100%);
  border-bottom:1px solid var(--g200);
}
.ml-reading-header-left { display:flex; align-items:center; gap:.75rem; }
.ml-reading-icon {
  width:36px; height:36px; border-radius:10px;
  background:linear-gradient(135deg,var(--p) 0%,#818CF8 100%);
  display:flex; align-items:center; justify-content:center; font-size:1rem;
  box-shadow:0 3px 10px rgba(79,70,229,.3); flex-shrink:0;
}
.ml-reading-meta { display:flex; flex-direction:column; gap:.1rem; }
.ml-reading-label { font-size:.65rem; font-weight:800; color:var(--g500); text-transform:uppercase; letter-spacing:.08em; }
.ml-reading-time { font-size:.75rem; color:var(--g500); font-weight:500; }
.ml-course-content {
  padding:2rem 2.5rem; font-size:.925rem; color:#374151; line-height:2;
  max-height:65vh; overflow-y:auto;
}
.ml-translating {
  display:flex; align-items:center; gap:.75rem; padding:2rem;
  color:var(--g500); font-size:.88rem; font-style:italic;
}
.ml-translating::before { content:''; width:18px; height:18px; border:2px solid var(--p); border-top-color:transparent; border-radius:50%; animation:spin .8s linear infinite; flex-shrink:0; }

/* Quiz */
.ml-quiz-wrap { background:white; border-radius:12px; border:1px solid var(--g200); padding:1.5rem; }
.ml-quiz-header { display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem; padding-bottom:1rem; border-bottom:1px solid var(--g100); }
.quiz-icon { font-size:2rem; }
.quiz-title { font-size:1rem; font-weight:800; color:var(--g900); }
.quiz-subtitle { font-size:.8rem; color:var(--g500); margin-top:2px; }
.ml-quiz-form { display:flex; flex-direction:column; gap:1.25rem; }
.ml-q-card { background:var(--g50); border-radius:10px; padding:1rem 1.25rem; border:1px solid var(--g100); }
.ml-q-num { font-size:.7rem; font-weight:800; color:var(--g500); text-transform:uppercase; letter-spacing:.05em; margin-bottom:.35rem; }
.ml-q-text { font-size:.9rem; font-weight:700; color:var(--g900); margin-bottom:.75rem; }
.ml-q-options { display:flex; flex-direction:column; gap:.4rem; }
.ml-q-opt { display:flex; align-items:center; gap:.6rem; padding:.45rem .75rem; border-radius:8px; cursor:pointer; border:1.5px solid transparent; transition:background .12s; }
.ml-q-opt:hover { background:#EEF2FF; border-color:#C7D2FE; }
.ml-q-opt input { accent-color:var(--p); }
.opt-letter { font-size:.75rem; font-weight:800; color:var(--p); width:16px; flex-shrink:0; }
.opt-text { font-size:.85rem; color:#374151; }
.ml-quiz-actions { padding-top:.5rem; }
.btn-submit-quiz { padding:10px 28px; border-radius:10px; border:none; background:#059669; color:white; font-weight:700; font-size:.9rem; cursor:pointer; }
.btn-submit-quiz:hover { background:#047857; }
.quiz-result-box { padding:2rem; border-radius:12px; border:2px solid; text-align:center; display:flex; flex-direction:column; align-items:center; gap:.35rem; margin-top:1rem; }

/* Sections */
.ml-sections { background:white; border-radius:12px; border:1px solid var(--g200); padding:1.25rem; }
.ml-sections-title { font-size:.75rem; font-weight:800; color:var(--g500); text-transform:uppercase; letter-spacing:.05em; margin-bottom:.75rem; }
.ml-section-row { display:flex; align-items:flex-start; gap:.75rem; padding:.5rem 0; border-bottom:1px solid var(--g100); }
.ml-section-row:last-child { border-bottom:none; }
.ml-section-row.section-done .s-title { color:#059669; }
.s-check { font-size:.9rem; font-weight:800; color:var(--g500); flex-shrink:0; margin-top:2px; }
.ml-section-row.section-done .s-check { color:#059669; }
.s-title { font-size:.88rem; font-weight:600; color:var(--g900); }
.s-desc { font-size:.78rem; color:var(--g500); margin-top:2px; }

/* Sidebar tabs */
.sidebar-tabs { display:flex; border-bottom:1px solid var(--g200); flex-shrink:0; background:var(--g50); padding:.5rem .75rem 0; gap:.25rem; }
.stab { flex:1; padding:.65rem .4rem .6rem; border:none; background:transparent; font-size:.72rem; font-weight:700; color:var(--g500); cursor:pointer; border-radius:var(--radius-sm) var(--radius-sm) 0 0; border-bottom:2px solid transparent; transition:all .18s; display:flex; align-items:center; justify-content:center; gap:.3rem; }
.stab:hover { color:var(--p); background:rgba(79,70,229,.05); }
.stab.active { color:var(--p); border-bottom-color:var(--p); background:white; }
.stab-icon { font-size:.85rem; }

.spanel { flex:1; overflow-y:auto; display:flex; flex-direction:column; min-height:0; }
.panel-inner { padding:1.1rem 1rem; display:flex; flex-direction:column; gap:.85rem; flex:1; }

/* Notes panel */
.notes-panel-title { display:flex; align-items:center; gap:.5rem; font-size:.82rem; font-weight:800; color:var(--g900); }
.notes-panel-title-icon { width:28px; height:28px; border-radius:8px; background:linear-gradient(135deg,#4F46E5 0%,#818CF8 100%); display:flex; align-items:center; justify-content:center; font-size:.78rem; }
.note-textarea { width:100%; border:1.5px solid var(--g200); border-radius:var(--radius-md); padding:.75rem; font-size:.82rem; resize:vertical; font-family:inherit; color:#374151; min-height:96px; background:var(--g50); transition:border-color .15s; }
.note-textarea:focus { outline:none; border-color:var(--p); box-shadow:0 0 0 3px rgba(79,70,229,.1); background:white; }
.btn-save-note { padding:8px 16px; border-radius:var(--radius-sm); border:none; background:linear-gradient(135deg,var(--p) 0%,#818CF8 100%); color:white; font-weight:700; font-size:.78rem; cursor:pointer; align-self:stretch; text-align:center; transition:all .2s; box-shadow:0 2px 8px rgba(79,70,229,.25); display:flex; align-items:center; justify-content:center; gap:.4rem; }
.btn-save-note:hover { transform:translateY(-1px); box-shadow:0 4px 14px rgba(79,70,229,.35); }
.notes-sep { font-size:.62rem; font-weight:800; color:var(--g500); text-transform:uppercase; letter-spacing:.12em; padding:.5rem 0 .3rem; display:flex; align-items:center; gap:.5rem; }
.notes-sep::after { content:''; flex:1; height:1px; background:var(--g200); }
.notes-history { display:flex; flex-direction:column; gap:.5rem; overflow-y:auto; }
.note-item { background:white; border-radius:var(--radius-md); padding:.75rem .9rem; border:1px solid var(--g200); box-shadow:var(--shadow-sm); transition:all .15s; cursor:pointer; }
.note-item:hover { box-shadow:var(--shadow-md); border-color:var(--g300); transform:translateY(-1px); }
.note-item-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:.35rem; }
.note-actions { display:flex; align-items:center; gap:.2rem; flex-shrink:0; }
.btn-expand-note { background:none; border:1.5px solid var(--g200); border-radius:5px; color:var(--g500); font-size:.72rem; cursor:pointer; padding:2px 5px; line-height:1; transition:all .15s; }
.btn-expand-note:hover { background:var(--p-light); border-color:var(--p); color:var(--p); }
.note-date { font-size:.68rem; color:var(--g500); }
.note-ai-badge { font-size:.62rem; font-weight:800; background:#EEF2FF; color:var(--p); padding:2px 8px; border-radius:12px; }
.note-text { font-size:.78rem; color:#64748B; line-height:1.45; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; word-break:break-word; }
.notes-empty { font-size:.82rem; color:var(--g500); text-align:center; padding:1.5rem; background:var(--g50); border-radius:var(--radius-md); border:1px dashed var(--g200); display:flex; flex-direction:column; align-items:center; gap:.4rem; }
.notes-empty::before { content:'📝'; font-size:1.5rem; }
.btn-delete-note { background:none; border:none; font-size:.75rem; color:#CBD5E1; cursor:pointer; padding:2px 5px; border-radius:4px; transition:color .12s; }
.btn-delete-note:hover { color:#EF4444; background:#FEF2F2; }

/* AI panel */
.ai-panel-header { display:flex; align-items:center; gap:.5rem; padding:.85rem 1rem; background:linear-gradient(135deg,#1E1B4B 0%,#312E81 100%); flex-shrink:0; }
.ai-panel-icon { font-size:1.1rem; }
.ai-panel-title-text { font-size:.82rem; font-weight:800; color:white; }
.ai-panel-sub { font-size:.68rem; color:rgba(255,255,255,.6); margin-top:.05rem; }
.ai-btns { display:flex; flex-direction:column; gap:.5rem; }
.btn-ai { padding:10px 14px; border-radius:var(--radius-md); border:1.5px solid var(--g200); background:white; font-size:.8rem; font-weight:700; color:var(--g900); cursor:pointer; text-align:left; transition:all .15s; display:flex; align-items:center; gap:.6rem; box-shadow:var(--shadow-sm); }
.btn-ai-summary:hover { background:#EEF2FF; border-color:#C7D2FE; color:var(--p); }
.btn-ai-explain:hover { background:#ECFDF5; border-color:#6EE7B7; color:#059669; }
.btn-ai-quiz:hover { background:#FEF3C7; border-color:#FCD34D; color:#D97706; }
.btn-ai-icon { width:28px; height:28px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:.85rem; flex-shrink:0; }
.btn-ai-summary .btn-ai-icon { background:#EEF2FF; }
.btn-ai-explain .btn-ai-icon { background:#ECFDF5; }
.btn-ai-quiz .btn-ai-icon { background:#FEF3C7; }
.btn-ai-label { display:flex; flex-direction:column; gap:.05rem; }
.btn-ai-label-main { font-size:.8rem; font-weight:700; }
.btn-ai-label-sub { font-size:.65rem; color:var(--g500); font-weight:500; }
.ai-status { display:flex; align-items:center; gap:.6rem; font-size:.8rem; color:var(--g500); padding:.6rem .75rem; background:var(--g50); border-radius:var(--radius-sm); border:1px dashed var(--g200); }
.ai-spinner { animation:spin 1s linear infinite; display:inline-block; font-size:.9rem; }
.ai-response { flex:1; overflow-y:auto; min-height:0; }
.ai-result { font-size:.81rem; color:#374151; line-height:1.75; background:linear-gradient(135deg,var(--g50) 0%,#F5F3FF 100%); border-radius:var(--radius-md); padding:1rem; border:1px solid #E0E7FF; }
.ai-result .ai-h2 { font-size:.85rem; font-weight:800; color:var(--g900); margin:.7rem 0 .25rem; display:flex; align-items:center; gap:.4rem; }
.ai-result .ai-h2::before { content:''; width:3px; height:14px; background:var(--p); border-radius:99px; display:inline-block; }
.ai-result .ai-h3 { font-size:.82rem; font-weight:700; color:var(--p); margin:.5rem 0 .15rem; }
.ai-result .ai-li { padding:.15rem 0 .15rem .9rem; color:#374151; position:relative; }
.ai-result .ai-li::before { content:'▸'; position:absolute; left:0; color:var(--p); font-size:.7rem; }
.ai-error { font-size:.82rem; color:#DC2626; background:#FEF2F2; border-radius:var(--radius-md); padding:.85rem; border:1px solid #FCA5A5; }
.btn-save-ai { padding:9px 16px; border-radius:var(--radius-sm); border:none; background:linear-gradient(135deg,var(--p) 0%,#818CF8 100%); color:white; font-weight:700; font-size:.78rem; cursor:pointer; width:100%; margin-top:.5rem; transition:all .2s; box-shadow:0 2px 8px rgba(79,70,229,.25); display:flex; align-items:center; justify-content:center; gap:.4rem; }
.btn-save-ai:hover { box-shadow:0 4px 14px rgba(79,70,229,.35); transform:translateY(-1px); }
.btn-save-ai:disabled { opacity:.7; cursor:not-allowed; transform:none; box-shadow:none; }

/* Videos panel */
.vid-panel-header { padding:.85rem 1rem; background:linear-gradient(135deg,#0F172A 0%,#1E293B 100%); display:flex; align-items:center; gap:.5rem; flex-shrink:0; }
.vid-panel-icon { font-size:1.1rem; }
.vid-panel-title-text { font-size:.82rem; font-weight:800; color:white; }
.vid-panel-sub { font-size:.68rem; color:rgba(255,255,255,.5); margin-top:.05rem; }
.vid-status { font-size:.8rem; color:var(--g500); padding:.5rem; background:var(--g50); border-radius:var(--radius-sm); border:1px dashed var(--g200); display:flex; align-items:center; gap:.5rem; }
.vid-status::before { content:'⏳'; font-size:.85rem; }
.video-results { display:flex; flex-direction:column; gap:.6rem; overflow-y:auto; }
.vid-card a { display:flex; gap:.7rem; text-decoration:none; color:inherit; padding:.6rem; border-radius:var(--radius-md); border:1px solid var(--g200); transition:all .15s; background:white; }
.vid-card a:hover { background:var(--g50); border-color:var(--p); transform:translateX(2px); }
.vid-thumb { width:88px; height:52px; border-radius:6px; object-fit:cover; flex-shrink:0; }
.vid-info { flex:1; min-width:0; }
.vid-title-txt { font-size:.74rem; font-weight:600; color:var(--g900); line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.vid-channel { font-size:.65rem; color:var(--g500); margin-top:3px; display:flex; align-items:center; gap:.25rem; }
.vid-channel::before { content:'📺'; font-size:.6rem; }
.vid-empty { font-size:.82rem; color:var(--g500); text-align:center; padding:1.5rem; background:var(--g50); border-radius:var(--radius-md); border:1px dashed var(--g200); }

/* AI Quiz interactif */
.aiq-wrap { display:flex; flex-direction:column; gap:.85rem; padding:.25rem 0; }
.aiq-header { font-size:.8rem; font-weight:800; color:var(--g500); text-transform:uppercase; letter-spacing:.05em; display:flex; align-items:center; gap:.5rem; }
.aiq-count { background:#EEF2FF; color:var(--p); padding:2px 8px; border-radius:10px; font-size:.72rem; }
.aiq-card { background:var(--g50); border-radius:10px; padding:.9rem 1rem; border:1px solid var(--g100); }
.aiq-num { font-size:.68rem; font-weight:800; color:var(--g500); text-transform:uppercase; letter-spacing:.05em; margin-bottom:.3rem; }
.aiq-text { font-size:.85rem; font-weight:700; color:var(--g900); margin-bottom:.6rem; }
.aiq-opts { display:flex; flex-direction:column; gap:.3rem; }
.aiq-opt { display:flex; align-items:center; gap:.5rem; padding:.4rem .65rem; border-radius:7px; cursor:pointer; border:1.5px solid transparent; transition:background .12s; }
.aiq-opt:hover { background:#EEF2FF; border-color:#C7D2FE; }
.aiq-letter { font-size:.72rem; font-weight:800; color:var(--p); width:14px; flex-shrink:0; }
.aiq-opttext { font-size:.82rem; color:#374151; }
.aiq-opt.aiq-correct { background:#D1FAE5 !important; border-color:#6EE7B7 !important; }
.aiq-opt.aiq-correct .aiq-letter { color:#059669; }
.aiq-opt.aiq-wrong { background:#FEE2E2 !important; border-color:#FCA5A5 !important; }
.aiq-opt.aiq-wrong .aiq-letter { color:#DC2626; }
.aiq-feedback { font-size:.78rem; font-weight:700; margin-top:.5rem; padding:.4rem .65rem; border-radius:6px; }
.aiq-fb-ok { background:#D1FAE5; color:#065F46; }
.aiq-fb-err { background:#FEE2E2; color:#991B1B; }
.aiq-score { padding:.75rem 1rem; border-radius:10px; font-size:.85rem; font-weight:700; text-align:center; margin-top:.25rem; }
.aiq-score-ok { background:#D1FAE5; color:#065F46; border:1.5px solid #6EE7B7; }
.aiq-score-err { background:#FEE2E2; color:#991B1B; border:1.5px solid #FCA5A5; }

/* Nav bar */
.ml-nav-bar { display:flex; align-items:center; justify-content:space-between; padding:.75rem 1.75rem; background:white; border-top:1px solid var(--g200); flex-shrink:0; box-shadow:0 -2px 12px rgba(0,0,0,.05); }
.btn-nav { padding:9px 22px; border-radius:var(--radius-sm); font-size:.82rem; font-weight:700; text-decoration:none; border:none; cursor:pointer; transition:all .15s; display:flex; align-items:center; gap:.35rem; }
.btn-prev { background:var(--g100); color:var(--g900); border:1.5px solid var(--g200); }
.btn-prev:hover { background:var(--g200); }
.btn-next { background:linear-gradient(135deg,var(--p) 0%,#818CF8 100%); color:white; box-shadow:0 2px 8px rgba(79,70,229,.3); }
.btn-next:hover { box-shadow:0 4px 14px rgba(79,70,229,.4); transform:translateY(-1px); }
.btn-next-disabled { background:var(--g200) !important; color:var(--g500) !important; pointer-events:none; box-shadow:none !important; transform:none !important; }
.btn-nav-disabled { padding:9px 22px; border-radius:var(--radius-sm); font-size:.82rem; font-weight:700; background:var(--g100); color:var(--g300); border:1.5px solid var(--g200); }
.nav-hint { font-size:.72rem; color:var(--g500); background:var(--g50); padding:6px 14px; border-radius:20px; border:1px solid var(--g200); display:flex; align-items:center; gap:.4rem; }
.nav-hint::before { content:'✏️'; font-size:.75rem; }

/* Modales */
.confirm-overlay { position:fixed; inset:0; background:rgba(15,23,42,.55); z-index:10000; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(5px); }
.confirm-box { background:white; border-radius:var(--radius-lg); padding:2rem 1.75rem; width:320px; display:flex; flex-direction:column; align-items:center; gap:.6rem; box-shadow:var(--shadow-lg); text-align:center; animation:popIn .2s cubic-bezier(.34,1.56,.64,1); }
@keyframes popIn { from{transform:scale(.85);opacity:0} to{transform:scale(1);opacity:1} }
.confirm-icon { font-size:2rem; }
.confirm-title { font-size:.95rem; font-weight:800; color:var(--g900); }
.confirm-sub { font-size:.8rem; color:var(--g500); }
.confirm-actions { display:flex; gap:.75rem; margin-top:.5rem; }
.confirm-btn-cancel { padding:8px 20px; border-radius:9px; border:1.5px solid var(--g200); background:white; color:var(--g900); font-weight:700; font-size:.85rem; cursor:pointer; }
.confirm-btn-cancel:hover { background:var(--g100); }
.confirm-btn-ok { padding:8px 20px; border-radius:9px; border:none; background:#DC2626; color:white; font-weight:700; font-size:.85rem; cursor:pointer; }
.confirm-btn-ok:hover { background:#B91C1C; }
.note-detail-box { background:white; border-radius:var(--radius-lg); width:85vw; max-width:600px; max-height:75vh; display:flex; flex-direction:column; box-shadow:var(--shadow-lg); overflow:hidden; animation:popIn .2s cubic-bezier(.34,1.56,.64,1); }
.note-detail-header { display:flex; align-items:center; justify-content:space-between; padding:.75rem 1rem; border-bottom:1px solid var(--g200); flex-shrink:0; background:var(--g50); }
.note-detail-date { font-size:.78rem; color:var(--g500); font-weight:600; }
.note-detail-body { padding:1.25rem 1.5rem; overflow-y:auto; font-size:.88rem; color:#374151; line-height:1.7; flex:1; }
.notes-modal-close { background:none; border:none; font-size:1rem; cursor:pointer; color:var(--g500); padding:4px 8px; border-radius:6px; }
.notes-modal-close:hover { background:#FEE2E2; color:#DC2626; }

/* Note detail markdown */
.nd-h1 { font-size:1rem; font-weight:800; color:var(--g900); margin:.75rem 0 .3rem; border-bottom:2px solid var(--g200); }
.nd-h2 { font-size:.92rem; font-weight:800; color:var(--g900); margin:.6rem 0 .25rem; }
.nd-h3 { font-size:.85rem; font-weight:700; color:var(--p); margin:.5rem 0 .2rem; }
.nd-li { font-size:.87rem; color:#374151; padding:.15rem 0 .15rem 1rem; position:relative; }
.nd-li::before { content:'•'; position:absolute; left:.2rem; color:var(--p); font-weight:800; }
.nd-sub { padding-left:1.8rem; font-size:.83rem; color:var(--g500); }
.nd-sub::before { content:'–'; color:var(--g500); }
.nd-gap { height:.5rem; }

/* FAB highlights */
.hl-save-fab { position:fixed; bottom:80px; right:18px; z-index:8999; width:44px; height:44px; border-radius:50%; border:1.5px solid var(--g200); background:white; color:var(--g500); font-size:1rem; cursor:pointer; box-shadow:0 4px 16px rgba(0,0,0,.14); display:flex; align-items:center; justify-content:center; transition:all .2s; }
.hl-save-fab:hover { transform:scale(1.12); }
.hl-menu { position:fixed; z-index:9000; background:white; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,.18); padding:.45rem .7rem; display:none; flex-direction:column; gap:.35rem; border:1px solid var(--g200); min-width:310px; }
.hl-menu-row { display:flex; align-items:center; gap:.4rem; }
.hl-menu-row2 { border-top:1px solid var(--g100); padding-top:.3rem; gap:.35rem; }
.hl-label { font-size:.68rem; font-weight:700; color:var(--g500); white-space:nowrap; }
.hl-colors { display:flex; align-items:center; gap:.3rem; }
.hl-swatch { width:20px; height:20px; border-radius:50%; border:2px solid rgba(0,0,0,.12); cursor:pointer; transition:transform .12s; flex-shrink:0; }
.hl-swatch:hover { transform:scale(1.3); }
.hl-sep { width:1px; height:18px; background:var(--g200); flex-shrink:0; }
.hl-ud { background:none; border:1.5px solid var(--g200); border-radius:6px; font-size:.82rem; color:var(--g500); cursor:pointer; padding:2px 6px; line-height:1; transition:all .12s; }
.hl-ud:hover:not(:disabled) { background:#EEF2FF; border-color:var(--p); color:var(--p); }
.hl-ud:disabled { opacity:.35; cursor:not-allowed; }
.hl-action-btn { flex:1; padding:4px 8px; border-radius:7px; border:1.5px solid var(--g200); background:var(--g50); font-size:.72rem; font-weight:700; cursor:pointer; white-space:nowrap; transition:all .15s; text-align:center; }
.hl-erase-sel { color:#DC2626; border-color:#FCA5A5; }
.hl-erase-sel:hover:not(:disabled) { background:#FEE2E2; }
.hl-erase-all { color:#92400E; border-color:#FCD34D; }

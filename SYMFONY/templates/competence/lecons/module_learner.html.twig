function renderMarkdown(text) {
  return text
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/^#{3} (.+)$/gm, '<h4 class="nd-h3">$1</h4>')
    .replace(/^#{2} (.+)$/gm, '<h3 class="nd-h2">$1</h3>')
    .replace(/^# (.+)$/gm,    '<h2 class="nd-h1">$1</h2>')
    .replace(/^ {2,}[+\-] (.+)$/gm, '<div class="nd-li nd-sub">$1</div>')
    .replace(/^[*\-+] (.+)$/gm,     '<div class="nd-li">$1</div>')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.+?)\*/g, '<em>$1</em>')
    .replace(/\n{2,}/g, '<div class="nd-gap"></div>')
    .replace(/\n/g, ' ');
}
function openNoteDetail(noteId, contenu, date) {
  document.getElementById('noteDetailModal').style.display = 'flex';
  document.getElementById('noteDetailDate').textContent = date;
  document.getElementById('noteDetailText').innerHTML = renderMarkdown(contenu);
}
function closeNoteDetailModal() {

    document.getElementById('exoLoader').style.display = 'none';
    document.getElementById('exoFeedback').innerHTML = `<div class="exo-error">❌ Erreur réseau : ${e.message} <button onclick="retryExercice()" class="btn-exo-retry" style="margin-top:.5rem">↺ Réessayer</button></div>`;

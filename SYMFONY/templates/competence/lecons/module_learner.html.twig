// ── Highlights ────────────────────────────────────────────────────────────
const HIGHLIGHT_COLORS = [
  { label:'Jaune',  value:'#FEF08A', text:'#713F12' },
  { label:'Vert',   value:'#BBF7D0', text:'#14532D' },
  { label:'Bleu',   value:'#BFDBFE', text:'#1E3A5F' },
  { label:'Rose',   value:'#FBCFE8', text:'#831843' },
  { label:'Orange', value:'#FED7AA', text:'#7C2D12' },
];
const HL_STORAGE_KEY = 'hl_module_' + MODULE_ID;
let hlUndoStack = [], hlRedoStack = [];
function hlSaveState() { hlUndoStack.push(document.getElementById('mlMain').innerHTML); if(hlUndoStack.length>30)hlUndoStack.shift(); hlRedoStack=[]; updateUndoRedoBtns(); hlMarkUnsaved(); }
function hlUndo() { if(!hlUndoStack.length)return; hlRedoStack.push(document.getElementById('mlMain').innerHTML); document.getElementById('mlMain').innerHTML=hlUndoStack.pop(); updateUndoRedoBtns(); hlMarkUnsaved(); }
function hlRedo() { if(!hlRedoStack.length)return; hlUndoStack.push(document.getElementById('mlMain').innerHTML); document.getElementById('mlMain').innerHTML=hlRedoStack.pop(); updateUndoRedoBtns(); hlMarkUnsaved(); }
function updateUndoRedoBtns() { document.getElementById('hlUndo').disabled=hlUndoStack.length===0; document.getElementById('hlRedo').disabled=hlRedoStack.length===0; }
let hlSaved = false;
function hlSave() { try { localStorage.setItem(HL_STORAGE_KEY, document.getElementById('mlMain').innerHTML); hlSaved=true; updateSaveBtn(true); } catch(e){} }
function hlRestore() { try { const saved=localStorage.getItem(HL_STORAGE_KEY); if(!saved)return; document.getElementById('mlMain').innerHTML=saved; hlSaved=true; updateSaveBtn(true); } catch(e){} }
function updateSaveBtn(saved) { const btn=document.getElementById('hlSaveBtn'); if(!btn)return; btn.innerHTML=saved?'✅':'💾'; btn.title=saved?'Surlignages sauvegardés':'Sauvegarder les surlignages'; }
function hlMarkUnsaved() { hlSaved=false; updateSaveBtn(false); }
window.addEventListener('DOMContentLoaded', () => { setTimeout(hlRestore, 150); });

const hlMenu = document.createElement('div');
hlMenu.id = 'hlMenu';
hlMenu.className = 'hl-menu';
hlMenu.innerHTML =
  '<div class="hl-menu-row">' +
    '<div class="hl-label">Surligner :</div>' +
    '<div class="hl-colors">' + HIGHLIGHT_COLORS.map(col => `<button class="hl-swatch" style="background:${col.value}" title="${col.label}" data-bg="${col.value}" data-text="${col.text}"></button>`).join('') + '</div>' +
    '<div class="hl-sep"></div>' +
    '<button class="hl-ud" id="hlUndo" title="Annuler" disabled>↩</button>' +
    '<button class="hl-ud" id="hlRedo" title="Rétablir" disabled>↪</button>' +
  '</div>' +
  '<div class="hl-menu-row hl-menu-row2">' +
    '<button class="hl-action-btn hl-erase-sel" id="hlEraseSel">✕ Effacer</button>' +
    '<button class="hl-action-btn hl-erase-all" id="hlEraseAll">🗑️ Tout effacer</button>' +
    '<button class="hl-action-btn hl-save-inline" id="hlSaveInline">💾 Sauvegarder</button>' +
  '</div>';
document.body.appendChild(hlMenu);

let savedRange = null;
function selectionHasHighlight() {
  if (!savedRange) return false;
  const container = savedRange.commonAncestorContainer;
  const el = container.nodeType === 3 ? container.parentElement : container;
  if (el && el.closest('mark.hl-mark')) return true;
  return savedRange.cloneContents().querySelector('mark.hl-mark') !== null;
}

document.addEventListener('mouseup', e => {
  const sel = window.getSelection();
  if (!sel || sel.isCollapsed || sel.toString().trim() === '') { hlMenu.style.display='none'; return; }
  const node = sel.anchorNode;
  if (!node) return;
  const inMain = node.parentElement && node.parentElement.closest('.ml-main');
  if (!inMain) { hlMenu.style.display='none'; return; }
  savedRange = sel.getRangeAt(0).cloneRange();
  const rect = sel.getRangeAt(0).getBoundingClientRect();
  hlMenu.style.display = 'flex';
  hlMenu.style.top  = (rect.top + window.scrollY - 78) + 'px';
  hlMenu.style.left = Math.max(4, rect.left + rect.width/2 - 155) + 'px';
  const eraseSelBtn = document.getElementById('hlEraseSel');
  if (selectionHasHighlight()) { eraseSelBtn.style.opacity='1'; eraseSelBtn.disabled=false; }
  else { eraseSelBtn.style.opacity='0.38'; eraseSelBtn.disabled=true; }
});

document.addEventListener('mousedown', e => { if (!hlMenu.contains(e.target)) hlMenu.style.display='none'; });
hlMenu.querySelectorAll('.hl-swatch').forEach(btn => {
  btn.addEventListener('mousedown', e => { e.preventDefault(); if(!savedRange)return; hlSaveState(); applyHighlight(savedRange,btn.dataset.bg,btn.dataset.text); hlMenu.style.display='none'; window.getSelection().removeAllRanges(); });
});
document.getElementById('hlUndo').addEventListener('mousedown', e => { e.preventDefault(); hlUndo(); hlMenu.style.display='none'; });
document.getElementById('hlRedo').addEventListener('mousedown', e => { e.preventDefault(); hlRedo(); hlMenu.style.display='none'; });
document.getElementById('hlEraseSel').addEventListener('mousedown', e => { e.preventDefault(); if(!savedRange)return; hlSaveState(); removeHighlightInRange(savedRange); hlMenu.style.display='none'; window.getSelection().removeAllRanges(); });
document.getElementById('hlEraseAll').addEventListener('mousedown', e => {
  e.preventDefault();
  if (!confirm('Effacer tous les surlignages de ce module ?')) return;
  hlSaveState();
  const main = document.getElementById('mlMain');
  main.querySelectorAll('mark.hl-mark').forEach(mark => { const p=mark.parentNode; while(mark.firstChild)p.insertBefore(mark.firstChild,mark); p.removeChild(mark); });
  main.normalize();
  hlMenu.style.display = 'none';
});
document.getElementById('hlSaveInline').addEventListener('mousedown', e => {
  e.preventDefault(); hlSave(); hlMenu.style.display='none'; window.getSelection().removeAllRanges();
  const btn = document.getElementById('hlSaveInline');
  btn.textContent = '✅ Sauvegardé !';
  setTimeout(() => { btn.textContent = '💾 Sauvegarder'; }, 1800);
});

function removeHighlightInRange(range) {
  const main = document.getElementById('mlMain');
  main.querySelectorAll('mark.hl-mark').forEach(mark => {
    const markRange = document.createRange();
    markRange.selectNode(mark);
    if (range.compareBoundaryPoints(Range.END_TO_START, markRange) <= 0 && range.compareBoundaryPoints(Range.START_TO_END, markRange) >= 0) {
      const p=mark.parentNode; while(mark.firstChild)p.insertBefore(mark.firstChild,mark); p.removeChild(mark);
    }
  });
  main.normalize();
}

function applyHighlight(range, bg, textColor) {
  const mark = document.createElement('mark');
  mark.className = 'hl-mark';
  mark.style.background = bg;
  mark.style.color = textColor;
  try { range.surroundContents(mark); }
  catch(e) { const frag=range.extractContents(); mark.appendChild(frag); range.insertNode(mark); }
}
</script>


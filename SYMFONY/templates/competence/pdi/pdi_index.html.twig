/* Action type toggle */
.action-type-toggle{display:flex;background:#F3F4F6;border-radius:12px;padding:4px;gap:4px}
.atb{flex:1;padding:9px 12px;border-radius:9px;border:none;background:transparent;font-size:.82rem;font-weight:700;color:var(--g500);cursor:pointer;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:5px}
.atb:hover:not(.active){background:rgba(255,255,255,.6)}
.atb.active{background:white;color:var(--p);box-shadow:0 1px 4px rgba(0,0,0,.1)}

/* Formation picker */
.formation-picker{position:relative}
.formation-dropdown{position:absolute;top:calc(100% + 4px);left:0;right:0;background:white;border:1.5px solid var(--g200);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.12);z-index:200;max-height:220px;overflow-y:auto}
.fdrop-item{display:flex;align-items:center;gap:.6rem;padding:.65rem 1rem;cursor:pointer;font-size:.85rem;color:var(--g900);transition:background .1s}
.fdrop-item:hover{background:#EEF2FF}
.fdrop-icon{font-size:.9rem;flex-shrink:0}
.fdrop-titre{flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.formation-selected-badge{display:flex;align-items:center;gap:.5rem;background:#EEF2FF;border:1.5px solid #C7D2FE;border-radius:9px;padding:.5rem .85rem;margin-top:.5rem;font-size:.82rem;color:#4F46E5}
.fsel-icon{font-size:.9rem}
.fsel-titre{flex:1;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.fsel-remove{background:none;border:none;color:#6366F1;cursor:pointer;font-size:.85rem;padding:0 0 0 .25rem;flex-shrink:0}
.fsel-remove:hover{color:#DC2626}

/* Edit formation hint */
.edit-formation-hint{display:flex;align-items:center;gap:.5rem;background:#EEF2FF;border:1px solid #C7D2FE;border-radius:8px;padding:.45rem .85rem;margin-top:.4rem;font-size:.78rem;color:#4F46E5;flex-wrap:wrap}
.efh-badge{font-weight:700;font-size:.72rem;background:#6366F1;color:white;padding:2px 8px;border-radius:20px}
.efh-unlink{background:none;border:none;color:#DC2626;cursor:pointer;font-size:.75rem;margin-left:auto;font-weight:700}
.efh-unlink:hover{text-decoration:underline}

/* Confirm modal */
.modal-confirm-box{max-width:400px;text-align:center;padding:2rem 1.75rem}
.confirm-icon-wrap{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;background:#FEF2F2}
.confirm-icon-inner{font-size:1.75rem}
.confirm-title{font-size:1.1rem;font-weight:800;color:var(--g900);margin:0 0 .4rem}
.confirm-sub{font-size:.85rem;color:var(--g500);margin:0 0 1.5rem}
.confirm-actions{display:flex;gap:.75rem;justify-content:center}
.btn-confirm-ok{padding:10px 24px;border-radius:10px;background:#DC2626;color:white;font-weight:700;font-size:.9rem;border:none;cursor:pointer;transition:opacity .15s}
.btn-confirm-ok:hover{opacity:.85}

/* Toast */
.pdi-toast{position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;align-items:center;gap:.75rem;padding:.85rem 1.25rem;border-radius:12px;font-size:.87rem;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,.15);animation:toastIn .25s ease;max-width:380px}
.pdi-toast-error{background:#FEF2F2;color:#991B1B;border:1px solid #FECACA}
.pdi-toast-success{background:#D1FAE5;color:#065F46;border:1px solid #6EE7B7}
.pdi-toast button{background:none;border:none;font-size:1rem;cursor:pointer;opacity:.6;color:inherit}
.pdi-toast button:hover{opacity:1}
@keyframes toastIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

@media(max-width:1100px){.pdi-body{grid-template-columns:1fr}.kanban-board{grid-template-columns:1fr}}
@media(max-width:1024px){.pdi-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.pdi-stats{grid-template-columns:1fr}.pdi-header{flex-direction:column}}
</style>
{% endblock %}

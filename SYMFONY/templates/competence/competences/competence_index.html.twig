{% extends 'base.html.twig' %}
{% block title %}Catalogue des compétences – Humania{% endblock %}

{% block body %}
<div class="catalog-wrapper">

  {# ══ HEADER ══════════════════════════════════════════════════════════════ #}
  <div class="cat-header">
    <div>
      <h1 class="catalog-title" id="pageTitle">Catalogue des compétences</h1>
      <p class="catalog-sub" id="pageSubtitle">Gérer les compétences et les compétences</p>
    </div>
    <div class="header-actions">
      {# ── Add Competence Button ── #}
      {% if is_granted('ROLE_ADMIN') %}
        <button class="btn-add" id="btnAddComp" onclick="openNewModal()">＋ Ajouter une compétence</button>
      {% endif %}
      {# ── Toggle Catalogue / Mes Compétences ── #}
      <button class="page-switch-btn" id="btnTogglePage" onclick="togglePageView()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span id="pageToggleLabel">Mes Compétences</span>
      </button>
    </div>
  </div>

  {# ══ FLASH ════════════════════════════════════════════════════════════════ #}
  {% for msg in app.flashes('success') %}<div class="flash-ok">{{ msg }}</div>{% endfor %}
  {% for msg in app.flashes('error')   %}<div class="flash-err">{{ msg }}</div>{% endfor %}

  {# ════════════════════════════════════════════════════════════════════════ #}
  {#  ██████  VUE CATALOGUE                                                  #}
  {# ════════════════════════════════════════════════════════════════════════ #}
  <div id="pageCatalog">

    {# ── Stats Catalogue ── #}
    <div class="stats-grid">
      <div class="stat-card stat-blue">
        <div class="stat-icon">📊</div>
        <div class="stat-body">
          <div class="stat-number">{{ stats.total }}</div>
          <div class="stat-label">Total Compétences</div>
          <div class="stat-link">📋 Référentiel complet</div>
        </div>
      </div>
      <div class="stat-card stat-purple">
        <div class="stat-icon">🏷️</div>
        <div class="stat-body">
          <div class="stat-number">{{ stats.totalCats }}</div>
          <div class="stat-label">Catégories</div>
          <div class="stat-link">🏷️ Domaines de compétence</div>
        </div>
      </div>
      <div class="stat-card stat-orange">
        <div class="stat-icon">🔑</div>
        <div class="stat-body">
          <div class="stat-number" style="color:#DC2626">{{ stats.critiques }}</div>
          <div class="stat-label">Critiques</div>
          <div class="stat-link">🔑 Compétences critiques</div>
        </div>
      </div>
      <div class="stat-card stat-green">
        <div class="stat-icon">⭐</div>
        <div class="stat-body">
          <div class="stat-number">{{ stats.avgMax }}</div>
          <div class="stat-label">Niveau Max Moyen</div>
          <div class="stat-link">⭐ Niveau moyen requis</div>
        </div>
      </div>
    </div>

    {# ── Filtres Catalogue ── #}
    <div class="filters-bar">
      <div class="search-wrap">
        <svg class="search-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="Search competencies…" oninput="filterAndPaginate()" class="search-input">
      </div>
      <div class="filter-select-wrap">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2"><polygon points="22,3 2,3 10,12.46 10,19 14,21 14,12.46"/></svg>
        <select id="catFilter" onchange="filterAndPaginate()" class="filter-select-inner">
          <option value="">All Categories</option>
          {% for cat in categories %}
            <option value="{{ cat.libelle }}">{{ cat.libelle }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="filters-spacer"></div>
      <div class="view-toggle-group">
        <button class="btn-view-toggle" id="btnGrid2" onclick="setView('grid')" title="Vue Grille">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        </button>
        <button class="btn-view-toggle active" id="btnList2" onclick="setView('list')" title="Vue Liste">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
      </div>
    </div>

    {# ── Grid View ── #}
    <div id="gridView" class="competence-grid" style="display:none">
      {% for comp in competences %}
        {% set actif    = comp.statutCompetence == 'ACTIF' %}
        {% set catColor = comp.cat_couleur ?? '#6366F1' %}
        {% set catLib   = comp.cat_libelle ?? '' %}
        <div class="comp-card {{ actif ? '' : 'comp-inactive' }}"
             data-name="{{ comp.libelle|lower }}"
             data-cat="{{ catLib|lower }}"
             data-type="{{ comp.typeCompetence }}"
             data-statut="{{ comp.statutCompetence }}"
             style="--cat-color:{{ catColor }}">
          <div class="card-banner" style="background:linear-gradient(135deg,{{ catColor }}dd,{{ catColor }}88)">
            <div class="card-avatar">{{ comp.libelle|slice(0,2)|upper }}</div>
            <div class="card-badges">
              <span class="badge-type badge-{{ comp.typeCompetence|lower }}">{{ comp.typeCompetence }}</span>
              {% if not actif %}<span class="badge-inactive">⏸ Inactif</span>{% endif %}
            </div>
          </div>
          <div class="card-body-custom">
            <div class="comp-name">{{ comp.libelle }}</div>
            {% if catLib %}
              <span class="cat-pill" style="background:{{ catColor }}18;color:{{ catColor }}">{{ catLib }}</span>
            {% endif %}
            <div class="level-row">
              <span class="level-label">Niveaux :</span>
              {% for i in 1..10 %}
                <span class="level-bar {{ i <= comp.niveauMax ? 'filled' : '' }}"
                      style="{{ i <= comp.niveauMax ? 'background:'~catColor : '' }}"></span>
              {% endfor %}
              <span class="level-text">{{ comp.niveauMax }}/10</span>
            </div>
            <div class="card-actions">
              {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
                <button class="btn-edit"
                        onclick="openEditModal({{ comp.id }}, '{{ comp.libelle|e('html_attr') }}', '{{ comp.typeCompetence }}', {{ comp.niveauMax }}, '{{ comp.cat_id ?? '' }}')">
                  ✏ Modifier
                </button>
                <div style="display:flex;gap:.4rem">
                  <form method="post" action="{{ path('competence_toggle', {id: comp.id}) }}" style="display:inline">
                    <button type="submit" class="{{ actif ? 'btn-deactivate' : 'btn-activate' }}">{{ actif ? '⏸' : '▶' }}</button>
                  </form>
                  <form method="post" action="{{ path('competence_delete', {id: comp.id}) }}" style="display:inline"
                        onsubmit="return confirm('Supprimer « {{ comp.libelle|e('js') }} » ?')">
                    <button type="submit" class="btn-del">🗑</button>
                  </form>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <div class="empty-state">Aucune compétence trouvée.</div>
      {% endfor %}
    </div>

    {# ── List View — groupée par catégorie ── #}
    <div id="listView" class="list-view-wrap">
      {% set grouped = {} %}
      {% for comp in competences %}
        {% set catKey = comp.cat_libelle ?? 'Sans catégorie' %}
        {% if grouped[catKey] is not defined %}{% set grouped = grouped|merge({(catKey): []}) %}{% endif %}
        {% set grouped = grouped|merge({(catKey): grouped[catKey]|merge([comp])}) %}
      {% endfor %}

      {% for catName, items in grouped %}
        {% set catColor = items[0].cat_couleur ?? '#6366F1' %}
        <div class="cat-group" data-cat-group="{{ catName|lower }}">
          <div class="cat-group-header" onclick="toggleGroup(this)" style="--gcolor:{{ catColor }}">
            <div class="cat-group-header-left">
              <svg class="cat-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6,9 12,15 18,9"/></svg>
              <span class="cat-group-name">{{ catName }}</span>
              <span class="cat-group-count">{{ items|length }} compétence{{ items|length > 1 ? 's' : '' }}</span>
            </div>
          </div>
          <div class="cat-group-body">
            {% for comp in items %}
              {% set actif     = comp.statutCompetence == 'ACTIF' %}
              {% set compColor = comp.cat_couleur ?? '#6366F1' %}
              <div class="list-row {{ actif ? '' : 'row-inactive' }}"
                   data-name="{{ comp.libelle|lower }}"
                   data-cat="{{ catName|lower }}"
                   data-type="{{ comp.typeCompetence }}"
                   data-statut="{{ comp.statutCompetence }}"
                   style="--rcolor:{{ compColor }}">
                <div class="row-avatar" style="background:{{ compColor }}22;color:{{ compColor }}">{{ comp.libelle|slice(0,2)|upper }}</div>
                <div class="row-info">
                  <div class="row-name">{{ comp.libelle }}</div>
                  <div class="row-meta">Niveaux 1–{{ comp.niveauMax }} · {{ comp.typeCompetence }}</div>
                </div>
                <span class="badge-type badge-{{ comp.typeCompetence|lower }}">{{ comp.typeCompetence }}</span>
                <span class="badge-statut {{ actif ? 'badge-actif' : 'badge-inactif' }}">{{ actif ? '● Actif' : '⏸ Inactif' }}</span>
                <div class="row-actions">
                  {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
                    <button class="row-btn row-btn-edit"
                            onclick="openEditModal({{ comp.id }}, '{{ comp.libelle|e('html_attr') }}', '{{ comp.typeCompetence }}', {{ comp.niveauMax }}, '{{ comp.cat_id ?? '' }}')"
                            title="Modifier">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </button>
                    <form method="post" action="{{ path('competence_toggle', {id: comp.id}) }}" style="display:inline">
                      <button type="submit" class="row-btn {{ actif ? 'row-btn-deactivate' : 'row-btn-activate' }}" title="{{ actif ? 'Désactiver' : 'Activer' }}">
                        {% if actif %}
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
                        {% else %}
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
                        {% endif %}
                      </button>
                    </form>
                    <form method="post" action="{{ path('competence_delete', {id: comp.id}) }}" style="display:inline"
                          onsubmit="return confirm('Supprimer « {{ comp.libelle|e('js') }} » ?')">
                      <button type="submit" class="row-btn row-btn-delete" title="Supprimer">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                      </button>
                    </form>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
      <div class="empty-list-state" id="emptyList" style="display:none">
        <div style="font-size:2rem;margin-bottom:.5rem">🔍</div>
        <p>Aucune compétence ne correspond à votre recherche.</p>
      </div>
    </div>

    {# ── Pagination ── #}
    <div id="paginationBar" class="comp-pag-bar" style="display:none">
      <div class="comp-pag-info" id="pagInfo"></div>
      <div class="comp-pag-controls" id="pagControls"></div>
      <div class="comp-pag-hint" id="pagHint"></div>
    </div>
  </div>{# /pageCatalog #}

  {# ════════════════════════════════════════════════════════════════════════ #}
  {#  ██████  VUE MES COMPÉTENCES                                            #}
  {# ════════════════════════════════════════════════════════════════════════ #}
  <div id="pageMes" style="display:none">

    {# ── Stats Mes Compétences ── #}
    <div class="stats-grid">
      <div class="stat-card stat-blue">
        <div class="stat-icon">🏆</div>
        <div class="stat-body">
          <div class="stat-number" id="statMaitrises">{{ myStats.maitrises }}</div>
          <div class="stat-label">Maîtrisées</div>
          <div class="stat-link">🏅 Compétences maîtrisées</div>
        </div>
      </div>
      <div class="stat-card stat-purple">
        <div class="stat-icon">⚡</div>
        <div class="stat-body">
          <div class="stat-number" id="statInProgress">{{ myStats.inProgress }}</div>
          <div class="stat-label">En progression</div>
          <div class="stat-link">⚡ Niveau atteint ≥ max</div>
        </div>
      </div>
      <div class="stat-card stat-orange">
        <div class="stat-icon">⚠️</div>
        <div class="stat-body">
          <div class="stat-number" id="statGaps" style="color:#DC2626">{{ myStats.gaps }}</div>
          <div class="stat-label">Gaps</div>
          <div class="stat-link">⚠ Niveau &lt; 60% requis</div>
        </div>
      </div>
      <div class="stat-card stat-green">
        <div class="stat-icon">📈</div>
        <div class="stat-body">
          <div class="stat-number" id="statScore">{{ myStats.score }}%</div>
          <div class="stat-label">Score global</div>
          <div class="stat-link">📊 Progression globale</div>
        </div>
      </div>
    </div>

    {# ── Filtres Mes Compétences ── #}
    <div class="filters-bar">
      <div class="search-wrap">
        <svg class="search-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="mySearchInput" placeholder="Search competencies…" oninput="filterMySkills()" class="search-input">
      </div>
      <div class="filter-select-wrap">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2"><polygon points="22,3 2,3 10,12.46 10,19 14,21 14,12.46"/></svg>
        <select id="myCatFilter" onchange="filterMySkills()" class="filter-select-inner">
          <option value="">All Categories</option>
          {% for cat in categories %}
            <option value="{{ cat.libelle }}">{{ cat.libelle }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="filters-spacer"></div>
      {# Tabs: Mes niveaux / Toutes #}
      <div class="my-tabs">
        <button class="my-tab active" id="tabMesNiveaux" onclick="setMyTab('mes')">
          Mes niveaux <span class="my-tab-count" id="countMes">{{ myStats.inProgress }}</span>
        </button>
        <button class="my-tab" id="tabToutes" onclick="setMyTab('toutes')">
          Toutes <span class="my-tab-count" id="countToutes">{{ myStats.total }}</span>
        </button>
      </div>
      <button class="btn-evaluer" onclick="openDeclareModal(null)">＋ Évaluer une compétence</button>
    </div>

    {# ── Cards Mes Compétences — groupées par catégorie ── #}
    <div id="mySkillsGrid">
      {% set myGrouped = {} %}
      {% for skill in mySkills %}
        {% set catKey = skill.cat_libelle ?? 'Sans catégorie' %}
        {% if myGrouped[catKey] is not defined %}{% set myGrouped = myGrouped|merge({(catKey): []}) %}{% endif %}
        {% set myGrouped = myGrouped|merge({(catKey): myGrouped[catKey]|merge([skill])}) %}
      {% endfor %}

      {% for catName, items in myGrouped %}
        {% set catColor = items[0].cat_couleur ?? '#6366F1' %}
        <div class="my-cat-section" data-cat="{{ catName }}">
          <div class="my-cat-label" style="--gcolor:{{ catColor }}">{{ catName|upper }}</div>
          <div class="my-skills-row">
            {% for skill in items %}
              {% set niveau    = skill.niveauActuel ?? 0 %}
              {% set niveauMax = skill.niveauMax %}
              {% set pct       = niveauMax > 0 ? (niveau / niveauMax * 100)|round : 0 %}
              {% set isGap     = niveau > 0 and niveau < (niveauMax * 0.6)|round %}
              {% set isMaitris = niveau >= niveauMax %}
              {% set notEval   = niveau == 0 or skill.niveauActuel is null %}
              <div class="my-skill-card"
                   data-name="{{ skill.libelle|lower }}"
                   data-cat="{{ catName }}"
                   data-gap="{{ isGap ? '1' : '0' }}"
                   data-eval="{{ notEval ? '0' : '1' }}"
                   data-competence-id="{{ skill.id }}"
                   data-niveau="{{ niveau }}"
                   data-niveau-max="{{ niveauMax }}"
                   data-libelle="{{ skill.libelle|e('html_attr') }}"
                   data-color="{{ catColor }}"
                   style="--scolor:{{ catColor }}">
                <div class="msk-header">
                  <div class="msk-avatar" style="background:{{ catColor }}22;color:{{ catColor }}">{{ skill.libelle|slice(0,2)|upper }}</div>
                  <div class="msk-info">
                    <div class="msk-name">{{ skill.libelle }}</div>
                    <div class="msk-cat">{{ catName }}</div>
                  </div>
                  {% if isGap %}
                    {% set gapSeverity = pct < 30 ? 'severe' : 'moderate' %}
                    <span class="msk-gap-badge gap-{{ gapSeverity }}">Gap {{ gapSeverity == 'severe' ? 'sévère' : 'modéré' }}</span>
                  {% elseif isMaitris %}
                    <span class="msk-gap-badge gap-ok">✓ Maîtrisé</span>
                  {% elseif not notEval %}
                    <span class="msk-gap-badge gap-progress">En cours</span>
                  {% else %}
                    <span class="msk-gap-badge gap-none">Non évalué</span>
                  {% endif %}
                </div>

                {% if not notEval %}
                  <div class="msk-level-bar">
                    <div class="msk-level-fill {{ isGap ? (pct < 30 ? 'fill-red' : 'fill-orange') : (isMaitris ? 'fill-green' : 'fill-blue') }}"
                         style="width:{{ pct }}%"></div>
                  </div>
                  <div class="msk-level-info">
                    <span>{{ niveau }}/{{ niveauMax }}</span>
                    <span>{{ pct }}%</span>
                  </div>
                {% endif %}

                <button class="msk-btn-declare" onclick="openDeclareModal(this.closest('.my-skill-card'))">
                  {% if notEval %}＋ Déclarer mon niveau{% else %}✏ Modifier mon niveau{% endif %}
                </button>
              </div>
            {% endfor %}
          </div>
        </div>
      {% endfor %}

      <div class="empty-state" id="myEmptyState" style="display:none;grid-column:1/-1">
        <div style="font-size:2rem;margin-bottom:.5rem">🔍</div>
        <p>Aucune compétence ne correspond à votre recherche.</p>
      </div>
    </div>

  </div>{# /pageMes #}

</div>{# /catalog-wrapper #}

{# ══ MODAL — Nouvelle compétence ══════════════════════════════════════════ #}
{% if is_granted('ROLE_ADMIN') %}
  <div id="modalNew" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeNewModal()">
    <div class="modal-box">
      <div class="modal-head">
        <h3 class="modal-title">➕ Nouvelle Compétence</h3>
        <button class="modal-close" onclick="closeNewModal()">✕</button>
      </div>
      <form method="post" action="{{ path('competence_new') }}" class="modal-form" onsubmit="return validateForm(this)" novalidate>
        <div class="mf-group">
          <label class="mf-lbl">Libellé <span class="req">*</span></label>
          <input type="text" name="libelle" class="mf-input" required placeholder="ex: JavaScript, Leadership…" oninput="validateField(this)">
          <span class="error-msg" style="display:none"></span>
        </div>
        <div class="mf-row">
          <div class="mf-group">
            <label class="mf-lbl">Type</label>
            <select name="typeCompetence" class="mf-input">
              <option value="CRITIQUE">🔑 CRITIQUE</option>
              <option value="IMPORTANTE" selected>⭐ IMPORTANTE</option>
              <option value="SOUHAITEE">✅ SOUHAITEE</option>
              <option value="OPTIONNELLE">○ OPTIONNELLE</option>
            </select>
          </div>
          <div class="mf-group">
            <label class="mf-lbl">Niveau Max (1-10) <span class="req">*</span></label>
            <input type="number" name="niveauMax" class="mf-input" min="1" max="10" value="5" required oninput="validateField(this)">
            <span class="error-msg" style="display:none"></span>
          </div>
        </div>
        <div class="mf-group">
          <label class="mf-lbl">Catégorie</label>
          <select name="categorie_id" class="mf-input">
            <option value="">— Aucune —</option>
            {% for cat in categories %}
              <option value="{{ cat.id }}">{{ cat.libelle }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn-cancel" onclick="closeNewModal()">Annuler</button>
          <button type="submit" class="btn-save">✅ Enregistrer</button>
        </div>
      </form>
    </div>
  </div>
{% endif %}

{# ══ MODAL — Modifier compétence ══════════════════════════════════════════ #}
<div id="modalEdit" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeEditModal()">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">✏ Modifier la Compétence</h3>
      <button class="modal-close" onclick="closeEditModal()">✕</button>
    </div>
    <form method="post" id="formEdit" action="" class="modal-form" onsubmit="return validateForm(this)" novalidate>
      <div class="mf-group">
        <label class="mf-lbl">Libellé <span class="req">*</span></label>
        <input type="text" name="libelle" id="edit_libelle" class="mf-input" required oninput="validateField(this)">
        <span class="error-msg" style="display:none"></span>
      </div>
      <div class="mf-row">
        <div class="mf-group">
          <label class="mf-lbl">Type</label>
          <select name="typeCompetence" id="edit_type" class="mf-input">
            <option value="CRITIQUE">🔑 CRITIQUE</option>
            <option value="IMPORTANTE">⭐ IMPORTANTE</option>
            <option value="SOUHAITEE">✅ SOUHAITEE</option>
            <option value="OPTIONNELLE">○ OPTIONNELLE</option>
          </select>
        </div>
        <div class="mf-group">
          <label class="mf-lbl">Niveau Max (1-10) <span class="req">*</span></label>
          <input type="number" name="niveauMax" id="edit_niveau" class="mf-input" min="1" max="10" required oninput="validateField(this)">
          <span class="error-msg" style="display:none"></span>
        </div>
      </div>
      <div class="mf-group">
        <label class="mf-lbl">Catégorie</label>
        <select name="categorie_id" id="edit_cat" class="mf-input">
          <option value="">— Aucune —</option>
          {% for cat in categories %}
            <option value="{{ cat.id }}">{{ cat.libelle }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeEditModal()">Annuler</button>
        <button type="submit" class="btn-save">💾 Mettre à jour</button>
      </div>
    </form>
  </div>
</div>

{# ══ MODAL — Déclarer mon niveau ══════════════════════════════════════════ #}
<div id="modalDeclare" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeDeclareModal()">
  <div class="modal-box" style="max-width:440px">
    <div class="modal-head">
      <div style="display:flex;align-items:center;gap:.75rem">
        <div class="msk-avatar" id="declareAvatar" style="background:#6366F122;color:#6366F1;width:42px;height:42px;font-size:.95rem">??</div>
        <div>
          <h3 class="modal-title" id="declareTitle" style="margin:0">Mon niveau</h3>
          <div style="font-size:.75rem;color:#6B7280;margin-top:2px" id="declareSubtitle">Behavioral · Niveau max 5</div>
        </div>
      </div>
      <button class="modal-close" onclick="closeDeclareModal()">✕</button>
    </div>
    <div class="modal-form">
      {# ── Competence Selector (shown only when evaluating a new competence) ── #}
      <div class="mf-group" id="declareCompSelector" style="display:none">
        <label class="mf-lbl">Sélectionnez une compétence</label>
        <select id="declareCompSelect" onchange="onCompetenceSelected()" class="mf-input" style="cursor:pointer">
          <option value="">-- Choisir une compétence --</option>
        </select>
      </div>
      <div class="mf-group">
        <label class="mf-lbl">Mon niveau actuel</label>
        <div class="declare-slider-wrap">
          <input type="range" id="declareSlider" min="0" max="10" value="0"
                 oninput="updateDeclareSlider()" class="declare-slider">
          <div style="display:flex;justify-content:space-between;font-size:.72rem;color:#9CA3AF;margin-top:2px">
            <span>0</span><span id="declareSliderMax">10</span>
          </div>
        </div>
        <div class="declare-level-display">
          <span id="declareLevelVal" style="font-size:1.5rem;font-weight:800;color:#4F46E5">0</span>
          <span id="declareLevelLabel" class="declare-level-label declare-label-none">Non évalué</span>
        </div>
      </div>
      <input type="hidden" id="declareCompetenceId" value="">
      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeDeclareModal()">Annuler</button>
        <button type="button" class="btn-save" id="declareSaveBtn" onclick="saveLevel()">
          <span id="declareSaveTxt">✔ Enregistrer</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// ══════════════════════════════════════════════════════════════════════════
//  STATE
// ══════════════════════════════════════════════════════════════════════════
let currentView   = 'grid';
let currentPage   = 1;
let currentMyTab  = 'mes';
const PER_PAGE    = 15;

// ──  All competences from catalog for selector ──
const allCompetences = [
  {% for comp in competences %}
  { id: {{ comp.id }}, libelle: '{{ comp.libelle|e('js') }}', niveauMax: {{ comp.niveauMax }}, cat_couleur: '{{ comp.cat_couleur ?? '#6366F1' }}', typeCompetence: '{{ comp.typeCompetence }}' }{{ not loop.last ? ',' : '' }}
  {% endfor %}
];

// ══════════════════════════════════════════════════════════════════════════
//  TOGGLE PAGE : Catalogue ↔ Mes Compétences
// ══════════════════════════════════════════════════════════════════════════
let currentPage2 = 'catalog'; // Track current page state

function togglePageView() {
  const isCatalog = currentPage2 === 'catalog';
  currentPage2 = isCatalog ? 'mes' : 'catalog';
  
  const btnToggle = document.getElementById('btnTogglePage');
  btnToggle.classList.toggle('active', currentPage2 === 'mes');
  
  document.getElementById('pageCatalog').style.display = isCatalog ? 'none' : 'block';
  document.getElementById('pageMes').style.display     = isCatalog ? 'block' : 'none';
  const addCompBtn = document.getElementById('btnAddComp');
  if (addCompBtn) {
    addCompBtn.style.display = isCatalog ? 'none' : '';
  }
  document.getElementById('pageToggleLabel').textContent = isCatalog ? 'Catalogue' : 'Mes Compétences';
  document.getElementById('pageTitle').textContent     = isCatalog ? 'Mes Compétences' : 'Competency Catalog';
  document.getElementById('pageSubtitle').textContent  = isCatalog ? 'Gérez et déclarez vos niveaux de compétences' : 'Manage skills and competencies';
  
  if (isCatalog) { 
    currentMyTab = 'mes'; 
    setMyTab('mes'); 
  }
}

// ══════════════════════════════════════════════════════════════════════════
//  TOGGLE CATÉGORIE (collapse/expand) — vue liste catalogue
// ══════════════════════════════════════════════════════════════════════════
function toggleGroup(headerEl) {
  const body    = headerEl.nextElementSibling;
  const chevron = headerEl.querySelector('.cat-chevron');
  const open    = body.style.display !== 'none';
  body.style.display      = open ? 'none' : 'block';
  chevron.style.transform = open ? 'rotate(-90deg)' : 'rotate(0deg)';
}

// ══════════════════════════════════════════════════════════════════════════
//  VUE GRILLE / LISTE (catalogue)
// ══════════════════════════════════════════════════════════════════════════
function setView(view) {
  currentView = view;
  const isGrid = view === 'grid';
  document.getElementById('gridView').style.display  = isGrid ? 'grid' : 'none';
  document.getElementById('listView').style.display  = isGrid ? 'none'  : 'block';
  document.getElementById('btnGrid2').classList.toggle('active', isGrid);
  document.getElementById('btnList2').classList.toggle('active', !isGrid);
  currentPage = 1;
  filterAndPaginate();
}

// ══════════════════════════════════════════════════════════════════════════
//  FILTRE + PAGINATION (catalogue)
// ══════════════════════════════════════════════════════════════════════════
function filterAndPaginate() {
  const q      = document.getElementById('searchInput').value.toLowerCase().trim();
  const cat    = document.getElementById('catFilter').value.toLowerCase();
  const isGrid = currentView === 'grid';

  if (isGrid) {
    const cards   = Array.from(document.querySelectorAll('.comp-card'));
    const visible = cards.filter(el => {
      const ok = (!q || el.dataset.name.includes(q)) && (!cat || el.dataset.cat.includes(cat));
      el.style.display = ok ? '' : 'none';
      return ok;
    });
    const total      = visible.length;
    const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
    currentPage      = Math.min(currentPage, totalPages);
    const start      = (currentPage - 1) * PER_PAGE;
    visible.forEach((el, i) => { el.style.display = (i >= start && i < start + PER_PAGE) ? '' : 'none'; });
    const emptyEl = document.querySelector('.empty-state');
    if (emptyEl) emptyEl.style.display = total === 0 ? '' : 'none';
    renderPagination(currentPage, totalPages, total, start + 1, Math.min(start + PER_PAGE, total));
    return;
  }

  const groups = Array.from(document.querySelectorAll('.cat-group'));
  let totalVisible = 0, allRows = [];
  groups.forEach(group => {
    const groupCat = group.dataset.catGroup || '';
    const catMatch = !cat || groupCat.includes(cat);
    const rows = Array.from(group.querySelectorAll('.list-row'));
    let groupHasVisible = false;
    rows.forEach(row => {
      const ok = (!q || row.dataset.name.includes(q)) && catMatch;
      row.style.display = ok ? '' : 'none';
      if (ok) { groupHasVisible = true; allRows.push(row); totalVisible++; }
    });
    group.style.display = groupHasVisible ? '' : 'none';
    if (groupHasVisible && (q || cat)) {
      const body    = group.querySelector('.cat-group-body');
      const chevron = group.querySelector('.cat-chevron');
      if (body)    body.style.display     = 'block';
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    }
  });
  const totalPages = Math.max(1, Math.ceil(totalVisible / PER_PAGE));
  currentPage      = Math.min(currentPage, totalPages);
  const start      = (currentPage - 1) * PER_PAGE;
  allRows.forEach((row, i) => { row.style.display = (i >= start && i < start + PER_PAGE) ? '' : 'none'; });
  groups.forEach(group => {
    if (group.style.display === 'none') return;
    const anyVisible = Array.from(group.querySelectorAll('.list-row')).some(r => r.style.display !== 'none');
    group.style.display = anyVisible ? '' : 'none';
  });
  const emptyEl = document.getElementById('emptyList');
  if (emptyEl) emptyEl.style.display = totalVisible === 0 ? 'flex' : 'none';
  renderPagination(currentPage, totalPages, totalVisible, start + 1, Math.min(start + PER_PAGE, totalVisible));
}

function renderPagination(page, totalPages, total, from, to) {
  const bar    = document.getElementById('paginationBar');
  const infoEl = document.getElementById('pagInfo');
  const ctrlEl = document.getElementById('pagControls');
  const hintEl = document.getElementById('pagHint');
  if (totalPages <= 1) { bar.style.display = 'none'; return; }
  bar.style.display = 'flex';
  infoEl.innerHTML  = `Affichage <strong>${Math.min(from, total)}–${to}</strong> sur <strong>${total}</strong> compétences`;
  hintEl.textContent = `Page ${page} / ${totalPages}`;
  const arrow = (dir, p, disabled) => `
    <${disabled ? 'span' : 'button'} class="cpag-btn cpag-arrow ${disabled ? 'cpag-disabled' : ''}"
      ${disabled ? '' : `onclick="goPage(${p})"`}>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="${dir === 'prev' ? '15,18 9,12 15,6' : '9,18 15,12 9,6'}"/>
      </svg>
    </${disabled ? 'span' : 'button'}>`;
  const winStart = Math.max(1, page - 2), winEnd = Math.min(totalPages, page + 2);
  let pages = '';
  if (winStart > 1) { pages += `<button class="cpag-btn" onclick="goPage(1)">1</button>`; if (winStart > 2) pages += `<span class="cpag-ellipsis">…</span>`; }
  for (let p = winStart; p <= winEnd; p++) pages += `<button class="cpag-btn ${p === page ? 'cpag-active' : ''}" onclick="goPage(${p})">${p}</button>`;
  if (winEnd < totalPages) { if (winEnd < totalPages - 1) pages += `<span class="cpag-ellipsis">…</span>`; pages += `<button class="cpag-btn" onclick="goPage(${totalPages})">${totalPages}</button>`; }
  ctrlEl.innerHTML = arrow('prev', page - 1, page <= 1) + pages + arrow('next', page + 1, page >= totalPages);
}
function goPage(p) {
  currentPage = p;
  filterAndPaginate();
  document.querySelector('.list-view-wrap, .competence-grid').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ══════════════════════════════════════════════════════════════════════════
//  FILTRE MES COMPÉTENCES
// ══════════════════════════════════════════════════════════════════════════
function setMyTab(tab) {
  currentMyTab = tab;
  document.getElementById('tabMesNiveaux').classList.toggle('active', tab === 'mes');
  document.getElementById('tabToutes').classList.toggle('active',     tab === 'toutes');
  filterMySkills();
}

function filterMySkills() {
  const q   = document.getElementById('mySearchInput').value.toLowerCase().trim();
  const cat = document.getElementById('myCatFilter').value;
  const tab = currentMyTab;

  const cards = Array.from(document.querySelectorAll('.my-skill-card'));
  let visibleCount = 0;

  // Show/hide sections based on cat filter
  document.querySelectorAll('.my-cat-section').forEach(sec => {
    const secCat = sec.dataset.cat;
    sec.style.display = (!cat || secCat === cat) ? '' : 'none';
  });

  cards.forEach(card => {
    const nameMatch = !q || card.dataset.name.includes(q);
    const catMatch  = !cat || card.dataset.cat === cat;
    let tabMatch = true;
    if (tab === 'mes')   tabMatch = card.dataset.eval === '1';  // toutes les évaluées
    if (tab === 'toutes') tabMatch = true;  // tout afficher
    const visible = nameMatch && catMatch && tabMatch;
    card.style.display = visible ? '' : 'none';
    if (visible) visibleCount++;
  });

  // Hide empty sections
  document.querySelectorAll('.my-cat-section').forEach(sec => {
    const anyVisible = Array.from(sec.querySelectorAll('.my-skill-card')).some(c => c.style.display !== 'none');
    if (!anyVisible) sec.style.display = 'none';
  });

  document.getElementById('myEmptyState').style.display = visibleCount === 0 ? 'block' : 'none';
}

// ══════════════════════════════════════════════════════════════════════════
//  MODAL DÉCLARER MON NIVEAU
// ══════════════════════════════════════════════════════════════════════════
function openDeclareModal(cardEl) {
  const modal = document.getElementById('modalDeclare');

  if (cardEl) {
    const id       = cardEl.dataset.competenceId;
    const libelle  = cardEl.dataset.libelle;
    const niveau   = parseInt(cardEl.dataset.niveau) || 0;
    const niveauMax = parseInt(cardEl.dataset.niveauMax) || 10;
    const color    = cardEl.dataset.color || '#6366F1';
    const cat      = cardEl.dataset.cat || '';

    document.getElementById('declareCompetenceId').value = id;
    document.getElementById('declareTitle').textContent  = 'Mon niveau — ' + libelle;
    document.getElementById('declareSubtitle').textContent = cat + ' · Niveau max ' + niveauMax;
    document.getElementById('declareAvatar').textContent = libelle.slice(0,2).toUpperCase();
    document.getElementById('declareAvatar').style.background = color + '22';
    document.getElementById('declareAvatar').style.color      = color;
    document.getElementById('declareSlider').max   = niveauMax;
    document.getElementById('declareSlider').value = niveau;
    document.getElementById('declareSliderMax').textContent = niveauMax;
    document.getElementById('declareCompSelector').style.display = 'none';
  } else {
    // Ouvert depuis "Évaluer une compétence" sans carte spécifique
    document.getElementById('declareCompetenceId').value = '';
    document.getElementById('declareTitle').textContent  = 'Évaluer une compétence';
    document.getElementById('declareSubtitle').textContent = 'Sélectionnez une compétence';
    document.getElementById('declareAvatar').textContent = '?';
    document.getElementById('declareSlider').max   = 10;
    document.getElementById('declareSlider').value = 0;
    document.getElementById('declareCompSelector').style.display = 'block';
    
    // Populate selector with all competences
    const selector = document.getElementById('declareCompSelect');
    selector.innerHTML = '<option value="">-- Choisir une compétence --</option>';
    allCompetences.forEach(comp => {
      const opt = document.createElement('option');
      opt.value = comp.id;
      opt.textContent = comp.libelle + ' (max: ' + comp.niveauMax + ')';
      selector.appendChild(opt);
    });
  }
  updateDeclareSlider();
  modal.style.display = 'flex';
}

function onCompetenceSelected() {
  const selector = document.getElementById('declareCompSelect');
  const compId = selector.value;
  
  if (!compId) {
    document.getElementById('declareCompetenceId').value = '';
    document.getElementById('declareTitle').textContent = 'Évaluer une compétence';
    document.getElementById('declareSubtitle').textContent = 'Sélectionnez une compétence';
    document.getElementById('declareAvatar').textContent = '?';
    document.getElementById('declareSlider').max = 10;
    document.getElementById('declareSlider').value = 0;
    updateDeclareSlider();
    return;
  }
  
  const comp = allCompetences.find(c => c.id == compId);
  if (!comp) return;
  
  document.getElementById('declareCompetenceId').value = comp.id;
  document.getElementById('declareTitle').textContent = 'Mon niveau — ' + comp.libelle;
  document.getElementById('declareSubtitle').textContent = comp.typeCompetence + ' · Niveau max ' + comp.niveauMax;
  document.getElementById('declareAvatar').textContent = comp.libelle.slice(0,2).toUpperCase();
  document.getElementById('declareAvatar').style.background = comp.cat_couleur + '22';
  document.getElementById('declareAvatar').style.color = comp.cat_couleur;
  document.getElementById('declareSlider').max = comp.niveauMax;
  document.getElementById('declareSlider').value = 0;
  document.getElementById('declareSliderMax').textContent = comp.niveauMax;
  
  updateDeclareSlider();
}

function closeDeclareModal() { document.getElementById('modalDeclare').style.display = 'none'; }

function updateDeclareSlider() {
  const slider = document.getElementById('declareSlider');
  const val    = parseInt(slider.value);
  const max    = parseInt(slider.max);
  document.getElementById('declareLevelVal').textContent = val;
  const lbl = document.getElementById('declareLevelLabel');
  lbl.className = 'declare-level-label';
  if (val === 0)             { lbl.textContent = 'Non évalué';   lbl.classList.add('declare-label-none'); }
  else if (val >= max)       { lbl.textContent = 'Maîtrisé ✓';  lbl.classList.add('declare-label-ok'); }
  else if (val < max * 0.6)  { lbl.textContent = 'Gap détecté ⚠'; lbl.classList.add('declare-label-gap'); }
  else                       { lbl.textContent = 'En progression'; lbl.classList.add('declare-label-progress'); }
  // Couleur du slider
  const pct = max > 0 ? val / max * 100 : 0;
  const color = val === 0 ? '#D1D5DB' : val < max * 0.6 ? '#EF4444' : val >= max ? '#10B981' : '#6366F1';
  slider.style.setProperty('--slider-color', color);
  slider.style.setProperty('--slider-pct', pct + '%');
}

async function saveLevel() {
  const id      = document.getElementById('declareCompetenceId').value;
  const niveau  = document.getElementById('declareSlider').value;
  const btn     = document.getElementById('declareSaveBtn');
  const txt     = document.getElementById('declareSaveTxt');

  if (!id) { alert('Veuillez sélectionner une compétence.'); return; }

  btn.disabled = true;
  txt.textContent = '⏳ Enregistrement…';

  try {
    const fd = new FormData();
    fd.append('niveau', niveau);

    const res  = await fetch(`/competence/${id}/declare-level`, { method: 'POST', body: fd });
    const data = await res.json();

    if (data.ok) {
      closeDeclareModal();
      updateCardUI(id, data.niveau, data.niveauMax, data.isGap, data.deleted);
      refreshMyStats();
    } else {
      alert('Erreur : ' + (data.error || 'Inconnu'));
    }
  } catch(e) {
    alert('Erreur réseau.');
  } finally {
    btn.disabled = false;
    txt.textContent = '✔ Enregistrer';
  }
}

function updateCardUI(competenceId, niveau, niveauMax, isGap, deleted) {
  const card = document.querySelector(`.my-skill-card[data-competence-id="${competenceId}"]`);
  if (!card) return;

  card.dataset.niveau = niveau;
  card.dataset.gap    = isGap ? '1' : '0';
  card.dataset.eval   = (deleted || niveau === 0) ? '0' : '1';

  const pct        = niveauMax > 0 ? Math.round(niveau / niveauMax * 100) : 0;
  const isMaitris  = niveau >= niveauMax;
  const notEval    = deleted || niveau === 0;
  const color      = card.dataset.color || '#6366F1';

  // Badge
  const badgeEl = card.querySelector('.msk-gap-badge');
  if (badgeEl) {
    badgeEl.className = 'msk-gap-badge';
    if (notEval)      { badgeEl.classList.add('gap-none');     badgeEl.textContent = 'Non évalué'; }
    else if (isGap)   { badgeEl.classList.add(pct < 30 ? 'gap-severe' : 'gap-moderate'); badgeEl.textContent = pct < 30 ? 'Gap sévère' : 'Gap modéré'; }
    else if (isMaitris){ badgeEl.classList.add('gap-ok');      badgeEl.textContent = '✓ Maîtrisé'; }
    else              { badgeEl.classList.add('gap-progress'); badgeEl.textContent = 'En cours'; }
  }

  // Progress bar
  let barWrap = card.querySelector('.msk-level-bar');
  let levelInfo = card.querySelector('.msk-level-info');

  if (notEval) {
    if (barWrap)    barWrap.remove();
    if (levelInfo)  levelInfo.remove();
  } else {
    if (!barWrap) {
      barWrap = document.createElement('div');
      barWrap.className = 'msk-level-bar';
      const fill = document.createElement('div');
      fill.className = 'msk-level-fill';
      barWrap.appendChild(fill);
      card.querySelector('.msk-btn-declare').before(barWrap);
    }
    if (!levelInfo) {
      levelInfo = document.createElement('div');
      levelInfo.className = 'msk-level-info';
      barWrap.after(levelInfo);
    }
    const fillEl = barWrap.querySelector('.msk-level-fill');
    fillEl.className = 'msk-level-fill ' + (isGap ? (pct < 30 ? 'fill-red' : 'fill-orange') : (isMaitris ? 'fill-green' : 'fill-blue'));
    fillEl.style.width = pct + '%';
    levelInfo.innerHTML = `<span>${niveau}/${niveauMax}</span><span>${pct}%</span>`;
  }

  // Bouton
  const declareBtn = card.querySelector('.msk-btn-declare');
  if (declareBtn) declareBtn.textContent = notEval ? '＋ Déclarer mon niveau' : '✏ Modifier mon niveau';

  // Re-filtrer
  filterMySkills();
}

function refreshMyStats() {
  // Recalcul côté client
  const cards     = Array.from(document.querySelectorAll('.my-skill-card'));
  const total     = cards.length;
  const evaluated = cards.filter(c => c.dataset.eval === '1').length;
  const maitrises = cards.filter(c => {
    const n = parseInt(c.dataset.niveau), m = parseInt(c.dataset.niveauMax);
    return n > 0 && n >= m;
  }).length;
  const inProgress = cards.filter(c => c.dataset.eval === '1' && parseInt(c.dataset.niveau) < parseInt(c.dataset.niveauMax)).length;
  const scoreSum  = cards.reduce((acc, c) => {
    const n = parseInt(c.dataset.niveau), m = parseInt(c.dataset.niveauMax);
    return acc + (n > 0 && m > 0 ? n / m * 100 : 0);
  }, 0);
  const score = total > 0 ? Math.round(scoreSum / total) : 0;

  document.getElementById('statMaitrises').textContent  = maitrises;
  document.getElementById('statInProgress').textContent = inProgress;
  document.getElementById('statScore').textContent      = score + '%';
  document.getElementById('countMes').textContent       = inProgress;
  document.getElementById('countToutes').textContent    = total;
}

// ── Modals Catalogue ───────────────────────────────────────────────────────
function openNewModal()  { document.getElementById('modalNew').style.display = 'flex'; }
function closeNewModal() { document.getElementById('modalNew').style.display = 'none'; }
function openEditModal(id, libelle, type, niveauMax, catId) {
  document.getElementById('edit_libelle').value = libelle;
  document.getElementById('edit_type').value    = type;
  document.getElementById('edit_niveau').value  = niveauMax;
  document.getElementById('edit_cat').value     = catId || '';
  document.getElementById('formEdit').action    = `/competence/${id}/edit`;
  document.getElementById('modalEdit').style.display = 'flex';
}
function closeEditModal() { document.getElementById('modalEdit').style.display = 'none'; }

// ── Validation ──────────────────────────────────────────────────────────────
function validateField(input) {
  const errEl = input.parentElement.querySelector('.error-msg');
  let ok = true, msg = '';
  if (input.type === 'text') {
    if (!input.value.trim()) { ok = false; msg = 'Ce champ est requis'; }
    else if (input.value.trim().length < 2) { ok = false; msg = 'Minimum 2 caractères'; }
  } else if (input.type === 'number') {
    const v = parseInt(input.value);
    if (!input.value) { ok = false; msg = 'Ce champ est requis'; }
    else if (v < parseInt(input.min||1)) { ok = false; msg = `Min: ${input.min}`; }
    else if (v > parseInt(input.max||10)) { ok = false; msg = `Max: ${input.max}`; }
  }
  input.classList.toggle('mf-input-error', !ok);
  if (errEl) { errEl.textContent = msg; errEl.style.display = ok ? 'none' : 'block'; }
  return ok;
}
function validateForm(form) {
  let all = true;
  form.querySelectorAll('input[required]').forEach(i => { if (!validateField(i)) all = false; });
  return all;
}

// Init
document.addEventListener('DOMContentLoaded', () => {
  setView('grid');
  currentMyTab = 'mes';
  filterMySkills();
});
</script>


</style>

{# ══ MACRO PAGINATION CUSTOM ═════════════════════════════════════════════ #}
{% macro paginationBlock(pagination, pageParam, accentColor, label) %}
  {% set currentPage = pagination.currentPageNumber %}
  {% set totalPages  = pagination.pageCount %}
  {% set totalItems  = pagination.totalItemCount %}
  {% set perPage     = pagination.itemNumberPerPage %}
  {% set startItem   = (currentPage - 1) * perPage + 1 %}
  {% set endItem     = min(currentPage * perPage, totalItems) %}

  <div class="knp-pag-wrap" style="--pag-accent:{{ accentColor }}">
    <div class="knp-pag-info">
      Affichage <strong>{{ startItem }}–{{ endItem }}</strong> sur <strong>{{ totalItems }}</strong> {{ label|lower }}
    </div>

    <div class="knp-pag-controls">
      {# Précédent #}
      {% if currentPage > 1 %}
        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pageParam): currentPage - 1})) }}"
           class="knp-btn knp-prev" aria-label="Page précédente">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15,18 9,12 15,6"/></svg>
        </a>
      {% else %}
        <span class="knp-btn knp-btn-disabled" aria-disabled="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15,18 9,12 15,6"/></svg>
        </span>
      {% endif %}

      {# Pages #}
      {% set windowStart = max(1, currentPage - 2) %}
      {% set windowEnd   = min(totalPages, currentPage + 2) %}

      {% if windowStart > 1 %}
        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pageParam): 1})) }}"
           class="knp-btn">1</a>
        {% if windowStart > 2 %}
          <span class="knp-ellipsis">…</span>
        {% endif %}
      {% endif %}

      {% for p in windowStart..windowEnd %}
        {% if p == currentPage %}
          <span class="knp-btn knp-btn-active" aria-current="page">{{ p }}</span>
        {% else %}
          <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pageParam): p})) }}"
             class="knp-btn">{{ p }}</a>
        {% endif %}
      {% endfor %}

      {% if windowEnd < totalPages %}
        {% if windowEnd < totalPages - 1 %}
          <span class="knp-ellipsis">…</span>
        {% endif %}
        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pageParam): totalPages})) }}"
           class="knp-btn">{{ totalPages }}</a>
      {% endif %}

      {# Suivant #}
      {% if currentPage < totalPages %}
        <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({(pageParam): currentPage + 1})) }}"
           class="knp-btn knp-next" aria-label="Page suivante">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9,18 15,12 9,6"/></svg>
        </a>
      {% else %}
        <span class="knp-btn knp-btn-disabled" aria-disabled="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9,18 15,12 9,6"/></svg>
        </span>
      {% endif %}
    </div>

    {# Indicateur de page #}
    <div class="knp-pag-pages-hint">
      Page {{ currentPage }} / {{ totalPages }}
    </div>
  </div>
{% endmacro %}

<style>
:root{--p:#4F46E5;--g100:#F3F4F6;--g200:#E5E7EB;--g300:#D1D5DB;--g500:#6B7280;--g700:#374151;--g900:#111827}
*{box-sizing:border-box}
.tc-wrapper{padding:2rem;max-width:1400px;margin:0 auto}

/* ── HEADER ── */
.tc-header{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:1.5rem}
.tc-title{font-size:2rem;font-weight:800;color:var(--g900);margin:0}
.tc-sub{color:var(--g500);margin:4px 0 0;font-size:.95rem}
.tc-header-actions{display:flex;gap:.6rem;align-items:center}
.btn-new-training{background:linear-gradient(135deg,#4F46E5,#7C3AED);color:white;padding:10px 22px;border-radius:12px;text-decoration:none;font-weight:700;font-size:.9rem;box-shadow:0 4px 12px rgba(79,70,229,.35);transition:opacity .2s}
.btn-new-training:hover{opacity:.9;color:white}
.flash-success{background:#D1FAE5;color:#065F46;padding:12px 16px;border-radius:10px;font-weight:600;margin-bottom:1rem}
.flash-error{background:#FEE2E2;color:#991B1B;padding:12px 16px;border-radius:10px;font-weight:600;margin-bottom:1rem}

/* ── STATS ── */
.tc-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem;margin-bottom:1.5rem}
.tc-stat-card{background:white;border-radius:16px;padding:1.25rem 1.5rem;border:1px solid var(--g200);display:flex;align-items:center;gap:1rem;box-shadow:0 1px 3px rgba(0,0,0,.06);border-top:3px solid transparent;transition:transform .2s,box-shadow .2s}
.tc-stat-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.09)}
.tc-stat-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;flex-shrink:0}
.tc-stat-number{font-size:1.8rem;font-weight:800;color:var(--g900);line-height:1}
.tc-stat-label{font-size:.8rem;color:var(--g500);margin:2px 0}
.tc-stat-link{font-size:.72rem;font-weight:700}

/* ── FILTER BAR ── */
.tc-filters{display:flex;gap:.75rem;align-items:center;flex-wrap:wrap;background:white;padding:1rem 1.25rem;border-radius:16px;border:1px solid var(--g200);margin-bottom:1.75rem;box-shadow:0 1px 4px rgba(0,0,0,.05)}
.tc-search-wrap{position:relative;flex:1;min-width:220px}
.tc-search-icon{position:absolute;left:13px;top:50%;transform:translateY(-50%);font-size:.95rem;color:var(--g500)}
.tc-search-input{width:100%;padding:10px 12px 10px 38px;border:1.5px solid var(--g200);border-radius:10px;font-size:.9rem;outline:none;transition:border-color .2s,box-shadow .2s;background:#FAFAFA}
.tc-search-input:focus{border-color:var(--p);box-shadow:0 0 0 3px #4F46E518;background:white}
.tc-select{padding:10px 14px;border:1.5px solid var(--g200);border-radius:10px;font-size:.88rem;min-width:140px;cursor:pointer;outline:none;background:#FAFAFA;color:var(--g700);transition:border-color .2s}
.tc-select:focus{border-color:var(--p);background:white}
.btn-filter{padding:10px 20px;border-radius:10px;border:none;background:linear-gradient(135deg,#4F46E5,#6366F1);color:white;font-weight:700;cursor:pointer;font-size:.88rem;box-shadow:0 3px 8px rgba(79,70,229,.3);transition:opacity .2s}
.btn-filter:hover{opacity:.9}
.btn-reset{padding:9px 14px;border-radius:10px;text-decoration:none;color:var(--g500);font-weight:600;font-size:.85rem;border:1.5px solid var(--g200);background:white;transition:all .2s}
.btn-reset:hover{border-color:#DC2626;color:#DC2626;background:#FEF2F2}
.link-reset{color:var(--p)}

/* ── SECTIONS ── */
.tc-section{margin-bottom:2.5rem}
.tc-section-header{display:flex;align-items:center;gap:.75rem;margin-bottom:1.25rem}
.tc-section-bar{width:4px;height:42px;border-radius:2px;flex-shrink:0}
.tc-section-title{font-size:1.15rem;font-weight:800;color:var(--g900)}
.tc-section-count{font-size:.82rem;color:var(--g500);margin-top:2px}

/* ── CARDS LIST (Mes Formations — full width rows) ── */
.tc-cards-list{display:flex;flex-direction:column;gap:1rem}

/* ── CARDS GRID (Découvrir — 2 colonnes) ── */
.tc-cards-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}

/* ── CARD ── */
.tc-card{background:white;border:1px solid var(--g200);border-radius:16px;padding:1.5rem;display:flex;justify-content:space-between;align-items:flex-start;gap:1.5rem;box-shadow:0 1px 4px rgba(0,0,0,.05);transition:box-shadow .2s,transform .2s;position:relative}
.tc-card:hover{box-shadow:0 6px 20px rgba(0,0,0,.1);transform:translateY(-3px)}
.tc-inactive{opacity:.65}
.tc-badge-insc{position:absolute;top:14px;right:14px;font-size:.72rem;font-weight:800;padding:4px 12px;border-radius:20px}
.badge-enrolled{background:#D1FAE5;color:#059669}
.badge-done{background:#DBEAFE;color:#1D4ED8}
.tc-card-left{flex:1;min-width:0}
.tc-type-pill{display:inline-block;font-size:.7rem;font-weight:800;padding:3px 10px;border-radius:20px;letter-spacing:.03em}
.tc-prix{font-size:.95rem;font-weight:800;margin-left:auto}
.tc-card-title{font-size:1.05rem;font-weight:800;color:var(--g900);margin:.3rem 0 .25rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tc-card-desc{font-size:.82rem;color:var(--g500);line-height:1.4;margin:0 0 .5rem;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.tc-meta{display:flex;flex-wrap:wrap;gap:.5rem;font-size:.8rem;color:var(--g500);margin-bottom:.75rem}
.tc-prog-row{display:flex;align-items:center;gap:.5rem;margin-bottom:.75rem}
.tc-prog-bg{flex:1;height:7px;background:var(--g100);border-radius:4px;overflow:hidden}
.tc-prog-fill{height:100%;border-radius:4px;transition:width .4s}
.tc-prog-pct{font-size:.75rem;font-weight:700;color:var(--g500);white-space:nowrap}

/* ── ACTIONS ── */
.tc-actions{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin-top:.25rem}
.btn-details{background:#EFF6FF;color:#2563EB;border:1px solid #BFDBFE;padding:7px 14px;border-radius:8px;font-size:.8rem;font-weight:700;text-decoration:none;transition:background .2s}
.btn-details:hover{background:#DBEAFE;color:#1D4ED8}
.btn-edit-sm{background:#F5F3FF;color:#7C3AED;border:1px solid #DDD6FE;padding:7px 12px;border-radius:8px;font-size:.85rem;font-weight:700;text-decoration:none;cursor:pointer;transition:background .2s}
.btn-edit-sm:hover{background:#EDE9FE}
.btn-deactivate{background:#FFF7ED;color:#C2410C;border:1px solid #FED7AA;padding:7px 14px;border-radius:8px;font-size:.8rem;font-weight:700;cursor:pointer;transition:background .2s}
.btn-deactivate:hover{background:#FFEDD5}
.btn-activate{background:#F0FDF4;color:#059669;border:1px solid #BBF7D0;padding:7px 14px;border-radius:8px;font-size:.8rem;font-weight:700;cursor:pointer;transition:background .2s}
.btn-activate:hover{background:#DCFCE7}
.btn-enroll{background:linear-gradient(135deg,#4F46E5,#7C3AED);color:white;border:none;padding:8px 20px;border-radius:20px;font-size:.85rem;font-weight:700;cursor:pointer;box-shadow:0 3px 10px rgba(79,70,229,.3);transition:opacity .2s}
.btn-enroll:hover{opacity:.9}
.btn-continue{background:linear-gradient(135deg,#10B981,#059669);color:white;border:none;padding:8px 20px;border-radius:20px;font-size:.85rem;font-weight:700;cursor:pointer;text-decoration:none;box-shadow:0 3px 10px rgba(16,185,129,.3);transition:opacity .2s}
.btn-continue:hover{opacity:.9}
.btn-delete{background:#FEF2F2;color:#DC2626;border:1px solid #FECACA;padding:7px 11px;border-radius:8px;font-size:.85rem;cursor:pointer;transition:background .2s}
.btn-delete:hover{background:#FEE2E2}
.badge-inactive{background:var(--g100);color:var(--g500);font-size:.75rem;font-weight:700;padding:6px 14px;border-radius:8px}

/* ── CARD RIGHT (icone catégorie) ── */
.tc-card-right{flex-shrink:0;display:flex;flex-direction:column;align-items:center;gap:.5rem;min-width:90px}
.tc-cat-icon{width:72px;height:72px;border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:2rem}
.tc-cat-label{font-size:.7rem;font-weight:700;text-align:center;max-width:90px;word-break:break-word}

/* ── EMPTY STATE ── */
.tc-empty{text-align:center;padding:3rem;color:var(--g500);background:white;border-radius:16px;border:2px dashed var(--g200)}

/* ── RESPONSIVE ── */
@media(max-width:1100px){.tc-cards-grid{grid-template-columns:1fr}}
@media(max-width:1024px){.tc-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:768px){.tc-card{flex-direction:column}.tc-card-right{display:none}.tc-filters{flex-direction:column;align-items:stretch}.tc-search-wrap,.tc-select{width:100%}}
@media(max-width:480px){.tc-stats{grid-template-columns:1fr}}

/* ── KNP Pagination custom ─────────────────────────────────────────── */
.knp-pag-wrap{
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;
  padding:1rem 1.25rem;margin-top:1.25rem;
  background:white;border-radius:14px;border:1px solid var(--g200);
  box-shadow:0 1px 4px rgba(0,0,0,.05);
}
.knp-pag-info{
  font-size:.8rem;color:var(--g500);
}
.knp-pag-info strong{color:var(--g900);font-weight:700}
.knp-pag-controls{display:flex;align-items:center;gap:.3rem}
.knp-btn{
  display:flex;align-items:center;justify-content:center;
  min-width:36px;height:36px;padding:0 .5rem;
  border-radius:10px;font-size:.82rem;font-weight:700;
  text-decoration:none;color:var(--g700);
  border:1.5px solid var(--g200);background:white;
  transition:all .15s;cursor:pointer;
}
.knp-btn:hover{background:var(--g100);border-color:var(--g300);color:var(--g900)}
.knp-btn-active{
  background:var(--pag-accent,#4F46E5) !important;
  border-color:var(--pag-accent,#4F46E5) !important;
  color:white !important;
  box-shadow:0 3px 10px color-mix(in srgb, var(--pag-accent,#4F46E5) 35%, transparent);
}
.knp-btn-disabled{
  color:var(--g200) !important;cursor:not-allowed !important;
  background:var(--g100) !important;border-color:var(--g200) !important;
}
.knp-prev,.knp-next{
  background:var(--g100);border-color:var(--g200);
}
.knp-prev:hover,.knp-next:hover{
  background:color-mix(in srgb, var(--pag-accent,#4F46E5) 10%, white);
  border-color:var(--pag-accent,#4F46E5);
  color:var(--pag-accent,#4F46E5);
}
.knp-ellipsis{
  display:flex;align-items:center;justify-content:center;
  min-width:28px;height:36px;font-size:.85rem;
  color:var(--g500);letter-spacing:.15em;
}
.knp-pag-pages-hint{
  font-size:.75rem;font-weight:600;color:var(--g500);
  background:var(--g100);padding:5px 12px;border-radius:20px;
  white-space:nowrap;
}

/* ══════════════════════════════════════════════
   AI ASSISTANT BUTTON (header)
══════════════════════════════════════════════ */
.btn-ai-assistant{
  position:relative;display:flex;align-items:center;gap:7px;
  padding:10px 20px;border-radius:12px;border:none;cursor:pointer;
  background:linear-gradient(135deg,#6366F1 0%,#8B5CF6 100%);
  color:white;font-size:.88rem;font-weight:700;
  box-shadow:0 4px 16px rgba(99,102,241,.4);
  transition:all .2s;overflow:hidden;
}
.btn-ai-assistant:hover{
  transform:translateY(-2px);
  box-shadow:0 8px 24px rgba(99,102,241,.55);
}
.ai-btn-pulse{
  position:absolute;inset:0;border-radius:12px;
  background:linear-gradient(135deg,#6366F1,#8B5CF6);
  animation:ai-pulse-ring 2.5s ease-in-out infinite;
  opacity:0;
}
@keyframes ai-pulse-ring{
  0%{opacity:.6;transform:scale(1)}
  100%{opacity:0;transform:scale(1.12)}
}

/* ══════════════════════════════════════════════
   AI CHAT WIDGET
══════════════════════════════════════════════ */
#aiChatWidget{
  position:fixed;bottom:28px;right:28px;z-index:9999;
  width:400px;height:600px;
  background:#F8FAFF;border-radius:20px;
  border:1px solid #E2E8F6;
  box-shadow:0 20px 60px rgba(99,102,241,.2),0 4px 16px rgba(0,0,0,.1);
  display:none;flex-direction:column;overflow:hidden;
  animation:widgetIn .28s cubic-bezier(.34,1.56,.64,1);
}
#aiChatWidget.open{display:flex}
@keyframes widgetIn{
  from{opacity:0;transform:scale(.88) translateY(20px)}
  to{opacity:1;transform:scale(1) translateY(0)}
}

/* Header */
.ai-widget-head{
  display:flex;align-items:center;gap:10px;
  padding:14px 16px;
  background:linear-gradient(135deg,#6366F1 0%,#8B5CF6 100%);
  flex-shrink:0;
}
.ai-widget-avatar{
  width:38px;height:38px;border-radius:50%;
  background:rgba(255,255,255,.15);
  display:flex;align-items:center;justify-content:center;
  font-size:16px;color:white;flex-shrink:0;
  border:1.5px solid rgba(255,255,255,.3);
  animation:avatar-glow 2.5s ease-in-out infinite;
}
@keyframes avatar-glow{
  0%,100%{box-shadow:0 0 0 0 rgba(255,255,255,.3)}
  50%{box-shadow:0 0 0 6px rgba(255,255,255,0)}
}
.ai-widget-info{flex:1;min-width:0}
.ai-widget-name{font-size:.88rem;font-weight:800;color:white}
.ai-widget-status{display:flex;align-items:center;gap:4px;margin-top:2px}
.ai-status-dot{width:6px;height:6px;border-radius:50%;background:#4ADE80;flex-shrink:0;animation:blink 1.4s ease-in-out infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.4}}
.ai-widget-status-txt{font-size:.68rem;color:rgba(255,255,255,.8)}
.ai-widget-actions{display:flex;gap:2px}
.ai-hd-btn{
  background:rgba(255,255,255,.12);border:none;color:white;
  width:28px;height:28px;border-radius:8px;cursor:pointer;font-size:.8rem;
  display:flex;align-items:center;justify-content:center;transition:background .15s;
}
.ai-hd-btn:hover{background:rgba(255,255,255,.25)}

/* Quick actions strip */
.ai-quick-strip{
  display:flex;gap:6px;padding:8px 12px;overflow-x:auto;
  background:#F0F4FF;border-bottom:1px solid #E2E8F6;flex-shrink:0;
}
.ai-quick-strip::-webkit-scrollbar{display:none}
.ai-chip{
  white-space:nowrap;padding:4px 11px;border-radius:20px;
  font-size:.72rem;font-weight:700;cursor:pointer;
  background:#FFFFFF;color:#64748B;
  border:1px solid #E2E8F6;transition:all .15s;flex-shrink:0;
}
.ai-chip:hover{background:#EEF2FF;border-color:#6366F1;color:#4F46E5}

/* Messages area */
.ai-messages{
  flex:1;overflow-y:auto;padding:12px;
  display:flex;flex-direction:column;gap:8px;
  background:#F8FAFF;
}
.ai-messages::-webkit-scrollbar{width:4px}
.ai-messages::-webkit-scrollbar-thumb{background:#C7D2FE;border-radius:99px}
.ai-messages::-webkit-scrollbar-thumb:hover{background:#6366F1}

/* Message bubbles */
.ai-msg-row{display:flex;gap:8px;align-items:flex-end}
.ai-msg-row.user{flex-direction:row-reverse}
.ai-msg-avatar{
  width:28px;height:28px;border-radius:50%;
  background:#6366F1;display:flex;align-items:center;justify-content:center;
  font-size:11px;color:white;flex-shrink:0;
}
.ai-bubble{
  max-width:290px;padding:10px 13px;
  font-size:.8rem;line-height:1.55;
  border-radius:4px 16px 16px 16px;
  background:#F1F5FE;color:#1E293B;
  border:1px solid #E2E8F6;
}
.ai-bubble.user{
  border-radius:16px 16px 4px 16px;
  background:linear-gradient(135deg,#6366F1,#8B5CF6);
  color:white;border:none;
  box-shadow:0 2px 8px rgba(99,102,241,.3);
}
.ai-bubble-time{font-size:.62rem;color:#94A3B8;margin-top:4px}
.ai-bubble.user .ai-bubble-time{color:rgba(255,255,255,.6)}

/* Markdown rendering in bubbles */
.ai-bubble h2{font-size:.82rem;font-weight:800;color:#6366F1;margin:.4rem 0 .15rem}
.ai-bubble h3{font-size:.78rem;font-weight:700;color:#374151;margin:.3rem 0 .1rem}
.ai-bubble ul{padding-left:1rem;margin:.2rem 0}
.ai-bubble li{margin:.1rem 0;font-size:.79rem}
.ai-bubble strong{font-weight:700;color:#1E293B}
.ai-bubble.user h2,.ai-bubble.user h3,.ai-bubble.user strong{color:white}
.ai-bubble p{margin:.2rem 0}

/* Bubble actions */
.ai-bubble-actions{display:flex;gap:5px;margin-top:5px}
.ai-ba-btn{
  background:transparent;border:none;font-size:.68rem;color:#94A3B8;
  cursor:pointer;padding:2px 6px;border-radius:6px;transition:all .12s;
}
.ai-ba-btn:hover{background:#E2E8F6;color:#64748B}

/* Typing indicator */
.ai-typing{display:flex;gap:4px;align-items:center;padding:10px 14px;
  background:#F1F5FE;border-radius:4px 16px 16px 16px;border:1px solid #E2E8F6;max-width:70px}
.ai-typing-dot{
  width:6px;height:6px;border-radius:50%;background:#6366F1;
  animation:typing-bounce .8s ease-in-out infinite;
}
.ai-typing-dot:nth-child(2){animation-delay:.15s}
.ai-typing-dot:nth-child(3){animation-delay:.3s}
@keyframes typing-bounce{
  0%,80%,100%{transform:translateY(0);opacity:.4}
  40%{transform:translateY(-5px);opacity:1}
}

/* Input area */
.ai-input-wrap{
  padding:10px 12px;border-top:1px solid #E2E8F6;
  background:#FFFFFF;flex-shrink:0;
}
.ai-input-row{display:flex;gap:8px;align-items:center}
.ai-input{
  flex:1;border:1.5px solid #E2E8F6;border-radius:20px;
  padding:9px 14px;font-size:.82rem;outline:none;
  background:#F8FAFF;color:#1E293B;
  transition:border-color .15s,box-shadow .15s;
  font-family:inherit;
}
.ai-input::placeholder{color:#94A3B8}
.ai-input:focus{border-color:#6366F1;box-shadow:0 0 0 3px rgba(99,102,241,.12);background:white}
.ai-send-btn{
  width:38px;height:38px;border-radius:50%;border:none;cursor:pointer;
  background:linear-gradient(135deg,#6366F1,#8B5CF6);color:white;
  font-size:.9rem;display:flex;align-items:center;justify-content:center;
  flex-shrink:0;transition:all .18s;
  box-shadow:0 2px 8px rgba(99,102,241,.35);
}
.ai-send-btn:hover{transform:scale(1.08);box-shadow:0 4px 14px rgba(99,102,241,.5)}
.ai-send-btn:disabled{opacity:.45;cursor:not-allowed;transform:none}
.ai-hint{font-size:.64rem;color:#94A3B8;text-align:center;padding:.4rem 0 .1rem}

/* FAB (floating button) */
#aiFab{
  position:fixed;bottom:28px;right:28px;z-index:10000;
  width:52px;height:52px;border-radius:50%;border:none;cursor:pointer;
  background:linear-gradient(135deg,#6366F1,#8B5CF6);color:white;
  font-size:1.2rem;display:flex;align-items:center;justify-content:center;
  box-shadow:0 6px 20px rgba(99,102,241,.45);
  transition:all .2s;display:none;
}
#aiFab:hover{transform:scale(1.1);box-shadow:0 8px 28px rgba(99,102,241,.6)}
.ai-fab-ring{
  position:absolute;inset:-4px;border-radius:50%;
  border:2px solid rgba(99,102,241,.35);
  animation:fab-ring 2.5s ease-in-out infinite;
}
@keyframes fab-ring{0%{opacity:.8;transform:scale(1)}100%{opacity:0;transform:scale(1.5)}}
</style>

{# ══ AI CHAT WIDGET DOM ══════════════════════════════════════════════════ #}
<div id="aiChatWidget">

  {# Header #}
  <div class="ai-widget-head">
    <div class="ai-widget-avatar">✦</div>
    <div class="ai-widget-info">
      <div class="ai-widget-name">AI Learning Assistant</div>
      <div class="ai-widget-status">
        <span class="ai-status-dot"></span>
        <span class="ai-widget-status-txt">En ligne · Groq / Llama 3.3</span>
      </div>
    </div>
    <div class="ai-widget-actions">
      <button class="ai-hd-btn" onclick="aiReset()" title="Réinitialiser la conversation">↺</button>
      <button class="ai-hd-btn" onclick="aiToggle()" title="Réduire">－</button>
    </div>
  </div>

  {# Quick action chips #}
  <div class="ai-quick-strip" id="aiQuickStrip">
    <button class="ai-chip" onclick="aiQuick('🎯 Analyse mes gaps de compétences')">🎯 Mes gaps</button>
    <button class="ai-chip" onclick="aiQuick('📚 Recommande-moi des formations adaptées à mon profil')">📚 Formations</button>
    <button class="ai-chip" onclick="aiQuick('🗺 Comment construire mon PDI ?')">🗺 Mon PDI</button>
    <button class="ai-chip" onclick="aiQuick('📊 Analyse mon profil de compétences globalement')">📊 Mon profil</button>
    <button class="ai-chip" onclick="aiQuick('🏆 Comment améliorer mon niveau en évaluations ?')">🏆 Évaluations</button>
  </div>

  {# Messages #}
  <div class="ai-messages" id="aiMessages"></div>

  {# Input #}
  <div class="ai-input-wrap">
    <div class="ai-input-row">
      <input class="ai-input" id="aiInput" type="text"
             placeholder="Posez votre question sur vos compétences..."
             maxlength="500" autocomplete="off">
      <button class="ai-send-btn" id="aiSendBtn" onclick="aiSend()">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22,2 15,22 11,13 2,9"/></svg>
      </button>
    </div>
    <div class="ai-hint">✦ Powered by Groq · Llama 3.3 · Votre coach IA formation</div>
  </div>

</div>

{# FAB (shown when widget is closed after first open) #}
<button id="aiFab" onclick="aiToggle()" title="AI Learning Assistant">
  <div class="ai-fab-ring"></div>
  ✦
</button>

<script>
// ══════════════════════════════════════════════════════════════════════
//  AI ASSISTANT STATE
// ══════════════════════════════════════════════════════════════════════
const AI_ENDPOINT = '{{ path("formation_ai_assistant") }}';
let aiHistory     = [];   // [{role:'user'|'assistant', content:'...'}]
let aiIsTyping    = false;
let aiOpened      = false;
const aiNow       = () => new Date().toLocaleTimeString('fr-FR', {hour:'2-digit',minute:'2-digit'});

// ══════════════════════════════════════════════════════════════════════
//  TOGGLE
// ══════════════════════════════════════════════════════════════════════
function aiToggle() {
  const widget = document.getElementById('aiChatWidget');
  const fab    = document.getElementById('aiFab');

  if (widget.classList.contains('open')) {
    widget.classList.remove('open');
    if (aiOpened) fab.style.display = 'flex';
  } else {
    widget.classList.add('open');
    fab.style.display = 'none';
    aiOpened = true;
    if (aiHistory.length === 0) aiSendWelcome();
    setTimeout(() => document.getElementById('aiInput').focus(), 300);
  }
}

// ══════════════════════════════════════════════════════════════════════
//  WELCOME MESSAGE (sent on first open, no API call)
// ══════════════════════════════════════════════════════════════════════
function aiSendWelcome() {
  const welcome = "## Bonjour ! 👋\n\nJe suis votre **AI Learning Assistant** — votre coach IA personnel pour tout ce qui concerne vos **compétences et formations**.\n\nJe connais déjà votre profil. Voici ce que je peux faire :\n\n- **Analyser** vos écarts de compétences\n- **Recommander** des formations adaptées\n- **Construire** votre PDI personnalisé\n- **Préparer** vos évaluations\n\nQue souhaitez-vous explorer aujourd'hui ?";
  aiAddMessage('assistant', welcome, false);
  aiHistory.push({role: 'assistant', content: welcome});
}

// ══════════════════════════════════════════════════════════════════════
//  SEND MESSAGE
// ══════════════════════════════════════════════════════════════════════
function aiSend() {
  const input = document.getElementById('aiInput');
  const msg   = input.value.trim();
  if (!msg || aiIsTyping) return;
  input.value = '';
  aiHistory.push({role:'user', content: msg});
  aiAddMessage('user', msg);
  aiCallApi(msg);
}

function aiQuick(text) {
  document.getElementById('aiInput').value = text;
  aiSend();
  // Hide quick strip after first use
  document.getElementById('aiQuickStrip').style.display = 'none';
}

// ══════════════════════════════════════════════════════════════════════
//  API CALL
// ══════════════════════════════════════════════════════════════════════
async function aiCallApi(message) {
  aiIsTyping = true;
  document.getElementById('aiSendBtn').disabled = true;
  document.getElementById('aiInput').disabled   = true;
  aiShowTyping();

  const fd = new FormData();
  fd.append('message', message);
  fd.append('history', JSON.stringify(aiHistory.slice(-8)));

  try {
    const res  = await fetch(AI_ENDPOINT, {method: 'POST', body: fd});
    const data = await res.json();
    aiRemoveTyping();

    if (data.ok) {
      aiHistory.push({role: 'assistant', content: data.response});
      aiAddMessage('assistant', data.response);
    } else {
      aiAddMessage('assistant', '⚠️ Désolé, une erreur est survenue.\n\n**Erreur :** ' + (data.error || 'Inconnue'));
    }
  } catch(e) {
    aiRemoveTyping();
    aiAddMessage('assistant', '⚠️ Impossible de contacter le serveur IA.\n\n**Erreur réseau :** ' + e.message);
  } finally {
    aiIsTyping = false;
    document.getElementById('aiSendBtn').disabled = false;
    document.getElementById('aiInput').disabled   = false;
    document.getElementById('aiInput').focus();
  }
}

// ══════════════════════════════════════════════════════════════════════
//  RENDER MESSAGE
// ══════════════════════════════════════════════════════════════════════
function aiAddMessage(role, text, animate = true) {
  const box  = document.getElementById('aiMessages');
  const row  = document.createElement('div');
  row.className = 'ai-msg-row ' + role;

  if (role === 'assistant') {
    const av = document.createElement('div');
    av.className = 'ai-msg-avatar';
    av.textContent = '✦';
    row.appendChild(av);
  }

  const col = document.createElement('div');
  col.style.display = 'flex';
  col.style.flexDirection = 'column';
  col.style.alignItems = role === 'user' ? 'flex-end' : 'flex-start';

  const bubble = document.createElement('div');
  bubble.className = 'ai-bubble ' + role;
  bubble.innerHTML = aiRenderMarkdown(text);

  const time = document.createElement('div');
  time.className = 'ai-bubble-time';
  time.textContent = (role === 'assistant' ? '✦ AI · ' : '') + aiNow();

  col.appendChild(bubble);
  col.appendChild(time);

  // Copy + regenerate actions for AI messages
  if (role === 'assistant') {
    const actions = document.createElement('div');
    actions.className = 'ai-bubble-actions';

    const btnCopy = document.createElement('button');
    btnCopy.className = 'ai-ba-btn';
    btnCopy.textContent = '📋 Copier';
    btnCopy.onclick = () => {
      navigator.clipboard.writeText(text);
      btnCopy.textContent = '✓ Copié';
      setTimeout(() => btnCopy.textContent = '📋 Copier', 2000);
    };

    const btnRegen = document.createElement('button');
    btnRegen.className = 'ai-ba-btn';
    btnRegen.textContent = '↺ Régénérer';
    btnRegen.onclick = () => {
      const lastUser = [...aiHistory].reverse().find(m => m.role === 'user');
      if (lastUser) aiCallApi(lastUser.content);
    };

    actions.appendChild(btnCopy);
    actions.appendChild(btnRegen);
    col.appendChild(actions);
  }

  row.appendChild(col);
  box.appendChild(row);

  // Animate in
  if (animate) {
    row.style.opacity = '0';
    row.style.transform = 'translateY(10px)';
    requestAnimationFrame(() => {
      row.style.transition = 'opacity .3s ease, transform .3s ease';
      row.style.opacity = '1';
      row.style.transform = 'translateY(0)';
    });
  }

  box.scrollTop = box.scrollHeight;
}

// ══════════════════════════════════════════════════════════════════════
//  MARKDOWN RENDERER
// ══════════════════════════════════════════════════════════════════════
function aiRenderMarkdown(text) {
  // Escape HTML
  let html = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');

  // Headers
  html = html.replace(/^## (.+)$/gm, '<h2>$1</h2>');
  html = html.replace(/^# (.+)$/gm,  '<h3>$1</h3>');

  // Bold
  html = html.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');

  // Bullet lists
  const lines = html.split('\n');
  let inList = false;
  const out  = [];
  for (const line of lines) {
    if (/^[-•*] (.+)/.test(line)) {
      if (!inList) { out.push('<ul>'); inList = true; }
      out.push('<li>' + line.replace(/^[-•*] /, '') + '</li>');
    } else {
      if (inList) { out.push('</ul>'); inList = false; }
      if (line.trim()) out.push('<p>' + line + '</p>');
      else out.push('');
    }
  }
  if (inList) out.push('</ul>');
  return out.join('');
}

// ══════════════════════════════════════════════════════════════════════
//  TYPING INDICATOR
// ══════════════════════════════════════════════════════════════════════
function aiShowTyping() {
  const box = document.getElementById('aiMessages');
  const row = document.createElement('div');
  row.className = 'ai-msg-row assistant';
  row.id = 'aiTypingRow';

  const av = document.createElement('div');
  av.className = 'ai-msg-avatar';
  av.textContent = '✦';

  const dots = document.createElement('div');
  dots.className = 'ai-typing';
  for (let i = 0; i < 3; i++) {
    const d = document.createElement('div');
    d.className = 'ai-typing-dot';
    dots.appendChild(d);
  }

  row.appendChild(av);
  row.appendChild(dots);
  box.appendChild(row);
  box.scrollTop = box.scrollHeight;
}

function aiRemoveTyping() {
  const el = document.getElementById('aiTypingRow');
  if (el) el.remove();
}

// ══════════════════════════════════════════════════════════════════════
//  RESET
// ══════════════════════════════════════════════════════════════════════
function aiReset() {
  aiHistory = [];
  document.getElementById('aiMessages').innerHTML = '';
  document.getElementById('aiQuickStrip').style.display = 'flex';
  aiSendWelcome();
}

// ── Keyboard: Enter to send ───────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('aiInput').addEventListener('keydown', e => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); aiSend(); }
  });
});
</script>
{% endblock %}

{% extends 'base.html.twig' %}
{% block title %}Catalogue de formations – Humania{% endblock %}

{% block body %}
<div class="tc-wrapper">

  {# ══ HEADER ══════════════════════════════════════════════ #}
  <div class="tc-header">
    <div>
      <h1 class="tc-title">Catalogue de formations</h1>
      <p class="tc-sub">Parcourir et s'inscrire aux programmes de formation disponibles</p>
    </div>
    <div class="tc-header-actions">
      {# ── AI Assistant Button ── #}
      <button class="btn-ai-assistant" id="btnOpenAI" onclick="aiToggle()">
        <span class="ai-btn-pulse"></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13,2 3,14 12,14 11,22 21,10 12,10"/></svg>
        AI Assistant
      </button>
      {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('formation_new') }}" class="btn-new-training">+ New Training</a>
      {% endif %}
    </div>
  </div>

  {# ══ FLASH ═══════════════════════════════════════════════ #}
  {% for msg in app.flashes('success') %}
    <div class="flash-success">{{ msg }}</div>
  {% endfor %}
  {% for msg in app.flashes('error') %}
    <div class="flash-error">{{ msg }}</div>
  {% endfor %}

  {# ══ STATS CARDS ════════════════════════════════════════ #}
  <div class="tc-stats">
    <div class="tc-stat-card" style="border-top-color:#10B981">
      <div class="tc-stat-icon" style="background:#F0FDF4;color:#10B981">🎓</div>
      <div>
        <div class="tc-stat-number">{{ stats.total }}</div>
        <div class="tc-stat-label">Total Formations</div>
        <div class="tc-stat-link" style="color:#10B981">✅ Catalogue complet</div>
      </div>
    </div>
    <div class="tc-stat-card" style="border-top-color:#3B82F6">
      <div class="tc-stat-icon" style="background:#EFF6FF;color:#3B82F6">💻</div>
      <div>
        <div class="tc-stat-number">{{ stats.eLearning }}</div>
        <div class="tc-stat-label">E-Learning</div>
        <div class="tc-stat-link" style="color:#3B82F6">🖥 Formations en ligne</div>
      </div>
    </div>
    <div class="tc-stat-card" style="border-top-color:#F59E0B">
      <div class="tc-stat-icon" style="background:#FFFBEB;color:#F59E0B">🏫</div>
      <div>
        <div class="tc-stat-number">{{ stats.classroom }}</div>
        <div class="tc-stat-label">Classroom</div>
        <div class="tc-stat-link" style="color:#F59E0B">🏫 Formations présentiel</div>
      </div>
    </div>
    <div class="tc-stat-card" style="border-top-color:#8B5CF6">
      <div class="tc-stat-icon" style="background:#F5F3FF;color:#8B5CF6">🎓</div>
      <div>
        <div class="tc-stat-number">{{ stats.totalCats }}</div>
        <div class="tc-stat-label">Catégories</div>
        <div class="tc-stat-link" style="color:#8B5CF6">🏷 Domaines de compétence</div>
      </div>
    </div>
  </div>

  {# ══ FILTRES ═════════════════════════════════════════════ #}
  <form method="get" action="{{ path('formation_catalog') }}" class="tc-filters">
    <div class="tc-search-wrap">
      <span class="tc-search-icon">🔍</span>
      <input type="text" name="search" value="{{ search }}"
             placeholder="Rechercher une formation..." class="tc-search-input"
             oninput="if(!this.value) this.form.submit()">
    </div>
    <select name="type" class="tc-select" onchange="this.form.submit()">
      <option value="">All Types</option>
      {% for key, t in types %}
        <option value="{{ key }}" {{ fType == key ? 'selected' : '' }}>{{ t.label }}</option>
      {% endfor %}
    </select>
    <select name="categorie" class="tc-select" onchange="this.form.submit()">
      <option value="">All Categories</option>
      {% for cat in categories %}
        <option value="{{ cat.id }}" {{ fCategory == cat.id ? 'selected' : '' }}>{{ cat.libelle }}</option>
      {% endfor %}
    </select>
    {# {% if isRH %} #}
    <select name="statut" class="tc-select" onchange="this.form.submit()">
      <option value="">All Statuses</option>
      <option value="Active" {{ fStatut == 'Active' ? 'selected' : '' }}>Active</option>
      <option value="Inactive" {{ fStatut == 'Inactive' ? 'selected' : '' }}>Inactive</option>
    </select>
    {# {% endif %} #}
    <button type="submit" class="btn-filter">Filtrer</button>
    {% if search or fType or fCategory or fStatut %}
      <a href="{{ path('formation_catalog') }}" class="btn-reset">✕ Réinitialiser</a>
    {% endif %}
  </form>

  {# ══ SECTION 1 : MES FORMATIONS ════════════════════════ #}
  {% if mesPagination.totalItemCount > 0 %}
  <div class="tc-section">
    <div class="tc-section-header">
      <div class="tc-section-bar" style="background:#10B981"></div>
      <div>
        <div class="tc-section-title">🎓 Mes Formations</div>
        <div class="tc-section-count">
          {{ mesPagination.totalItemCount }} formation{{ mesPagination.totalItemCount > 1 ? 's' : '' }} en cours
        </div>
      </div>
    </div>

    <div class="tc-cards-grid">
      {% for f in mesPagination %}
        {% set ti = types[f.typeFormation] ?? {label: f.typeFormation, icon: '📘', color: '#6366F1'} %}
        {% set col = f.categorie_couleur ?: ti.color %}
        {% set pct = f.progression_dynamic %}
        {% set done = f.insc_statut == 'Completed' %}

        <div class="tc-card">
          <span class="tc-badge-insc {{ done ? 'badge-done' : 'badge-enrolled' }}">
            {{ done ? '🏆 Complété' : '✓ Inscrit' }}
          </span>

          <div class="tc-card-left">
            <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.35rem">
              <span class="tc-type-pill" style="background:{{ col }}20;color:{{ col }}">
                {{ ti.icon }} {{ ti.label|upper }}
              </span>
              <span class="tc-prix" style="color:{{ col }}">{{ f.cout|number_format(0,'.',',') }} DTN</span>
            </div>

            <div class="tc-card-title">{{ f.titre }}</div>
            {% if f.description %}
              <p class="tc-card-desc">{{ f.description|slice(0,90) }}{% if f.description|length > 90 %}…{% endif %}</p>
            {% endif %}

            <div class="tc-meta">
              <span>⏱ {{ f.duree }}h</span>
              {% if f.total_modules > 0 %}
                <span>• 📚 {{ f.done_modules }}/{{ f.total_modules }} modules</span>
              {% endif %}
              {% if f.lieu %}
                <span>• {{ f.lieu == 'En ligne' ? '🌐' : '📍' }} {{ f.lieu }}</span>
              {% endif %}
            </div>

            {% if not done %}
              <div class="tc-prog-row">
                <div class="tc-prog-bg">
                  <div class="tc-prog-fill" style="width:{{ pct }}%;background:{{ col }}"></div>
                </div>
                <span class="tc-prog-pct">{{ pct }}%</span>
              </div>
            {% endif %}

            <div class="tc-actions">
              <button class="btn-details" onclick="openDetailsModal({{ f.id }})">🔍 Détails</button>
              {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
                <a href="{{ path('formation_edit', {id: f.id}) }}" class="btn-edit-sm">=</a>
                <form method="post" action="{{ path('formation_toggle', {id: f.id}) }}" style="display:inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('toggle'~f.id) }}">
                  <button class="{{ f.statutFormation=='Active' ? 'btn-deactivate' : 'btn-activate' }}">
                    {{ f.statutFormation=='Active' ? '⏸ Désactiver' : '▶ Activer' }}
                  </button>
                </form>
              {% endif %}
              {% if not done %}
                <a href="{{ path('mes_lecons_formation', {id: f.id}) }}" class="btn-continue">▶ Continuer</a>
              {% endif %}
              {# ── Cancel inscription ── #}
              <button class="btn-cancel-insc" onclick="openCancelModal({{ f.id }}, '{{ f.titre|e('html_attr') }}')">
                ✕ Se désinscrire
              </button>
            </div>
          </div>

          <div class="tc-card-right">
            <div class="tc-cat-icon" style="background:{{ col }}18;color:{{ col }}">{{ ti.icon }}</div>
            {% if f.categorie_libelle %}
              <div class="tc-cat-label" style="color:{{ col }}">{{ f.categorie_libelle }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {# ── Pagination Mes Formations ── #}
    {% if mesPagination.pageCount > 1 %}
      {{ _self.paginationBlock(mesPagination, 'mes_page', '#10B981', 'Mes formations') }}
    {% endif %}
  </div>
  {% endif %}

  {# ══ SECTION 2 : DÉCOUVRIR D'AUTRES FORMATIONS ═════════ #}
  <div class="tc-section">
    <div class="tc-section-header">
      <div class="tc-section-bar" style="background:#4F46E5"></div>
      <div>
        <div class="tc-section-title">🎓 Découvrir d'autres formations</div>
        <div class="tc-section-count">{{ autresPagination.totalItemCount }} formation{{ autresPagination.totalItemCount > 1 ? 's' : '' }}</div>
      </div>
    </div>

    {% if autresPagination.totalItemCount == 0 %}
      <div class="tc-empty">
        <div style="font-size:2.5rem;margin-bottom:.5rem">🎓</div>
        <p>Aucune formation supplémentaire disponible.</p>
        {% if search or fType or fCategory %}
          <a href="{{ path('formation_catalog') }}" class="link-reset">Réinitialiser les filtres →</a>
        {% endif %}
      </div>
    {% else %}
    <div class="tc-cards-grid">
      {% for f in autresPagination %}
        {% set ti = types[f.typeFormation] ?? {label: f.typeFormation, icon: '📘', color: '#6366F1'} %}
        {% set col = f.categorie_couleur ?: ti.color %}
        {% set actif = f.statutFormation == 'Active' %}

        <div class="tc-card {{ not actif ? 'tc-inactive' : '' }}">
          <div class="tc-card-left">
            <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:.35rem">
              <span class="tc-type-pill" style="background:{{ col }}20;color:{{ col }}">
                {{ ti.icon }} {{ ti.label|upper }}
              </span>
              <span class="tc-prix" style="color:{{ col }}">{{ f.cout|number_format(0,'.',',') }} DTN</span>
            </div>

            <div class="tc-card-title">{{ f.titre }}</div>
            {% if f.description %}
              <p class="tc-card-desc">{{ f.description|slice(0,100) }}{% if f.description|length > 100 %}…{% endif %}</p>
            {% endif %}

            <div class="tc-meta">
              <span>⏱ {{ f.duree }}h</span>
              {% if f.total_modules > 0 %}<span>• 📚 {{ f.total_modules }} modules</span>{% endif %}
              {% if f.next_session_debut %}
                <span>• 📅 {{ f.next_session_debut|date('d/m/Y') }}</span>
              {% endif %}
              {% if f.formateur_nom and f.formateur_nom|trim != '' %}
                <span>• 👤 {{ f.formateur_nom }}</span>
              {% endif %}
            </div>

            <div class="tc-actions">
              <button class="btn-details" onclick="openDetailsModal({{ f.id }})">🔍 Détails</button>
              {% if actif %}
                <form method="post" action="{{ path('formation_inscrire', {id: f.id}) }}" style="display:inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('insc'~f.id) }}">
                  <button class="btn-enroll">+ S'inscrire</button>
                </form>
              {% else %}
                <span class="badge-inactive">⏸ Inactive</span>
              {% endif %}

              {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_RH') %}
                <a href="{{ path('formation_edit', {id: f.id}) }}" class="btn-edit-sm">=</a>
                <form method="post" action="{{ path('formation_toggle', {id: f.id}) }}" style="display:inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('toggle'~f.id) }}">
                  <button class="{{ actif ? 'btn-deactivate' : 'btn-activate' }}">
                    {{ actif ? '⏸ Désactiver' : '▶ Activer' }}
                  </button>
                </form>
                <form method="post" action="{{ path('formation_delete', {id: f.id}) }}"
                      style="display:inline"
                      onsubmit="return confirm('Supprimer « {{ f.titre|e('js') }} » ?')">
                  <input type="hidden" name="_token" value="{{ csrf_token('del'~f.id) }}">
                  <button class="btn-delete">🗑</button>
                </form>
              {% endif %}
            </div>
          </div>

          <div class="tc-card-right">
            <div class="tc-cat-icon" style="background:{{ col }}18;color:{{ col }}">{{ ti.icon }}</div>
            {% if f.categorie_libelle %}
              <div class="tc-cat-label" style="color:{{ col }}">{{ f.categorie_libelle }}</div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {# ── Pagination Autres Formations ── #}
    {% if autresPagination.pageCount > 1 %}
      {{ _self.paginationBlock(autresPagination, 'page', '#4F46E5', 'Formations') }}
    {% endif %}
    {% endif %}
  </div>

</div>

{# ══ MODAL — Détails formation ════════════════════════════════════════════ #}
<div id="modalDetails" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeDetails()">
  <div class="modal-box modal-details-box">
    <div id="detailsContent">
      <div class="det-loading">
        <div class="det-spinner"></div>
        Chargement…
      </div>
    </div>
    <div class="det-footer">
      <button class="det-close-btn" onclick="closeDetails()">Fermer</button>
    </div>
  </div>
</div>

{# ══ MODAL — Confirmer désinscription ════════════════════════════════════ #}
<div id="modalCancel" class="modal-overlay" style="display:none" onclick="if(event.target===this)closeCancelModal()">
  <div class="modal-box modal-confirm-box">
    <div class="confirm-icon-wrap">
      <div style="font-size:2rem">⚠️</div>
    </div>
    <h3 class="confirm-title">Se désinscrire ?</h3>
    <p class="confirm-sub" id="cancelSubText">Votre progression sera perdue et vous serez retiré de cette formation.</p>
    <form method="post" id="formDesinscrire" action="">
      <input type="hidden" name="employe_id" value="12">
      <div class="confirm-actions">
        <button type="button" class="btn-cancel-modal" onclick="closeCancelModal()">Annuler</button>
        <button type="submit" class="btn-confirm-desinsc">✕ Confirmer la désinscription</button>
      </div>
    </form>
  </div>
</div>

<script>
// ══ DETAILS MODAL ══════════════════════════════════════════════════════════
const TYPE_ICONS = {
  'video':'🎥','reading':'📖','lecture':'📖','cours':'📖','quiz':'🧠','exercice':'✏️'
};
const TYPE_COLORS = {
  'video':'#DBEAFE','reading':'#D1FAE5','cours':'#D1FAE5','lecture':'#D1FAE5',
  'quiz':'#EDE9FE','exercice':'#FEF3C7'
};
const TYPE_TEXT = {
  'video':'#1D4ED8','reading':'#065F46','cours':'#065F46','lecture':'#065F46',
  'quiz':'#5B21B6','exercice':'#92400E'
};

async function openDetailsModal(formationId) {
  document.getElementById('detailsContent').innerHTML = `
    <div class="det-loading"><div class="det-spinner"></div>Chargement…</div>`;
  document.getElementById('modalDetails').style.display = 'flex';

  try {
    const res  = await fetch(`/formation/${formationId}/details`);
    const data = await res.json();
    if (!data.ok) throw new Error(data.error || 'Erreur');

    const f = data.formation;
    const mods = data.modules;
    const color = f.categorie_couleur || '#4F46E5';

    let modulesHtml = '';
    if (mods.length === 0) {
      modulesHtml = '<div class="det-no-modules">Aucun module disponible pour cette formation.</div>';
    } else {
      mods.forEach((m, i) => {
        const tc   = m.type_contenu?.toLowerCase() || '';
        const icon = TYPE_ICONS[tc] || '📄';
        const bg   = TYPE_COLORS[tc] || '#F3F4F6';
        const fg   = TYPE_TEXT[tc]   || '#374151';
        modulesHtml += `
          <div class="det-module-row">
            <div class="det-mod-num" style="background:${color};color:white">${i + 1}</div>
            <div class="det-mod-info">
              <div class="det-mod-title">${m.titre}</div>
              ${m.description ? `<div class="det-mod-desc">${m.description}</div>` : ''}
            </div>
            <span class="det-mod-type" style="background:${bg};color:${fg}">${icon} ${m.type_contenu || ''}</span>
            ${m.duree_minutes ? `<span class="det-mod-dur">⏱ ${m.duree_minutes}min</span>` : ''}
          </div>`;
      });
    }

    const costLabel = f.cout > 0 ? `${parseFloat(f.cout).toLocaleString('fr-FR')} DTN` : 'Gratuit';

    document.getElementById('detailsContent').innerHTML = `
      <div class="det-header" style="background:${color}">
        <div class="det-header-chips">
          <span class="det-chip">${f.typeFormation?.replace('_',' ') || ''}</span>
          <span class="det-chip">${f.categorie}</span>
        </div>
        <h2 class="det-title">${f.titre}</h2>
      </div>
      <div class="det-meta-grid">
        <div class="det-meta-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
          <div><div class="det-meta-val">${f.duree}h</div><div class="det-meta-lbl">Durée</div></div>
        </div>
        ${data.estimation ? `<div class="det-meta-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <div><div class="det-meta-val">${data.estimation}</div><div class="det-meta-lbl">Estimation</div></div>
        </div>` : ''}
        <div class="det-meta-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M12 6v6l4 2"/></svg>
          <div><div class="det-meta-val">${costLabel}</div><div class="det-meta-lbl">Coût</div></div>
        </div>
        <div class="det-meta-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="${color}" stroke-width="2"><polyline points="20,6 9,17 4,12"/></svg>
          <div><div class="det-meta-val">${f.statutFormation}</div><div class="det-meta-lbl">Statut</div></div>
        </div>
      </div>
      ${f.description ? `<div class="det-section"><div class="det-section-title">📝 Description</div><p class="det-desc">${f.description}</p></div>` : ''}
      <div class="det-section">
        <div class="det-section-title">📚 Programme — ${mods.length} module${mods.length > 1 ? 's' : ''}</div>
        <div class="det-modules-list">${modulesHtml}</div>
      </div>`;
  } catch(e) {
    document.getElementById('detailsContent').innerHTML =
      `<div class="det-error">❌ Impossible de charger les détails : ${e.message}</div>`;
  }
}

function closeDetails() {
  document.getElementById('modalDetails').style.display = 'none';
}

// ══ CANCEL INSCRIPTION MODAL ═══════════════════════════════════════════════
function openCancelModal(formationId, titre) {
  document.getElementById('cancelSubText').textContent =
    `Vous allez vous désinscrire de « ${titre} ». Votre progression sera perdue.`;
  document.getElementById('formDesinscrire').action = `/formation/${formationId}/desinscrire`;
  document.getElementById('modalCancel').style.display = 'flex';
}
function closeCancelModal() {
  document.getElementById('modalCancel').style.display = 'none';
}
</script>

<style>
/* ── Cancel inscription button ── */
.btn-cancel-insc{
  background:#FEF2F2;color:#DC2626;border:1px solid #FECACA;
  padding:7px 13px;border-radius:8px;font-size:.78rem;font-weight:700;cursor:pointer;
  transition:all .15s;
}
.btn-cancel-insc:hover{background:#FEE2E2;border-color:#F87171}

/* ── Modals shared ── */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1000;display:flex;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(3px)}
.modal-box{background:white;border-radius:20px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);animation:modalIn .2s ease;display:flex;flex-direction:column}
@keyframes modalIn{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}

/* ── Details modal ── */
.modal-details-box{max-width:580px}
.det-loading{display:flex;align-items:center;gap:.75rem;padding:2rem;color:#6B7280;font-size:.9rem}
.det-spinner{width:20px;height:20px;border:2px solid #E5E7EB;border-top-color:#4F46E5;border-radius:50%;animation:spin .7s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.det-error{padding:1.5rem;color:#DC2626;font-size:.9rem}

.det-header{padding:1.5rem 1.75rem 1.25rem;border-radius:20px 20px 0 0;color:white}
.det-header-chips{display:flex;gap:.4rem;margin-bottom:.65rem;flex-wrap:wrap}
.det-chip{background:rgba(255,255,255,.22);font-size:.68rem;font-weight:800;padding:3px 10px;border-radius:20px;letter-spacing:.04em;text-transform:uppercase}
.det-title{font-size:1.3rem;font-weight:800;line-height:1.2;margin:0}

.det-meta-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border-bottom:1px solid #F1F5F9}
.det-meta-item{display:flex;align-items:center;gap:.6rem;padding:.9rem 1rem;border-right:1px solid #F1F5F9}
.det-meta-item:last-child{border-right:none}
.det-meta-val{font-size:.9rem;font-weight:800;color:#0F172A}
.det-meta-lbl{font-size:.65rem;color:#94A3B8;margin-top:1px;text-transform:uppercase;letter-spacing:.04em}

.det-section{padding:1rem 1.75rem}
.det-section-title{font-size:.8rem;font-weight:800;color:#374151;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.75rem;display:flex;align-items:center;gap:.4rem}
.det-desc{font-size:.88rem;color:#475569;line-height:1.6;margin:0}

.det-modules-list{display:flex;flex-direction:column;gap:.5rem}
.det-module-row{display:flex;align-items:center;gap:.75rem;padding:.65rem .85rem;background:#F8FAFC;border-radius:10px;border:1px solid #E2E8F0;transition:background .15s}

{% extends 'base.html.twig' %}

{% block title %}Mini Map{% endblock %}

{% block body %}
<div style="max-width:720px;margin:3rem auto;text-align:center;">
    <div style="font-size:64px;margin-bottom:1rem;">🗺️</div>
    <h1 style="font-family:var(--font-serif);font-size:2rem;color:var(--text-dark);margin-bottom:.75rem;">
        Mini Map
    </h1>
    <p style="color:var(--text-mid);font-size:1rem;line-height:1.6;margin-bottom:2rem;">
        Ce module est en cours de développement.<br>
        Il offrira une visualisation interactive des espaces et événements : plan des étages, disponibilité en temps réel et localisation des salles de réunion.
    </p>
    <span style="display:inline-block;padding:6px 18px;border-radius:20px;background:rgba(93,184,122,0.12);color:var(--accent-green);font-weight:600;font-size:13px;">
        🔧 En construction
    </span>
</div>
{% endblock %}

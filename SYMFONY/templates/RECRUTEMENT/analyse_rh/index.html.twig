{% extends 'base.html.twig' %}

{% block title %}Analyse RH{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --bg:      #f5f7fa;
    --card:    #ffffff;
    --border:  #e2e8f0;
    --text:    #0f172a;
    --muted:   #64748b;
    --muted2:  #94a3b8;
    --purple:  #7c3aed;
    --indigo:  #4f46e5;
    --green:   #059669;
    --amber:   #d97706;
    --sky:     #0ea5e9;
    --red:     #ef4444;
    --radius:  14px;
    --shadow:  0 1px 4px rgba(0,0,0,.07), 0 3px 10px rgba(0,0,0,.04);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: 'DM Sans', sans-serif; background: var(--bg); color: var(--text); font-size: 14px; }

/* ── Header ── */
.arh-header { margin-bottom: 28px; }
.arh-header h1 { font-size: 26px; font-weight: 700; color: var(--text); }
.arh-header p  { font-size: 13px; color: var(--muted); margin-top: 3px; }

/* ── KPI Grid ── */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
    margin-bottom: 24px;
}
.kpi-card {
    background: var(--card);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
}
.kpi-bar {
    height: 4px;
    border-radius: var(--radius) var(--radius) 0 0;
}
.kpi-body { padding: 16px 20px 18px; }
.kpi-icon { font-size: 20px; margin-bottom: 8px; }
.kpi-num  {
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
}
.kpi-label { font-size: 12px; color: var(--muted); margin-bottom: 6px; }
.kpi-sub   { font-size: 11px; font-weight: 500; }

/* couleurs */
.kpi-purple .kpi-bar { background: linear-gradient(90deg,#7c3aed,#a78bfa); }
.kpi-purple .kpi-num { color: var(--purple); }
.kpi-purple .kpi-sub { color: var(--purple); }

.kpi-indigo .kpi-bar { background: linear-gradient(90deg,#4f46e5,#818cf8); }
.kpi-indigo .kpi-num { color: var(--indigo); }
.kpi-indigo .kpi-sub { color: var(--indigo); }

.kpi-green .kpi-bar { background: linear-gradient(90deg,#10b981,#34d399); }
.kpi-green .kpi-num { color: var(--green); }
.kpi-green .kpi-sub { color: var(--green); }

.kpi-amber .kpi-bar { background: linear-gradient(90deg,#f59e0b,#fbbf24); }
.kpi-amber .kpi-num { color: var(--amber); }
.kpi-amber .kpi-sub { color: var(--amber); }

.kpi-sky .kpi-bar { background: linear-gradient(90deg,#0ea5e9,#38bdf8); }
.kpi-sky .kpi-num { color: var(--sky); }
.kpi-sky .kpi-sub { color: var(--sky); }

/* ── Chart cards ── */
.charts-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}
.chart-card {
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 20px 20px 16px;
}
.chart-card-full {
    background: var(--card);
    border-radius: var(--radius);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    padding: 20px 20px 16px;
    margin-bottom: 20px;
}
.chart-header {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 18px;
}
.chart-header-icon { font-size: 18px; line-height: 1.4; }
.chart-title {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 2px;
}
.chart-sub {
    font-size: 11px;
    color: var(--muted2);
}
.chart-canvas-wrap { position: relative; height: 240px; }
.chart-canvas-wrap-lg { position: relative; height: 260px; }
</style>
{% endblock %}

{% block body %}

{# ── Header ── #}
<div class="arh-header">
    <h1>Analyse RH</h1>
    <p>Indicateurs clés de recrutement et tendances</p>
</div>

{# ── KPI Cards ── #}
<div class="kpi-grid">

    <div class="kpi-card kpi-purple">
        <div class="kpi-bar"></div>
        <div class="kpi-body">
            <div class="kpi-icon">🔄</div>
            <div class="kpi-num">{{ kpi_internes }}</div>
            <div class="kpi-label">Candidatures Internes</div>
            <div class="kpi-sub">↗ Mobilité interne</div>
        </div>
    </div>

    <div class="kpi-card kpi-indigo">
        <div class="kpi-bar"></div>
        <div class="kpi-body">
            <div class="kpi-icon">👤</div>
            <div class="kpi-num">{{ kpi_externes }}</div>
            <div class="kpi-label">Candidatures Externes</div>
            <div class="kpi-sub">↗ Recrutement externe</div>
        </div>
    </div>

    <div class="kpi-card kpi-green">
        <div class="kpi-bar"></div>
        <div class="kpi-body">
            <div class="kpi-icon">✅</div>
            <div class="kpi-num">{{ kpi_taux }}</div>
            <div class="kpi-label">Taux d'Acceptation</div>
            <div class="kpi-sub">→ Niveau de sélection</div>
        </div>
    </div>

    <div class="kpi-card kpi-amber">
        <div class="kpi-bar"></div>
        <div class="kpi-body">
            <div class="kpi-icon">🤖</div>
            <div class="kpi-num">{{ kpi_score }}</div>
            <div class="kpi-label">Score IA Moyen</div>
            <div class="kpi-sub">→ Matching candidats</div>
        </div>
    </div>

    <div class="kpi-card kpi-sky">
        <div class="kpi-bar"></div>
        <div class="kpi-body">
            <div class="kpi-icon">📌</div>
            <div class="kpi-num">{{ kpi_postes }}</div>
            <div class="kpi-label">Postes Ouverts</div>
            <div class="kpi-sub">↗ Offres actives</div>
        </div>
    </div>

</div>

{# ── Charts row : Bar + Pie ── #}
<div class="charts-row">

    <div class="chart-card">
        <div class="chart-header">
            <span class="chart-header-icon">📊</span>
            <div>
                <div class="chart-title">Candidatures par type de contrat</div>
                <div class="chart-sub">Distribution CDI, CDD, Stage, Mission</div>
            </div>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="barChart"></canvas>
        </div>
    </div>

    <div class="chart-card">
        <div class="chart-header">
            <span class="chart-header-icon">🥧</span>
            <div>
                <div class="chart-title">Répartition par statut</div>
                <div class="chart-sub">Accepté, En cours, Refusé</div>
            </div>
        </div>
        <div class="chart-canvas-wrap">
            <canvas id="pieChart"></canvas>
        </div>
    </div>

</div>

{# ── Line chart ── #}
<div class="chart-card-full">
    <div class="chart-header">
        <span class="chart-header-icon">📈</span>
        <div>
            <div class="chart-title">Évolution des candidatures</div>
            <div class="chart-sub">Tendance mensuelle — internes et externes</div>
        </div>
    </div>
    <div class="chart-canvas-wrap-lg">
        <canvas id="lineChart"></canvas>
    </div>
</div>
{% endblock %}

{# Chart.js dans <head> + init sur turbo:load (UX Turbo n’exécute pas les <script> du body) #}
{% block javascripts %}
{{ parent() }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
(function () {
    const barLabels  = {{ bar_labels|raw }};
    const barData    = {{ bar_data|raw }};
    const pieLabels  = {{ pie_labels|raw }};
    const pieData    = {{ pie_data|raw }};
    const lineLabels = {{ line_labels|raw }};
    const lineData   = {{ line_data|raw }};

    function destroyIfAny(id) {
        const el = document.getElementById(id);
        if (!el || typeof Chart === 'undefined') return;
        const ch = Chart.getChart(el);
        if (ch) ch.destroy();
    }

    function initAnalyseRhCharts() {
        const barEl = document.getElementById('barChart');
        if (!barEl) return;

        destroyIfAny('barChart');
        destroyIfAny('pieChart');
        destroyIfAny('lineChart');

        Chart.defaults.font.family = "'DM Sans', sans-serif";
        Chart.defaults.color = '#64748b';

        new Chart(barEl, {
            type: 'bar',
            data: {
                labels: barLabels,
                datasets: [{
                    label: 'Candidatures',
                    data: barData,
                    backgroundColor: '#2563eb',
                    borderRadius: 6,
                    barPercentage: 0.55,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#fff',
                        bodyColor: '#94a3b8',
                        padding: 10,
                        cornerRadius: 8,
                    }
                },
                scales: {
                    x: {
                        grid: { display: false },
                        ticks: { font: { size: 12 }, color: '#64748b' },
                        border: { display: false }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { size: 11 }, color: '#64748b' },
                        grid: { color: '#f1f5f9', lineWidth: 1 },
                        border: { display: false, dash: [4, 4] }
                    }
                }
            }
        });

        new Chart(document.getElementById('pieChart'), {
            type: 'pie',
            data: {
                labels: pieLabels,
                datasets: [{
                    data: pieData,
                    backgroundColor: ['#059669', '#2563eb', '#ef4444'],
                    borderWidth: 2,
                    borderColor: '#ffffff',
                    hoverOffset: 8,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: {
                            padding: 18,
                            font: { size: 12 },
                            usePointStyle: true,
                            pointStyleWidth: 10,
                        }
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#fff',
                        bodyColor: '#94a3b8',
                        padding: 10,
                        cornerRadius: 8,
                    }
                }
            }
        });

        new Chart(document.getElementById('lineChart'), {
            type: 'line',
            data: {
                labels: lineLabels,
                datasets: [{
                    label: 'Candidatures',
                    data: lineData,
                    borderColor: '#2563eb',
                    backgroundColor: 'rgba(37,99,235,0.06)',
                    borderWidth: 2.5,
                    pointRadius: 5,
                    pointBackgroundColor: '#ffffff',
                    pointBorderColor: '#f59e0b',
                    pointBorderWidth: 2,
                    pointHoverRadius: 7,
                    fill: true,
                    tension: 0.15,
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'bottom',
                        labels: { usePointStyle: true, pointStyleWidth: 10, font: { size: 12 }, padding: 16 }
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        titleColor: '#fff',
                        bodyColor: '#94a3b8',
                        padding: 10,
                        cornerRadius: 8,
                    }
                },
                scales: {
                    x: {
                        grid: { color: '#f1f5f9' },
                        ticks: { font: { size: 12 }, color: '#64748b' },
                        border: { display: false },
                        title: { display: true, text: 'Mois', color: '#94a3b8', font: { size: 11 } }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, maxTicksLimit: 8, font: { size: 11 }, color: '#64748b' },
                        grid: { color: '#f1f5f9', lineWidth: 1 },
                        border: { display: false, dash: [4, 4] },
                        title: { display: true, text: 'Nombre de candidatures', color: '#94a3b8', font: { size: 11 } }
                    }
                }
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAnalyseRhCharts, { once: true });
    } else {
        initAnalyseRhCharts();
    }
})();
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ candidature_interne.posteActuel }} → {{ candidature_interne.nouveauPoste }}{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root { --purple:#6c3fc5; --green:#10b981; --red:#ef4444; --orange:#f59e0b; --border:#e2e8f0; --bg:#f4f6fb; --text:#1e293b; --muted:#64748b; }
  body { font-family:'DM Sans',sans-serif; background:var(--bg); color:var(--text); }

  .show-wrap { max-width:760px; margin:40px auto; }
  .back { display:inline-flex; align-items:center; gap:6px; color:var(--muted); font-size:.88rem; text-decoration:none; margin-bottom:20px; }
  .back:hover { color:var(--purple); }

  .show-card { background:#fff; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.08); overflow:hidden; }

  .show-banner {
    background: linear-gradient(135deg, #6c3fc5 0%, #4c2d9c 100%);
    padding: 28px 32px;
    display: flex; align-items: center; gap: 20px;
  }
  .show-avatar {
    width:60px; height:60px; border-radius:50%;
    background:rgba(255,255,255,.2); color:#fff;
    font-size:1.3rem; font-weight:700;
    display:flex; align-items:center; justify-content:center;
    border:3px solid rgba(255,255,255,.35); flex-shrink:0;
  }
  .show-banner h1 { color:#fff; font-size:1.3rem; font-weight:700; margin-bottom:4px; }
  .show-banner p  { color:rgba(255,255,255,.7); font-size:.85rem; }
  .show-banner .arrow { color:rgba(255,255,255,.6); margin:0 8px; }

  .show-body { padding:28px 32px; }

  .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }
  .info-item label {
    display:block; font-size:.75rem; font-weight:600;
    color:var(--muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px;
  }
  .info-item span { font-size:.95rem; font-weight:500; }

  .motif-box {
    background:var(--bg); border-radius:10px;
    padding:16px 20px; margin-bottom:24px;
    border-left:4px solid var(--purple);
    font-size:.92rem; line-height:1.6; color:var(--text);
  }
  .motif-box strong { display:block; font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); margin-bottom:6px; }

  .badge { padding:4px 14px; border-radius:20px; font-size:.78rem; font-weight:600; }
  .badge.orange { background:#fef3c7; color:#b45309; }
  .badge.green  { background:#d1fae5; color:#065f46; }
  .badge.red    { background:#fee2e2; color:#991b1b; }
  .badge.purple { background:#ede9fe; color:#6c3fc5; }

  .show-actions { display:flex; gap:10px; align-items:center; padding-top:20px; border-top:1px solid var(--border); }
  .btn-edit-link {
    display:inline-flex; align-items:center; gap:6px;
    padding:10px 22px; border-radius:8px; border:none;
    background:#fef9ec; color:#b45309;
    font-size:.88rem; font-family:inherit; font-weight:600;
    cursor:pointer; text-decoration:none; transition:background .2s;
  }
  .btn-edit-link:hover { background:#fde68a; }
</style>
{% endblock %}

{% block body %}
<div class="show-wrap">
  <a href="{{ path('app_candidature_interne_index') }}" class="back">← Retour à la liste</a>

  <div class="show-card">
    <div class="show-banner">
      {% set words = candidature_interne.posteActuel|split(' ') %}
      {% set ini = (words|first|first ~ (words|length > 1 ? words[1]|first : words|first|slice(1,1)))|upper %}
      <div class="show-avatar">{{ ini }}</div>
      <div>
        <h1>
          {{ candidature_interne.posteActuel }}
          <span class="arrow">→</span>
          {{ candidature_interne.nouveauPoste }}
        </h1>
        <p>Demande #{{ candidature_interne.id }}</p>
      </div>
    </div>

    <div class="show-body">
      <div class="info-grid">
        <div class="info-item">
          <label>Date de la demande</label>
          <span>{{ candidature_interne.dateDemande ? candidature_interne.dateDemande|date('d/m/Y') : '—' }}</span>
        </div>
        <div class="info-item">
          <label>Dernière modification</label>
          <span>{{ candidature_interne.derniereModification ? candidature_interne.derniereModification|date('d/m/Y H:i') : '—' }}</span>
        </div>
        {% if candidature_interne.nouveauSalaire is defined and candidature_interne.nouveauSalaire %}
        <div class="info-item">
          <label>Nouveau salaire</label>
          <span>{{ candidature_interne.nouveauSalaire|number_format(0,',','') }} TND</span>
        </div>
        {% endif %}
        {% if candidature_interne.statut is defined %}
        <div class="info-item">
          <label>Statut</label>
          <span>
            <span class="badge
              {% if candidature_interne.statut == 'En attente' %}orange
              {% elseif candidature_interne.statut == 'Approuvée' %}green
              {% elseif candidature_interne.statut == 'Refusée' %}red
              {% else %}purple{% endif %}">
              {{ candidature_interne.statut }}
            </span>
          </span>
        </div>
        {% endif %}
      </div>

      {% if candidature_interne.motif %}
      <div class="motif-box">
        <strong>Motif de la demande</strong>
        {{ candidature_interne.motif }}
      </div>
      {% endif %}

      <div class="show-actions">
        <a href="{{ path('app_candidature_interne_edit', {'id': candidature_interne.id}) }}" class="btn-edit-link">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Modifier
        </a>
        {{ include('RECRUTEMENT/candidature_interne/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}

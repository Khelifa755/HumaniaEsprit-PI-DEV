{% extends 'base.html.twig' %}

{% block title %}Modifier la demande interne{% endblock %}

{% block body %}
<div style="max-width: 760px; margin: 40px auto; background:#fff; border-radius:16px; padding:28px; box-shadow:0 4px 24px rgba(0,0,0,.08);">
  <a href="{{ path('app_candidature_interne_index') }}" style="display:inline-block; margin-bottom:16px; color:#64748b; text-decoration:none;">
    ← Retour à la liste
  </a>
  <h1 style="margin:0 0 20px; font-size:1.35rem;">Modifier la demande</h1>

  {{ include('RECRUTEMENT/candidature_interne/_form.html.twig', {
    form: form,
    button_label: 'Mettre à jour',
    form_action: path('app_candidature_interne_edit', {'id': candidature_interne.id})
  }) }}

  <hr style="margin:20px 0; border:none; border-top:1px solid #e2e8f0;">
  {{ include('RECRUTEMENT/candidature_interne/_delete_form.html.twig') }}
</div>
{% endblock %}

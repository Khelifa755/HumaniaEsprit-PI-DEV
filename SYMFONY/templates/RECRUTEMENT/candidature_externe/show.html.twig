{% extends 'base.html.twig' %}

{% block title %}{{ candidature_externe.prenom }} {{ candidature_externe.nom }} — Candidature{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root { --purple:#6c3fc5; --green:#10b981; --red:#ef4444; --orange:#f59e0b; --blue:#3b82f6; --border:#e2e8f0; --bg:#f4f6fb; --text:#1e293b; --muted:#64748b; }
  body { font-family:'DM Sans',sans-serif; background:var(--bg); color:var(--text); }

  .show-wrapper { max-width:760px; margin:40px auto; }

  .back-link {
    display:inline-flex; align-items:center; gap:6px;
    color:var(--muted); font-size:.88rem; text-decoration:none; margin-bottom:20px;
  }
  .back-link:hover { color:var(--purple); }

  .show-card {
    background:#fff; border-radius:16px;
    box-shadow:0 4px 24px rgba(0,0,0,.08);
    overflow:hidden;
  }

  .show-banner {
    background:linear-gradient(135deg,#6c3fc5 0%,#5530a8 100%);
    padding:30px 32px;
    display:flex; align-items:center; gap:20px;
  }
  .show-avatar {
    width:64px; height:64px; border-radius:50%;
    background:rgba(255,255,255,.25);
    color:#fff; font-size:1.4rem; font-weight:700;
    display:flex; align-items:center; justify-content:center;
    border:3px solid rgba(255,255,255,.4);
  }
  .show-banner h1 { color:#fff; font-size:1.5rem; font-weight:700; margin-bottom:4px; }
  .show-banner p  { color:rgba(255,255,255,.75); font-size:.88rem; }

  .show-body { padding:28px 32px; }

  .info-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:28px;
  }
  .info-item label {
    display:block; font-size:.75rem; font-weight:600;
    color:var(--muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px;
  }
  .info-item span {
    font-size:.95rem; font-weight:500; color:var(--text);
  }

  .badge {
    padding:4px 14px; border-radius:20px; font-size:.78rem; font-weight:600;
  }
  .badge.orange { background:#fef3c7; color:#b45309; }
  .badge.green  { background:#d1fae5; color:#065f46; }
  .badge.red    { background:#fee2e2; color:#991b1b; }
  .badge.blue   { background:#dbeafe; color:#1d4ed8; }
  .badge.purple { background:#ede9fe; color:#6c3fc5; }

  .show-actions {
    display:flex; gap:10px; align-items:center;
    padding-top:20px; border-top:1px solid var(--border);
  }
  .btn-edit-page {
    display:inline-flex; align-items:center; gap:6px;
    padding:10px 22px; border-radius:8px; border:none;
    background:#fef9ec; color:#b45309;
    font-size:.88rem; font-family:inherit; font-weight:600;
    cursor:pointer; text-decoration:none; transition:background .2s;
  }
  .btn-edit-page:hover { background:#fde68a; }
</style>
{% endblock %}

{% block body %}
<div class="show-wrapper">
  <a href="{{ path('app_candidature_externe_index') }}" class="back-link">← Retour à la liste</a>

  <div class="show-card">
    <div class="show-banner">
      <div class="show-avatar">
        {{ (candidature_externe.nom|first ~ candidature_externe.prenom|first)|upper }}
      </div>
      <div>
        <h1>{{ candidature_externe.prenom }} {{ candidature_externe.nom }}</h1>
        <p>Candidature #{{ candidature_externe.id }} · Poste #{{ candidature_externe.posteExterneId }}</p>
      </div>
    </div>

    <div class="show-body">
      <div class="info-grid">
        <div class="info-item">
          <label>Date de dépôt</label>
          <span>{{ candidature_externe.dateDepot ? candidature_externe.dateDepot|date('d/m/Y') : '—' }}</span>
        </div>
        <div class="info-item">
          <label>Dernière modification</label>
          <span>{{ candidature_externe.derniereModification ? candidature_externe.derniereModification|date('d/m/Y H:i') : '—' }}</span>
        </div>
        <div class="info-item">
          <label>Statut</label>
          <span>
            <span class="badge
              {% if candidature_externe.statut == 'En attente' %}orange
              {% elseif candidature_externe.statut == 'Acceptée' %}green
              {% elseif candidature_externe.statut == 'Refusée' %}red
              {% elseif candidature_externe.statut == 'En entretien' %}blue
              {% else %}purple{% endif %}">
              {{ candidature_externe.statut }}
            </span>
          </span>
        </div>
        <div class="info-item">
          <label>Étape pipeline</label>
          <span>{{ candidature_externe.etapePipeline ?? '—' }}</span>
        </div>
        <div class="info-item">
          <label>Scoring IA</label>
          <span>{{ candidature_externe.scoringIa ?? '—' }}</span>
        </div>
        <div class="info-item">
          <label>CV</label>
          <span>
            {% if candidature_externe.cvUrl %}
              <a href="{{ candidature_externe.cvUrl }}" target="_blank" style="color:#6c3fc5">Voir le CV ↗</a>
            {% else %}—{% endif %}
          </span>
        </div>
        {% if candidature_externe.lettreMotivationUrl %}
        <div class="info-item" style="grid-column:1/-1">
          <label>Lettre de motivation</label>
          <span><a href="{{ candidature_externe.lettreMotivationUrl }}" target="_blank" style="color:#6c3fc5">Voir la lettre ↗</a></span>
        </div>
        {% endif %}
      </div>

      <div class="show-actions">
        <a href="{{ path('app_candidature_externe_edit', {'id': candidature_externe.id}) }}" class="btn-edit-page">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Modifier
        </a>
        {{ include('RECRUTEMENT/candidature_externe/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}HUMANIA{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
        <style>
            :root {
                --humania-red: #e11d48;
                --humania-blue: #2563eb;
                --humania-yellow: #eab308;
                --humania-green: #16a34a;
                --nav-bg: #eef1f6;
                --nav-header: #7eb8e8;
                --nav-text: #1e293b;
                --nav-muted: #64748b;
                --sidebar-w: 272px;
            }

            * { box-sizing: border-box; }
            html, body { min-height: 100%; margin: 0; }

            .app-layout {
                display: flex;
                min-height: 100vh;
                font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
                color: var(--nav-text);
                background: #f4f6f9;
            }

            .app-sidebar {
                width: var(--sidebar-w);
                flex-shrink: 0;
                background: var(--nav-bg);
                display: flex;
                flex-direction: column;
                border-right: 1px solid #e2e8f0;
                position: relative;
            }

            .app-sidebar::after {
                content: '';
                position: absolute;
                top: 0;
                right: 0;
                width: 4px;
                height: 100%;
                background: linear-gradient(180deg,
                    var(--humania-red) 0%,
                    var(--humania-blue) 33%,
                    var(--humania-yellow) 66%,
                    var(--humania-green) 100%);
                opacity: 0.85;
            }

            .brand {
                padding: 28px 22px 20px;
                border-bottom: 1px solid #e2e8f0;
            }

            .brand__logo {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: inherit;
            }

            .brand__h {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--humania-red) 0%, var(--humania-yellow) 40%, var(--humania-blue) 70%, var(--humania-green) 100%);
                display: grid;
                place-items: center;
                font-family: 'DM Serif Display', Georgia, serif;
                font-size: 1.35rem;
                font-weight: 400;
                color: #fff;
                text-shadow: 0 1px 2px rgba(0,0,0,.2);
            }

            .brand__name {
                font-family: 'DM Serif Display', Georgia, serif;
                font-size: 1.5rem;
                font-weight: 400;
                color: #0f172a;
                letter-spacing: 0.02em;
            }

            .brand__tag {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 8px;
                margin-left: 56px;
                font-size: 0.75rem;
                color: #60a5fa;
                font-weight: 500;
            }

            .brand__dots span {
                display: inline-block;
                width: 6px;
                height: 6px;
                border-radius: 50%;
                margin-right: 3px;
            }
            .brand__dots span:nth-child(1) { background: var(--humania-red); }
            .brand__dots span:nth-child(2) { background: var(--humania-blue); }
            .brand__dots span:nth-child(3) { background: var(--humania-yellow); }
            .brand__dots span:nth-child(4) { background: var(--humania-green); }

            .nav-scroll {
                flex: 1;
                overflow-y: auto;
                padding: 12px 0 16px;
            }

            .nav-section {
                border: none;
                margin: 0;
                padding: 0 12px;
            }

            .nav-section + .nav-section {
                margin-top: 6px;
            }

            .nav-section summary {
                list-style: none;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 10px 8px;
                font-size: 0.68rem;
                font-weight: 700;
                letter-spacing: 0.12em;
                color: var(--nav-header);
                user-select: none;
            }

            .nav-section summary::-webkit-details-marker { display: none; }

            .nav-section summary::after {
                content: '';
                width: 0;
                height: 0;
                border-left: 4px solid transparent;
                border-right: 4px solid transparent;
                border-top: 5px solid var(--nav-header);
                opacity: 0.7;
            }

            .nav-section[open] summary::after {
                transform: rotate(180deg);
            }

            .nav-section__links {
                display: flex;
                flex-direction: column;
                gap: 2px;
                padding-bottom: 8px;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 12px 10px 14px;
                border-radius: 10px;
                text-decoration: none;
                color: var(--nav-text);
                font-size: 0.875rem;
                font-weight: 500;
                transition: background .15s, color .15s;
                border-left: 4px solid transparent;
                margin-left: 0;
            }

            .nav-link:hover {
                background: rgba(255,255,255,.65);
            }

            .nav-link--active {
                background: rgba(22, 163, 74, 0.12);
                color: var(--humania-green);
                border-left-color: var(--humania-green);
            }

            .nav-link__icon {
                width: 38px;
                height: 38px;
                border-radius: 10px;
                display: grid;
                place-items: center;
                flex-shrink: 0;
            }

            .nav-link__icon--blue { background: #dbeafe; color: #1d4ed8; }
            .nav-link__icon--green { background: #dcfce7; color: #15803d; }
            .nav-link__icon--yellow { background: #fef9c3; color: #a16207; }
            .nav-link__icon--pink { background: #fce7f3; color: #be185d; }

            .sidebar-footer {
                margin-top: auto;
                padding: 16px 18px;
                border-top: 3px solid transparent;
                border-image: linear-gradient(90deg, var(--humania-red), var(--humania-blue), var(--humania-yellow), var(--humania-green)) 1;
                background: rgba(255,255,255,.5);
            }

            .sidebar-footer__row {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .sidebar-footer__avatar {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: #f1f5f9;
                display: grid;
                place-items: center;
                font-family: 'DM Serif Display', Georgia, serif;
                font-size: 1rem;
                font-weight: 400;
                color: #0f172a;
            }

            .sidebar-footer__meta { flex: 1; min-width: 0; }

            .sidebar-footer__name {
                font-weight: 700;
                font-size: 0.9rem;
                color: #0f172a;
            }

            .sidebar-footer__email {
                font-size: 0.72rem;
                color: var(--nav-muted);
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .sidebar-footer__badge {
                display: inline-block;
                margin-top: 6px;
                font-size: 0.62rem;
                font-weight: 700;
                letter-spacing: 0.06em;
                color: #fff;
                background: #ec4899;
                padding: 3px 8px;
                border-radius: 6px;
            }

            .sidebar-footer__logout {
                margin-left: auto;
                width: 40px;
                height: 40px;
                border: none;
                border-radius: 10px;
                background: transparent;
                color: var(--nav-muted);
                cursor: pointer;
                display: grid;
                place-items: center;
                transition: background .15s, color .15s;
            }

            .sidebar-footer__logout:hover {
                background: #e2e8f0;
                color: #0f172a;
            }

            .app-main {
                flex: 1;
                min-width: 0;
                overflow-x: auto;
                padding: 28px 32px 40px;
            }

            @media (max-width: 900px) {
                .app-layout { flex-direction: column; }
                .app-sidebar {
                    width: 100%;
                    max-height: none;
                }
                .app-sidebar::after { display: none; }
                .nav-scroll {
                    max-height: 50vh;
                }
            }
        </style>
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% set current = app.request.attributes.get('_route')|default('') %}
        {% set ph = app.request.attributes.get('section') %}
        <div class="app-layout">
            <aside class="app-sidebar">
                <div class="brand">
                    <a href="{{ path('app_home') }}" class="brand__logo">
                        <span class="brand__h">H</span>
                        <span class="brand__name">HUMANIA</span>
                    </a>
                    <div class="brand__tag">
                        <span class="brand__dots"><span></span><span></span><span></span><span></span></span>
                        RH · Management
                    </div>
                </div>

                <nav class="nav-scroll" aria-label="Navigation principale">
                    <details class="nav-section" open>
                        <summary>Utilisateurs</summary>
                        <div class="nav-section__links">
                            <a href="{{ path('app_placeholder', {section: 'utilisateurs'}) }}" class="nav-link {% if current == 'app_placeholder' and ph == 'utilisateurs' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--blue" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                                </span>
                                Gestion Utilisateurs
                            </a>
                            <a href="{{ path('app_placeholder', {section: 'candidats-acceptes'}) }}" class="nav-link {% if current == 'app_placeholder' and ph == 'candidats-acceptes' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--green" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                                </span>
                                Candidats Acceptés
                            </a>
                            <a href="{{ path('app_placeholder', {section: 'archives'}) }}" class="nav-link {% if current == 'app_placeholder' and ph == 'archives' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--yellow" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                                </span>
                                Archives
                            </a>
                        </div>
                    </details>

                    <details class="nav-section" open>
                        <summary>Recrutement</summary>
                        <div class="nav-section__links">
                            <a href="{{ path('app_candidature_interne_index') }}" class="nav-link {% if current is not empty and current starts with 'app_candidature_interne' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--blue" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                                </span>
                                Candidature interne
                            </a>
                            <a href="{{ path('app_candidature_externe_index') }}" class="nav-link {% if current is not empty and current starts with 'app_candidature_externe' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--blue" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h8"/><path d="M8 11h8"/></svg>
                                </span>
                                Candidature externe
                            </a>
                            <a href="{{ path('app_document_index') }}" class="nav-link {% if current is not empty and current starts with 'app_document' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--yellow" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h11a2 2 0 0 1 2 2z"/></svg>
                                </span>
                                Documents
                            </a>
                            <a href="{{ path('app_poste_externe_index') }}" class="nav-link {% if current is not empty and current starts with 'app_poste_externe' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--green" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                                </span>
                                Poste externe
                            </a>
                            <a href="{{ path('app_poste_interne_index') }}" class="nav-link {% if current is not empty and current starts with 'app_poste_interne' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--green" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                                </span>
                                Poste interne
                            </a>
                            <a href="{{ path('app_analyse_rh_index') }}" class="nav-link {% if current is not empty and current starts with 'app_analyse_rh' %}nav-link--active{% endif %}" data-turbo="false">
                                <span class="nav-link__icon nav-link__icon--pink" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 4 4-6"/></svg>
                                </span>
                                Analyse RH
                            </a>
                            <a href="{{ path('app_analyse_cv_index') }}" class="nav-link {% if current is not empty and current starts with 'app_analyse_cv' %}nav-link--active{% endif %}" data-turbo="false">
                                <span class="nav-link__icon nav-link__icon--yellow" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/><path d="M10 9H8"/></svg>
                                </span>
                                Analyse CV
                            </a>
                        </div>
                    </details>

                    <details class="nav-section" open>
                        <summary>Social media</summary>
                        <div class="nav-section__links">
                            <a href="{{ path('app_placeholder', {section: 'reseaux-sociaux'}) }}" class="nav-link {% if current == 'app_placeholder' and ph == 'reseaux-sociaux' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--blue" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                                </span>
                                Réseaux sociaux
                            </a>
                        </div>
                    </details>

                    <details class="nav-section" open>
                        <summary>Compétences</summary>
                        <div class="nav-section__links">
                            <a href="{{ path('app_placeholder', {section: 'competences'}) }}" class="nav-link {% if current == 'app_placeholder' and ph == 'competences' %}nav-link--active{% endif %}">
                                <span class="nav-link__icon nav-link__icon--yellow" aria-hidden="true">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                                </span>
                                Compétences
                            </a>
                        </div>
                    </details>
                </nav>

                <div class="sidebar-footer">
                    <div class="sidebar-footer__row">
                        <div class="sidebar-footer__avatar">SY</div>
                        <div class="sidebar-footer__meta">
                            <div class="sidebar-footer__name">System Admin</div>
                            <div class="sidebar-footer__email">admin@humania.com</div>
                            <span class="sidebar-footer__badge">ADMIN</span>
                        </div>
                        <button type="button" class="sidebar-footer__logout" title="Déconnexion" aria-label="Déconnexion">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                        </button>
                    </div>
                </div>
            </aside>

            <main class="app-main">
                {% block body %}{% endblock %}
            </main>
        </div>
    </body>
</html>

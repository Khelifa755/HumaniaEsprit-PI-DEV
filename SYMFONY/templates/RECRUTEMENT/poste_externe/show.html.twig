{% extends 'base.html.twig' %}

{% block title %}{{ poste_externe.titre }} — Poste Externe{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root { --cyan:#06b6d4; --green:#10b981; --red:#ef4444; --orange:#f59e0b; --purple:#8b5cf6; --border:#e2e8f0; --bg:#f4f6fb; --text:#1e293b; --muted:#64748b; }
  body { font-family:'DM Sans',sans-serif; background:var(--bg); color:var(--text); }

  .show-wrap { max-width:800px; margin:40px auto; }
  .back { display:inline-flex; align-items:center; gap:6px; color:var(--muted); font-size:.88rem; text-decoration:none; margin-bottom:20px; }
  .back:hover { color:var(--cyan); }

  .show-card { background:#fff; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.08); overflow:hidden; }

  .show-banner {
    background: linear-gradient(135deg, #0891b2 0%, #06b6d4 60%, #22d3ee 100%);
    padding: 28px 32px;
    display: flex; align-items: center; gap: 20px;
  }
  .banner-icon {
    width: 64px; height: 64px; border-radius: 16px;
    background: rgba(255,255,255,.2);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; border: 2px solid rgba(255,255,255,.3);
  }
  .show-banner h1 { color:#fff; font-size:1.4rem; font-weight:700; margin-bottom:5px; }
  .show-banner p  { color:rgba(255,255,255,.75); font-size:.85rem; }
  .banner-badges  { display:flex; gap:8px; margin-top:8px; flex-wrap:wrap; }

  .badge { padding:4px 13px; border-radius:20px; font-size:.76rem; font-weight:600; }
  .badge-ouvert  { background:rgba(255,255,255,.9); color:#065f46; }
  .badge-ferme   { background:rgba(255,255,255,.6); color:#475569; }
  .badge-haute   { background:#fee2e2; color:#991b1b; }
  .badge-moyenne { background:#fef3c7; color:#b45309; }
  .badge-basse   { background:#e0f2fe; color:#0369a1; }
  .badge-cdi     { background:#ede9fe; color:#6d28d9; }
  .badge-cdd     { background:#dbeafe; color:#1d4ed8; }
  .badge-other   { background:#f1f5f9; color:#64748b; }

  .show-body { padding:28px 32px; }

  .info-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }
  .info-item label { display:block; font-size:.75rem; font-weight:600; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px; }
  .info-item span  { font-size:.95rem; font-weight:500; }

  .desc-box {
    background:var(--bg); border-radius:10px; padding:18px 20px;
    margin-bottom:20px; border-left:4px solid var(--cyan);
    font-size:.92rem; line-height:1.65; color:var(--text);
  }
  .desc-box strong { display:block; font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); margin-bottom:6px; }

  .comp-box {
    background:#f0fdf4; border-radius:10px; padding:16px 20px;
    margin-bottom:24px; border-left:4px solid var(--green);
    font-size:.9rem; line-height:1.6; color:var(--text);
  }
  .comp-box strong { display:block; font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; color:var(--muted); margin-bottom:6px; }

  .show-actions { display:flex; gap:10px; align-items:center; padding-top:20px; border-top:1px solid var(--border); }
  .btn-edit-link {
    display:inline-flex; align-items:center; gap:6px;
    padding:10px 22px; border-radius:8px; border:none;
    background:#fef9ec; color:#b45309;
    font-size:.88rem; font-family:inherit; font-weight:600;
    cursor:pointer; text-decoration:none; transition:background .2s;
  }
  .btn-edit-link:hover { background:#fde68a; }
</style>
{% endblock %}

{% block body %}
<div class="show-wrap">
  <a href="{{ path('app_poste_externe_index') }}" class="back">← Retour aux postes</a>

  <div class="show-card">
    <div class="show-banner">
      <div class="banner-icon">
        <svg width="30" height="30" fill="none" stroke="white" stroke-width="1.8" viewBox="0 0 24 24">
          <rect x="2" y="7" width="20" height="14" rx="2"/>
          <path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>
        </svg>
      </div>
      <div>
        <h1>{{ poste_externe.titre }}</h1>
        <p>Poste #{{ poste_externe.id }}</p>
        <div class="banner-badges">
          <span class="badge {{ poste_externe.statut == 'Ouvert' ? 'badge-ouvert' : 'badge-ferme' }}">
            {{ poste_externe.statut }}
          </span>
          {% if poste_externe.priorite %}
          <span class="badge
            {% if poste_externe.priorite == 'Haute' %}badge-haute
            {% elseif poste_externe.priorite == 'Moyenne' %}badge-moyenne
            {% else %}badge-basse{% endif %}">
            {{ poste_externe.priorite }}
          </span>
          {% endif %}
          {% if poste_externe.typeContrat %}
          <span class="badge
            {% if poste_externe.typeContrat == 'CDI' %}badge-cdi
            {% elseif poste_externe.typeContrat == 'CDD' %}badge-cdd
            {% else %}badge-other{% endif %}">
            {{ poste_externe.typeContrat }}
          </span>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="show-body">
      {% if poste_externe.description %}
      <div class="desc-box">
        <strong>Description</strong>
        {{ poste_externe.description }}
      </div>
      {% endif %}

      <div class="info-grid">
        <div class="info-item">
          <label>Date de publication</label>
          <span>{{ poste_externe.datePublication ? poste_externe.datePublication|date('d/m/Y') : '—' }}</span>
        </div>
        <div class="info-item">
          <label>Date de clôture</label>
          <span>{{ poste_externe.dateCloture ? poste_externe.dateCloture|date('d/m/Y') : '—' }}</span>
        </div>
        {% if poste_externe.salaire %}
        <div class="info-item">
          <label>Salaire</label>
          <span>{{ poste_externe.salaire|number_format(0,',','') }} TND</span>
        </div>
        {% endif %}
        {% if poste_externe.nombreEmploye %}
        <div class="info-item">
          <label>Postes disponibles</label>
          <span>{{ poste_externe.nombreEmploye }}</span>
        </div>
        {% endif %}
        {% if poste_externe.experienceRequise %}
        <div class="info-item">
          <label>Expérience requise</label>
          <span>{{ poste_externe.experienceRequise }}</span>
        </div>
        {% endif %}
        {% if poste_externe.niveauEtudeRequis %}
        <div class="info-item">
          <label>Niveau d'étude</label>
          <span>{{ poste_externe.niveauEtudeRequis }}</span>
        </div>
        {% endif %}
      </div>

      {% if poste_externe.competencesRequises %}
      <div class="comp-box">
        <strong>Compétences requises</strong>
        {{ poste_externe.competencesRequises }}
      </div>
      {% endif %}

      <div class="show-actions">
        <a href="{{ path('app_poste_externe_edit', {'id': poste_externe.id}) }}" class="btn-edit-link">
          <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
          Modifier
        </a>
        {{ include('RECRUTEMENT/poste_externe/_delete_form.html.twig') }}
      </div>
    </div>
  </div>
</div>
{% endblock %}

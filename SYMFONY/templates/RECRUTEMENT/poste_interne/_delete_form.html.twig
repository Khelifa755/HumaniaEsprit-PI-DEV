<form method="post" action="{{ path('app_poste_interne_delete', {'id': poste_interne.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ poste_interne.id) }}">
    <button type="submit" class="btn-del-inline"
        onclick="return confirm('Supprimer ce poste ?')">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;vertical-align:middle;margin-right:4px"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
        Supprimer ce poste
    </button>
</form>

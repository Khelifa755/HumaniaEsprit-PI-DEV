{% extends 'base.html.twig' %}

{% block title %}Événements — Humania{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Page header ─────────────────────────────────────────────────────────── */
.page-header {
    display: flex; align-items: flex-start; justify-content: space-between;
    margin-bottom: 24px; gap: 1rem; flex-wrap: wrap;
}
.page-header-text h1  { font-size: 1.75rem; font-weight: 700; margin: 0 0 4px; color: #0f172a; }
.page-header-text p   { margin: 0; color: #94a3b8; font-size: .9rem; }

/* ── Add button ──────────────────────────────────────────────────────────── */
.btn-add-event {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .65rem 1.35rem; background: #2563eb; color: #fff;
    border: none; border-radius: 10px; font-size: .92rem; font-weight: 700;
    cursor: pointer; white-space: nowrap;
    box-shadow: 0 2px 10px rgba(37,99,235,.28);
    transition: background .18s, box-shadow .18s;
    font-family: inherit;
}
.btn-add-event:hover { background: #1d4ed8; box-shadow: 0 4px 16px rgba(37,99,235,.38); }

/* ── Flash messages ──────────────────────────────────────────────────────── */
.flash { padding: .72rem 1rem; border-radius: 10px; font-size: .9rem; font-weight: 500; margin-bottom: 14px; }
.flash-success { background: #d1fae5; color: #065f46; border: 1px solid #6ee7b7; }
.flash-error   { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }

/* ── Search bar ──────────────────────────────────────────────────────────── */
.search-bar {
    display: flex; align-items: center; gap: 10px;
    background: #fff; border: 1.5px solid #e2e8f0; border-radius: 14px;
    padding: 10px 16px; margin-bottom: 16px; max-width: 420px;
    box-shadow: 0 1px 3px rgba(0,0,0,.06);
}
.search-bar input {
    border: none; outline: none; font-size: .9rem;
    font-family: inherit; color: #0f172a; background: transparent; flex: 1;
}
.search-bar input::placeholder { color: #94a3b8; }
.search-ico { font-size: 1rem; color: #94a3b8; line-height: 1; }

/* ── Status filter bar ───────────────────────────────────────────────────── */
.filter-bar {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    background: #fff; border: 1px solid #e2e8f0; border-radius: 14px;
    padding: 14px 20px; margin-bottom: 28px;
}
.filter-bar-label { font-size: .88rem; font-weight: 700; color: #0f172a; margin-right: 4px; }
.filter-btn {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 7px 16px; border-radius: 99px; font-size: .82rem; font-weight: 600;
    cursor: pointer; border: 1.5px solid #e2e8f0; background: #fff;
    color: #64748b; font-family: inherit; transition: background .15s, color .15s, border-color .15s;
}
.filter-btn:hover               { background: #f8fafc; border-color: #cbd5e1; }
.filter-btn.is-active           { background: #0f172a; color: #fff; border-color: #0f172a; }
.filter-btn.btn-avenir.is-active  { background: #2563eb; border-color: #2563eb; color: #fff; }
.filter-btn.btn-encours.is-active { background: #10b981; border-color: #10b981; color: #fff; }
.filter-btn.btn-termine.is-active { background: #1f2937; border-color: #1f2937; color: #fff; }

/* ── Cards grid ──────────────────────────────────────────────────────────── */
.cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 18px; }

/* ── Event card ──────────────────────────────────────────────────────────── */
.event-card {
    background: #fff; border-radius: 14px; border: 1px solid #e2e8f0;
    box-shadow: 0 1px 3px rgba(0,0,0,.08); padding: 20px;
    display: flex; flex-direction: column; gap: .85rem;
    transition: box-shadow .18s, transform .18s;
}
.event-card:hover { box-shadow: 0 6px 20px rgba(0,0,0,.09); transform: translateY(-1px); }

.card-header { display: flex; justify-content: space-between; gap: .5rem; align-items: flex-start; }
.card-title  { font-weight: 700; margin: 0 0 .25rem; font-size: 1rem; color: #0f172a; line-height: 1.35; }
.card-desc   { margin: 0; color: #94a3b8; font-size: .84rem; line-height: 1.45; }

.badge          { padding: .2rem .6rem; border-radius: 99px; font-size: .72rem; font-weight: 600; white-space: nowrap; flex-shrink: 0; }
.badge-done     { background: #1f2937; color: #fff; }
.badge-active   { background: #10b981; color: #fff; }
.badge-upcoming { background: #2563eb; color: #fff; }

.type-pill {
    display: inline-flex; align-items: center; gap: 5px;
    padding: 4px 12px; border-radius: 99px; font-size: .78rem; font-weight: 600;
    background: #fef3c7; color: #92400e; border: 1.5px solid #fde68a;
}

.card-meta   { display: grid; grid-template-columns: 1fr 1fr; gap: 5px 8px; }
.meta-item   { display: flex; align-items: center; gap: 5px; font-size: .8rem; color: #64748b; }

.capacity-label { display: flex; justify-content: space-between; font-size: .78rem; color: #64748b; margin-bottom: 5px; }
.capacity-bar   { height: 6px; background: #f1f5f9; border-radius: 99px; overflow: hidden; }
.capacity-fill  { height: 100%; background: #2563eb; border-radius: 99px; }

.card-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.card-tag  { padding: 3px 10px; border-radius: 99px; font-size: .75rem; color: #64748b; border: 1.5px solid #e2e8f0; background: #fff; }

/* ── Card footer ─────────────────────────────────────────────────────────── */
.card-footer {
    display: flex; gap: 8px; align-items: stretch;
    padding-top: 14px; border-top: 1px solid #f1f5f9; margin-top: auto;
    flex-wrap: wrap;
}
/* FIX #1: btn-details is now a <button> that triggers the modal — no broken href */
.btn-details {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    flex: 1; padding: 8px 10px; border: 1.5px solid #e2e8f0; border-radius: 10px;
    background: #fff; color: #1e293b; font-size: .82rem; font-weight: 600;
    text-decoration: none; font-family: inherit; cursor: pointer;
    transition: background .15s, border-color .15s;
    white-space: nowrap;
}
.btn-details:hover { background: #f8fafc; border-color: #cbd5e1; }

.btn-edit-ev {
    display: inline-flex; align-items: center; justify-content: center; gap: 5px;
    flex: 1; padding: 8px 10px; border-radius: 10px; font-size: .82rem; font-weight: 700;
    border: none; background: #f59e0b; color: #fff; cursor: pointer;
    font-family: inherit; transition: background .18s, transform .12s;
    white-space: nowrap;
}
.btn-edit-ev:hover { background: #d97706; transform: scale(1.02); }

.btn-delete-ev {
    display: inline-flex; align-items: center; justify-content: center; gap: 5px;
    flex: 1; padding: 8px 10px; border-radius: 10px; font-size: .82rem; font-weight: 700;
    background: #fff; color: #ef4444; border: 2px solid #ef4444;
    cursor: pointer; font-family: inherit; transition: background .18s, color .18s;
    white-space: nowrap;
}
.btn-delete-ev:hover { background: #ef4444; color: #fff; }

/* ── Empty state ─────────────────────────────────────────────────────────── */
.empty-grid { grid-column: 1 / -1; text-align: center; padding: 3rem; color: #94a3b8; }

/* ══ Modal overlay ═══════════════════════════════════════════════════════════ */
.modal-overlay {
    position: fixed; inset: 0;
    background: rgba(15,23,42,.5);
    display: none; align-items: center; justify-content: center;
    z-index: 900;
    animation: moFade .15s ease;
}
.modal-overlay.is-open { display: flex; }
@keyframes moFade { from { opacity: 0; } to { opacity: 1; } }

.modal-box {
    background: #fff; border-radius: 16px;
    box-shadow: 0 12px 48px rgba(15,23,42,.18);
    width: 540px; max-width: 95vw; max-height: 90vh; overflow-y: auto;
    animation: moUp .18s ease;
}
@keyframes moUp { from { transform: translateY(20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

.modal-head {
    position: relative; padding: 1.1rem 1.5rem 1rem;
    border-bottom: 1.5px solid #f1f5f9;
}
.modal-title { font-size: 1.1rem; font-weight: 800; color: #0f172a; margin: 0; }
.modal-close {
    position: absolute; top: .9rem; right: 1.1rem;
    background: none; border: none; font-size: 1.1rem;
    color: #94a3b8; cursor: pointer; line-height: 1; transition: color .15s;
}
.modal-close:hover { color: #0f172a; }

.modal-form { padding: 1.25rem 1.5rem; }

.mf-group { margin-bottom: 1rem; }
.mf-lbl {
    display: block; font-size: .83rem; font-weight: 700;
    color: #374151; margin-bottom: .3rem;
}
.mf-lbl .req { color: #ef4444; }
.mf-input {
    width: 100%; padding: .58rem .85rem;
    border: 1.5px solid #e2e8f0; border-radius: 8px;
    font-size: .92rem; color: #0f172a; background: #f8fafc;
    outline: none; box-sizing: border-box;
    transition: border-color .2s, background .2s; font-family: inherit;
}
.mf-input:focus { border-color: #2563eb; background: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
textarea.mf-input { resize: vertical; min-height: 72px; }
.mf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
.mf-row .mf-group { margin-bottom: 0; }

.modal-footer {
    display: flex; justify-content: flex-end; gap: .75rem;
    padding: .9rem 1.5rem 1.25rem; border-top: 1.5px solid #f1f5f9;
}
.btn-cancel {
    padding: .6rem 1.3rem; background: #fff; color: #ef4444;
    border: 2px solid #ef4444; border-radius: 8px;
    font-size: .9rem; font-weight: 700; cursor: pointer;
    transition: background .18s, color .18s; font-family: inherit;
}
.btn-cancel:hover { background: #ef4444; color: #fff; }
.btn-save {
    padding: .6rem 1.5rem; background: #2563eb; color: #fff;
    border: none; border-radius: 8px;
    font-size: .9rem; font-weight: 700; cursor: pointer;
    transition: background .2s; font-family: inherit;
}
.btn-save:hover { background: #1d4ed8; }

/* ── Details read-only modal ─────────────────────────────────────────────── */
.detail-row {
    display: flex; gap: .75rem; align-items: flex-start;
    padding: .65rem 0; border-bottom: 1px solid #f8fafc;
    font-size: .9rem; color: #374151;
}
.detail-row:last-child { border-bottom: none; }
.detail-row strong { min-width: 130px; color: #0f172a; font-weight: 700; }
.modal-detail-body { padding: 1.25rem 1.5rem 1.5rem; }
</style>
{% endblock %}

{% block body %}
<div id="evenement-public-root">

{# ── Flash ── #}
{% for msg in app.flashes('success') %}
    <div class="flash flash-success">✅ {{ msg }}</div>
{% endfor %}
{% for msg in app.flashes('error') %}
    <div class="flash flash-error">⚠ {{ msg }}</div>
{% endfor %}

{# ── Page header ── #}
<div class="page-header">
    <div class="page-header-text">
        <h1>Événements</h1>
        <p>Découvrez et participez aux événements à venir</p>
    </div>
    <button type="button" class="btn-add-event" onclick="openNewModal()">
        ＋ Ajouter un événement
    </button>
</div>

{# ── Search ── #}
<div class="search-bar">
    <span class="search-ico" aria-hidden="true">🔍</span>
    <input type="search" id="searchEv" placeholder="Rechercher un événement…"
           autocomplete="off" oninput="filterEv()">
</div>

{# ── Status filter bar ── #}
<div class="filter-bar" role="group" aria-label="Filtrer par statut">
    <span class="filter-bar-label">Statut :</span>
    <button type="button" class="filter-btn is-active"    data-filter="all"     aria-pressed="true">Tous</button>
    <button type="button" class="filter-btn btn-avenir"   data-filter="avenir"  aria-pressed="false">📅 À venir</button>
    <button type="button" class="filter-btn btn-encours"  data-filter="encours" aria-pressed="false">▶ En cours</button>
    <button type="button" class="filter-btn btn-termine"  data-filter="termine" aria-pressed="false">✓ Terminé</button>
</div>

{# ── Cards grid ── #}
<div class="cards-grid" id="cardsGrid">
{% for evenement in evenements %}

    {% set now_ts  = "now"|date("U") %}
    {% set debut   = evenement.dateHeureDebut ? evenement.dateHeureDebut|date("U") : 0 %}
    {% set fin     = evenement.dateHeureFin   ? evenement.dateHeureFin|date("U")   : 0 %}

    {% if fin < now_ts %}
        {% set statusLabel = "Terminé"  %} {% set statusClass = "badge-done"     %} {% set statusKey = "termine" %}
    {% elseif debut <= now_ts and fin >= now_ts %}
        {% set statusLabel = "En cours" %} {% set statusClass = "badge-active"   %} {% set statusKey = "encours" %}
    {% else %}
        {% set statusLabel = "À venir"  %} {% set statusClass = "badge-upcoming" %} {% set statusKey = "avenir"  %}
    {% endif %}

    {% set raw      = evenement.participantsInscrits|default('')|trim %}
    {% set inscrits = raw is empty ? 0 : raw|split(',')|length %}
    {% set pct      = evenement.nbParticipantsMax > 0 ? ((inscrits / evenement.nbParticipantsMax) * 100)|round : 0 %}

    <div class="event-card" id="event-{{ evenement.id }}" data-title="{{ evenement.titre|lower }}" data-status="{{ statusKey }}"
         data-ev-titre="{{ evenement.titre|e('html_attr') }}"
         data-ev-desc="{{ evenement.description|default('')|e('html_attr') }}"
         data-ev-lieu="{{ evenement.lieu|default('—')|e('html_attr') }}"
         data-ev-date="{{ evenement.dateEvenement ? evenement.dateEvenement|date('d/m/Y') : '—' }}"
         data-ev-debut="{{ evenement.dateHeureDebut ? evenement.dateHeureDebut|date('H:i') : '—' }}"
         data-ev-fin="{{ evenement.dateHeureFin ? evenement.dateHeureFin|date('H:i') : '—' }}"
         data-ev-max="{{ evenement.nbParticipantsMax|default(0) }}">

        <div class="card-header">
            <div>
                <p class="card-title">{{ evenement.titre }}</p>
                <p class="card-desc">{{ evenement.description|slice(0, 100) }}{% if evenement.description|length > 100 %}…{% endif %}</p>
            </div>
            <span class="badge {{ statusClass }}">{{ statusLabel }}</span>
        </div>

        <div><span class="type-pill">🏷 Événement</span></div>

        <div class="card-meta">
            <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                {{ evenement.dateEvenement ? evenement.dateEvenement|date('d M Y') : '—' }}
            </span>
            <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
                {{ evenement.lieu ?: '—' }}
            </span>
            <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                {{ evenement.nbParticipantsMax ?: '0' }} max
            </span>
            <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                {{ evenement.dateHeureDebut ? evenement.dateHeureDebut|date('H:i') : '—' }}
                – {{ evenement.dateHeureFin ? evenement.dateHeureFin|date('H:i') : '—' }}
            </span>
        </div>

        <div>
            <div class="capacity-label"><span>Capacité</span><span>{{ pct }}%</span></div>
            <div class="capacity-bar"><div class="capacity-fill" style="width:{{ pct }}%"></div></div>
        </div>

        <div class="card-tags">
            <span class="card-tag">Entreprise</span>
            <span class="card-tag">Interne</span>
        </div>

        {# ── Footer: details modal + edit + delete ── #}
        <div class="card-footer">

            {# FIX #1: was a broken <a href="..."> pointing to a non-existent route;
               now a <button> that opens a read-only details modal. #}
            <button type="button" class="btn-details"
                    onclick="openDetailsModal(
                        '{{ evenement.titre|e('js') }}',
                        '{{ evenement.description|default('')|e('js') }}',
                        '{{ evenement.lieu|default('—')|e('js') }}',
                        '{{ evenement.dateEvenement ? evenement.dateEvenement|date('d/m/Y') : '—' }}',
                        '{{ evenement.dateHeureDebut ? evenement.dateHeureDebut|date('H:i') : '—' }}',
                        '{{ evenement.dateHeureFin   ? evenement.dateHeureFin|date('H:i')   : '—' }}',
                        {{ evenement.nbParticipantsMax|default(0) }}
                    )">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                Détails
            </button>

            <button type="button" class="btn-edit-ev"
                onclick="openEditModal(
                    {{ evenement.id }},
                    '{{ evenement.titre|e('js') }}',
                    '{{ evenement.description|default('')|e('js') }}',
                    '{{ evenement.dateHeureDebut ? evenement.dateHeureDebut|date('Y-m-d\\TH:i') : '' }}',
                    '{{ evenement.dateHeureFin   ? evenement.dateHeureFin|date('Y-m-d\\TH:i')   : '' }}',
                    '{{ evenement.lieu|default('')|e('js') }}',
                    {{ evenement.nbParticipantsMax|default(1) }}
                )">✎ Modifier</button>

            <form method="post"
                  action="{{ path('app_evenement_delete', {'id': evenement.id}) }}"
                  data-delete-form data-name="{{ evenement.titre|e('html_attr') }}"
                  style="display:contents;">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                <button type="submit" class="btn-delete-ev">🗑</button>
            </form>
        </div>

    </div>
{% else %}
    <p class="empty-grid">Aucun événement disponible.</p>
{% endfor %}
</div>{# /cards-grid #}

</div>{# /evenement-public-root #}


{# ════════════════════════════════════════════════════════════════════════════
   MODAL — Détails (read-only)  ← FIX #1
════════════════════════════════════════════════════════════════════════════ #}
<div id="modalDetails" class="modal-overlay" onclick="if(event.target===this)closeDetailsModal()">
    <div class="modal-box">
        <div class="modal-head">
            <h3 class="modal-title" id="mdTitle">Détails</h3>
            <button class="modal-close" onclick="closeDetailsModal()" aria-label="Fermer">✕</button>
        </div>
        <div class="modal-detail-body">
            <div class="detail-row"><strong>Titre :</strong>       <span id="mdTitre"></span></div>
            <div class="detail-row"><strong>Description :</strong> <span id="mdDesc"  style="white-space:pre-line;"></span></div>
            <div class="detail-row"><strong>Lieu :</strong>        <span id="mdLieu"></span></div>
            <div class="detail-row"><strong>Date :</strong>        <span id="mdDate"></span></div>
            <div class="detail-row"><strong>Horaires :</strong>    <span id="mdHeures"></span></div>
            <div class="detail-row"><strong>Participants max :</strong> <span id="mdMax"></span></div>
        </div>
    </div>
</div>


{# ════════════════════════════════════════════════════════════════════════════
   MODAL — Nouvel événement
════════════════════════════════════════════════════════════════════════════ #}
<div id="modalNew" class="modal-overlay" onclick="if(event.target===this)closeNewModal()">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">➕ Nouvel Événement</h3>
      <button class="modal-close" onclick="closeNewModal()">✕</button>
    </div>
    <form method="post" action="{{ path('app_evenement_new') }}" class="modal-form">

      <div class="mf-group">
        <label class="mf-lbl">Titre <span class="req">*</span></label>
        <input type="text" name="titre" class="mf-input" required
               placeholder="Ex : Réunion d'équipe, Team building…">
      </div>

      <div class="mf-group">
        <label class="mf-lbl">Description</label>
        <textarea name="description" class="mf-input"
                  placeholder="Décrivez l'événement…"></textarea>
      </div>

      <div class="mf-row">
        <div class="mf-group">
          <label class="mf-lbl">Date &amp; heure de début <span class="req">*</span></label>
          <input type="datetime-local" name="dateHeureDebut" class="mf-input" required>
        </div>
        <div class="mf-group">
          <label class="mf-lbl">Date &amp; heure de fin <span class="req">*</span></label>
          <input type="datetime-local" name="dateHeureFin" class="mf-input" required>
        </div>
      </div>

      <div class="mf-row">
        <div class="mf-group">
          <label class="mf-lbl">Lieu</label>
          <input type="text" name="lieu" class="mf-input" placeholder="Ex : Salle A, Paris…">
        </div>
        <div class="mf-group">
          <label class="mf-lbl">Participants max</label>
          <input type="number" name="nbParticipantsMax" class="mf-input" min="1" value="10">
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeNewModal()">Annuler</button>
        <button type="submit" class="btn-save">✅ Enregistrer</button>
      </div>
    </form>
  </div>
</div>


{# ════════════════════════════════════════════════════════════════════════════
   MODAL — Modifier événement
════════════════════════════════════════════════════════════════════════════ #}
<div id="modalEdit" class="modal-overlay" onclick="if(event.target===this)closeEditModal()">
  <div class="modal-box">
    <div class="modal-head">
      <h3 class="modal-title">✏ Modifier l'Événement</h3>
      <button class="modal-close" onclick="closeEditModal()">✕</button>
    </div>
    <form method="post" id="formEdit" action="" class="modal-form">

      <div class="mf-group">
        <label class="mf-lbl">Titre <span class="req">*</span></label>
        <input type="text" name="titre" id="edit_titre" class="mf-input" required>
      </div>

      <div class="mf-group">
        <label class="mf-lbl">Description</label>
        <textarea name="description" id="edit_description" class="mf-input"></textarea>
      </div>

      <div class="mf-row">
        <div class="mf-group">
          <label class="mf-lbl">Date &amp; heure de début <span class="req">*</span></label>
          <input type="datetime-local" name="dateHeureDebut" id="edit_debut" class="mf-input" required>
        </div>
        <div class="mf-group">
          <label class="mf-lbl">Date &amp; heure de fin <span class="req">*</span></label>
          <input type="datetime-local" name="dateHeureFin" id="edit_fin" class="mf-input" required>
        </div>
      </div>

      <div class="mf-row">
        <div class="mf-group">
          <label class="mf-lbl">Lieu</label>
          <input type="text" name="lieu" id="edit_lieu" class="mf-input">
        </div>
        <div class="mf-group">
          <label class="mf-lbl">Participants max</label>
          <input type="number" name="nbParticipantsMax" id="edit_max" class="mf-input" min="1">
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn-cancel" onclick="closeEditModal()">Annuler</button>
        <button type="submit" class="btn-save">💾 Mettre à jour</button>
      </div>
    </form>
  </div>
</div>


<script>
(function () {
    'use strict';

    /* ── Details modal (read-only) ───────────────────────────────────────── */
    window.openDetailsModal = function (titre, desc, lieu, date, debut, fin, max) {
        document.getElementById('mdTitle').textContent  = '📋 ' + titre;
        document.getElementById('mdTitre').textContent  = titre;
        document.getElementById('mdDesc').textContent   = desc || '—';
        document.getElementById('mdLieu').textContent   = lieu;
        document.getElementById('mdDate').textContent   = date;
        document.getElementById('mdHeures').textContent = debut + ' – ' + fin;
        document.getElementById('mdMax').textContent    = max > 0 ? max : '—';
        document.getElementById('modalDetails').classList.add('is-open');
    };
    window.closeDetailsModal = function () {
        document.getElementById('modalDetails').classList.remove('is-open');
    };

    /* ── New modal ───────────────────────────────────────────────────────── */
    window.openNewModal  = function () { document.getElementById('modalNew').classList.add('is-open'); };
    window.closeNewModal = function () { document.getElementById('modalNew').classList.remove('is-open'); };

    /* ── Edit modal ──────────────────────────────────────────────────────── */
    window.openEditModal = function (id, titre, description, debut, fin, lieu, max) {
        document.getElementById('formEdit').action = '/evenement/' + id + '/edit';
        document.getElementById('edit_titre').value       = titre;
        document.getElementById('edit_description').value = description;
        document.getElementById('edit_debut').value       = debut;
        document.getElementById('edit_fin').value         = fin;
        document.getElementById('edit_lieu').value        = lieu;
        document.getElementById('edit_max').value         = max;
        document.getElementById('modalEdit').classList.add('is-open');
    };
    window.closeEditModal = function () { document.getElementById('modalEdit').classList.remove('is-open'); };

    /* ── Delete confirm ──────────────────────────────────────────────────── */
    document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-delete-form] button[type="submit"]');
        if (!btn) return;
        e.preventDefault();
        var form = btn.closest('[data-delete-form]');
        var name = form.dataset.name || 'cet événement';
        if (confirm('Supprimer l\'événement « ' + name + ' » ? Cette action est irréversible.')) {
            form.submit();
        }
    });

    /* ── Escape to close ─────────────────────────────────────────────────── */
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            window.closeNewModal();
            window.closeEditModal();
            window.closeDetailsModal();
        }
    });

    /* ── Search + status filter ──────────────────────────────────────────── */
    var activeFilter = 'all';

    function applyFilters() {
        var q = (document.getElementById('searchEv').value || '').toLowerCase();
        document.querySelectorAll('#cardsGrid .event-card').forEach(function (card) {
            var titleMatch  = (card.dataset.title  || '').includes(q);
            var statusMatch = activeFilter === 'all' || card.dataset.status === activeFilter;
            card.style.display = (titleMatch && statusMatch) ? '' : 'none';
        });
    }

    window.filterEv = applyFilters;
    document.getElementById('searchEv').addEventListener('input', applyFilters);

    document.querySelectorAll('.filter-bar .filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.querySelectorAll('.filter-bar .filter-btn').forEach(function (b) {
                b.classList.remove('is-active');
                b.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('is-active');
            btn.setAttribute('aria-pressed', 'true');
            activeFilter = btn.dataset.filter;
            applyFilters();
        });
    });

    /* ── Auto-open modal from URL hash (e.g. #event-5) ──────────────────── */
    (function() {
        const hash = window.location.hash;
        if (!hash || !hash.startsWith('#event-')) return;
        const card = document.querySelector(hash);
        if (!card) return;
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.style.transition = 'box-shadow 0.3s';
        card.style.boxShadow  = '0 0 0 3px #2563eb, 0 6px 20px rgba(37,99,235,.25)';
        setTimeout(() => { card.style.boxShadow = ''; }, 2500);
        // Auto-open detail modal
        window.openDetailsModal(
            card.dataset.evTitre,
            card.dataset.evDesc,
            card.dataset.evLieu,
            card.dataset.evDate,
            card.dataset.evDebut,
            card.dataset.evFin,
            parseInt(card.dataset.evMax, 10)
        );
    })();

})();
</script>
{% endblock %}

{# templates/PLANNIFICATION/reunion/_modal_nouvelle_reunion.html.twig #}
{# Partagé entre index.html.twig et calendar.html.twig                 #}

<div id="rm-overlay" class="rm-overlay" aria-hidden="true" role="presentation">
    <div class="rm-dialog" role="dialog" aria-modal="true" aria-labelledby="rm-dialog-title">

        {# ── Header ─────────────────────────────────────────────── #}
        <div class="rm-dialog__head">
            <div class="rm-dialog__head-left">
                <span class="rm-dialog__head-icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8"  y1="2" x2="8"  y2="6"/>
                        <line x1="3"  y1="10" x2="21" y2="10"/>
                        <line x1="12" y1="15" x2="12" y2="15" stroke-width="2" stroke-linecap="round"/>
                        <polyline points="8 15 10 17 14 13" stroke-width="2"/>
                    </svg>
                </span>
                <div>
                    <h2 id="rm-dialog-title" class="rm-dialog__title">Planifier une réunion</h2>
                    <p class="rm-dialog__subtitle">Remplissez les informations ci-dessous</p>
                </div>
            </div>
            <button type="button" class="rm-dialog__close" data-rm-close aria-label="Fermer">
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <line x1="18" y1="6"  x2="6"  y2="18"/>
                    <line x1="6"  y1="6"  x2="18" y2="18"/>
                </svg>
            </button>
        </div>

        {# ── Body ────────────────────────────────────────────────── #}
        <div class="rm-dialog__body">
            <div id="rm-form-errors"  class="rm-form-errors"  role="alert"  hidden></div>
            <div id="rm-form-success" class="rm-form-success" role="status" hidden></div>

            {{ form_start(form_create, {
                attr: { id: 'reunion-modal-form', class: 'rm-form', novalidate: 'novalidate' }
            }) }}

            {# Titre #}
            <div class="rm-field">
                {{ form_label(form_create.titre) }}
                {{ form_widget(form_create.titre, { attr: { placeholder: 'Ex : Réunion hebdomadaire équipe RH' } }) }}
                {{ form_errors(form_create.titre) }}
            </div>

            {# Description #}
            <div class="rm-field">
                {{ form_label(form_create.description) }}
                {{ form_widget(form_create.description, { attr: { placeholder: 'Objectifs, ordre du jour…' } }) }}
                {{ form_errors(form_create.description) }}
            </div>

            {# Début #}
            <p class="rm-section-label"><span>📅 Date &amp; heure de début</span></p>
            <div class="rm-row">
                <div class="rm-field">
                    <label>Date</label>
                    {{ form_widget(form_create.debut_date) }}
                    {{ form_errors(form_create.debut_date) }}
                </div>
                <div class="rm-field">
                    <label>Heure</label>
                    {{ form_widget(form_create.debut_time) }}
                    {{ form_errors(form_create.debut_time) }}
                </div>
            </div>

            {# Fin #}
            <p class="rm-section-label"><span>🏁 Date &amp; heure de fin</span></p>
            <div class="rm-row">
                <div class="rm-field">
                    <label>Date</label>
                    {{ form_widget(form_create.fin_date) }}
                    {{ form_errors(form_create.fin_date) }}
                </div>
                <div class="rm-field">
                    <label>Heure</label>
                    {{ form_widget(form_create.fin_time) }}
                    {{ form_errors(form_create.fin_time) }}
                </div>
            </div>

            {# Modalité #}
            <p class="rm-section-label"><span>📡 Modalité</span></p>

            <label class="rm-toggle-row" for="{{ form_create.enLigne.vars.id }}">
                <span class="rm-toggle">
                    {{ form_widget(form_create.enLigne) }}
                    <span class="rm-toggle__slider" aria-hidden="true"></span>
                </span>
                <span class="rm-toggle__text">
                    🎥 Réunion en ligne (Visioconférence)
                    <span>Activez pour générer un lien Zoom automatiquement</span>
                </span>
            </label>
            {{ form_errors(form_create.enLigne) }}

            <div class="rm-field" id="rm-salle-field">
                {{ form_label(form_create.idSalle) }}
                {{ form_widget(form_create.idSalle) }}
                {{ form_errors(form_create.idSalle) }}
            </div>

            {# Participants #}
            <p class="rm-section-label"><span>👥 Participants</span></p>
            <div class="rm-field">
                {{ form_widget(form_create.participants, {
                    attr: { placeholder: 'prenom.nom@entreprise.com, autre@mail.com…' }
                }) }}
                {{ form_errors(form_create.participants) }}
            </div>

            {# Footer actions #}
            <div class="rm-form-footer">
                <button type="button" class="rm-btn rm-btn--cancel" data-rm-close>Annuler</button>
                <button type="submit" class="rm-btn rm-btn--submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Créer la réunion
                </button>
            </div>

            {{ form_end(form_create) }}
        </div>{# /.rm-dialog__body #}
    </div>{# /.rm-dialog #}
</div>{# /#rm-overlay #}

{% extends 'base.html.twig' %}

{% block title %}Modifier — {{ reunion.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/reunion_modal.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid px-2 px-md-3 py-2" style="max-width: 720px;">
    <h1 class="h4 fw-bold mb-3">Modifier la réunion</h1>

    {{ form_start(form, { attr: { class: 'card border rounded-3 p-3 p-md-4 shadow-sm' } }) }}
        {{ form_widget(form) }}
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn text-white border-0 rounded-3" style="background:#7F77DD">Enregistrer</button>
            <a href="{{ path('app_reunion_show', { id: reunion.id }) }}" class="btn btn-outline-secondary rounded-3">Annuler</a>
        </div>
    {{ form_end(form) }}

    <form method="post" action="{{ path('app_reunion_delete', { id: reunion.id }) }}" class="mt-3"
          onsubmit="return confirm('Supprimer cette réunion ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reunion.id) }}">
        <button type="submit" class="btn btn-outline-danger btn-sm rounded-3">Supprimer</button>
    </form>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/reunion_modal.js') }}"></script>
{% endblock %}

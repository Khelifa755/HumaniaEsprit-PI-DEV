        color: #c00;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
</style>

<script>
    // Fetch stats on page load
    window.addEventListener('DOMContentLoaded', function() {
        loadAdminStats();
    });

    function loadAdminStats() {
        // Define colors for avatars (used in multiple sections)
        const avatarColors = ['blue', 'purple', 'teal', 'coral', 'amber'];
        const badgeColors = ['blue-light', 'purple-light', 'teal-light', 'coral-light', 'amber-light'];
        const barColors = ['#185FA5', '#534AB7', '#1D9E75', '#D85A30', '#BA7517'];
        
        fetch('/admin/api/stats', {
            method: 'GET',
            headers: {
                'Content-Type': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.error) {
                document.getElementById('summaryCards').innerHTML = `<div class="error">${data.error}</div>`;
                return;
            }

            // Render summary cards with weekly trend
            const summaryHtml = `
                <div class="stat-card">
                    <div class="stat-icon"><i class="fas fa-users" style="color: #185FA5;"></i></div>
                    <div><div class="stat-number">${data.summary.totalUsers}</div>
                    <div class="stat-label">Total Utilisateurs</div></div>
                    <div class="stat-trend">↑ +${data.weeklyTrend.users} cette semaine</div>
                </div>
                <div class="stat-card alt1">
                    <div class="stat-icon"><i class="fas fa-file-alt" style="color: #534AB7;"></i></div>
                    <div><div class="stat-number">${data.summary.totalPublications}</div>
                    <div class="stat-label">Total Publications</div></div>
                    <div class="stat-trend">↑ +${data.weeklyTrend.publications} cette semaine</div>
                </div>
                <div class="stat-card alt2">
                    <div class="stat-icon"><i class="fas fa-comments" style="color: #1D9E75;"></i></div>
                    <div><div class="stat-number">${data.summary.totalComments}</div>
                    <div class="stat-label">Total Commentaires</div></div>
                    <div class="stat-trend">↑ +${data.weeklyTrend.comments} cette semaine</div>
                </div>
                <div class="stat-card alt3">
                    <div class="stat-icon"><i class="fas fa-people-carry" style="color: #D85A30;"></i></div>
                    <div><div class="stat-number">${data.summary.totalGroups}</div>
                    <div class="stat-label">Total Groupes</div></div>
                    <div class="stat-trend">↑ +${data.weeklyTrend.groups} cette semaine</div>
                </div>
            `;
            document.getElementById('summaryCards').innerHTML = summaryHtml;

            // Render group stats with semantic colors and activity labels
            const maxPubs = Math.max(...data.groupStats.map(g => g.publications), 1);
            const groupHtml = data.groupStats.map((group, i) => {
                const progressPercent = (group.publications / maxPubs) * 100;
                
                // Determine activity level
                let activityClass, barColor, activityLabel;
                if (progressPercent >= 60) {
                    activityClass = 'activity-high';
                    barColor = '#639922';
                    activityLabel = 'actif';
                } else if (progressPercent >= 30) {
                    activityClass = 'activity-medium';
                    barColor = '#BA7517';
                    activityLabel = 'moyen';
                } else {
                    activityClass = 'activity-low';
                    barColor = '#E24B4A';
                    activityLabel = 'faible';
                }
                
                return `
                    <div class="group-item ${activityClass}">
                        <div class="group-info">
                            <a href="/social/groups/${group.id}" style="text-decoration: none;">
                                <span class="group-name">${group.name}</span>
                            </a>
                            <div class="group-stats">
                                <span class="group-stats-text">${group.publications} posts · ${group.members} membres</span>
                                <span class="group-activity-label">${activityLabel}</span>
                            </div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${progressPercent}%; background: ${barColor};"></div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('groupStats').innerHTML = groupHtml || '<p style="color: #65676b;">Aucun groupe</p>';

            // Render top contributors with colored avatars
            const topContributorsHtml = data.topContributors.map((user, i) => {
                const initials = user.firstName.charAt(0) + user.lastName.charAt(0);
                const avatarColor = avatarColors[i];
                const badgeColor = badgeColors[i];
                return `
                    <div class="user-item">
                        <div class="user-info">
                            <div class="user-avatar ${avatarColor}">${initials}</div>
                            <div class="user-details">
                                <span class="user-name">#${i + 1} ${user.firstName} ${user.lastName}</span>
                            </div>
                        </div>
                        <div class="user-count ${badgeColor}">${user.pubCount} posts</div>
                    </div>
                `;
            }).join('');
            document.getElementById('topContributors').innerHTML = topContributorsHtml || '<p style="color: #65676b;">Aucun contributeur</p>';

            // Render recent users with colored avatars and role
            const recentUsersHtml = data.recentUsers.map((user, i) => {
                const initials = user.name.split(' ')[0].charAt(0) + (user.name.split(' ')[1] ? user.name.split(' ')[1].charAt(0) : '');
                const avatarColor = avatarColors[i % avatarColors.length];
                return `
                    <div class="user-item">
                        <div class="user-info">
                            <div class="user-avatar ${avatarColor}">${initials}</div>
                            <div class="user-details">
                                <span class="user-name">${user.name}</span>
                                <span class="user-role">${user.role}</span>
                            </div>
                        </div>
                        <div class="user-count teal-light">📅 ${user.joinDate}</div>
                    </div>
                `;
            }).join('');
            document.getElementById('recentUsers').innerHTML = recentUsersHtml || '<p style="color: #65676b;">Aucun utilisateur</p>';

            // Initialize Activity Chart with filtering
            if (data.activityData && data.activityData.length > 0) {
                // Store full data for filtering
                window.chartData = data.activityData;
                window.currentChartFilter = 30;
                
                // Helper function to render chart with selected filter
                function renderActivityChart(days) {
                    const ctx = document.getElementById('activityChart').getContext('2d');
                    
                    // Filter data based on selected days
                    const filteredData = window.chartData.slice(-days);
                    
                    const dates = filteredData.map(d => d.date);
                    const publications = filteredData.map(d => d.publications);
                    const newUsers = filteredData.map(d => d.newUsers);
                    
                    // Destroy existing chart if any
                    if (window.activityChartInstance) {
                        window.activityChartInstance.destroy();
                    }
                    
                    window.activityChartInstance = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: dates,
                            datasets: [
                                {
                                    label: 'Publications',
                                    data: publications,
                                    borderColor: '#378ADD',
                                    backgroundColor: 'rgba(55, 138, 221, 0.1)',
                                    borderWidth: 2.5,
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: '#378ADD',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 1,
                                    pointRadius: 2,
                                    pointHoverRadius: 5
                                },
                                {
                                    label: 'Nouveaux Utilisateurs',
                                    data: newUsers,
                                    borderColor: '#1D9E75',
                                    backgroundColor: 'rgba(29, 158, 117, 0.1)',
                                    borderWidth: 2.5,
                                    fill: true,
                                    tension: 0.4,
                                    pointBackgroundColor: '#1D9E75',
                                    pointBorderColor: '#fff',
                                    pointBorderWidth: 1,
                                    pointRadius: 2,
                                    pointHoverRadius: 5
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: true,
                            interaction: {
                                intersect: false,
                                mode: 'index'
                            },
                            plugins: {
                                legend: {
                                    display: true,
                                    position: 'top',
                                    labels: {
                                        padding: 15,
                                        font: { size: 13, weight: '600' },
                                        usePointStyle: true,
                                        color: '#1A1D2E'
                                    }
                                },
                                tooltip: {
                                    backgroundColor: '#fff',
                                    titleColor: '#1A1D2E',
                                    bodyColor: '#1A1D2E',
                                    borderColor: '#E8EAF6',
                                    borderWidth: 1,
                                    padding: 12,
                                    displayColors: true,
                                    callbacks: {
                                        label: function(context) {
                                            let label = context.dataset.label || '';
                                            if (label) label += ': ';
                                            label += context.parsed.y;
                                            return label;
                                        }
                                    }
                                }
                            },
                            scales: {
                                y: {
                                    beginAtZero: true,
                                    ticks: {
                                        stepSize: 1,
                                        font: { size: 12 },
                                        color: '#65676b'
                                    },
                                    grid: {
                                        color: '#f0f0f0',
                                        drawBorder: false
                                    }
                                },
                                x: {
                                    grid: {
                                        display: false,
                                        drawBorder: false
                                    },
                                    ticks: {
                                        font: { size: 12 },
                                        color: '#65676b',
                                        maxTicksLimit: 7
                                    }
                                }
                            }
                        }
                    });
                    
                    // Update chart title
                    const titleText = days === 7 ? '7 derniers jours' : (days === 30 ? '30 derniers jours' : '90 derniers jours');
                    document.querySelector('[data-chart-title]').textContent = '📈 Activité (' + titleText + ')';
                }
                
                // Add data-chart-title attribute to the chart title
                const chartTitle = document.querySelector('#chartFilters').parentElement.querySelector('h2');
                chartTitle.setAttribute('data-chart-title', '📈 Activité (30 derniers jours)');
                
                // Initial render
                renderActivityChart(30);
                
                // Add filter button listeners
                document.querySelectorAll('.chart-filter-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const days = parseInt(this.getAttribute('data-days'));
                        window.currentChartFilter = days;
                        
                        // Update active button
                        document.querySelectorAll('.chart-filter-btn').forEach(b => b.classList.remove('active'));
                        this.classList.add('active');
                        
                        // Re-render chart
                        renderActivityChart(days);
                    });
                });
            }

            // Render inactive users
            const inactiveUsersHtml = data.inactiveUsers.map((user, i) => {
                const initials = user.name.split(' ')[0].charAt(0) + (user.name.split(' ')[1] ? user.name.split(' ')[1].charAt(0) : '');
                const avatarColor = avatarColors[i % avatarColors.length];
                return `
                    <div class="user-item">
                        <div class="user-info">
                            <div class="user-avatar ${avatarColor}">${initials}</div>
                            <div class="user-details">
                                <span class="user-name">${user.name}</span>
                                <span class="user-role">Jamais publié</span>
                            </div>
                        </div>
                        <div class="user-count red">0 posts</div>
                    </div>
                `;
            }).join('');
            document.getElementById('inactiveUsers').innerHTML = inactiveUsersHtml || '<p style="color: #65676b;">Aucun utilisateur inactif</p>';

            // Render engagement stats
            const engagementStatsHtml = data.groupStats.map((group, i) => {
                const barColor = barColors[i % barColors.length];
                let statusColor, statusText;
                if (group.engagementRate > 60) {
                    statusColor = '#4CAF50';
                    statusText = 'Excellent';
                } else if (group.engagementRate >= 30) {
                    statusColor = '#FFC107';
                    statusText = 'Bon';
                } else {
                    statusColor = '#F44336';
                    statusText = 'Faible';
                }
                const progressPercent = Math.min(group.engagementRate, 100);
                return `
                    <div class="group-item">
                        <div class="group-info">
                            <span class="group-name">${group.name}</span>
                            <div class="group-stats">${group.publications} posts · ${group.comments} commentaires</div>
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: ${progressPercent}%; background: ${statusColor};"></div>
                            </div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-weight: 700; color: ${statusColor}; font-size: 16px;">${group.engagementRate.toFixed(1)}%</div>
                            <div style="font-size: 12px; color: #65676b;">${statusText}</div>
                        </div>
                    </div>
                `;
            }).join('');
            document.getElementById('engagementStats').innerHTML = engagementStatsHtml || '<p style="color: #65676b;">Aucun groupe</p>';

        })
        .catch(error => {
            console.error('Error:', error);
            document.getElementById('summaryCards').innerHTML = `<div class="error">Erreur de chargement des statistiques</div>`;
        });
    }

</script>

{% endblock %}

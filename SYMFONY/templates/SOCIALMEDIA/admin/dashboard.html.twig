    }
    
    .stat-card.alt2 {
        background: #E1F5EE;
        color: #085041;
        border-left-color: #1D9E75;
    }
    
    .stat-card.alt3 {
        background: #FAECE7;
        color: #712B13;
        border-left-color: #D85A30;
    }

    .stat-icon {
        font-size: 32px;
        margin-bottom: 8px;
    }

    .stat-number {
        font-size: 48px;

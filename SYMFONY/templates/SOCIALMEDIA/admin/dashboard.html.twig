    }
    
    .group-item.activity-high {
        background: rgba(234, 243, 222, 0.5);
        border-color: rgba(208, 229, 184, 0.4);
    }
    
    .group-item.activity-medium {
        background: rgba(250, 238, 218, 0.5);
        border-color: rgba(244, 216, 168, 0.4);
    }
    
    .group-item.activity-low {

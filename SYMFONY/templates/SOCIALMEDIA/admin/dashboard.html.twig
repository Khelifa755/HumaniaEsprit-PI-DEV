        font-weight: 600;
    }
    
    .stat-card .stat-trend {
        background: #B5D4F4;
        color: #0C447C;
    }
    
    .stat-card.alt1 .stat-trend {
        background: #CECBF6;
        color: #3C3489;
    }
    
    .stat-card.alt2 .stat-trend {
        background: #9FE1CB;
        color: #085041;
    }
    
    .stat-card.alt3 .stat-trend {
        background: #F5C4B3;
        color: #712B13;
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    th, td {
        padding: 14px;
        text-align: left;
        border-bottom: 1px solid #E8EAF6;
    }

    th {
        background: #F9FAFB;
        font-weight: 700;
        color: #1A1D2E;

        font-weight: 500;
        margin-top: 4px;
    }
    
    .stat-card .stat-label {
        color: #185FA5;
    }
    
    .stat-card.alt1 .stat-label {
        color: #534AB7;
    }
    
    .stat-card.alt2 .stat-label {
        color: #1D9E75;
    }
    
    .stat-card.alt3 .stat-label {
        color: #D85A30;
    }

    .stat-trend {
        font-size: 11px;

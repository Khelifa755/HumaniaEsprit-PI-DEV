function displayGifs(gifs) {
    const gifContainer = document.getElementById('gifPickerResults');
    gifContainer.innerHTML = '';
    
    if (gifs.length === 0) {
        gifContainer.innerHTML = '<div style="padding:20px;text-align:center;color:#A0A8CC">Aucun GIF trouvé</div>';
        return;
    }
    
    gifContainer.style.display = 'grid';
    gifContainer.style.gridTemplateColumns = 'repeat(auto-fill, minmax(120px, 1fr))';
    gifContainer.style.gap = '10px';
    
    gifs.forEach(gif => {
        const gifDiv = document.createElement('div');
        gifDiv.style.cssText = 'cursor:pointer;position:relative;overflow:hidden;border-radius:8px;aspect-ratio:1;';
        gifDiv.innerHTML = `<img src="${gif.previewUrl}" alt="${gif.title}" style="width:100%;height:100%;object-fit:cover;transition:transform 0.2s">`;
        
        gifDiv.addEventListener('hover', function() {
            this.querySelector('img').style.transform = 'scale(1.05)';
        });
        
        gifDiv.addEventListener('click', function() {
            selectGif(gif.originalUrl, gif.previewUrl, gif.title);
        });
        
        gifContainer.appendChild(gifDiv);
    });
}

function selectGif(originalUrl, previewUrl, title) {
    if (currentGifContext === 'post') {
        // Store GIF URL in hidden field
        const form = document.getElementById('createPostForm');
        const input = form.querySelector('input[name="gifUrl"]');
        if (input) {
            input.value = originalUrl;
        }
        
        // Show preview
        showGifPreview('post', previewUrl, title);
    } else if (currentGifContext === 'comment' && currentCommentPublicationId) {
        // Store GIF URL in comment hidden field
        const commentForm = document.getElementById('commentForm-' + currentCommentPublicationId);
        if (commentForm) {
            const input = commentForm.querySelector('input[name="gifUrl"]');
            if (input) {
                input.value = originalUrl;
            }
        }
        
        // Show preview in comment
        const previewDiv = document.getElementById('commentGifPreview-' + currentCommentPublicationId);
        if (previewDiv) {
            previewDiv.innerHTML = `<img src="${previewUrl}" alt="${title}" style="max-width:180px;height:auto;border-radius:6px;margin-right:8px;display:inline-block">
                                    <button type="button" onclick="removeCommentGif(${currentCommentPublicationId})" style="padding:4px 8px;background:#E74C3C;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px">✕</button>`;
            previewDiv.style.display = 'block';
        }
    }
    
    // Close modal
    document.getElementById('gifPickerModal').style.display = 'none';
}

function showGifPreview(context, gifUrl, title) {
    if (context === 'post') {
        const previewDiv = document.getElementById('postGifPreview');
        if (previewDiv) {
            previewDiv.innerHTML = `<img src="${gifUrl}" alt="${title}" style="max-width:100%;height:auto;border-radius:8px;margin-top:8px">
                                    <button type="button" onclick="removePostGif()" style="margin-top:8px;padding:4px 8px;background:#E74C3C;color:white;border:none;border-radius:4px;cursor:pointer;font-size:11px">✕ Supprimer</button>`;
            previewDiv.style.display = 'block';
        }
    }
}

function removePostGif() {
    const form = document.getElementById('createPostForm');
    const input = form.querySelector('input[name="gifUrl"]');
    if (input) input.value = '';
    
    const previewDiv = document.getElementById('postGifPreview');
    if (previewDiv) previewDiv.style.display = 'none';
}

function removeCommentGif(pubId) {
    const commentForm = document.getElementById('commentForm-' + pubId);
    if (commentForm) {
        const input = commentForm.querySelector('input[name="gifUrl"]');
        if (input) input.value = '';
    }
    
    const previewDiv = document.getElementById('commentGifPreview-' + pubId);
    if (previewDiv) previewDiv.style.display = 'none';
}

// Prevent form submission if GROUP is selected but no group is chosen
document.addEventListener('DOMContentLoaded', function() {
    const createPostForm = document.getElementById('createPostForm');
    if (createPostForm) {
        createPostForm.addEventListener('submit', function(e) {
            const visibility = document.getElementById('postVisibility').value;
            const groupSelector = document.getElementById('groupSelector');
            
            if (visibility === 'GROUP' && !groupSelector.value) {
                e.preventDefault();
                alert('Veuillez sélectionner un groupe');
                return false;
            }
        });
    }
});
</script>

{# ══ MODAL D'ÉDITION DE COMMENTAIRE ══ #}
<div id="editCommentModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:18px;width:100%;max-width:500px;margin:0 16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);border:1.5px solid #E8EAF6;overflow:hidden">

        {# Header #}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #E8EAF6">
            <div style="font-size:15px;font-weight:700;color:#1A1D2E">Éditer le commentaire</div>
            <button type="button" onclick="document.getElementById('editCommentModal').style.display='none'"
                    style="background:none;border:none;font-size:21px;color:#A0A8CC;cursor:pointer;line-height:1">×</button>
        </div>

        <form id="editCommentForm" method="post" style="display:contents">
            <div style="padding:18px 20px">

                {# Texte with validation #}
                <div style="position:relative;margin-bottom:9px">
                    <textarea id="editCommentContenu" name="contenu" rows="3" required
                        placeholder="Écrire un commentaire..."
                        data-min="1"
                        data-max="500"
                        data-type="commentaire"
                        style="width:100%;border:1.5px solid #E8EAF6;border-radius:11px;padding:13px 15px;font-size:13.5px;font-family:inherit;color:#1A1D2E;resize:vertical;outline:none;background:#F4F5FB;box-sizing:border-box"></textarea>
                    
                    {# Error message #}
                    <div class="validation-error" style="display:none;margin-top:8px;padding:9px 12px;background:#FFF1F0;border:1px solid #F5CCCA;border-radius:8px;font-size:12px;color:#C23C35;font-weight:500"></div>
                    
                    {# Character counter #}
                    <div style="text-align:right;margin-top:6px;font-size:11px;color:#A0A8CC">
                        <span class="char-counter">0/500</span>
                    </div>
                </div>
            </div>

            {# Footer #}
            <div style="display:flex;justify-content:flex-end;gap:9px;padding:13px 20px;border-top:1px solid #E8EAF6">
                <button type="button"
                        onclick="document.getElementById('editCommentModal').style.display='none'"
                        style="padding:8px 18px;border-radius:9px;border:1.5px solid #E8EAF6;background:#F4F5FB;color:#4A5080;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                    Annuler
                </button>
                <button type="submit"
                        style="padding:8px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#6C5CE7,#A29BFE);color:#fff;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 12px rgba(108,92,231,0.3)">
                    Enregistrer
                </button>
            </div>
        </form>
    </div>
</div>

{# ══ MODAL DE PARTAGE ══ #}
<div id="shareModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:18px;width:100%;max-width:520px;margin:0 16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);border:1.5px solid #E8EAF6;overflow:hidden">

        {# Header #}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #E8EAF6">
            <div style="font-size:15px;font-weight:700;color:#1A1D2E">📤 Partager cette publication</div>
            <button type="button" onclick="document.getElementById('shareModal').style.display='none'"
                    style="background:none;border:none;font-size:21px;color:#A0A8CC;cursor:pointer;line-height:1">×</button>
        </div>

        <form id="shareForm" method="post" style="display:contents">
            <div style="padding:18px 20px">

                {# Publication preview (grisé) #}
                <div style="padding:13px 14px;background:#F3F4F6;border-radius:11px;border-left:4px solid #6C5CE7;margin-bottom:14px">
                    <div style="font-size:11px;color:#A0A8CC;margin-bottom:6px;font-weight:600">Vous allez partager :</div>
                    <div id="sharePreviewContent" style="font-size:13px;color:#4A5080;line-height:1.5"></div>
                </div>

                {# User info + Visibilité #}
                <div style="display:flex;align-items:center;gap:11px;margin-bottom:14px">
                    <div style="width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#A29BFE,#6C5CE7);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700;flex-shrink:0">
                        😊
                    </div>
                    <div>
                        <div style="font-size:13.5px;font-weight:700;color:#1A1D2E">Vous</div>
                        <select name="visibility" style="background:#F4F5FB;border:1.5px solid #E8EAF6;border-radius:7px;padding:3px 9px;font-size:11.5px;color:#4A5080;outline:none;font-family:inherit;margin-top:3px;cursor:pointer">
                            <option value="PUBLIC">🌍 Public</option>
                            <option value="FRIENDS">👥 Abonnés</option>
                            <option value="PRIVATE">🔒 Privé</option>
                        </select>
                    </div>
                </div>

                {# Message optionnel #}
                <label style="display:block;font-size:12.5px;color:#4A5080;font-weight:600;margin-bottom:6px">
                    Ajouter un message (optionnel)
                </label>
                <textarea name="shareMessage" rows="3" placeholder="Partager vos pensées sur cette publication..."
                    style="width:100%;border:1.5px solid #E8EAF6;border-radius:11px;padding:13px 15px;font-size:13.5px;font-family:inherit;color:#1A1D2E;resize:vertical;outline:none;background:#F4F5FB;box-sizing:border-box"></textarea>
            </div>

            {# Footer #}
            <div style="display:flex;justify-content:flex-end;gap:9px;padding:13px 20px;border-top:1px solid #E8EAF6">
                <button type="button"
                        onclick="document.getElementById('shareModal').style.display='none'"
                        style="padding:8px 18px;border-radius:9px;border:1.5px solid #E8EAF6;background:#F4F5FB;color:#4A5080;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                    Annuler
                </button>
                <button type="submit"
                        style="padding:8px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#10b981,#34d399);color:#fff;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 12px rgba(16,185,129,0.3)">
                    Partager
                </button>
            </div>
        </form>
    </div>
</div>

{% endblock %}

{% extends 'SOCIALMEDIA/feed/base.html.twig' %}

{% block title %}Accueil · Social{% endblock %}

{% block feed_content %}

{# ══ CARTE CRÉER UNE PUBLICATION ══ #}
<div style="background:#fff;border-radius:16px;border:1.5px solid #E8EAF6;padding:16px 18px;margin-bottom:16px;box-shadow:0 2px 10px rgba(108,92,231,0.06)">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
        {# Avatar user courant #}
        <div style="width:42px;height:42px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#74b9ff,#0984e3);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700;overflow:hidden;border:2px solid #fff">
            {% if currentUser %}
                {% if currentUser.avatarUrl %}
                    <img src="{{ currentUser.avatarUrl }}" style="width:100%;height:100%;object-fit:cover">
                {% else %}
                    {{ currentUser.firstName|slice(0, 1)|upper }}{{ currentUser.lastName|slice(0, 1)|upper }}
                {% endif %}
            {% else %}?{% endif %}
        </div>

        {# Champ fake → ouvre la modal #}
        <div onclick="document.getElementById('createPostModal').style.display='flex'; initializeValidation(document.getElementById('createPostContenu'))"
             style="flex:1;height:42px;border-radius:50px;background:#F4F5FB;border:1.5px solid #E8EAF6;padding:0 18px;display:flex;align-items:center;font-size:13px;color:#A0A8CC;cursor:pointer">
            Partagez quelque chose avec votre équipe...
        </div>
    </div>

    <div style="display:flex;gap:8px">
        <button onclick="document.getElementById('createPostModal').style.display='flex'"
            style="display:flex;align-items:center;gap:6px;padding:7px 13px;border-radius:9px;border:none;background:#F4F5FB;color:#4A5080;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit">
            🖼️ Photo
        </button>
        <button onclick="document.getElementById('createPostModal').style.display='flex'"
            style="display:flex;align-items:center;gap:6px;padding:7px 13px;border-radius:9px;border:none;background:#F4F5FB;color:#4A5080;font-size:12px;font-weight:500;cursor:pointer;font-family:inherit">
            😊 Sentiment
        </button>
    </div>
</div>

{# ══ LISTE DES PUBLICATIONS ══ #}
{% if publications is empty %}
    <div style="text-align:center;padding:60px 20px;background:#fff;border-radius:16px;border:1.5px dashed #E8EAF6">
        <div style="font-size:44px;margin-bottom:10px">📭</div>
        <div style="font-size:14px;font-weight:600;color:#4A5080">Aucune publication pour l'instant</div>
        <div style="font-size:12px;color:#A0A8CC;margin-top:5px">Soyez le premier à partager quelque chose !</div>
    </div>
{% else %}

    {% for pub in publications %}
        {% set author  = pub.authorId %}
        {% set pubId   = pub.getId() %}
        {% set myReact = userReactions[pubId] ?? null %}
        {% set isSaved = userSaved[pubId] ?? false %}

        {% include 'SOCIALMEDIA/feed/components/_publication-card.html.twig' with {
            pub: pub,
            pubId: pubId,
            author: author,
            myReact: myReact,
            isSaved: isSaved,
            userShares: userShares,
            currentUserId: currentUserId,
            publicationComments: commentsByPublication[pubId] ?? [],
            currentUser: currentUser,
            reactionStats: reactionStats,
            shareCount: shareCount
        } %}

    {% endfor %}

{% endif %}
{% endblock %}

{% block modals %}
{# ══ MODAL CRÉER PUBLICATION ══ #}
<div id="createPostModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:18px;width:100%;max-width:540px;margin:0 16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);border:1.5px solid #E8EAF6;overflow:hidden">

        {# Header #}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #E8EAF6">
            <div style="font-size:15px;font-weight:700;color:#1A1D2E">Nouvelle publication</div>
            <button onclick="document.getElementById('createPostModal').style.display='none'"
                    style="background:none;border:none;font-size:21px;color:#A0A8CC;cursor:pointer;line-height:1">×</button>
        </div>

        <form action="{{ path('social_feed_post_create') }}" method="post" enctype="multipart/form-data" id="createPostForm">
            <div style="padding:18px 20px">

                {# User info + visibilité #}
                <div style="display:flex;align-items:center;gap:11px;margin-bottom:14px">
                    <div style="width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,#A29BFE,#6C5CE7);display:flex;align-items:center;justify-content:center;color:#fff;font-size:14px;font-weight:700;flex-shrink:0;overflow:hidden;border:2px solid #fff">
                        {% if currentUser %}
                            {% if currentUser.avatarUrl %}
                                <img src="{{ currentUser.avatarUrl }}" style="width:100%;height:100%;object-fit:cover">
                            {% else %}
                                {{ currentUser.firstName|slice(0, 1)|upper }}{{ currentUser.lastName|slice(0, 1)|upper }}
                            {% endif %}
                        {% endif %}
                    </div>
                    <div>
                        <div style="font-size:13.5px;font-weight:700;color:#1A1D2E">
                            {% if currentUser %}{{ currentUser.firstName }} {{ currentUser.lastName }}{% endif %}
                        </div>
                        <div style="display:flex;gap:8px;align-items:center;margin-top:6px">
                            <select id="postVisibility" name="visibility" onchange="updateGroupSelector()" style="background:#F4F5FB;border:1.5px solid #E8EAF6;border-radius:7px;padding:4px 10px;font-size:11.5px;color:#4A5080;outline:none;font-family:inherit;cursor:pointer">
                                <option value="PUBLIC">🌍 Public</option>
                                <option value="GROUP">👥 Groupe</option>
                            </select>
                            <select id="groupSelector" name="groupId" style="background:#F4F5FB;border:1.5px solid #E8EAF6;border-radius:7px;padding:4px 10px;font-size:11.5px;color:#4A5080;outline:none;font-family:inherit;cursor:pointer;display:none">
                                <option value="">-- Sélectionner un groupe --</option>
                                {% for group in userGroups %}
                                    <option value="{{ group.id }}">{{ group.name }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>
                </div>

                {# Texte avec validation #}
                <div style="position:relative;margin-bottom:9px">
                    <textarea id="createPostContenu" name="contenu" rows="4" required
                        placeholder="Partagez quelque chose avec votre équipe..."
                        data-min="3"
                        data-max="5000"
                        data-type="publication"
                        style="width:100%;border:1.5px solid #E8EAF6;border-radius:11px;padding:13px 15px;font-size:13.5px;font-family:inherit;color:#1A1D2E;resize:vertical;outline:none;background:#F4F5FB;box-sizing:border-box"></textarea>
                    
                    {# Error message #}
                    <div class="validation-error" style="display:none;margin-top:8px;padding:9px 12px;background:#FFF1F0;border:1px solid #F5CCCA;border-radius:8px;font-size:12px;color:#C23C35;font-weight:500"></div>
                    
                    {# Character counter #}
                    <div style="text-align:right;margin-top:6px;font-size:11px;color:#A0A8CC">
                        <span class="char-counter">0/5000</span>
                    </div>
                </div>

                {# GIF Picker Button + AI Buttons #}
                <div style="display:flex;gap:6px;margin-top:9px;margin-bottom:9px;flex-wrap:wrap">
                    <button type="button" onclick="openGifPickerModal('post')" style="display:flex;align-items:center;gap:4px;padding:6px 12px;border-radius:7px;border:1.5px solid #FF6B6B;background:none;color:#FF6B6B;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit">
                        🎬 GIF
                    </button>
                    <button type="button" onclick="improvePostText()" style="display:flex;align-items:center;gap:4px;padding:6px 12px;border-radius:7px;border:1.5px solid #6C5CE7;background:none;color:#6C5CE7;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit">
                        ✨ Améliorer
                    </button>
                    <button type="button" onclick="openGeneratePostModal()" style="display:flex;align-items:center;gap:4px;padding:6px 12px;border-radius:7px;border:1.5px solid #2DAA63;background:none;color:#2DAA63;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit">
                        🤖 Générer
                    </button>
                </div>

                {# GIF Preview #}
                <div id="postGifPreview" style="display:none;margin-bottom:9px"></div>

                {# Hidden GIF URL field #}
                <input type="hidden" name="gifUrl" value="">

                {# Image Upload #}
                <label style="display:block;margin-top:9px;font-size:12.5px;color:#4A5080;font-weight:500;margin-bottom:6px">🖼️ Ajouter une image</label>
                <input type="file" name="image" accept="image/*"
                       style="width:100%;border:1.5px solid #E8EAF6;border-radius:9px;padding:9px 13px;font-size:12.5px;font-family:inherit;outline:none;background:#F4F5FB;box-sizing:border-box">
            </div>

            {# Footer #}
            <div style="display:flex;justify-content:flex-end;gap:9px;padding:13px 20px;border-top:1px solid #E8EAF6">
                <button type="button"
                        onclick="document.getElementById('createPostModal').style.display='none'"
                        style="padding:8px 18px;border-radius:9px;border:1.5px solid #E8EAF6;background:#F4F5FB;color:#4A5080;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                    Annuler
                </button>
                <button type="submit"
                        style="padding:8px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#6C5CE7,#A29BFE);color:#fff;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 12px rgba(108,92,231,0.3)">
                    Publier
                </button>
            </div>
        </form>
    </div>
</div>

{# ══ GIF PICKER MODAL ══ #}
<div id="gifPickerModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:18px;width:100%;max-width:600px;margin:0 16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);border:1.5px solid #E8EAF6;overflow:hidden">

        {# Header #}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #E8EAF6">
            <div style="font-size:15px;font-weight:700;color:#1A1D2E">🎬 Sélectionner un GIF</div>
            <button type="button" onclick="document.getElementById('gifPickerModal').style.display='none'"
                    style="background:none;border:none;font-size:21px;color:#A0A8CC;cursor:pointer;line-height:1">×</button>
        </div>

        <div style="padding:18px 20px">

            {# Search bar #}
            <div style="display:flex;gap:8px;margin-bottom:14px">
                <input type="text" id="gifSearchInput" placeholder="Rechercher des GIFs..."
                    style="flex:1;border:1.5px solid #E8EAF6;border-radius:9px;padding:10px 13px;font-size:13.5px;font-family:inherit;color:#1A1D2E;outline:none;background:#F4F5FB;box-sizing:border-box">
                <button type="button" onclick="searchGifs()" style="padding:10px 20px;border-radius:9px;border:none;background:#6C5CE7;color:white;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                    🔍 Chercher
                </button>
            </div>

            {# GIF grid #}
            <div id="gifPickerResults" style="display:grid;grid-template-columns:repeat(auto-fill, minmax(120px, 1fr));gap:10px;max-height:400px;overflow-y:auto;padding-right:8px">
                {# GIFs will be loaded here #}
            </div>
        </div>

        {# Footer #}
        <div style="display:flex;justify-content:flex-end;gap:9px;padding:13px 20px;border-top:1px solid #E8EAF6">
            <button type="button"
                    onclick="document.getElementById('gifPickerModal').style.display='none'"
                    style="padding:8px 18px;border-radius:9px;border:1.5px solid #E8EAF6;background:#F4F5FB;color:#4A5080;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                Fermer
            </button>
        </div>
    </div>
</div>

{# ══ MODAL DE GÉNÉRATION DE PUBLICATION ══ #}
<div id="generatePostModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:18px;width:100%;max-width:480px;margin:0 16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);border:1.5px solid #E8EAF6;overflow:hidden">

        {# Header #}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #E8EAF6">
            <div style="font-size:15px;font-weight:700;color:#1A1D2E">🤖 Générer une publication</div>
            <button type="button" onclick="document.getElementById('generatePostModal').style.display='none'"
                    style="background:none;border:none;font-size:21px;color:#A0A8CC;cursor:pointer;line-height:1">×</button>
        </div>

        <div style="padding:18px 20px">

            {# Subject input #}
            <div style="margin-bottom:14px">
                <label style="display:block;font-size:12.5px;color:#4A5080;font-weight:600;margin-bottom:8px">
                    📌 Sujet ou titre
                </label>
                <input type="text" id="generateSubject" placeholder="Ex: Les avantages du télétravail..."
                    style="width:100%;border:1.5px solid #E8EAF6;border-radius:9px;padding:10px 13px;font-size:13.5px;font-family:inherit;color:#1A1D2E;outline:none;background:#F4F5FB;box-sizing:border-box">
            </div>

            {# Tone selector #}
            <div style="margin-bottom:18px">
                <label style="display:block;font-size:12.5px;color:#4A5080;font-weight:600;margin-bottom:8px">
                    💬 Ton de la publication
                </label>
                <select id="generateTone" style="width:100%;border:1.5px solid #E8EAF6;border-radius:9px;padding:10px 13px;font-size:13.5px;color:#4A5080;outline:none;background:#F4F5FB;box-sizing:border-box;font-family:inherit;cursor:pointer">
                    <option value="professionnel">💼 Professionnel</option>
                    <option value="inspirationnel">✨ Inspirationnel</option>
                    <option value="casual">😊 Casual</option>
                    <option value="informatif">📚 Informatif</option>
                    <option value="humoristique">😂 Humoristique</option>
                </select>
            </div>

            {# Info text #}
            <div style="padding:11px 13px;background:#F0F4FF;border-radius:8px;border-left:4px solid #6C5CE7;margin-bottom:14px;font-size:12px;color:#4A5080;line-height:1.5">
                💡 L'IA générera une publication adaptée au ton choisi en fonction de votre sujet.
            </div>
        </div>

        {# Footer #}
        <div style="display:flex;justify-content:flex-end;gap:9px;padding:13px 20px;border-top:1px solid #E8EAF6">
            <button type="button"
                    onclick="document.getElementById('generatePostModal').style.display='none'"
                    style="padding:8px 18px;border-radius:9px;border:1.5px solid #E8EAF6;background:#F4F5FB;color:#4A5080;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                Annuler
            </button>
            <button type="button" onclick="generatePostFromSubject()"
                    style="padding:8px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#2DAA63,#10b981);color:#fff;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 12px rgba(45,170,99,0.3)">
                Générer
            </button>
        </div>
    </div>
</div>

{# ══ MODAL D'ÉDITION ══ #}
<div id="editPostModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.45);align-items:center;justify-content:center">
    <div style="background:#fff;border-radius:18px;width:100%;max-width:540px;margin:0 16px;box-shadow:0 20px 60px rgba(0,0,0,0.2);border:1.5px solid #E8EAF6;overflow:hidden">

        {# Header #}
        <div style="display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid #E8EAF6">
            <div style="font-size:15px;font-weight:700;color:#1A1D2E">Éditer la publication</div>
            <button type="button" onclick="document.getElementById('editPostModal').style.display='none'"
                    style="background:none;border:none;font-size:21px;color:#A0A8CC;cursor:pointer;line-height:1">×</button>
        </div>

        <form id="editPostForm" method="post" enctype="multipart/form-data" style="display:contents">
            <div style="padding:18px 20px">

                {# Texte avec validation #}
                <div style="position:relative;margin-bottom:9px">
                    <textarea id="editContenu" name="contenu" rows="4" required
                        placeholder="Partagez quelque chose avec votre équipe..."
                        data-min="3"
                        data-max="5000"
                        data-type="publication"
                        style="width:100%;border:1.5px solid #E8EAF6;border-radius:11px;padding:13px 15px;font-size:13.5px;font-family:inherit;color:#1A1D2E;resize:vertical;outline:none;background:#F4F5FB;box-sizing:border-box;margin-bottom:0"></textarea>
                    
                    {# Error message #}
                    <div class="validation-error" style="display:none;margin-top:8px;padding:9px 12px;background:#FFF1F0;border:1px solid #F5CCCA;border-radius:8px;font-size:12px;color:#C23C35;font-weight:500"></div>
                    
                    {# Character counter #}
                    <div style="text-align:right;margin-top:6px;margin-bottom:9px;font-size:11px;color:#A0A8CC">
                        <span class="char-counter">0/5000</span>
                    </div>
                </div>

                {# Visibilité #}
                <select id="editVisibility" name="visibility" onchange="updateEditGroupSelector()" style="width:100%;background:#F4F5FB;border:1.5px solid #E8EAF6;border-radius:7px;padding:9px 13px;font-size:12.5px;color:#4A5080;outline:none;font-family:inherit;cursor:pointer;box-sizing:border-box;margin-bottom:9px">
                    <option value="PUBLIC">🌍 Public</option>
                    <option value="GROUP">👥 Groupe</option>
                </select>

                {# Group Selector (hidden by default) #}
                <select id="editGroupSelector" name="groupId" style="width:100%;background:#F4F5FB;border:1.5px solid #E8EAF6;border-radius:7px;padding:9px 13px;font-size:12.5px;color:#4A5080;outline:none;font-family:inherit;cursor:pointer;box-sizing:border-box;margin-bottom:9px;display:none">
                    <option value="">-- Sélectionner un groupe --</option>
                    {% for group in userGroups %}
                        <option value="{{ group.id }}">{{ group.name }}</option>
                    {% endfor %}
                </select>

                {# AI Buttons for Edit #}
                <div style="display:flex;gap:6px;margin-bottom:9px;flex-wrap:wrap">
                    <button type="button" onclick="improveEditText()" style="display:flex;align-items:center;gap:4px;padding:6px 12px;border-radius:7px;border:1.5px solid #6C5CE7;background:none;color:#6C5CE7;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit">
                        ✨ Améliorer
                    </button>
                    <button type="button" onclick="summarizeEditText()" style="display:flex;align-items:center;gap:4px;padding:6px 12px;border-radius:7px;border:1.5px solid #F5A623;background:none;color:#F5A623;font-size:11.5px;font-weight:600;cursor:pointer;font-family:inherit">
                        📝 Résumer
                    </button>
                </div>

                {# Image Upload #}
                <label style="display:block;font-size:12.5px;color:#4A5080;font-weight:500;margin-bottom:6px">🖼️ Ajouter une image</label>
                <input type="file" id="editImage" name="image" accept="image/*"
                       style="width:100%;border:1.5px solid #E8EAF6;border-radius:9px;padding:9px 13px;font-size:12.5px;font-family:inherit;outline:none;background:#F4F5FB;box-sizing:border-box">
            </div>

            {# Footer #}
            <div style="display:flex;justify-content:flex-end;gap:9px;padding:13px 20px;border-top:1px solid #E8EAF6">
                <button type="button"
                        onclick="document.getElementById('editPostModal').style.display='none'"
                        style="padding:8px 18px;border-radius:9px;border:1.5px solid #E8EAF6;background:#F4F5FB;color:#4A5080;font-size:12.5px;font-weight:600;cursor:pointer;font-family:inherit">
                    Annuler
                </button>
                <button type="submit"
                        style="padding:8px 20px;border-radius:9px;border:none;background:linear-gradient(135deg,#6C5CE7,#A29BFE);color:#fff;font-size:12.5px;font-weight:700;cursor:pointer;font-family:inherit;box-shadow:0 4px 12px rgba(108,92,231,0.3)">
                    Enregistrer
                </button>
            </div>
        </form>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function toggleComments(pubId) {
    const commentsDiv = document.getElementById(`comments-${pubId}`);
    commentsDiv.style.display = commentsDiv.style.display === 'none' ? 'block' : 'none';
}

function togglePostMenu(pubId) {
    const menu = document.getElementById(`post-menu-${pubId}`);
    menu.style.display = menu.style.display === 'none' || menu.style.display === '' ? 'block' : 'none';
}

function closePostMenu(pubId) {
    document.getElementById(`post-menu-${pubId}`).style.display = 'none';
}

function toggleCommentMenu(commentId) {
    const menu = document.getElementById(`comment-menu-${commentId}`);
    menu.style.display = menu.style.display === 'none' || menu.style.display === '' ? 'block' : 'none';
}

function closeCommentMenu(commentId) {
    document.getElementById(`comment-menu-${commentId}`).style.display = 'none';
}

function openShareModal(pubId, contentPreview) {
    document.getElementById('sharePreviewContent').textContent = contentPreview;
    
    const form = document.getElementById('shareForm');
    form.action = '{{ path("social_feed_share", {id: 0}) }}'.replace('/0', '/' + pubId);
    
    document.getElementById('shareModal').style.display = 'flex';
}

function openEditModal(pubId, contenu, visibility, groupId = null) {
    const textarea = document.getElementById('editContenu');
    textarea.value = contenu;
    document.getElementById('editVisibility').value = visibility;
    
    // Set group selector value if groupId is provided
    const groupSelector = document.getElementById('editGroupSelector');
    if (groupId) {
        groupSelector.value = groupId;
    } else {
        groupSelector.value = '';
    }
    
    // Update group selector visibility
    updateEditGroupSelector();
    
    const form = document.getElementById('editPostForm');
    form.action = '{{ path("social_feed_edit", {id: 0}) }}'.replace('/0', '/' + pubId);
    
    document.getElementById('editPostModal').style.display = 'flex';
    
    // Initialize validation
    initializeValidation(textarea);
}

function updateEditGroupSelector() {
    const visibility = document.getElementById('editVisibility').value;
    const groupSelector = document.getElementById('editGroupSelector');
    
    if (visibility === 'GROUP') {
        groupSelector.style.display = 'block';
        groupSelector.required = true;
    } else {
        groupSelector.style.display = 'none';
        groupSelector.required = false;

// ══ SEARCH FILTER FUNCTION ══
function filterPublications() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase();
    const posts = document.querySelectorAll('[id^="post-"]');
    const usersResultsDiv = document.getElementById('searchUsersResults');
    
    // Filter posts locally
    let visibleCount = 0;
    posts.forEach(post => {
        const content = post.textContent.toLowerCase();
        const visible = (
            content.includes(searchTerm) || 
            searchTerm === ''
        );
        
        post.style.display = visible ? 'block' : 'none';
        if (visible) visibleCount++;
    });
    
    // Search users if search term is long enough
    if (searchTerm.length >= 2) {
        fetch('{{ path("social_feed_search") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: 'q=' + encodeURIComponent(searchTerm)
        })
        .then(r => r.json())
        .then(data => {
            if (data.users && data.users.length > 0) {
                usersResultsDiv.innerHTML = '<div style="padding:12px 16px;border-bottom:1px solid #F4F5FB;font-size:10px;font-weight:700;color:#A0A8CC;text-transform:uppercase;letter-spacing:1px">👥 Utilisateurs</div>';
                
                data.users.forEach(user => {
                    const userDiv = document.createElement('div');
                    userDiv.style.cssText = 'display:flex;align-items:center;gap:12px;padding:12px 16px;border-bottom:1px solid #F4F5FB;cursor:pointer;transition:background 0.2s';
                    userDiv.onmouseover = function() { this.style.background = '#F4F5FB'; };
                    userDiv.onmouseout = function() { this.style.background = 'transparent'; };
                    
                    const avatar = user.avatarUrl ? 
                        '<img src="' + user.avatarUrl + '" style="width:100%;height:100%;object-fit:cover;">' : 
                        user.firstName.charAt(0).toUpperCase() + user.lastName.charAt(0).toUpperCase();
                    
                    userDiv.innerHTML = '<div style="width:36px;height:36px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;color:#fff;font-size:12px;font-weight:700;overflow:hidden">' + avatar + '</div>' +
                        '<div style="flex:1;min-width:0">' +
                        '<div style="font-size:12.5px;font-weight:600;color:#1A1D2E">' + user.firstName + ' ' + user.lastName + '</div>' +
                        '<div style="font-size:11px;color:#A0A8CC">@' + user.username + '</div>' +
                        '</div>';
                    
                    userDiv.onclick = function() {
                        window.location.href = '{{ path("social_profile_show", {id: 0}) }}'.replace('/0', '/' + user.id);
                    };
                    
                    usersResultsDiv.appendChild(userDiv);
                });
                
                usersResultsDiv.style.display = 'block';
            } else {
                usersResultsDiv.style.display = 'none';
            }
        })
        .catch(err => console.error('Search error:', err));
    } else {
        usersResultsDiv.style.display = 'none';
    }
    
    // Show/hide a "no results" message if needed
    if (searchTerm !== '' && visibleCount === 0) {
        let noResults = document.getElementById('noSearchResults');
        if (!noResults) {
            noResults = document.createElement('div');
            noResults.id = 'noSearchResults';
            noResults.style.cssText = 'text-align:center;padding:40px 20px;background:#fff;border-radius:16px;border:1.5px dashed #E8EAF6;color:#A0A8CC;font-size:14px';
            noResults.innerHTML = '<div style="font-size:28px;margin-bottom:10px">🔍</div><div>Aucune publication trouvée</div><div style="font-size:12px;margin-top:5px">Essayez de chercher d\'autres mots clés</div>';
            const postsContainer = document.querySelector('[id^="post-"]')?.parentElement;
            if (postsContainer) {
                postsContainer.insertBefore(noResults, postsContainer.firstChild);
            }
        }
        noResults.style.display = 'block';
    } else {
        const noResults = document.getElementById('noSearchResults');
        if (noResults) noResults.style.display = 'none';
    }
}

// ══ CLIENT-SIDE VALIDATION FOR FORMS ══
function validateContentOnChange(element) {
    const minLen = parseInt(element.getAttribute('data-min'), 10);
    const maxLen = parseInt(element.getAttribute('data-max'), 10);
    const type = element.getAttribute('data-type') || 'publication';
    const currentLen = element.value.trim().length;
    const content = element.value.trim();
    
    // Update character counter
    const counter = element.parentElement.querySelector('.char-counter');
    if (counter) {
        counter.textContent = `${currentLen}/${maxLen}`;
        if (currentLen < minLen) {
            counter.style.color = '#E74C3C';
        } else if (currentLen > maxLen) {
            counter.style.color = '#E74C3C';
        } else {
            counter.style.color = '#27AE60';
        }
    }
    
    // Check if valid
    const submitBtn = element.closest('form').querySelector('[type="submit"]');
    const errorMsg = element.parentElement.querySelector('.validation-error');
    
    // Check for repeated characters (alert)
    if (/(.)\1{5,}/.test(content)) {
        alert('⚠️ Attention!\n\nLes caractères répétés en excès ne sont pas autorisés.\n\nVeruillez éviter de répéter un même caractère plus de 5 fois.');
        element.value = element.value.substring(0, element.value.length - 1);
        validateContentOnChange(element);
        return;
    }
    
    // Check if valid overall
    const isValid = currentLen >= minLen && currentLen <= maxLen;
    if (submitBtn) {
        submitBtn.disabled = !isValid;
        submitBtn.style.opacity = isValid ? '1' : '0.5';
        submitBtn.style.cursor = isValid ? 'pointer' : 'not-allowed';
    }
    
    // Show error message for length issues
    if (!isValid && currentLen > 0) {
        if (currentLen < minLen) {
            if (errorMsg) {
                errorMsg.textContent = `${type === 'commentaire' ? 'Commentaire' : 'Publication'} trop court (min: ${minLen})`;
                errorMsg.style.display = 'block';
            }
        } else if (currentLen > maxLen) {
            if (errorMsg) {
                errorMsg.textContent = `${type === 'commentaire' ? 'Commentaire' : 'Publication'} trop long (max: ${maxLen})`;
                errorMsg.style.display = 'block';
            }
        }
    } else if (errorMsg) {
        errorMsg.style.display = 'none';
    }
}

function initializeValidation(textarea) {
    if (!textarea) return;
    
    const minLen = parseInt(textarea.getAttribute('data-min'), 10);
    const maxLen = parseInt(textarea.getAttribute('data-max'), 10);
    
    // Add event listeners
    textarea.addEventListener('input', function() {
        validateContentOnChange(this);
    });
    textarea.addEventListener('change', function() {
        validateContentOnChange(this);
    });
    
    // Initial validation
    validateContentOnChange(textarea);
}

// ══ INLINE COMMENT VALIDATION ══
function validateCommentInput(input) {
    const form = input.closest('form');
    const submitBtn = form.querySelector('[type="submit"]');
    const trimmedValue = input.value.trim();
    
    if (trimmedValue.length >= 1 && trimmedValue.length <= 500) {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
    } else {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
    }
}


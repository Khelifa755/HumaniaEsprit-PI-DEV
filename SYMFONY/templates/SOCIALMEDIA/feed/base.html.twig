// ══ NOTIFICATIONS SYSTEM (WebSocket/Polling) ══
class NotificationSystem {
    constructor() {
        this.pollInterval = 5000; // 5 secondes
        this.lastCount = -1;
        this.init();
    }

    init() {
        // Demander la permission pour les notifications navigateur
        if ('Notification' in window && Notification.permission === 'default') {
            Notification.requestPermission();
        }
        
        // Démarrer le polling
        this.startPolling();
    }

    startPolling() {
        setInterval(() => this.poll(), this.pollInterval);
        // First poll immediately
        this.poll();
    }

    async poll() {
        try {
            const response = await fetch('/social/notifications/unread-count');
            const data = await response.json();
            const count = data.count;

            if (this.lastCount === -1) {
                // Premier poll - initialiser sans notifier
                this.lastCount = count;
                this.updateBadge(count);
                return;
            }

            if (count > this.lastCount) {
                // Nouvelle(s) notification(s) !
                const newCount = count - this.lastCount;
                await this.showLatestNotification(newCount);
                this.updateBadge(count);
            }

            this.lastCount = count;
        } catch (e) {
            console.error('❌ Erreur polling notifications:', e);
        }
    }

    async showLatestNotification(newCount) {
        try {
            const response = await fetch('/social/notifications/list');
            const notifs = await response.json();
            
            if (notifs.length > 0) {
                const latest = notifs[0];
                this.showToast(latest);
                
                // Notification navigateur si app en arrière-plan
                if (document.hidden && 'Notification' in window && Notification.permission === 'granted') {
                    new Notification(latest.titre, {
                        body: latest.message,
                        icon: latest.icon || '🔔',
                        badge: '🔔',
                        tag: 'notification-' + latest.id
                    });
                }
            }
        } catch (e) {
            console.error('❌ Erreur récupération notif:', e);
        }
    }

    showToast(notif) {
        const toast = document.createElement('div');
        toast.id = 'notif-toast-' + notif.id;
        toast.style.cssText = `
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #fff;
            border: 1.5px solid #E8EAF6;
            border-radius: 12px;
            padding: 14px 18px;
            box-shadow: 0 8px 24px rgba(108,92,231,0.15);
            max-width: 320px;
            z-index: 9999;
            animation: slideIn 0.3s ease-out;
            cursor: pointer;
            font-family: 'DM Sans', sans-serif;
        `;

        const html = `
            <div style="display: flex; gap: 10px; align-items: flex-start;">
                <span style="font-size: 20px;">${notif.icon}</span>
                <div style="flex: 1;">
                    <div style="font-size: 12px; font-weight: 700; color: #6C5CE7;">${notif.titre}</div>
                    <div style="font-size: 13px; color: #4A5080; margin-top: 2px; line-height: 1.4;">${notif.message}</div>
                </div>
                <button onclick="this.parentElement.parentElement.remove()" 
                        style="background: none; border: none; font-size: 16px; cursor: pointer; color: #A0A8CC;">×</button>
            </div>
        `;

        toast.innerHTML = html;
        document.body.appendChild(toast);

        // Auto-remove after 6s
        setTimeout(() => {
            toast.style.animation = 'slideOut 0.3s ease-out';
            setTimeout(() => toast.remove(), 300);
        }, 6000);
    }

    updateBadge(count) {
        const badge = document.getElementById('notification-badge');
        if (badge) {
            if (count > 0) {
                badge.textContent = count > 99 ? '99+' : count;
                badge.style.display = 'flex';
            } else {
                badge.style.display = 'none';
            }
        }
    }
}

// Init notifications au chargement
// Initialize all suggestion buttons with their current follow status
function initializeSuggestionButtons() {
    const buttons = document.querySelectorAll('.suggest-follow-btn');
    buttons.forEach(btn => {
        const userId = btn.dataset.userId;
        if (userId) {
            fetch(`/social/network/check-follow/${userId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.isFollowing) {
                        if (data.status === 'PENDING') {
                            btn.textContent = '⏳ Demande envoyée';
                            btn.style.background = '#FFA500';
                        } else if (data.status === 'ACTIVE') {
                            btn.textContent = '✓ Suivi';
                            btn.style.background = '#4CAF50';
                        }
                        btn.disabled = true;
                    }
                })
                .catch(err => console.error('Error checking follow status:', err));
        }
    });
}

document.addEventListener('DOMContentLoaded', () => {
    new NotificationSystem();
    
    // Initialize suggestion buttons with follow status
    initializeSuggestionButtons();
});

// ══ NOTIFICATIONS MODAL FUNCTIONS ══
async function openNotificationsModal(e) {
    e.preventDefault();
    document.getElementById('notificationsModal').style.display = 'flex';
    await loadNotifications();
}

function closeNotificationsModal() {
    document.getElementById('notificationsModal').style.display = 'none';
}

async function loadNotifications() {
    try {
        const response = await fetch('/social/notifications/list');
        const notifs = await response.json();
        
        const content = document.getElementById('notificationsModalContent');
        
        if (notifs.length === 0) {
            content.innerHTML = '<div style="text-align: center; padding: 30px 20px; color: #A0A8CC;">📭 Pas de notifications</div>';
            return;
        }
        
        content.innerHTML = notifs.map(notif => `
            <div style="display: flex; gap: 12px; padding: 14px 20px; border-bottom: 1px solid #E8EAF6; cursor: pointer; transition: all 0.18s;" onmouseover="this.style.background='#f8f9fc'" onmouseout="this.style.background='transparent'" onclick="markNotificationRead(${notif.id})">
                <span style="font-size: 20px; flex-shrink: 0;">${notif.icon}</span>
                <div style="flex: 1; min-width: 0;">
                    <div style="font-size: 12px; font-weight: 700; color: #6C5CE7;">${notif.titre}</div>
                    <div style="font-size: 13px; color: #4A5080; margin-top: 3px; line-height: 1.4;">${notif.message}</div>
                    <div style="font-size: 11px; color: #A0A8CC; margin-top: 6px;">${new Date(notif.dateCreation).toLocaleString('fr-FR')}</div>
                </div>
                ${!notif.seen ? '<span style="width: 8px; height: 8px; background: #6C5CE7; border-radius: 50%; flex-shrink: 0; margin-top: 6px;"></span>' : ''}
            </div>
        `).join('');
    } catch (e) {
        console.error('❌ Erreur:', e);
        document.getElementById('notificationsModalContent').innerHTML = '<div style="text-align: center; padding: 30px 20px; color: #991b1b;">❌ Erreur de chargement</div>';
    }
}

async function markNotificationRead(notifId) {
    try {
        await fetch(`/social/notifications/mark-read/${notifId}`, { method: 'POST' });
        await loadNotifications();
    } catch (e) {
        console.error('❌ Erreur:', e);
    }
}

async function markAllNotificationsRead() {
    try {
        await fetch('/social/notifications/mark-all-read', { method: 'POST' });
        // Reload to show updated state
        location.reload();
    } catch (e) {
        console.error('❌ Erreur:', e);
    }
}

// Close modal on escape key
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNotificationsModal();
});


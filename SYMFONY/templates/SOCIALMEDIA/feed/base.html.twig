    {% endif %}
</nav>

{# ══ CORPS SOCIAL ══ #}
<div class="social-body">

    {# Colonne feed (centre) #}
    <div class="feed-col">
        {# Flash messages #}
        {% for msg in app.flashes('success') %}
            <div style="margin-bottom:14px;padding:11px 16px;background:#d1fae5;border-radius:10px;color:#065f46;font-size:13px;font-weight:600">
                ✅ {{ msg }}
            </div>
        {% endfor %}
        {% for msg in app.flashes('error') %}
            <div style="margin-bottom:14px;padding:11px 16px;background:#fee2e2;border-radius:10px;color:#991b1b;font-size:13px;font-weight:600">
                ❌ {{ msg }}
            </div>
        {% endfor %}

        {% block feed_content %}{% endblock %}
    </div>

    {# Colonne droite #}
    <div class="right-col">
        {% block right_sidebar %}

            {# ══ TRENDING TOPICS (Hybrid: Keywords + Departments) ══ #}
            {% if trendingTopics is defined and trendingTopics|length > 0 %}
                <div style="background:#fff;border-radius:14px;border:1.5px solid #E8EAF6;padding:14px;margin-bottom:14px;box-shadow:0 2px 10px rgba(108,92,231,0.05)">
                    <div style="font-size:10px;font-weight:700;color:#A0A8CC;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px">
                        🔥 Tendances maintenant
                    </div>

                    {% for topic in trendingTopics %}
                        <button onclick="toggleTopicFilter('{{ topic.name }}', '{{ topic.type }}')" 
                           id="topic-{{ topic.name }}"
                           class="topic-btn"
                           data-topic="{{ topic.name }}"
                           data-topic-type="{{ topic.type }}"
                           style="display:flex;align-items:center;justify-content:space-between;padding:10px;margin-bottom:10px;background:#F4F5FB;border:1.5px solid #E8EAF6;border-radius:10px;transition:all 0.2s;text-decoration:none;cursor:pointer;width:100%;font-family:inherit;color:inherit" 
                           onmouseover="this.style.background='#EFEFFF'; this.style.borderColor='#D9D5F0'" 
                           onmouseout="if(!this.classList.contains('active')) { this.style.background='#F4F5FB'; this.style.borderColor='#E8EAF6' }">
                            
                            {# Topic Name & Badge #}
                            <div style="flex:1;min-width:0;text-align:left">
                                <div style="font-size:12px;font-weight:600;color:#1A1D2E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    {{ topic.name }}
                                </div>
                                <div style="font-size:9px;color:#A0A8CC;margin-top:2px">
                                    {{ topic.type == 'department' ? '🏢 Département' : '💬 Tendance' }}
                                </div>
                            </div>

                            {# Match Count #}
                            <div class="topic-match-count" style="background:rgba(108,92,231,0.1);color:#6C5CE7;padding:4px 8px;border-radius:6px;font-size:10px;font-weight:600;white-space:nowrap;margin-left:8px;flex-shrink:0">
                                {{ topic.count }}
                            </div>
                        </button>
                    {% endfor %}
                </div>
            {% endif %}

            {# ══ SUGGESTIONS D'UTILISATEURS ══ #}
            {% if suggestedUsers is defined and suggestedUsers|length > 0 %}
                <div style="background:#fff;border-radius:14px;border:1.5px solid #E8EAF6;padding:14px;margin-bottom:14px;box-shadow:0 2px 10px rgba(108,92,231,0.05)">
                    <div style="font-size:10px;font-weight:700;color:#A0A8CC;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:12px">
                        👥 Suggestions pour vous
                    </div>

                    {% for user in suggestedUsers %}
                        <a href="{{ path('social_profile_show', {id: user.id}) }}" style="display:flex;align-items:center;gap:10px;padding:10px;margin-bottom:10px;background:#F4F5FB;border-radius:10px;transition:all 0.2s;text-decoration:none;border:1.5px solid transparent" onmouseover="this.style.background='#EFEFFF'; this.style.borderColor='#D9D5F0'" onmouseout="this.style.background='#F4F5FB'; this.style.borderColor='transparent'">
                            
                            {# Avatar #}
                            <div style="width:40px;height:40px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,#667eea,#764ba2);display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700;overflow:hidden">
                                {% if user.avatarUrl %}
                                    <img src="{{ user.avatarUrl }}" style="width:100%;height:100%;object-fit:cover">
                                {% else %}
                                    {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
                                {% endif %}
                            </div>

                            {# Info #}
                            <div style="flex:1;min-width:0">
                                <div style="font-size:12px;font-weight:600;color:#1A1D2E;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    {{ user.firstName }} {{ user.lastName }}
                                </div>
                                <div style="font-size:10px;color:#A0A8CC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    {% if user.posteActuel %}{{ user.posteActuel }}{% else %}No Title{% endif %}
                                </div>
                                <div style="font-size:9px;color:#A0A8CC;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">
                                    @{{ user.username }}
                                </div>
                            </div>

                            {# Button Suivre #}
                            <button class="suggest-follow-btn" data-user-id="{{ user.id }}" onclick="event.preventDefault(); followUserSuggest({{ user.id }}, this)"
                                    style="padding:5px 10px;background:linear-gradient(135deg,#6C5CE7,#5B4FD3);color:#fff;border:none;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;white-space:nowrap;transition:all 0.2s;flex-shrink:0">
                                + Suivre
                            </button>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

        {% endblock %}
    </div>

</div>

{# Notifications Modal #}
<div id="notificationsModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 10000; justify-content: center; align-items: center;">
    <div style="background: #fff; border-radius: 16px; width: 90%; max-width: 450px; max-height: 80vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
        {# Header #}
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 18px 20px; border-bottom: 1.5px solid #E8EAF6;">
            <h2 style="margin: 0; font-size: 16px; font-weight: 700; color: #1A1D2E;">Notifications</h2>
            <button onclick="closeNotificationsModal()" style="background: none; border: none; font-size: 24px; cursor: pointer; color: #A0A8CC;">×</button>
        </div>
        
        {# Content #}
        <div id="notificationsModalContent" style="padding: 12px 0;">
            <div style="text-align: center; padding: 30px 20px; color: #A0A8CC;">
                📬 Chargement...
            </div>
        </div>
        
        {# Footer #}
        <div style="padding: 12px 20px; border-top: 1.5px solid #E8EAF6; text-align: center;">
            <button onclick="markAllNotificationsRead()" style="background: #6C5CE7; color: #fff; border: none; border-radius: 8px; padding: 8px 16px; font-size: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s;" onmouseover="this.style.background='#5a4ab8'" onmouseout="this.style.background='#6C5CE7'">Marquer tout comme lu</button>
        </div>
    </div>
</div>

{# Modals #}
{% block modals %}{% endblock %}

<script>
// ── IMPROVED TRENDING TOPICS FILTER WITH TYPE SUPPORT ──
let activeFilters = new Map();  // Changed from Set to Map to store {name: type}

function toggleTopicFilter(topicName, topicType) {
    if (activeFilters.has(topicName)) {
        activeFilters.delete(topicName);
    } else {
        activeFilters.set(topicName, topicType);  // Store type along with name
    }
    
    if (activeFilters.size === 0) {
        clearFilter();
    } else {
        applyFilters();
    }
}

function applyFilters() {
    const publications = document.querySelectorAll('[data-publication]');
    let visibleCount = 0;

    publications.forEach(pub => {
        const pubFullText = (pub.getAttribute('data-publication') || '').toLowerCase();
        const pubDepartment = (pub.getAttribute('data-department') || '').toLowerCase();
        const pubGroup = (pub.getAttribute('data-group') || '').toLowerCase();
        
        const matches = Array.from(activeFilters.entries()).some(([filterName, filterType]) => {
            const filterLower = filterName.toLowerCase();
            
            try {
                // Create regex for word boundary matching
                const regex = new RegExp('(^|\\s)' + filterLower.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '(\\s|$)');
                
                // Filter based on type
                if (filterType === 'department') {
                    // For department filters, ONLY match against the department field
                    const result = regex.test(pubDepartment);
                    console.log(`[DEPT] Filter: "${filterLower}" | Dept: "${pubDepartment}" | Match: ${result}`);
                    return result;
                } else if (filterType === 'group') {
                    // For group filters, ONLY match against the group field
                    const result = regex.test(pubGroup);
                    console.log(`[GROUP] Filter: "${filterLower}" | Group: "${pubGroup}" | Match: ${result}`);
                    return result;
                } else {
                    // For keyword filters, match against full content (but NOT department or group)
                    const contentWithoutDeptAndGroup = pubFullText.replace(pubDepartment, '').replace(pubGroup, '').trim();
                    const result = regex.test(contentWithoutDeptAndGroup);
                    console.log(`[KEYWORD] Filter: "${filterLower}" | Content: "${contentWithoutDeptAndGroup.substring(0, 50)}..." | Match: ${result}`);
                    return result;
                }
            } catch (e) {
                console.error('Regex error:', e);
                // Fallback to includes if regex fails
                if (filterType === 'department') {
                    return pubDepartment.includes(filterLower);
                } else if (filterType === 'group') {
                    return pubGroup.includes(filterLower);
                } else {
                    const contentWithoutDeptAndGroup = pubFullText.replace(pubDepartment, '').replace(pubGroup, '').trim();
                    return contentWithoutDeptAndGroup.includes(filterLower);
                }
            }
        });

        if (matches) {
            pub.style.display = 'block';
            pub.style.opacity = '1';
            pub.style.animation = 'fadeIn 0.3s ease-in';
            visibleCount++;
        } else {
            pub.style.display = 'none';
            pub.style.opacity = '0.3';
        }
    });

    // Update topic button styling
    document.querySelectorAll('.topic-btn').forEach(btn => {
        const topic = btn.getAttribute('data-topic');
        if (activeFilters.has(topic)) {
            btn.classList.add('active');
            btn.style.background = '#6C5CE7';
            btn.style.borderColor = '#6C5CE7';
            btn.style.color = '#fff';
            btn.querySelector('div').style.color = '#fff';
            const countDiv = btn.querySelector('.topic-match-count');
            if (countDiv) {
                countDiv.style.background = 'rgba(255,255,255,0.2)';
                countDiv.style.color = '#fff';
            }
        } else {
            btn.classList.remove('active');
            btn.style.background = '#F4F5FB';
            btn.style.borderColor = '#E8EAF6';
            btn.style.color = 'inherit';
            btn.querySelector('div').style.color = '#1A1D2E';
            const countDiv = btn.querySelector('.topic-match-count');
            if (countDiv) {
                countDiv.style.background = 'rgba(108,92,231,0.1)';
                countDiv.style.color = '#6C5CE7';
            }
        }
    });

    // Show/update filter indicator
    if (visibleCount === 0) {
        showNoResults();
    } else {
        showFilterIndicator(Array.from(activeFilters.keys()), visibleCount);
    }
}

function showFilterIndicator(topics, count) {
    // Remove existing indicator
    const existing = document.getElementById('filter-indicator');
    if (existing) existing.remove();
    const noResults = document.getElementById('no-results-indicator');
    if (noResults) noResults.remove();

    // Create filter indicator
    const indicator = document.createElement('div');
    indicator.id = 'filter-indicator';
    indicator.style.cssText = `
        position: fixed;
        top: 92px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #6C5CE7, #5B4FD3);
        color: #fff;
        padding: 14px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(108, 92, 231, 0.3);
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: slideDown 0.3s ease-out;
        max-width: 90vw;
        flex-wrap: wrap;
        justify-content: center;
    `;

    const topicsList = topics.map((t, i) => `<strong>${t}</strong>${i < topics.length - 1 ? ' + ' : ''}`).join('');
    const resultText = count === 1 ? '1 résultat' : `${count} résultats`;
    
    indicator.innerHTML = `
        <span>🔍 ${topicsList} • ${resultText}</span>
        <button onclick="clearFilter()" style="background: rgba(255,255,255,0.2); border: 1px solid #fff; color: #fff; padding: 6px 12px; border-radius: 14px; font-size: 12px; cursor: pointer; transition: all 0.2s; font-weight: 600;" onmouseover="this.style.background='rgba(255,255,255,0.3)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">
            ✕ Réinitialiser
        </button>
    `;

    document.body.appendChild(indicator);
}

function showNoResults() {
    // Remove existing indicators
    const existing = document.getElementById('filter-indicator');
    if (existing) existing.remove();
    const noResults = document.getElementById('no-results-indicator');
    if (noResults) return; // Already showing

    // Create no results indicator
    const indicator = document.createElement('div');
    indicator.id = 'no-results-indicator';
    indicator.style.cssText = `
        position: fixed;
        top: 92px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #EF4444, #DC2626);
        color: #fff;
        padding: 14px 20px;
        border-radius: 24px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 4px 15px rgba(239, 68, 68, 0.3);
        z-index: 100;
        display: flex;
        align-items: center;
        gap: 14px;
        animation: slideDown 0.3s ease-out;
    `;

    indicator.innerHTML = `
        <span>😕 Aucun résultat pour cette sélection</span>
        <button onclick="clearFilter()" style="background: rgba(255,255,255,0.2); border: 1px solid #fff; color: #fff; padding: 6px 12px; border-radius: 14px; font-size: 12px; cursor: pointer; transition: all 0.2s; font-weight: 600;" onmouseover="this.style.background='rgba(255,255,255,0.3)'" onmouseout="this.style.background='rgba(255,255,255,0.2)'">
            ✕ Effacer
        </button>
    `;

    document.body.appendChild(indicator);
}

function clearFilter() {
    activeFilters.clear();
    
    // Show all publications with smooth animation
    const publications = document.querySelectorAll('[data-publication]');
    publications.forEach(pub => {
        pub.style.display = 'block';
        pub.style.opacity = '1';
        pub.style.animation = 'fadeIn 0.3s ease-in';
    });

    // Reset all topic buttons
    document.querySelectorAll('.topic-btn').forEach(btn => {
        btn.classList.remove('active');
        btn.style.background = '#F4F5FB';
        btn.style.borderColor = '#E8EAF6';
        btn.style.color = 'inherit';
        btn.querySelector('div').style.color = '#1A1D2E';
        const countDiv = btn.querySelector('.topic-match-count');
        if (countDiv) {
            countDiv.style.background = 'rgba(108,92,231,0.1)';
            countDiv.style.color = '#6C5CE7';
        }
    });

    // Remove filter indicators with animation
    const indicator = document.getElementById('filter-indicator');
    const noResults = document.getElementById('no-results-indicator');
    if (indicator) {
        indicator.style.animation = 'slideUp 0.3s ease-out';
        setTimeout(() => indicator.remove(), 300);
    }
    if (noResults) {
        noResults.style.animation = 'slideUp 0.3s ease-out';
        setTimeout(() => noResults.remove(), 300);
    }
}

// Fallback search function
function searchTopic(topicName) {
    const searchInput = document.querySelector('input[name="q"]');
    if (searchInput) {
        searchInput.value = topicName;
        searchInput.focus();
    }
    window.location.href = `/social/feed?search=${encodeURIComponent(topicName)}`;
}

function toggleComments(pubId) {
    const el = document.getElementById('comments-' + pubId);
    if (!el) return;
    const isHidden = el.style.display === 'none' || el.style.display === '';
    el.style.display = isHidden ? 'block' : 'none';
    if (isHidden) {
        const inp = el.querySelector('input[name="contenu"]');
        if (inp) inp.focus();
    }
}

// ── SUGGESTION UTILISATEURS ──
function followUserSuggest(userId, btn) {
    const originalText = btn.textContent;
    btn.textContent = '⏳...';
    btn.disabled = true;

    fetch(`/social/network/follow/${userId}`, {
        method: 'POST',
        headers: { 
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(async r => {
        const text = await r.text();
        console.log('Response status:', r.status);
        console.log('Response text:', text);
        
        try {
            return JSON.parse(text);
        } catch (e) {
            console.error('Failed to parse JSON:', text);
            throw new Error('Invalid JSON response');
        }
    })
    .then(data => {
        console.log('Data:', data);
        if (data.success) {
            // Show status based on returned status
            if (data.status === 'PENDING') {
                btn.textContent = '⏳ Demande envoyée';
                btn.style.background = '#FFA500';
            } else if (data.status === 'ACTIVE') {
                btn.textContent = '✓ Suivi';
                btn.style.background = '#4CAF50';
            }
            btn.disabled = true;
            
            // Fade out the suggestion card
            const card = btn.closest('div[style*="background:#F4F5FB"]');
            if (card) {
                setTimeout(() => {
                    card.style.opacity = '0.5';
                    card.style.pointerEvents = 'none';
                }, 300);
            }
        } else {
            alert('Erreur: ' + (data.error || 'Impossible de suivre cet utilisateur'));
            btn.textContent = originalText;
            btn.disabled = false;
        }
    })
    .catch(err => {
        console.error('Erreur suivi:', err);
        alert('Erreur: ' + err.message);
        btn.textContent = originalText;
        btn.disabled = false;
    });
}


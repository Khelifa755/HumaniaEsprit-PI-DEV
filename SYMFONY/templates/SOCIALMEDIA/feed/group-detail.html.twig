            </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 9px; padding: 13px 20px; border-top: 1px solid #E8EAF6; flex-shrink: 0;">
            <button type="button" onclick="closeEditGroupModal()" style="padding: 8px 18px; border-radius: 9px; border: 1.5px solid #E8EAF6; background: #F4F5FB; color: #4A5080; font-size: 12.5px; font-weight: 600; cursor: pointer; font-family: inherit;">
                Fermer
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block social_js %}

<script>
// ════════════════════════════════════════════════════════════════
// Modal Functions
// ════════════════════════════════════════════════════════════════

function openCreatePostModal() {
    document.getElementById('createPostModal').style.display = 'flex';
}

function closeCreatePostModal() {
    document.getElementById('createPostModal').style.display = 'none';
}

function openEditModal(pubId, contenu, visibility, groupId = null) {
    // For group posts, open the group edit modal
    if (groupId) {
        const editGroupForm = document.getElementById('editGroupPostForm');
        const editGroupContenu = document.getElementById('editGroupContenu');
        editGroupContenu.value = contenu;
        editGroupForm.action = '{{ path("social_groups_edit_post", {id: 0, postId: 0}) }}'.replace('/0/post/0', '/' + groupId + '/post/' + pubId);
        document.getElementById('editGroupPostModal').style.display = 'flex';
    }
}

function closeEditGroupPostModal() {
    document.getElementById('editGroupPostModal').style.display = 'none';
}

function openShareModal(postId, preview) {
    document.getElementById('sharePreviewContent').textContent = preview;
    const form = document.getElementById('shareForm');
    form.action = '{{ path("social_feed_share", {id: 0}) }}'.replace('/0', '/' + postId);
    document.getElementById('shareModal').style.display = 'flex';
}

function closeShareModal() {
    document.getElementById('shareModal').style.display = 'none';
}

function openEditCommentModal(commentId, content) {
    document.getElementById('editCommentId').value = commentId;
    document.getElementById('editCommentContent').value = content;
    document.getElementById('editCommentModal').style.display = 'flex';
}

function closeEditCommentModal() {
    document.getElementById('editCommentModal').style.display = 'none';
}

function openEditGroupModal(groupId, groupName) {
    currentGroupId = groupId;
    document.getElementById('editGroupName').value = groupName;
    document.getElementById('memberSearchInput').value = '';
    document.getElementById('membersList').innerHTML = '<div style="text-align:center;padding:20px;color:#A0A8CC;font-size:13px">⏳ Chargement...</div>';
    document.getElementById('editGroupModal').style.display = 'flex';
    document.getElementById('editGroupName').focus();
    // Load initial members list
    setTimeout(() => searchMembers(''), 100);
}

function closeEditGroupModal() {
    document.getElementById('editGroupModal').style.display = 'none';
    currentGroupId = null;
}

function submitEditGroup(groupId) {
    const groupName = document.getElementById('editGroupName').value.trim();
    const gId = currentGroupId || groupId;
    
    if (!groupName || groupName.length < 3) {
        alert('⚠️ Le nom du groupe doit contenir au moins 3 caractères');
        return;
    }
    
    const btn = event.target;
    btn.disabled = true;
    btn.textContent = '⏳ En cours...';
    
    fetch('{{ path("social_groups_update", {id: 0}) }}'.replace('/0', '/' + gId), {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: 'name=' + encodeURIComponent(groupName)
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update the group name in the page
            document.querySelector('h1').textContent = groupName;
            alert('✅ Groupe modifié avec succès');
            location.reload(); // Reload to reflect all changes
        } else {
            alert('⚠️ ' + (data.error || 'Erreur lors de la modification'));
            btn.disabled = false;
            btn.textContent = '✓ Enregistrer';
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('⚠️ Erreur de connexion');
        btn.disabled = false;
        btn.textContent = '✓ Enregistrer';
    });
}

function submitEditComment() {
    const commentId = document.getElementById('editCommentId').value;
    const content = document.getElementById('editCommentContent').value.trim();

    if (!content) {
        alert('Le commentaire ne peut pas être vide');
        return;
    }

    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '{{ path("social_feed_edit_comment", {id: 0}) }}'.replace('/0', '/' + commentId);
    form.innerHTML = '<input type="hidden" name="contenu" value="' + content.replace(/"/g, '&quot;') + '">';
    form.innerHTML += '<input type="hidden" name="returnUrl" value="' + window.location.href + '">';
    document.body.appendChild(form);
    form.submit();
}

// ════════════════════════════════════════════════════════════════
// Post Functions
// ════════════════════════════════════════════════════════════════

function togglePostMenu(postId) {
    const menu = document.getElementById('post-menu-' + postId);
    if (menu) {
        menu.style.display = menu.style.display === 'none' ? 'flex' : 'none';
    }
    // Close other menus
    document.querySelectorAll('[id^="post-menu-"]').forEach(m => {
        if (m.id !== 'post-menu-' + postId) m.style.display = 'none';
    });
}

function closePostMenu(postId) {
    const menu = document.getElementById('post-menu-' + postId);
    if (menu) {
        menu.style.display = 'none';
    }
}

// ════════════════════════════════════════════════════════════════
// Reaction & Comment Functions
// ════════════════════════════════════════════════════════════════

function submitReaction(postId, reactionType) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = '{{ path("social_feed_react", {id: 0}) }}'.replace('/0', '/' + postId);
    form.innerHTML = '<input type="hidden" name="type" value="' + reactionType + '">';
    form.innerHTML += '<input type="hidden" name="returnUrl" value="' + window.location.href + '">';
    document.body.appendChild(form);
    form.submit();
}

function showReactionPicker(postId) {
    const picker = document.getElementById('picker-' + postId);
    if (picker) {
        picker.style.display = 'flex';
    }
}

function hideReactionPicker(postId) {
    const picker = document.getElementById('picker-' + postId);
    if (picker) {
        picker.style.display = 'none';
    }
}

function toggleComments(postId) {
    const comments = document.getElementById('comments-' + postId);
    if (comments) {
        comments.style.display = comments.style.display === 'none' ? 'block' : 'none';
    }
}

function toggleCommentMenu(commentId) {
    const menu = document.getElementById('comment-menu-' + commentId);
    if (menu) {
        menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
    }
    // Close other menus
    document.querySelectorAll('[id^="comment-menu-"]').forEach(m => {
        if (m.id !== 'comment-menu-' + commentId) m.style.display = 'none';
    });
}

function closeCommentMenu(commentId) {
    const menu = document.getElementById('comment-menu-' + commentId);
    if (menu) {
        menu.style.display = 'none';
    }
}
</script>

{% endblock %}

{% block right_sidebar %}
    {% if membersWithStatus|length > 0 %}
        <div style="background: #fff; border-radius: 14px; border: 1.5px solid #E8EAF6; padding: 14px; margin-bottom: 14px; box-shadow: 0 2px 10px rgba(108, 92, 231, 0.05);">
            <div style="font-size: 10px; font-weight: 700; color: #A0A8CC; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 12px;">
                👥 Membres du groupe
            </div>

            {% for memberItem in membersWithStatus %}
                <div style="display: flex; align-items: center; gap: 10px; padding: 10px; margin-bottom: 10px; background: #F4F5FB; border-radius: 10px; transition: all 0.2s;" onmouseover="this.style.background='#EFEFFF'" onmouseout="this.style.background='#F4F5FB'">
                    <a href="{{ path('social_profile_show', { id: memberItem.user.id }) }}" style="display: flex; align-items: center; gap: 10px; flex: 1; text-decoration: none; color: inherit; cursor: pointer;">
                        {# Avatar #}
                        <div style="width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, #74b9ff, #0984e3); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 13px; font-weight: 700; overflow: hidden;">
                            {% if memberItem.user.avatarUrl %}
                                <img src="{{ memberItem.user.avatarUrl }}" style="width: 100%; height: 100%; object-fit: cover;">
                            {% else %}
                                {{ memberItem.user.firstName|first|upper }}{{ memberItem.user.lastName|first|upper }}
                            {% endif %}
                        </div>

                        {# Info #}
                        <div style="flex: 1; min-width: 0;">
                            <div style="font-size: 12px; font-weight: 600; color: #1A1D2E; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                {{ memberItem.user.firstName }} {{ memberItem.user.lastName }}
                                {% if memberItem.user.id == group.getCreatedById().id %}
                                    <span style="background: #DCFCE7; color: #059669; padding: 1px 6px; border-radius: 8px; font-size: 8px; font-weight: 700;">👑</span>
                                {% endif %}
                            </div>
                            <div style="font-size: 10px; color: #A0A8CC;">
                                @{{ memberItem.user.username ?? memberItem.user.email }}
                            </div>
                        </div>
                    </a>

                    {# Remove Button (only for admin) #}
                    {% if isAdmin and memberItem.user.id != group.getCreatedById().id %}
                        <form action="{{ path('social_groups_remove_member', { id: group.id, memberId: memberItem.user.id }) }}" method="post" style="display: inline;">
                            <button type="submit" onclick="return confirm('Retirer {{ memberItem.user.firstName }} du groupe ?')" style="padding: 4px 8px; background: #FEE2E2; color: #DC2626; border: none; border-radius: 6px; font-size: 10px; font-weight: 600; cursor: pointer; white-space: nowrap; transition: all 0.2s; flex-shrink: 0;" onmouseover="this.style.background='#FCA5A5'" onmouseout="this.style.background='#FEE2E2'">
                                ✕
                            </button>
                        </form>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}


{# SOCIALMEDIA/network/_user_card.html.twig #}
{# Params: user, cardType (FOLLOWING|FOLLOWER|PENDING), isMutual #}

<div class="user-card">
    {# Avatar #}
    <div class="card-avatar">
        {% if user.avatarUrl %}
            <img src="{{ user.avatarUrl }}" alt="{{ user.fullName }}" class="avatar-img">
        {% else %}
            <div class="avatar-initials">{{ user.initials }}</div>
        {% endif %}
    </div>

    {# Name & Username #}
    <h3 class="card-name">{{ user.fullName }}</h3>
    <p class="card-username">@{{ user.username }}</p>

    {# Badges #}
    <div class="card-badges">
        {% if isMutual %}
            <span class="badge badge-mutual">Mutuel</span>
        {% endif %}
        {% if cardType == 'PENDING' %}
            <span class="badge badge-pending">En attente</span>
        {% endif %}
    </div>

    {# Buttons #}
    <div class="card-buttons">
        <a href="{{ path('social_profile_show', {id: user.id}) }}" class="btn btn-secondary">
            Voir profil
        </a>

        {% if cardType == 'FOLLOWING' %}
            <button class="btn btn-danger" onclick="unfollowUser({{ user.id }})">
                Se désabonner
            </button>

        {% elseif cardType == 'FOLLOWER' %}
            <button class="btn btn-danger" onclick="removeFollower({{ user.id }})">
                Supprimer
            </button>

        {% elseif cardType == 'PENDING' %}
            <button class="btn btn-success" onclick="acceptFollow({{ user.id }})">
                ✓ Accepter
            </button>
            <button class="btn btn-danger" onclick="rejectFollow({{ user.id }})">
                Refuser
            </button>
        {% endif %}
    </div>
</div>

<style>
    .user-card {
        background: white;
        border: 1px solid #E8EAF6;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .user-card:hover {
        border-color: #D4CAFF;
        box-shadow: 0 4px 16px rgba(108, 92, 231, 0.1);
        transform: translateY(-2px);
    }

    .card-avatar {
        width: 80px;
        height: 80px;
        margin: 0 auto;
        position: relative;
    }

    .avatar-img {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid white;
        box-shadow: 0 4px 12px rgba(108, 92, 231, 0.2);
    }

    .avatar-initials {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: bold;
        font-size: 1.75rem;
        border: 3px solid white;
    }

    .card-name {
        margin: 0;
        font-size: 1.1rem;
        color: #1A1D2E;
        font-weight: 800;
    }

    .card-username {
        margin: 0;
        font-size: 0.9rem;
        color: #A0A8CC;
    }

    .card-badges {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
        flex-wrap: wrap;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.4rem 0.75rem;
        border-radius: 9999px;
        font-weight: 600;
    }

    .badge-mutual {
        background: #EDE9FE;
        color: #7C3AED;
    }

    .badge-pending {
        background: #FEF3C7;
        color: #D97706;
    }

    .card-buttons {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .btn {
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-secondary {
        background: #F0EEFF;
        color: #6C5CE7;
    }

    .btn-secondary:hover {
        background: #E5DEFF;
    }

    .btn-success {
        background: linear-gradient(135deg, #6C5CE7, #5B4FD3);
        color: white;
        box-shadow: 0 4px 12px rgba(108, 92, 231, 0.3);
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(108, 92, 231, 0.4);
    }

    .btn-danger {
        background: #FEE2E2;
        color: #EF4444;
    }

    .btn-danger:hover {
        background: #FECACA;
    }
</style>

<script>
    function unfollowUser(userId) {
        if (confirm('Voulez-vous vraiment vous désabonner ?')) {
            fetch(`/social/network/unfollow/${userId}`, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                });
        }
    }

    function removeFollower(userId) {
        if (confirm('Voulez-vous vraiment supprimer ce suiveur ?')) {
            fetch(`/social/network/unfollow/${userId}`, { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    }
                });
        }
    }

    function acceptFollow(userId) {
        fetch(`/social/network/follow/${userId}/accept`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
    }

    function rejectFollow(userId) {
        fetch(`/social/network/follow/${userId}/reject`, { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    location.reload();
                }
            });
    }
</script>

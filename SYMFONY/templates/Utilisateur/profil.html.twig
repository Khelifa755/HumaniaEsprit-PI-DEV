{% extends "base.html.twig" %}

{% block title %}Mon Profil - Humania{% endblock %}

{% block body %}
<div class="profil-page">

    {# ── PAGE HEADER ── #}
    <div class="profil-header">
        <div class="profil-header-left">
            <div class="profil-header-icon">
                <svg width="28" height="28" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4"/><path d="M6 20v-1a6 6 0 0 1 12 0v1"/>
                </svg>
            </div>
            <div>
                <h1>Mon Profil</h1>
                <p>• Gérez vos informations personnelles et la sécurité de votre compte</p>
            </div>
        </div>
        <a href="{{ path('app_home') }}" class="btn-back">← Retour</a>
    </div>

    {# Flash messages #}
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✓ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error">✕ {{ msg }}</div>
    {% endfor %}

    {# ── PERSONAL INFO FORM ── #}
    <div class="profil-section">
        <div class="section-title-row">
            <h2>Informations personnelles</h2>
            <span class="required-note">* champs obligatoires</span>
        </div>
        <div class="section-divider"></div>

        {% if error %}
            <div class="flash flash-error">{{ error }}</div>
        {% endif %}

        <form method="post" enctype="multipart/form-data" action="{{ path('app_profil') }}" class="profil-form" data-turbo="false">

            {# Avatar + fields side-by-side #}
            <div class="profil-body">
                {# Avatar column #}
                <div class="avatar-col">
                    <div class="avatar-label">Photo de profil</div>
                    <div class="avatar-circle">
                        {% if utilisateur.pdp %}
                            <img src="/uploads/avatars/{{ utilisateur.pdp }}"
                                 alt="Photo de profil"
                                 style="width:100%;height:100%;object-fit:cover;border-radius:50%;">
                        {% else %}
                            <span class="avatar-initials">{{ utilisateur.initials }}</span>
                        {% endif %}
                    </div>
                    <label class="btn-browse">
                        📁 Parcourir...
                        <input type="file" name="avatar" accept="image/*" style="display:none;"
                               onchange="previewAvatar(this)">
                    </label>
                </div>

                {# Fields grid #}
                <div class="fields-grid">
                    <div class="form-field">
                        <label>Nom *</label>
                        <input type="text" name="nom" value="{{ utilisateur.nom }}" required placeholder="Votre nom">
                    </div>
                    <div class="form-field">
                        <label>Prenom *</label>
                        <input type="text" name="prenom" value="{{ utilisateur.prenom }}" required placeholder="Votre prénom">
                    </div>
                    <div class="form-field full">
                        <label>Email *</label>
                        <input type="email" name="email" value="{{ utilisateur.email }}" required placeholder="vous@exemple.com">
                    </div>
                    <div class="form-field">
                        <label>Username *</label>
                        <input type="text" name="username" value="{{ utilisateur.username }}" required placeholder="username">
                    </div>
                    <div class="form-field">
                        <label>Telephone</label>
                        <input type="tel" name="numtel" value="{{ utilisateur.numtel }}" placeholder="00000000">
                    </div>
                    <div class="form-field">
                        <label>Nouveau mot de passe</label>
                        <input type="password" name="new_password" placeholder="Laisser vide pour ne pas changer">
                    </div>
                    <div class="form-field">
                        <label>Confirmer mot de passe</label>
                        <input type="password" name="confirm_password" placeholder="Confirmer si vous changez">
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-save">
                    💾 Enregistrer les modifications
                </button>
            </div>
        </form>
    </div>

    {# ── SECURITY SECTION ── #}
    <div class="profil-section security-section">
        <div class="section-title-row">
            <h2>Sécurité du compte</h2>
            <span class="required-note">Renforcez la protection de votre compte</span>
        </div>

        <div class="security-cards">
            {# MFA card #}
            <div class="security-card">
                <div class="security-card-header">
                    <div class="security-icon-box" style="background:#ede9fe;">
                        <svg width="22" height="22" fill="none" stroke="#7c3aed" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
                        </svg>
                    </div>
                    <div>
                        <div class="security-card-title">Double authentification</div>
                        <div class="security-card-sub">Google Authenticator · Authy</div>
                    </div>
                </div>
                <div class="security-card-divider"></div>
                <p class="security-desc">Protégez votre compte avec un code temporaire à usage unique (TOTP).</p>

                {% if utilisateur.mfaEnabled %}
                    <div class="status-line status-ok">✔ Activee</div>
                    <div class="security-card-actions">
                        <form method="post" action="{{ path('app_mfa_disable') }}"
                              onsubmit="return confirm('Désactiver le MFA ? Votre compte sera moins protégé.')">
                            <button type="submit" class="btn-sec btn-sec-danger">Desactiver MFA</button>
                        </form>
                    </div>
                {% else %}
                    <div class="status-line status-off">✕ Désactivée</div>
                    <div class="security-card-actions">
                        <a href="{{ path('app_mfa_setup') }}" class="btn-sec btn-sec-purple">Activer le MFA</a>
                    </div>
                {% endif %}
            </div>

            {# FACE RECOGNITION CARD #}
            <div class="security-card">
                <div class="security-card-header">
                    <div class="security-icon-box" style="background:#e0f2fe;">
                        <svg width="22" height="22" fill="none" stroke="#0284c7" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                            <circle cx="12" cy="10" r="3"/>
                        </svg>
                    </div>
                    <div>
                        <div class="security-card-title">Reconnaissance Faciale</div>
                        <div class="security-card-sub">Face++ Login</div>
                    </div>
                </div>
                <div class="security-card-divider"></div>
                <p class="security-desc">Connectez-vous rapidement et en toute sécurité avec votre visage.</p>

                {% if utilisateur.donneesFaciales %}
                    <div class="status-line status-ok">✔ Visage enregistré</div>
                    <div class="security-card-actions">
                        <form method="post" action="{{ path('app_profil_face_delete') }}"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre visage ? Vous ne pourrez plus vous connecter avec la reconnaissance faciale.')">
                            <button type="submit" class="btn-sec btn-sec-danger">Supprimer visage</button>
                        </form>
                    </div>
                {% else %}
                    <div class="status-line status-off">✕ Aucun visage</div>
                    <div class="security-card-actions">
                        <button type="button" class="btn-sec btn-sec-purple" onclick="openFaceModal()">Ajouter mon visage</button>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

</div>

<script>
function previewAvatar(input) {
    if (!input.files || !input.files[0]) return;
    var reader = new FileReader();
    reader.onload = function(e) {
        var circle = input.closest('.avatar-col').querySelector('.avatar-circle');
        circle.innerHTML = '<img src="' + e.target.result + '" style="width:100%;height:100%;object-fit:cover;border-radius:50%;">';
    };
    reader.readAsDataURL(input.files[0]);
}

let videoStream = null;

function openFaceModal() {
    document.getElementById('faceModal').style.display = 'flex';
    navigator.mediaDevices.getUserMedia({ video: true })
        .then(function(stream) {
            videoStream = stream;
            document.getElementById('videoElement').srcObject = stream;
        })
        .catch(function(err) {
            alert("Erreur d'accès à la caméra : " + err);
            closeFaceModal();
        });
}

function closeFaceModal() {
    document.getElementById('faceModal').style.display = 'none';
    if (videoStream) {
        videoStream.getTracks().forEach(track => track.stop());
        videoStream = null;
    }
}

function captureFace() {
    const video = document.getElementById('videoElement');
    const canvas = document.getElementById('canvasElement');
    const btn = document.getElementById('captureBtn');
    
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    
    const base64Image = canvas.toDataURL('image/jpeg');
    
    btn.disabled = true;
    btn.innerText = "Enregistrement...";

    fetch('{{ path("app_profil_face_register") }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ image: base64Image })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            alert(data.message);
            window.location.reload();
        } else {
            alert("Erreur : " + data.message);
            btn.disabled = false;
            btn.innerText = "Capturer et enregistrer";
        }
    })
    .catch(err => {
        alert("Erreur de connexion.");
        btn.disabled = false;
        btn.innerText = "Capturer et enregistrer";
    });
}
</script>

<div id="faceModal" class="face-modal-overlay" style="display:none;">
    <div class="face-modal">
        <h3>Enregistrement du visage</h3>
        <p>Veuillez regarder la caméra et cliquer sur "Capturer".</p>
        <div class="camera-container">
            <video id="videoElement" autoplay playsinline></video>
            <canvas id="canvasElement" style="display:none;"></canvas>
        </div>
        <div class="face-modal-actions">
            <button type="button" class="btn-sec btn-sec-danger" onclick="closeFaceModal()">Annuler</button>
            <button type="button" class="btn-sec btn-sec-teal" id="captureBtn" onclick="captureFace()">Capturer et enregistrer</button>
        </div>
    </div>
</div>

<style>
.profil-page { max-width:1100px; margin:0 auto; padding:0 1rem 3rem; }

/* Header */
.profil-header {
    display:flex;justify-content:space-between;align-items:center;
    padding:1.25rem 1.75rem;margin-bottom:1.5rem;
    background:white;border-radius:14px;
    box-shadow:0 2px 8px rgba(0,0,0,.07);
}
.profil-header-left { display:flex;align-items:center;gap:1rem; }
.profil-header-icon {
    width:52px;height:52px;border-radius:14px;
    background:linear-gradient(135deg,#7c3aed,#9333ea);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.profil-header h1 { margin:0;font-size:1.5rem;color:#111827;font-weight:700; }
.profil-header p  { margin:0;color:#6b7280;font-size:.88rem; }
.btn-back {
    padding:.6rem 1.25rem;border-radius:10px;border:1.5px solid #e5e7eb;
    background:white;color:#374151;text-decoration:none;font-weight:600;font-size:.88rem;
    transition:all .2s;
}
.btn-back:hover { border-color:#7c3aed;color:#7c3aed; }

/* Flash */
.flash { padding:.8rem 1rem;border-radius:8px;font-size:.88rem;margin-bottom:1rem; }
.flash-success { background:#f0fdf4;color:#166534;border:1px solid #bbf7d0; }
.flash-error   { background:#fef2f2;color:#b91c1c;border:1px solid #fecaca; }

/* Section */
.profil-section {
    background:white;border-radius:14px;padding:1.75rem 2rem;
    box-shadow:0 2px 8px rgba(0,0,0,.07);margin-bottom:1.5rem;
}
.section-title-row {
    display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem;
}
.section-title-row h2 { margin:0;font-size:1.1rem;font-weight:700;color:#111827; }
.required-note { font-size:.8rem;color:#9ca3af; }
.section-divider { height:1.5px;background:#f3f4f6;margin-bottom:1.5rem; }

/* Profile body layout */
.profil-body { display:flex;gap:2.5rem;align-items:flex-start; }

/* Avatar */
.avatar-col { display:flex;flex-direction:column;align-items:center;gap:.75rem;flex-shrink:0; }
.avatar-label { font-size:.82rem;color:#9ca3af;font-weight:500; }
.avatar-circle {
    width:130px;height:130px;border-radius:50%;
    background:linear-gradient(135deg,#ede9fe,#ddd6fe);
    display:flex;align-items:center;justify-content:center;
    overflow:hidden;
}
.avatar-initials { font-size:2.5rem;font-weight:800;color:#7c3aed; }
.btn-browse {
    display:inline-flex;align-items:center;gap:.4rem;
    padding:.5rem 1rem;border:1.5px solid #e5e7eb;border-radius:8px;
    background:white;font-size:.85rem;color:#374151;cursor:pointer;
    font-weight:500;transition:all .2s;
}
.btn-browse:hover { border-color:#7c3aed;color:#7c3aed; }

/* Fields */
.fields-grid {
    flex:1;display:grid;grid-template-columns:1fr 1fr;gap:1rem;
}
.fields-grid .full { grid-column:span 2; }
.form-field { display:flex;flex-direction:column;gap:.4rem; }
.form-field label { font-size:.85rem;font-weight:600;color:#374151; }
.form-field input {
    padding:.75rem 1rem;border:1.5px solid #e5e7eb;border-radius:10px;
    font-size:.92rem;color:#111827;background:#fafafa;outline:none;
    transition:border-color .2s,box-shadow .2s;
}
.form-field input:focus { border-color:#7c3aed;background:white;box-shadow:0 0 0 3px rgba(124,58,237,.1); }

.form-actions { margin-top:1.5rem; }
.btn-save {
    padding:.8rem 2rem;background:linear-gradient(135deg,#7c3aed,#9333ea);
    color:white;border:none;border-radius:10px;font-size:.95rem;
    font-weight:700;cursor:pointer;transition:opacity .2s,transform .15s;
}
.btn-save:hover { opacity:.9;transform:translateY(-1px); }

/* Security section */
.security-section { margin-top:1.5rem; }
.security-cards { display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1rem; }

.security-card {
    border:1.5px solid #f3f4f6;border-radius:14px;padding:1.5rem;
    transition:box-shadow .2s;
}
.security-card:hover { box-shadow:0 4px 16px rgba(0,0,0,.08); }

.security-card-header { display:flex;align-items:flex-start;gap:.9rem;margin-bottom:.75rem; }
.security-icon-box {
    width:44px;height:44px;border-radius:12px;
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.security-card-title { font-weight:700;font-size:1rem;color:#111827; }
.security-card-sub   { font-size:.8rem;color:#9ca3af;margin-top:.1rem; }
.security-card-divider { height:1px;background:#f3f4f6;margin:.75rem 0; }
.security-desc { font-size:.88rem;color:#6b7280;line-height:1.6;margin:0 0 .75rem; }

.status-line { font-size:.88rem;font-weight:600;margin-bottom:1rem; }
.status-ok  { color:#16a34a; }
.status-off { color:#9ca3af; }

.security-card-actions { display:flex;gap:.75rem;flex-wrap:wrap; }

.btn-sec {
    padding:.55rem 1.1rem;border-radius:8px;font-size:.85rem;font-weight:600;
    cursor:pointer;text-decoration:none;border:none;transition:all .2s;display:inline-flex;align-items:center;gap:.4rem;
}
.btn-sec-teal  { background:#d1fae5;color:#065f46; }
.btn-sec-teal:hover { background:#a7f3d0; }
.btn-sec-danger-outline { background:white;border:1.5px solid #fca5a5;color:#dc2626; }
.btn-sec-danger-outline:hover { background:#fef2f2; }
.btn-sec-danger { background:#fef2f2;color:#dc2626; }
.btn-sec-danger:hover { background:#fee2e2; }
.btn-sec-purple { background:#ede9fe;color:#7c3aed; }
.btn-sec-purple:hover { background:#ddd6fe; }

@media(max-width:768px){
    .profil-body { flex-direction:column; }
    .fields-grid { grid-template-columns:1fr; }
    .fields-grid .full { grid-column:span 1; }
    .security-cards { grid-template-columns:1fr; }
}

.face-modal-overlay {
    position: fixed; top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0,0,0,0.6); z-index: 1000;
    display: flex; align-items: center; justify-content: center;
}
.face-modal {
    background: white; padding: 2rem; border-radius: 14px;
    width: 400px; max-width: 90%; text-align: center;
}
.face-modal h3 { margin-top: 0; margin-bottom: 0.5rem; }
.camera-container {
    margin: 1.5rem 0; width: 100%; aspect-ratio: 4/3;
    background: #000; border-radius: 8px; overflow: hidden;
}
.camera-container video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
.face-modal-actions { display: flex; justify-content: center; gap: 1rem; }
</style>

{% endblock %}

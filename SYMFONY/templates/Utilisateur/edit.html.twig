{% extends "base.html.twig" %}

{% block title %}Modifier Utilisateur - Humania{% endblock %}

{% block body %}
<div class="edit-page">

    <div class="page-header">
        <div class="page-header-left">
            <div class="page-icon" style="background:linear-gradient(135deg,#7c3aed,#9333ea);overflow:hidden;">
                {% if utilisateur.pdp %}
                    <img src="/uploads/avatars/{{ utilisateur.pdp }}" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                    <svg width="24" height="24" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                    </svg>
                {% endif %}
            </div>
            <div>
                <h1>Modifier l'utilisateur</h1>
                <p>• {{ utilisateur.prenom }} {{ utilisateur.nom }}</p>
            </div>
        </div>
        <a href="{{ path('app_admin_users') }}" class="btn-back">← Retour</a>
    </div>

    {% if error %}
        <div class="flash flash-error">✕ {{ error }}</div>
    {% endif %}
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✓ {{ msg }}</div>
    {% endfor %}

    <div class="edit-card">
        <form method="post" action="{{ path('app_admin_user_edit', {id: utilisateur.id}) }}">

            <div class="section-label">Informations personnelles</div>
            <div class="form-grid">
                <div class="form-field">
                    <label>Nom *</label>
                    <input type="text" name="nom" value="{{ utilisateur.nom }}" required>
                </div>
                <div class="form-field">
                    <label>Prénom *</label>
                    <input type="text" name="prenom" value="{{ utilisateur.prenom }}" required>
                </div>
                <div class="form-field">
                    <label>Email *</label>
                    <input type="email" name="email" value="{{ utilisateur.email }}" required>
                </div>
                <div class="form-field">
                    <label>Username</label>
                    <input type="text" name="username" value="{{ utilisateur.username }}">
                </div>
                <div class="form-field">
                    <label>Téléphone</label>
                    <input type="tel" name="numtel" value="{{ utilisateur.numtel }}">
                </div>
                <div class="form-field">
                    <label>Nouveau mot de passe</label>
                    <input type="password" name="mot_de_passe" placeholder="Laisser vide pour ne pas changer">
                </div>
            </div>

            <div class="section-label">Rôle & Statut</div>
            <div class="form-grid">
                <div class="form-field">
                    <label>Rôle</label>
                    <select name="role">
                        {% for role in roles %}
                            <option value="{{ role.value }}"
                                    {% if utilisateur.roleValue == role.value %}selected{% endif %}>
                                {{ role.label() }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-field">
                    <label>Statut</label>
                    <select name="statut">
                        <option value="Actif"    {% if utilisateur.statut == 'Actif' %}selected{% endif %}>Actif</option>
                        <option value="Bloqué"   {% if utilisateur.statut == 'Bloqué' %}selected{% endif %}>Bloqué</option>
                        <option value="Suspendu" {% if utilisateur.statut == 'Suspendu' %}selected{% endif %}>Suspendu</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>Manager</label>
                    <select name="manager_id">
                        <option value="">— Aucun —</option>
                        {% for mgr in managers %}
                            <option value="{{ mgr.id }}"
                                    {% if mgr.id == utilisateur.managerId %}selected{% endif %}>
                                {{ mgr.prenom }} {{ mgr.nom }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="form-field">
                    <label>Date d'embauche</label>
                    <input type="date" name="date_embauche"
                           value="{{ utilisateur.dateEmbauche ? utilisateur.dateEmbauche|date('Y-m-d') : '' }}">
                </div>
            </div>

            <div class="section-label">Informations professionnelles</div>
            <div class="form-grid">
                <div class="form-field">
                    <label>Matricule</label>
                    <input type="text" name="matricule" value="{{ utilisateur.matricule }}">
                </div>
                <div class="form-field">
                    <label>Poste actuel</label>
                    <input type="text" name="poste_actuel" value="{{ utilisateur.posteActuel }}">
                </div>
                <div class="form-field full">
                    <label>Département</label>
                    <input type="text" name="departement" value="{{ utilisateur.departement }}">
                </div>
            </div>

            <div class="form-actions">
                <a href="{{ path('app_admin_users') }}" class="btn-cancel">Annuler</a>
                <button type="submit" class="btn-save">💾 Enregistrer les modifications</button>
            </div>
        </form>
    </div>
</div>

<style>
.edit-page{max-width:800px;margin:0 auto;padding:0 1rem 3rem;}
.page-header{display:flex;justify-content:space-between;align-items:center;padding:1.5rem 2rem;margin-bottom:2rem;background:linear-gradient(135deg,#ffffff,#f9fafb);border-radius:20px;box-shadow:0 4px 20px rgba(0,0,0,.06);border:1px solid rgba(255,255,255,.5);transition:all .3s ease;}
.page-header:hover{box-shadow:0 8px 30px rgba(0,0,0,.08);}
.page-header-left{display:flex;align-items:center;gap:1.5rem;}
.page-icon{width:60px;height:60px;border-radius:18px;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 15px rgba(0,0,0,.1);}
.page-header h1{margin:0;font-size:1.5rem;color:#111827;font-weight:800;letter-spacing:-.5px;}
.page-header p{margin:0.5rem 0 0;color:#6b7280;font-size:.9rem;font-weight:500;}
.btn-back{padding:.65rem 1.4rem;border:none;border-radius:12px;background:white;color:#374151;text-decoration:none;font-weight:600;font-size:.88rem;transition:all .3s ease;box-shadow:0 2px 8px rgba(0,0,0,.05);}
.btn-back:hover{transform:translateY(-2px);box-shadow:0 6px 16px rgba(124,58,237,.15);color:#7c3aed;background:#f9fafb;}
.flash{padding:1rem 1.25rem;border-radius:14px;font-size:.88rem;margin-bottom:1.5rem;border-left:4px solid;animation:slideIn .3s ease;}
.flash-success{background:#f0fdf4;color:#166534;border-left-color:#22c55e;}
.flash-error{background:#fef2f2;color:#b91c1c;border-left-color:#ef4444;}
@keyframes slideIn{from{opacity:0;transform:translateX(-20px);}to{opacity:1;transform:translateX(0);}}
.edit-card{background:linear-gradient(135deg,#ffffff,#fafafa);border-radius:20px;padding:2.5rem;box-shadow:0 4px 20px rgba(0,0,0,.06);border:1px solid rgba(255,255,255,.5);}
.section-label{font-size:.75rem;font-weight:800;text-transform:uppercase;letter-spacing:1.5px;color:#9ca3af;margin:2rem 0 1rem;padding-bottom:.75rem;border-bottom:2px solid #f3f4f6;}
.section-label:first-child{margin-top:0;}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:1rem;}
.form-grid .full{grid-column:span 2;}
.form-field{display:flex;flex-direction:column;gap:.5rem;}
.form-field label{font-size:.88rem;font-weight:700;color:#374151;}
.form-field input,.form-field select{padding:.85rem 1.1rem;border:1.5px solid #e5e7eb;border-radius:14px;font-size:.92rem;color:#111827;outline:none;transition:all .3s ease;background:#fafafa;font-family:inherit;}
.form-field input:hover,.form-field select:hover{border-color:#d1d5db;background:white;}
.form-field input:focus,.form-field select:focus{border-color:#7c3aed;background:white;box-shadow:0 0 0 4px rgba(124,58,237,.12);}
.form-actions{display:flex;justify-content:flex-end;gap:1rem;margin-top:2.5rem;padding-top:2rem;border-top:2px solid #f3f4f6;}
.btn-cancel{padding:.8rem 1.8rem;border:none;border-radius:14px;background:#f3f4f6;color:#374151;text-decoration:none;font-size:.92rem;font-weight:700;transition:all .3s ease;cursor:pointer;}
.btn-cancel:hover{background:#e5e7eb;transform:translateY(-2px);box-shadow:0 4px 12px rgba(0,0,0,.08);}
.btn-save{padding:.8rem 2rem;background:linear-gradient(135deg,#7c3aed,#9333ea);color:white;border:none;border-radius:14px;font-size:.92rem;font-weight:700;cursor:pointer;transition:all .3s ease;box-shadow:0 4px 15px rgba(124,58,237,.3);}
.btn-save:hover{transform:translateY(-3px);box-shadow:0 8px 25px rgba(124,58,237,.4);opacity:1;}
.btn-save:active{transform:translateY(-1px);}
@media(max-width:600px){.form-grid{grid-template-columns:1fr;}.form-grid .full{grid-column:1;}}
</style>
{% endblock %}

    {# Status breakdown #}
    <div class="hm-card">
      <div class="hm-card-title">
        <i class="fa-solid fa-list-check"></i>
        Statuts Pipeline
      </div>
      {% set statusColors = {
        'Accepté':          'var(--success)',
        'Rejeté':           'var(--danger)',
        'En attente':       'var(--warn)',
        'Entretien':        'var(--info)',
        'Test':             'var(--accent2)',
        'Offre':            'var(--accent3)',
        'Candidature reçue':'var(--muted)',
        'En cours':         'var(--accent)',
        'Pré-selection':    'var(--accent)',
        'Nouvelle':         'var(--muted)'
      } %}
      {% set statusIcons = {
        'Accepté':          'fa-circle-check',
        'Rejeté':           'fa-circle-xmark',
        'En attente':       'fa-clock',
        'Entretien':        'fa-microphone',
        'Test':             'fa-pen-to-square',
        'Offre':            'fa-briefcase',
        'Candidature reçue':'fa-envelope-open-text',
        'En cours':         'fa-spinner',
        'Pré-selection':    'fa-filter',
        'Nouvelle':         'fa-file-circle-plus'
      } %}
      {% if stats.candidatureByStatus is defined and stats.candidatureByStatus|length %}
        {% for status, count in stats.candidatureByStatus %}
          {% set pct = stats.totalCandidatures > 0 ? (count / stats.totalCandidatures * 100)|round : 0 %}
          {% set color = statusColors[status] ?? 'var(--muted)' %}
          {% set icon  = statusIcons[status] ?? 'fa-tag' %}
          <div class="hm-progress-row">
            <div class="hm-progress-header">
              <span class="hm-progress-label">
                <i class="fa-solid {{ icon }}" style="color:{{ color }};font-size:.75rem;"></i>
                {{ status }}
              </span>
              <span class="hm-progress-count">{{ count }}</span>
            </div>
            <div class="hm-bar-bg">
              <div class="hm-bar-fill" style="width:{{ pct }}%;background:{{ color }};"></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="hm-empty"><i class="fa-solid fa-inbox"></i> Aucune donnée</div>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {# ══════════════════════════════════════════════════════════════
     3) CONGÉS & ABSENCES
  ══════════════════════════════════════════════════════════════ #}
  <div class="hm-section-header">
    <div class="icon icon-green"><i class="fa-solid fa-umbrella-beach"></i></div>
    <h3>Congés &amp; Absences</h3>
  </div>

  <div class="hm-kpi-grid">
    <div class="hm-kpi kpi-green">
      <div class="hm-kpi-icon icon-green"><i class="fa-solid fa-calendar-check"></i></div>
      <div class="hm-kpi-val">{{ stats.totalConges ?? '—' }}</div>
      <div class="hm-kpi-label">Total congés</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-list fa-xs"></i><span>Toutes périodes</span></div>
    </div>
    <div class="hm-kpi kpi-warn">
      <div class="hm-kpi-icon icon-orange"><i class="fa-solid fa-hourglass-half"></i></div>
      <div class="hm-kpi-val">{{ stats.congesEnAttente ?? '—' }}</div>
      <div class="hm-kpi-label">En attente approbation</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-bell fa-xs"></i><span>À traiter</span></div>
    </div>
    <div class="hm-kpi kpi-blue">
      <div class="hm-kpi-icon icon-blue"><i class="fa-solid fa-person-walking-arrow-right"></i></div>
      <div class="hm-kpi-val">{{ stats.totalAbsences ?? '—' }}</div>
      <div class="hm-kpi-label">Absences déclarées</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-calendar-xmark fa-xs"></i><span>Ce mois</span></div>
    </div>
    <div class="hm-kpi kpi-teal">
      <div class="hm-kpi-icon icon-teal"><i class="fa-solid fa-check-double"></i></div>
      <div class="hm-kpi-val">{{ stats.congesApprouves ?? '—' }}</div>
      <div class="hm-kpi-label">Congés approuvés</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-circle-check fa-xs" style="color:var(--success);"></i><span>Validés</span></div>
    </div>
  </div>

  {# ══════════════════════════════════════════════════════════════
     4) FORMATIONS & ÉVALUATIONS
  ══════════════════════════════════════════════════════════════ #}
  <div class="hm-section-header">
    <div class="icon icon-purple"><i class="fa-solid fa-graduation-cap"></i></div>
    <h3>Formations &amp; Évaluations</h3>
  </div>

  <div class="hm-kpi-grid">
    <div class="hm-kpi kpi-purple">
      <div class="hm-kpi-icon icon-purple"><i class="fa-solid fa-book-open"></i></div>
      <div class="hm-kpi-val">{{ stats.totalFormations ?? '—' }}</div>
      <div class="hm-kpi-label">Formations disponibles</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-layer-group fa-xs"></i><span>Catalogue</span></div>
    </div>
    <div class="hm-kpi kpi-info">
      <div class="hm-kpi-icon icon-info"><i class="fa-solid fa-person-chalkboard"></i></div>
      <div class="hm-kpi-val">{{ stats.totalInscriptions ?? '—' }}</div>
      <div class="hm-kpi-label">Inscriptions actives</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-users fa-xs"></i><span>Apprenants</span></div>
    </div>
    <div class="hm-kpi kpi-orange">
      <div class="hm-kpi-icon icon-orange"><i class="fa-solid fa-clipboard-question"></i></div>
      <div class="hm-kpi-val">{{ stats.totalEvaluations ?? '—' }}</div>
      <div class="hm-kpi-label">Évaluations disponibles</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-square-poll-vertical fa-xs"></i><span>QCM &amp; exercices</span></div>
    </div>
    <div class="hm-kpi kpi-green">
      <div class="hm-kpi-icon icon-green"><i class="fa-solid fa-star-half-stroke"></i></div>
      <div class="hm-kpi-val">{{ stats.avgEvalScore ?? '—' }}</div>
      <div class="hm-kpi-label">Score moyen évaluations</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-trophy fa-xs" style="color:var(--warn);"></i><span>Moyenne apprenants</span></div>
    </div>
  </div>

  {# ══════════════════════════════════════════════════════════════
     5) COMPÉTENCES
  ══════════════════════════════════════════════════════════════ #}
  <div class="hm-section-header">
    <div class="icon icon-orange"><i class="fa-solid fa-star"></i></div>
    <h3>Compétences</h3>
  </div>

  <div class="hm-two-col">
    <div class="hm-card">
      <div class="hm-card-title">
        <i class="fa-solid fa-chart-pie"></i>
        Répartition par type
      </div>
      {% set compTypes = {'CRITIQUE': 'var(--danger)', 'IMPORTANTE': 'var(--warn)', 'SECONDAIRE': 'var(--info)'} %}
      {% set compIcons = {'CRITIQUE': 'fa-fire', 'IMPORTANTE': 'fa-triangle-exclamation', 'SECONDAIRE': 'fa-circle-info'} %}
      {% if stats.competencesByType is defined %}
        {% for type, count in stats.competencesByType %}
          <div class="hm-progress-row">
            <div class="hm-progress-header">
              <span class="hm-progress-label">
                <i class="fa-solid {{ compIcons[type] ?? 'fa-star' }}" style="color:{{ compTypes[type] ?? 'var(--muted)' }};font-size:.75rem;"></i>
                {{ type }}
              </span>
              <span class="hm-progress-count">{{ count }}</span>
            </div>
            {% set pctC = stats.totalCompetences is defined and stats.totalCompetences > 0 ? (count / stats.totalCompetences * 100)|round : 0 %}
            <div class="hm-bar-bg">
              <div class="hm-bar-fill" style="width:{{ pctC }}%;background:{{ compTypes[type] ?? 'var(--muted)' }};"></div>
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="hm-progress-row">
          <div class="hm-progress-header">
            <span class="hm-progress-label"><i class="fa-solid fa-fire" style="color:var(--danger);font-size:.75rem;"></i> CRITIQUE</span>
            <span class="hm-progress-count">{{ stats.totalCompetences ?? '—' }}</span>
          </div>
          <div class="hm-bar-bg"><div class="hm-bar-fill" style="width:60%;background:var(--danger);"></div></div>
        </div>
        <div class="hm-progress-row">
          <div class="hm-progress-header">
            <span class="hm-progress-label"><i class="fa-solid fa-triangle-exclamation" style="color:var(--warn);font-size:.75rem;"></i> IMPORTANTE</span>
            <span class="hm-progress-count">—</span>
          </div>
          <div class="hm-bar-bg"><div class="hm-bar-fill" style="width:30%;background:var(--warn);"></div></div>
        </div>
      {% endif %}
      <div class="hm-kpi-footer" style="margin-top:1rem;border-top:1px solid var(--border);padding-top:.75rem;">
        <i class="fa-solid fa-database fa-xs"></i>
        <span>{{ stats.totalCompetences ?? '—' }} compétences au référentiel</span>
      </div>
    </div>

    <div class="hm-card">
      <div class="hm-card-title">
        <i class="fa-solid fa-user-graduate"></i>
        Maîtrise des employés
      </div>
      {% set ringTotal = (stats.totalCompetencesEmployes ?? 100) %}
      {% set ringValidated = (stats.competencesValidees ?? 70) %}
      {% set pctRing = ringTotal > 0 ? (ringValidated / ringTotal * 100)|round : 0 %}
      {% set dash = 220 %}
      {% set dashOffset = dash - (dash * pctRing / 100) %}
      <div class="hm-ring-wrap">
        <div class="hm-ring" style="width:100px;height:100px;">
          <svg width="100" height="100" viewBox="0 0 100 100">
            <circle cx="50" cy="50" r="35" fill="none" stroke="var(--ring-track)" stroke-width="10"/>
            <circle cx="50" cy="50" r="35" fill="none" stroke="var(--accent2)" stroke-width="10"
              stroke-dasharray="{{ dash }}" stroke-dashoffset="{{ dashOffset }}"
              stroke-linecap="round" style="transition:stroke-dashoffset .8s ease;"/>
          </svg>
          <div class="hm-ring-label">
            {{ pctRing }}%
            <span>validé</span>
          </div>
        </div>
        <div class="hm-ring-legend">
          <div class="hm-ring-legend-item">
            <div class="hm-ring-legend-dot" style="background:var(--accent2);"></div>
            <span class="hm-ring-legend-name">Validées</span>
            <span class="hm-ring-legend-val">{{ stats.competencesValidees ?? '—' }}</span>
          </div>
          <div class="hm-ring-legend-item">
            <div class="hm-ring-legend-dot" style="background:var(--border2);"></div>
            <span class="hm-ring-legend-name">Non validées</span>
            <span class="hm-ring-legend-val">{{ (ringTotal - ringValidated) }}</span>
          </div>
          <div class="hm-ring-legend-item">
            <div class="hm-ring-legend-dot" style="background:var(--warn);"></div>
            <span class="hm-ring-legend-name">Total entrées</span>
            <span class="hm-ring-legend-val">{{ stats.totalCompetencesEmployes ?? '—' }}</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# ══════════════════════════════════════════════════════════════
     6) SOCIAL / MESSAGING & ÉVÉNEMENTS
  ══════════════════════════════════════════════════════════════ #}
  <div class="hm-section-header">
    <div class="icon icon-teal"><i class="fa-solid fa-comments"></i></div>
    <h3>Social &amp; Événements</h3>
  </div>

  <div class="hm-kpi-grid">
    <div class="hm-kpi kpi-teal">
      <div class="hm-kpi-icon icon-teal"><i class="fa-solid fa-newspaper"></i></div>
      <div class="hm-kpi-val">{{ stats.totalPublications ?? '—' }}</div>
      <div class="hm-kpi-label">Publications actives</div>
      <div class="hm-kpi-footer"><i class="fa-brands fa-rocketchat fa-xs"></i><span>Fil d'actualité</span></div>
    </div>
    <div class="hm-kpi kpi-info">
      <div class="hm-kpi-icon icon-info"><i class="fa-solid fa-envelope-open-text"></i></div>
      <div class="hm-kpi-val">{{ stats.totalMessages ?? '—' }}</div>
      <div class="hm-kpi-label">Messages échangés</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-comments fa-xs"></i><span>Messagerie privée</span></div>
    </div>
    <div class="hm-kpi kpi-purple">
      <div class="hm-kpi-icon icon-purple"><i class="fa-solid fa-calendar-days"></i></div>
      <div class="hm-kpi-val">{{ stats.totalEvenements ?? '—' }}</div>
      <div class="hm-kpi-label">Événements planifiés</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-location-dot fa-xs"></i><span>À venir</span></div>
    </div>
    <div class="hm-kpi kpi-orange">
      <div class="hm-kpi-icon icon-orange"><i class="fa-solid fa-bell"></i></div>
      <div class="hm-kpi-val">{{ stats.totalNotifications ?? '—' }}</div>
      <div class="hm-kpi-label">Notifications envoyées</div>
      <div class="hm-kpi-footer"><i class="fa-solid fa-satellite-dish fa-xs"></i><span>Système</span></div>
    </div>
  </div>

  {# ══════════════════════════════════════════════════════════════
     QUICK ACTIONS
  ══════════════════════════════════════════════════════════════ #}
  <div class="hm-sep"></div>
  <div class="hm-full">
    <div class="hm-card">
      <div class="hm-card-title"><i class="fa-solid fa-bolt"></i> Actions Rapides</div>
      <div class="hm-actions-grid">
        {% if isAdmin or isRH %}
        <a href="{{ path('app_admin_candidats_acceptes') }}" class="hm-action">
          <i class="fa-solid fa-user-plus" style="background:rgba(52,208,138,.12);color:var(--success);"></i>
          Convertir candidats
        </a>
        <a href="{{ path('app_admin_users') }}" class="hm-action">
          <i class="fa-solid fa-users-gear" style="background:rgba(91,110,245,.12);color:var(--accent);"></i>
          Gérer utilisateurs
        </a>
        <a href="{{ path('app_admin_archives') }}" class="hm-action">
          <i class="fa-solid fa-box-archive" style="background:rgba(245,166,35,.12);color:var(--warn);"></i>
          Archives
        </a>
        {% endif %}
        {% if isAdmin or isRH or isManager %}
        <a href="{{ path('app_analyse_rh_index') }}" class="hm-action">
          <i class="fa-solid fa-id-card" style="background:rgba(56,178,249,.12);color:var(--info);"></i>
          Candidatures
        </a>
        <a href="{{ path('mes_lecons_index') }}" class="hm-action">
          <i class="fa-solid fa-graduation-cap" style="background:rgba(155,92,246,.12);color:var(--accent2);"></i>
          Formations
        </a>
        {% endif %}
        <a href="{{ path('app_conge_index') }}" class="hm-action">
          <i class="fa-solid fa-umbrella-beach" style="background:rgba(52,208,138,.12);color:var(--success);"></i>
          Mes Congés
        </a>
        {% if isAdmin %}
        <a href="{{ path('competence_catalog') }}" class="hm-action">
          <i class="fa-solid fa-star" style="background:rgba(245,166,35,.12);color:var(--warn);"></i>
          Compétences
        </a>
        <a href="{{ path('social_feed') }}" class="hm-action">
          <i class="fa-solid fa-comments" style="background:rgba(14,201,176,.12);color:var(--accent3);"></i>
          Social
        </a>
        {% endif %}
      </div>
    </div>
  </div>

  {% else %}
  {# No stats: empty state #}
  <div class="hm-card" style="text-align:center;padding:3rem;">
    <i class="fa-solid fa-chart-bar" style="font-size:3rem;color:var(--muted);opacity:.4;display:block;margin-bottom:1rem;"></i>
    <p style="color:var(--muted);">Les statistiques ne sont pas disponibles.</p>
  </div>
  {% endif %}{# fin hasStats #}

  {% endif %}{# fin isEmploye / else admin-rh-manager #}

</div>

{# ── SCRIPTS ──────────────────────────────────────────────────── #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  const ctx = document.getElementById('submissionsChart');
  if (!ctx) return;

  let months = {{ chartMonths is defined ? chartMonths|raw : '[]' }};
  let counts = {{ chartCounts is defined ? chartCounts|raw : '[]' }};
  if (!months || months.length === 0) {
    months = ['Sep 25','Oct 25','Nov 25','Déc 25','Jan 26','Fév 26','Mar 26','Avr 26'];
    counts = [8, 12, 15, 18, 14, 20, 25, 22];
  }

  Chart.defaults.color = '#5c6578';
  Chart.defaults.font.family = "'DM Sans', sans-serif";

  new Chart(ctx, {
    type: 'line',
    data: {
      labels: months,
      datasets: [{
        label: 'Candidatures soumises',
        data: counts,
        borderColor: '#4f5fef',
        backgroundColor: function(ctx) {
          const c = ctx.chart.ctx;
          const g = c.createLinearGradient(0, 0, 0, 200);
          g.addColorStop(0, 'rgba(79,95,239,.22)');
          g.addColorStop(1, 'rgba(79,95,239,0)');
          return g;
        },
        borderWidth: 2.5,
        fill: true,
        tension: 0.4,
        pointRadius: 4,
        pointBackgroundColor: '#4f5fef',
        pointBorderColor: '#ffffff',
        pointBorderWidth: 2,
        pointHoverRadius: 7,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#ffffff',
          titleColor: '#141827',
          bodyColor: '#5c6578',
          borderColor: 'rgba(15,23,42,.12)',
          borderWidth: 1,
          padding: 10,
          titleFont: { weight: '700' },
          callbacks: {
            label: ctx => ` ${ctx.parsed.y} candidature${ctx.parsed.y > 1 ? 's' : ''}`
          }
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          grid: { color: 'rgba(15,23,42,.06)', drawBorder: false },
          ticks: { font: { size: 11 }, color: '#5c6578' }
        },
        x: {
          grid: { display: false, drawBorder: false },
          ticks: { font: { size: 11 }, color: '#5c6578' }
        }
      }
    }
  });
});
</script>
{% endblock %}

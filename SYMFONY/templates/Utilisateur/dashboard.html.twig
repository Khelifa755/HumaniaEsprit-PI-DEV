{% extends "base.html.twig" %}

{% block title %}Bienvenue — Humania{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
<style>

/* ═══════════════════════════════════════════════════════════════
   ROOT & TOKENS
═══════════════════════════════════════════════════════════════ */
:root {
  --hue: 234;
  --bg:          #F4F6FB;
  --surface:     #ffffff; 
  --surface2:    #f4f6fb;
  --border:      rgba(15, 23, 42, .08);
  --border2:     rgba(15, 23, 42, .14);
  --text:        #141827;
  --muted:       #5c6578;
  --accent:      #4f5fef;
  --accent2:     #8b4fd9;
  --accent3:     #0aa894;
  --danger:      #e02445;
  --warn:        #d97706;
  --success:     #0d9f6e;
  --info:        #0e8ecf;
  --shadow:      0 4px 24px rgba(15, 23, 42, .08);
  --ring-track:  rgba(15, 23, 42, .1);
  --radius:      14px;
  --radius-lg:   20px;
  --font-head:   'Syne', sans-serif;
  --font-body:   'DM Sans', sans-serif;
  --transition:  .22s cubic-bezier(.4,0,.2,1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
}

/* ═══════════════════════════════════════════════════════════════
   LAYOUT
═══════════════════════════════════════════════════════════════ */
.hm-dash {
  max-width: 1440px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
  position: relative;
}

/* Ambient blobs */
.hm-dash::before, .hm-dash::after {
  content: '';
  position: fixed;
  border-radius: 50%;
  filter: blur(100px);
  pointer-events: none;
  z-index: 0;
  opacity: .1;
}
.hm-dash::before {
  width: 500px; height: 500px;
  background: var(--accent);
  top: -100px; left: -100px;
}
.hm-dash::after {
  width: 400px; height: 400px;
  background: var(--accent2);
  bottom: 100px; right: -80px;
}

/* ═══════════════════════════════════════════════════════════════
   TOP BAR
═══════════════════════════════════════════════════════════════ */
.hm-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2.5rem;
  position: relative;
  z-index: 1;
}
.hm-topbar-left h1 {
  font-family: var(--font-head);
  font-size: 1.75rem;
  font-weight: 800;
  background: linear-gradient(135deg, #141827 35%, var(--accent));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.2;
}
.hm-topbar-left p {
  color: var(--muted);
  font-size: .88rem;
  margin-top: .3rem;
}
.hm-topbar-badge {
  display: inline-flex;
  align-items: center;
  gap: .4rem;
  background: rgba(13,159,110,.1);
  color: var(--success);
  border: 1px solid rgba(13,159,110,.22);
  border-radius: 20px;
  font-size: .75rem;
  font-weight: 600;
  padding: .3rem .75rem;
  margin-top: .5rem;
}
.hm-topbar-right {
  display: flex;
  align-items: center;
  gap: .75rem;
}
.hm-btn {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .55rem 1.1rem;
  border-radius: 10px;
  font-size: .84rem;
  font-weight: 600;
  text-decoration: none;
  border: 1px solid var(--border2);
  background: var(--surface);
  color: var(--text);
  transition: var(--transition);
  cursor: pointer;
  font-family: var(--font-body);
}
.hm-btn:hover {
  background: var(--surface2);
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-1px);
}
.hm-btn-danger {
  background: rgba(242,92,122,.1);
  border-color: rgba(242,92,122,.3);
  color: var(--danger);
}
.hm-btn-danger:hover {
  background: rgba(242,92,122,.2);
  border-color: var(--danger);
  color: var(--danger);
}

/* ═══════════════════════════════════════════════════════════════
   ROLE BANNER
═══════════════════════════════════════════════════════════════ */
.hm-role-banner {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, var(--surface) 0%, var(--surface2) 100%);
  border: 1px solid var(--border2);
  border-radius: var(--radius-lg);
  padding: 1.5rem 2rem;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 1.25rem;
  overflow: hidden;
}
.hm-role-banner::after {
  content: '';
  position: absolute;
  right: -40px; top: -40px;
  width: 200px; height: 200px;
  background: var(--accent);
  border-radius: 50%;
  opacity: .08;
}
.hm-role-avatar {
  width: 56px; height: 56px;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--accent), var(--accent2));
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem;
  flex-shrink: 0;
  color: #fff;
}
.hm-role-info h2 {
  font-family: var(--font-head);
  font-size: 1.15rem;
  font-weight: 700;
}
.hm-role-info p { color: var(--muted); font-size: .85rem; margin-top: .2rem; }
.hm-role-pill {
  margin-left: auto;
  padding: .4rem 1rem;
  border-radius: 20px;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  flex-shrink: 0;
}
.hm-role-pill.admin   { background: rgba(79,95,239,.12); color: #3730a3; border: 1px solid rgba(79,95,239,.28); }
.hm-role-pill.manager { background: rgba(217,119,6,.1); color: #b45309; border: 1px solid rgba(217,119,6,.28); }
.hm-role-pill.rh      { background: rgba(139,79,217,.1); color: #6b21a8; border: 1px solid rgba(139,79,217,.28); }
.hm-role-pill.employe { background: rgba(10,168,148,.1); color: #0f766e; border: 1px solid rgba(10,168,148,.28); }

/* ═══════════════════════════════════════════════════════════════
   SECTION HEADER
═══════════════════════════════════════════════════════════════ */
.hm-section-header {
  position: relative; z-index: 1;
  display: flex;
  align-items: center;
  gap: .75rem;
  margin: 2.5rem 0 1.25rem;
}
.hm-section-header .icon {
  width: 36px; height: 36px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: .95rem;
  flex-shrink: 0;
}
.hm-section-header h3 {
  font-family: var(--font-head);
  font-size: 1rem;
  font-weight: 700;
  letter-spacing: .02em;
}
.hm-section-header::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--border);
  margin-left: .5rem;
}

/* Color variants */
.icon-blue  { background: rgba(91,110,245,.15); color: var(--accent); }
.icon-green { background: rgba(52,208,138,.12); color: var(--success); }
.icon-purple{ background: rgba(155,92,246,.12); color: var(--accent2); }
.icon-teal  { background: rgba(14,201,176,.12); color: var(--accent3); }
.icon-orange{ background: rgba(245,166,35,.12); color: var(--warn); }
.icon-red   { background: rgba(242,92,122,.12); color: var(--danger); }
.icon-info  { background: rgba(56,178,249,.12); color: var(--info); }

/* ═══════════════════════════════════════════════════════════════
   KPI GRID
═══════════════════════════════════════════════════════════════ */
.hm-kpi-grid {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1rem;
  margin-bottom: .5rem;
}
.hm-kpi {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.4rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: .5rem;
  position: relative;
  overflow: hidden;
  transition: var(--transition);
  text-decoration: none;
  color: inherit;
}
.hm-kpi::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 3px;
  border-radius: var(--radius) var(--radius) 0 0;
}
.hm-kpi:hover {
  border-color: var(--border2);
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}
.hm-kpi-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem;
  margin-bottom: .25rem;
}
.hm-kpi-val {
  font-family: var(--font-head);
  font-size: 2rem;
  font-weight: 800;
  line-height: 1;
  color: var(--text);
}
.hm-kpi-label {
  font-size: .8rem;
  color: var(--muted);
  font-weight: 500;
}
.hm-kpi-footer {
  display: flex; align-items: center; gap: .35rem;
  font-size: .75rem;
  color: var(--muted);
  margin-top: .25rem;
  border-top: 1px solid var(--border);
  padding-top: .65rem;
}
.hm-kpi-footer a { color: var(--accent); text-decoration: none; font-weight: 600; }
.hm-kpi-footer a:hover { text-decoration: underline; }

/* accent-colored tops */
.kpi-blue::before   { background: var(--accent); }
.kpi-green::before  { background: var(--success); }
.kpi-purple::before { background: var(--accent2); }
.kpi-teal::before   { background: var(--accent3); }
.kpi-orange::before { background: var(--warn); }
.kpi-red::before    { background: var(--danger); }
.kpi-info::before   { background: var(--info); }
.kpi-muted::before  { background: var(--muted); }

/* ═══════════════════════════════════════════════════════════════
   TWO-COLUMN LAYOUT
═══════════════════════════════════════════════════════════════ */
.hm-two-col {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
  margin-bottom: .5rem;
}
.hm-three-col {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 1.25rem;
}

/* ═══════════════════════════════════════════════════════════════
   CARDS
═══════════════════════════════════════════════════════════════ */
.hm-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  position: relative; z-index: 1;
}
.hm-card-title {
  font-family: var(--font-head);
  font-size: .95rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
  display: flex; align-items: center; gap: .5rem;
}
.hm-card-title i { color: var(--accent); }

/* ═══════════════════════════════════════════════════════════════
   PROGRESS BARS
═══════════════════════════════════════════════════════════════ */
.hm-progress-row {
  display: flex;
  flex-direction: column;
  gap: .6rem;
  margin-bottom: 1rem;
}
.hm-progress-row:last-child { margin-bottom: 0; }
.hm-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: .82rem;
}
.hm-progress-label { color: var(--text); font-weight: 500; display: flex; align-items: center; gap: .5rem; }
.hm-progress-count { color: var(--muted); font-weight: 600; font-size: .8rem; }
.hm-bar-bg {
  height: 6px;
  background: var(--border);
  border-radius: 3px;
  overflow: hidden;
}
.hm-bar-fill {
  height: 100%;
  border-radius: 3px;
  transition: width .6s cubic-bezier(.4,0,.2,1);
}

/* ═══════════════════════════════════════════════════════════════
   STATUS BADGE
═══════════════════════════════════════════════════════════════ */
.hm-badge {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .2rem .65rem;
  border-radius: 20px;
  font-size: .72rem;
  font-weight: 600;
}
.badge-success { background: rgba(52,208,138,.12); color: var(--success); }
.badge-warn    { background: rgba(245,166,35,.12);  color: var(--warn); }
.badge-danger  { background: rgba(242,92,122,.12);  color: var(--danger); }
.badge-info    { background: rgba(56,178,249,.12);  color: var(--info); }
.badge-muted   { background: rgba(123,130,176,.1);  color: var(--muted); }
.badge-purple  { background: rgba(155,92,246,.12);  color: var(--accent2); }

/* ═══════════════════════════════════════════════════════════════
   QUICK ACTIONS
═══════════════════════════════════════════════════════════════ */
.hm-actions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: .85rem;
}
.hm-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .6rem;
  padding: 1.25rem .75rem;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: var(--surface2);
  text-decoration: none;
  color: var(--text);
  font-size: .8rem;
  font-weight: 600;
  text-align: center;
  transition: var(--transition);
}
.hm-action:hover {
  border-color: var(--accent);
  background: rgba(91,110,245,.08);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(91,110,245,.2);
}
.hm-action i {
  font-size: 1.3rem;
  width: 42px; height: 42px;
  border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
}

/* ═══════════════════════════════════════════════════════════════
   CHART
═══════════════════════════════════════════════════════════════ */
.hm-chart-wrap {
  position: relative;
  height: 210px;
}

/* ═══════════════════════════════════════════════════════════════
   MODULE MINI CARDS (6-module overview)
═══════════════════════════════════════════════════════════════ */
.hm-modules-grid {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 1rem;
  margin-bottom: .5rem;
}
.hm-module {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem 1rem;
  text-align: center;
  text-decoration: none;
  color: inherit;
  transition: var(--transition);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: .5rem;
}
.hm-module:hover {
  border-color: var(--border2);
  transform: translateY(-3px);
  box-shadow: var(--shadow);
  background: var(--surface2);
}
.hm-module i {
  font-size: 1.4rem;
}
.hm-module-name {
  font-size: .75rem;
  font-weight: 600;
  color: var(--muted);
  line-height: 1.3;
}
.hm-module-val {
  font-family: var(--font-head);
  font-size: 1.4rem;
  font-weight: 800;
  color: var(--text);
}

/* ═══════════════════════════════════════════════════════════════
   ACTIVITY FEED
═══════════════════════════════════════════════════════════════ */
.hm-feed {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.hm-feed-item {
  display: flex;
  align-items: flex-start;
  gap: .85rem;
  padding: .85rem 0;
  border-bottom: 1px solid var(--border);
}
.hm-feed-item:last-child { border-bottom: none; }
.hm-feed-dot {
  width: 32px; height: 32px;
  border-radius: 8px;
  display: flex; align-items: center; justify-content: center;
  font-size: .8rem;
  flex-shrink: 0;
  margin-top: .1rem;
}
.hm-feed-content { flex: 1; min-width: 0; }
.hm-feed-title {
  font-size: .84rem;
  font-weight: 600;
  color: var(--text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hm-feed-sub { font-size: .75rem; color: var(--muted); margin-top: .15rem; }
.hm-feed-time { font-size: .72rem; color: var(--muted); flex-shrink: 0; }

/* ═══════════════════════════════════════════════════════════════
   DONUT / RING STAT
═══════════════════════════════════════════════════════════════ */
.hm-ring-wrap {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}
.hm-ring { position: relative; flex-shrink: 0; }
.hm-ring svg { transform: rotate(-90deg); }
.hm-ring-label {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-family: var(--font-head);
  font-weight: 800;
  font-size: 1.3rem;
  color: var(--text);
}
.hm-ring-label span { font-size: .65rem; font-weight: 500; color: var(--muted); font-family: var(--font-body); }
.hm-ring-legend { flex: 1; display: flex; flex-direction: column; gap: .6rem; }
.hm-ring-legend-item {
  display: flex; align-items: center; gap: .6rem;
  font-size: .8rem;
}
.hm-ring-legend-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.hm-ring-legend-name { color: var(--muted); flex: 1; }
.hm-ring-legend-val { font-weight: 700; color: var(--text); }

/* ═══════════════════════════════════════════════════════════════
   FULL-WIDTH ROW
═══════════════════════════════════════════════════════════════ */
.hm-full { position: relative; z-index: 1; }

/* ═══════════════════════════════════════════════════════════════
   EMPTY STATE
═══════════════════════════════════════════════════════════════ */
.hm-empty {
  text-align: center;
  padding: 2rem;
  color: var(--muted);
  font-size: .85rem;
}
.hm-empty i { font-size: 2rem; margin-bottom: .5rem; display: block; opacity: .4; }

/* ═══════════════════════════════════════════════════════════════
   SEPARATOR
═══════════════════════════════════════════════════════════════ */
.hm-sep { height: 1.5rem; }

/* ═══════════════════════════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════════════════════════ */
@media (max-width: 1280px) {
  .hm-modules-grid { grid-template-columns: repeat(3, 1fr); }
  .hm-kpi-grid     { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 900px) {
  .hm-two-col, .hm-three-col { grid-template-columns: 1fr; }
  .hm-actions-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (max-width: 640px) {
  .hm-modules-grid { grid-template-columns: repeat(2, 1fr); }
  .hm-kpi-grid     { grid-template-columns: 1fr; }
  .hm-topbar { flex-direction: column; align-items: flex-start; gap: 1rem; }
  .hm-topbar-right { flex-wrap: wrap; }
  .hm-actions-grid { grid-template-columns: repeat(2, 1fr); }
}

/* ═══════════════════════════════════════════════════════════════
   ANIMATION
═══════════════════════════════════════════════════════════════ */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.hm-kpi, .hm-card, .hm-module {
  animation: fadeUp .45s ease both;
}
.hm-kpi:nth-child(1)  { animation-delay: .04s; }
.hm-kpi:nth-child(2)  { animation-delay: .08s; }
.hm-kpi:nth-child(3)  { animation-delay: .12s; }
.hm-kpi:nth-child(4)  { animation-delay: .16s; }
.hm-kpi:nth-child(5)  { animation-delay: .20s; }
.hm-kpi:nth-child(6)  { animation-delay: .24s; }
.hm-kpi:nth-child(7)  { animation-delay: .28s; }
.hm-kpi:nth-child(8)  { animation-delay: .32s; }
.hm-module:nth-child(1){ animation-delay: .05s; }
.hm-module:nth-child(2){ animation-delay: .10s; }
.hm-module:nth-child(3){ animation-delay: .15s; }
.hm-module:nth-child(4){ animation-delay: .20s; }
.hm-module:nth-child(5){ animation-delay: .25s; }
.hm-module:nth-child(6){ animation-delay: .30s; }

</style>
{% endblock %}

{% block body %}
{% set role = app.user ? app.user.role.value : 'EMPLOYE' %}
{% set isAdmin   = role == 'ADMIN' %}
{% set isRH      = role == 'RH' %}
{% set isManager = role == 'MANAGER' %}
{% set isEmploye = role == 'EMPLOYE' %}
{% set hasStats  = stats is defined %}

<div class="hm-dash">

  {# ── TOP BAR ────────────────────────────────────────────────── #}
  <div class="hm-topbar">
    <div class="hm-topbar-left">
      <h1><i class="fa-solid fa-hand-sparkles" style="font-size:1.3rem;-webkit-text-fill-color:var(--accent);"></i>&nbsp; Bienvenue{% if app.user %}, {{ app.user.prenom }}{% endif %}</h1>
      <p>{{ "now"|date("l d F Y") }} &mdash; Humania RH</p>
      <div class="hm-topbar-badge">
        <i class="fa-solid fa-circle" style="font-size:.5rem;"></i>
        Système opérationnel
      </div>
    </div>
    <div class="hm-topbar-right">
      {% if isAdmin or isRH %}
        <a href="{{ path('app_admin_users') }}" class="hm-btn">
          <i class="fa-solid fa-users-gear"></i> Utilisateurs
        </a>
      {% endif %}
      <a href="{{ path('app_profil') }}" class="hm-btn">
        <i class="fa-solid fa-circle-user"></i> Mon Profil
      </a>
      <a href="{{ path('app_logout') }}" class="hm-btn hm-btn-danger">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Déconnexion
      </a>

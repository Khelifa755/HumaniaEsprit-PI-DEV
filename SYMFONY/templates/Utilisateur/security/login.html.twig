{% extends "base.html.twig" %}

{% block title %}Connexion · Humania{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .main-content { padding: 0 !important; }
    </style>
{% endblock %}

{% block body %}

<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>
/* ══════════════════════════════════════════
   DESIGN TOKENS
══════════════════════════════════════════ */
:root {
  --ink:       #0f0e17;
  --ink-mid:   #3a3853;
  --ink-soft:  #6b7280;
  --bg:        #fafaf9;
  --surface:   #ffffff;
  --border:    #e8e6f0;
  --primary:   #4F46E5;
  --primary-d: #3730a3;
  --primary-l: #ede9fe;
  --green:     #5db87a;
  --font-head: 'Syne', sans-serif;
  --font-body: 'DM Sans', sans-serif;
  --shadow:    0 4px 24px rgba(15,14,23,.08);
  --shadow-lg: 0 16px 56px rgba(15,14,23,.16);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: var(--font-body); background: var(--bg); color: var(--ink); min-height: 100vh; overflow-x: hidden; margin: 0 !important; padding: 0 !important; }
body > * { margin: 0 !important; }
body > br, body > #wrapper > br { display: none; }

/* ── CONTAINER ── */
.container {
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
  padding: 0 48px;
}

/* ── NAV ── */
.lp-nav { 
  position: sticky; top: 0; z-index: 100;
  background: rgba(250,250,249,.92); backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border);
}
.lp-nav-inner {
  max-width: 1280px;
  margin: 0 auto;
  width: 100%;
  padding: 0 48px;
  height: 56px;
  display: flex; align-items: center; justify-content: space-between;
}
.lp-nav-brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-head); font-weight: 800; font-size: 18px; color: var(--ink); text-decoration: none; letter-spacing: .06em; }
.lp-nav-brand img { height: 32px; width: 32px; border-radius: 8px; object-fit: cover; }
.nav-links { display: flex; align-items: center; gap: 32px; }
.nav-links a { font-size: 14px; font-weight: 500; color: var(--ink-mid); text-decoration: none; transition: color .15s; }
.nav-links a:hover { color: var(--primary); }
.nav-btn { display: inline-flex; align-items: center; gap: 7px; background: var(--primary); color: white; padding: 9px 20px; border-radius: 99px; font-size: 14px; font-weight: 600; font-family: var(--font-body); text-decoration: none; transition: background .18s, transform .18s, box-shadow .18s; width: auto; flex-shrink: 0; white-space: nowrap; }
.nav-btn:hover { background: var(--primary-d); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(79,70,229,.28); color: white; }

/* ── HERO ── */
.hero { min-height: calc(100vh - 56px); position: relative; overflow: hidden; background: linear-gradient(135deg, #f0effe 0%, #fafaf9 40%, #eef6ff 70%, #f5f0ff 100%); }
.hero-inner { max-width: 1280px; margin: 0 auto; padding: 36px 48px 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; position: relative; z-index: 1; }
.hero::before { content: ''; position: absolute; inset: 0; z-index: 0; background-image: radial-gradient(circle, rgba(79,70,229,.18) 1.5px, transparent 1.5px), radial-gradient(circle, rgba(167,139,250,.10) 1px, transparent 1px); background-size: 36px 36px, 18px 18px; background-position: 0 0, 9px 9px; opacity: .6; }
.hero::after { content: ''; position: absolute; top: -80px; right: -80px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(79,70,229,.13) 0%, transparent 70%); z-index: 0; }
.hero-copy { position: relative; z-index: 1; }
.hero-pill { display: inline-flex; align-items: center; gap: 7px; background: white; border: 1px solid var(--border); border-radius: 99px; padding: 6px 14px 6px 9px; font-size: 12.5px; font-weight: 600; color: var(--ink-mid); margin-bottom: 28px; box-shadow: var(--shadow); }
.hero-pill-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100%{ box-shadow:0 0 0 0 rgba(93,184,122,.5); } 50%{ box-shadow:0 0 0 5px rgba(93,184,122,0); } }
.hero-title { font-family: var(--font-head); font-size: clamp(2.8rem, 5vw, 4.2rem); font-weight: 800; line-height: 1.03; color: var(--ink); margin-bottom: 20px; }
.hero-title .accent { color: var(--primary); }
.hero-desc { font-size: 15px; line-height: 1.7; color: var(--ink-soft); max-width: 420px; margin-bottom: 36px; }
.hero-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.btn-hero-primary { display: inline-flex; align-items: center; gap: 8px; background: var(--primary); color: white; padding: 13px 28px; border-radius: 99px; font-size: 14px; font-weight: 700; font-family: var(--font-body); text-decoration: none; transition: all .2s; }
.btn-hero-primary:hover { background: var(--primary-d); transform: translateY(-2px); box-shadow: 0 10px 32px rgba(79,70,229,.32); color: white; }
.btn-hero-secondary { display: inline-flex; align-items: center; gap: 8px; color: var(--ink-mid); font-size: 14px; font-weight: 600; text-decoration: none; transition: color .15s; }
.btn-hero-secondary svg { transition: transform .2s; }
.btn-hero-secondary:hover { color: var(--primary); }
.btn-hero-secondary:hover svg { transform: translateX(3px); }
.hero-stats { display: flex; gap: 32px; margin-top: 44px; }
.hero-stat-num { font-family: var(--font-head); font-size: 1.6rem; font-weight: 800; color: var(--ink); }
.hero-stat-label { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }

/* ── LOGIN CARD ── */
.hero-form-col { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: stretch; animation: cardIn .6s cubic-bezier(.22,1,.36,1) both; }
@keyframes cardIn { from { opacity:0; transform:translateY(32px) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }
.login-card { background: var(--surface); border: 1.5px solid var(--border); border-radius: 24px; padding: 36px 36px 32px; box-shadow: var(--shadow-lg); }
.status-badge { display: inline-flex; align-items: center; gap: 7px; background: var(--primary-l); border: 1px solid #ddd6fe; border-radius: 99px; padding: 5px 14px 5px 9px; font-size: 12px; font-weight: 600; color: var(--primary); margin-bottom: 18px; }
.status-dot { width:7px;height:7px;border-radius:50%;background:var(--green); animation: pulse 2s infinite; }
.card-title { font-family: var(--font-head); font-size: 1.75rem; font-weight: 800; color: var(--ink); letter-spacing: -.02em; margin-bottom: 5px; }
.card-sub { font-size: 14px; color: var(--ink-soft); line-height: 1.5; margin-bottom: 26px; }
.alert { display:flex;align-items:flex-start;gap:10px; padding:12px 14px;border-radius:12px; font-size:13.5px;font-weight:500;line-height:1.5; margin-bottom:16px; }
.alert-icon { flex-shrink:0;font-size:15px;margin-top:1px; }
.alert-danger  { background:#fef2f2;color:#b91c1c;border:1px solid #fecaca; }
.alert-warning { background:#fffbeb;color:#92400e;border:1px solid #fde68a; }
.alert-success { background:#f0fdf4;color:#166534;border:1px solid #bbf7d0; }
.lockout-bar { height:4px;border-radius:2px;background:#fee2e2;margin-bottom:18px;overflow:hidden; }
.lockout-bar-inner { height:100%;border-radius:2px;background:#ef4444; animation:shrinkBar linear forwards; animation-duration:calc(var(--secs,60) * 1s); }
@keyframes shrinkBar { from{width:100%} to{width:0%} }
.attempt-row { display:flex;align-items:center;gap:7px;margin-bottom:18px; }
.att-dot { width:11px;height:11px;border-radius:50%;background:#e5e7eb;transition:background .3s,transform .2s; }
.att-dot.used { background:#ef4444;transform:scale(1.15); }
.att-label { font-size:12px;font-weight:600;color:#dc2626;margin-left:2px; }
.form-field { margin-bottom: 18px; }
.form-label { display:block; font-size:11px;font-weight:700; text-transform:uppercase;letter-spacing:.09em; color:var(--ink-soft);margin-bottom:8px; }
.label-row { display:flex;justify-content:space-between;align-items:center; margin-bottom:8px; }
.label-row .form-label { margin:0; }
.forgot-link { font-size:12.5px;font-weight:600; color:var(--primary);text-decoration:none;transition:color .15s; }
.forgot-link:hover { color:var(--primary-d); }
.input-wrap { position:relative;display:flex;align-items:center; }
.input-ico { position:absolute;left:13px; color:#c0c8d5;pointer-events:none; display:flex;align-items:center;transition:color .2s; }
.input-wrap:focus-within .input-ico { color:var(--primary); }
.input-wrap input { width:100%; padding:12px 14px 12px 41px; border:1.5px solid var(--border);border-radius:11px; font-size:14.5px;font-family:var(--font-body); color:var(--ink);background:var(--bg); outline:none; transition:border-color .18s,box-shadow .18s,background .18s; }
.input-wrap input:focus { border-color:var(--primary);background:white; box-shadow:0 0 0 3.5px rgba(79,70,229,.11); }
.input-wrap input::placeholder { color:#c8d0de; }
.pw-toggle { position:absolute;right:12px; background:none;border:none;cursor:pointer; color:#c0c8d5;display:flex;padding:4px; transition:color .15s; }
.pw-toggle:hover { color:var(--primary); }
.pw-toggle:focus { outline:none; }
.remember-row { display:flex;align-items:center;gap:9px;margin-bottom:22px; }
.remember-row input[type=checkbox] { width:15px;height:15px;accent-color:var(--primary);cursor:pointer; }
.remember-row label { font-size:13px;color:var(--ink-soft);cursor:pointer; }
.btn-submit { width:100%;padding:13px; background:var(--primary);color:white; border:none;border-radius:12px; font-size:15px;font-weight:700;font-family:var(--font-head); letter-spacing:.01em;cursor:pointer; display:flex;align-items:center;justify-content:center;gap:9px; transition:background .2s,transform .18s,box-shadow .2s; position:relative;overflow:hidden; }
.btn-submit::after { content:'';position:absolute;inset:0; background:linear-gradient(120deg,transparent 30%,rgba(255,255,255,.12) 50%,transparent 70%); transform:translateX(-100%);transition:transform .5s; }
.btn-submit:hover::after { transform:translateX(100%); }
.btn-submit:hover:not(:disabled) { background:var(--primary-d); transform:translateY(-2px); box-shadow:0 8px 28px rgba(79,70,229,.35); }
.btn-submit:active:not(:disabled) { transform:translateY(0); }
.btn-submit:disabled { opacity:.5;cursor:not-allowed; }
.divider { display:flex;align-items:center;gap:12px; margin:22px 0;color:#d0d4de;font-size:12px; }
.divider::before,.divider::after { content:'';flex:1;height:1px;background:var(--border); }
.btn-google { width:100%; display:flex;align-items:center;justify-content:center;gap:10px; padding:12px; background:#ffffff;color:#3a3853; border:1.5px solid #d1d5db;border-radius:12px; font-size:14px;font-weight:600;font-family:var(--font-body); text-decoration:none;cursor:pointer; transition:all .18s; box-shadow: 0 1px 4px rgba(0,0,0,.06); }
.btn-google:hover { border-color:#4285F4;color:#4285F4; box-shadow:0 4px 16px rgba(66,133,244,.18); transform:translateY(-1px); background:#f8fbff; }
.btn-face { width:100%; display:flex;align-items:center;justify-content:center;gap:10px; padding:12px; background:#f0f9ff;color:#0369a1; border:1.5px solid #7dd3fc;border-radius:12px; font-size:14px;font-weight:600;font-family:var(--font-body); text-decoration:none;cursor:pointer; transition:all .18s; box-shadow: 0 1px 4px rgba(14,165,233,.1); margin-top:12px; }
.btn-face:hover { border-color:#0ea5e9;color:#0369a1; box-shadow:0 4px 16px rgba(14,165,233,.22); transform:translateY(-1px); background:#e0f2fe; }
.card-security { display:flex;justify-content:center; gap:18px;flex-wrap:wrap;margin-top:16px; }
.sec-item { display:flex;align-items:center;gap:5px; font-size:11px;color:#b0b8c8;font-weight:500; }

/* ── NOTRE CULTURE ── */
.culture-section { padding: 32px 0; }
.culture-section .container { }
.culture-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
.culture-copy { max-width: 480px; }
.culture-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
.culture-tag { padding: 7px 16px; border-radius: 99px; background: var(--bg); border: 1.5px solid var(--border); font-size: 13px; font-weight: 600; color: var(--ink-mid); }
.culture-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
.culture-card { border-radius: 18px; padding: 22px; }
.culture-card-icon { font-size: 22px; margin-bottom: 10px; }
.culture-card-title { font-family: var(--font-head); font-size: 15px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
.culture-card-desc { font-size: 13px; color: var(--ink-soft); line-height: 1.6; }
.culture-card.c1 { background: #fef9ec; }
.culture-card.c2 { background: #fdf4f4; }
.culture-card.c3 { background: #f0f9ff; }
.culture-card.c4 { background: #f0fdf4; }

/* ── STATS SECTION ── */
.stats-section { padding: 32px 0; background: var(--surface); }
.stats-header { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; margin-bottom: 48px; }
.stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.stat-card { background: white; border: 1.5px solid var(--border); border-radius: 18px; padding: 24px; position: relative; overflow: hidden; }
.stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; }
.stat-card.s1::before { background: var(--primary); }
.stat-card.s2::before { background: #22c55e; }
.stat-card.s3::before { background: #f59e0b; }
.stat-card.s4::before { background: #ef4444; }
.stat-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.stat-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 16px; }
.stat-icon.i1 { background: var(--primary-l); }
.stat-icon.i2 { background: #dcfce7; }
.stat-icon.i3 { background: #fef3c7; }
.stat-icon.i4 { background: #fee2e2; }
.stat-trend { font-size: 11px; font-weight: 600; color: #22c55e; display: flex; align-items: center; gap: 3px; }
.stat-num { font-family: var(--font-head); font-size: 2rem; font-weight: 800; color: var(--ink); margin-bottom: 4px; }
.stat-label { font-size: 13px; color: var(--ink-soft); font-weight: 500; }
.stat-sub { font-size: 11px; color: #b0b8c8; margin-top: 4px; }
.stats-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--border); }
.stats-footer-left { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--ink-soft); }
.stats-footer-right { display: flex; gap: 20px; }
.stats-cert { font-size: 12px; font-weight: 700; color: var(--ink-soft); letter-spacing: .04em; }

/* ── JOBS ── */
.section { padding: 32px 0; }
.section-tag { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--primary); margin-bottom: 12px; }
.section-tag::before { content:''; width:28px; height:2px; background:var(--primary); border-radius:1px; }
.section-title { font-family: var(--font-head); font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 800; color: var(--ink); margin-bottom: 8px; }
.section-sub { font-size: 14.5px; color: var(--ink-soft); margin-bottom: 36px; }
.jobs-header { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28px; flex-wrap: wrap; gap: 16px; }
.jobs-search { display: flex; align-items: center; gap: 8px; border: 1.5px solid var(--border); border-radius: 10px; padding: 9px 14px; background: white; font-size: 13.5px; color: var(--ink-soft); }
.jobs-search svg { color: #c0c8d5; flex-shrink:0; }
.jobs-tabs { display: flex; gap: 8px; margin-bottom: 24px; flex-wrap: wrap; }
.job-tab { padding: 7px 16px; border-radius: 99px; border: 1.5px solid var(--border); font-size: 13px; font-weight: 600; color: var(--ink-soft); cursor: pointer; transition: all .15s; background: white; text-decoration: none; }
.job-tab.active, .job-tab:hover { background: var(--primary); border-color: var(--primary); color: white; }
.jobs-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.job-card { background: white; border: 1.5px solid var(--border); border-radius: 18px; padding: 22px; transition: all .18s; position: relative; }
.job-card:hover { border-color: var(--primary); transform: translateY(-3px); box-shadow: 0 12px 32px rgba(79,70,229,.1); }
.job-card-top { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 14px; }
.job-avatar { width: 42px; height: 42px; border-radius: 12px; background: var(--primary); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-head); font-size: 14px; font-weight: 800; }
.job-badges { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
.badge { padding: 3px 10px; border-radius: 99px; font-size: 11px; font-weight: 700; }
.badge-green { background: #dcfce7; color: #166534; }
.badge-orange { background: #fff7ed; color: #c2410c; }
.badge-gray { background: #f3f4f6; color: #374151; }
.badge-red { background: #fef2f2; color: #991b1b; }
.job-title { font-family: var(--font-head); font-size: 16px; font-weight: 700; color: var(--ink); margin-bottom: 6px; }
.job-meta { font-size: 12px; color: var(--ink-soft); display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
.job-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
.job-tag { padding: 4px 10px; border-radius: 99px; background: var(--bg); border: 1px solid var(--border); font-size: 11px; color: var(--ink-mid); }
.job-footer { display: flex; align-items: center; justify-content: space-between; }
.job-salary { font-family: var(--font-head); font-size: 14px; font-weight: 700; color: var(--ink); }
.job-salary span { font-size: 10px; font-weight: 400; color: var(--ink-soft); }
.btn-apply { padding: 8px 18px; border-radius: 99px; background: var(--primary); color: white; font-size: 13px; font-weight: 700; font-family: var(--font-body); text-decoration: none; display: flex; align-items: center; gap: 6px; transition: all .18s; cursor: pointer; border: none; }
.btn-apply:hover { background: var(--primary-d); color:white; transform:translateY(-1px); box-shadow:0 6px 20px rgba(79,70,229,.28); }
.btn-apply-ghost { padding: 8px 18px; border-radius: 99px; background: transparent; color: var(--ink-soft); border: 1.5px solid var(--border); font-size: 13px; font-weight: 600; font-family: var(--font-body); text-decoration: none; }

/* ── PROCESS ── */
.process-section { padding: 32px 0; background: var(--surface); }
.process-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0; position: relative; margin-top: 48px; }
.process-steps::before { content: ''; position: absolute; top: 24px; left: 10%; right: 10%; height: 2px; background: linear-gradient(90deg, var(--primary) 0%, #a78bfa 100%); z-index: 0; }
.process-step { text-align: center; position: relative; z-index: 1; padding: 0 12px; }
.step-num { width: 48px; height: 48px; border-radius: 50%; background: var(--primary); color: white; font-family: var(--font-head); font-size: 16px; font-weight: 800; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; box-shadow: 0 6px 20px rgba(79,70,229,.28); }
.step-title { font-weight: 700; font-size: 13.5px; color: var(--ink); margin-bottom: 6px; }
.step-desc { font-size: 12px; color: var(--ink-soft); line-height: 1.5; }

/* ── FAQ ── */
.faq-section { padding: 32px 0; }
.faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 40px; }
.faq-item { background: white; border: 1.5px solid var(--border); border-radius: 14px; padding: 18px 20px; cursor: pointer; transition: border-color .15s; }
.faq-item:hover { border-color: var(--primary); }
.faq-header { display: flex; align-items: center; justify-content: space-between; }
.faq-q { font-size: 14px; font-weight: 600; color: var(--ink); }
.faq-ico { width: 26px; height: 26px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: var(--ink-soft); font-size: 16px; transition: background .15s, color .15s; }
.faq-item:hover .faq-ico { background: var(--primary-l); color: var(--primary); border-color: #ddd6fe; }
.faq-answer { font-size: 13px; color: var(--ink-soft); line-height: 1.6; margin-top: 12px; display: none; }
.faq-item.open .faq-answer { display: block; }
.faq-item.open .faq-ico { background: var(--primary-l); color: var(--primary); border-color: #ddd6fe; content: '−'; }

/* ── TESTIMONIALS ── */
.testimonials-section { padding: 32px 0; background: var(--surface); }
.testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 40px; }
.testimonial-card { background: white; border: 1.5px solid var(--border); border-radius: 18px; padding: 28px; }
.testimonial-quote { font-size: 28px; color: #f87171; margin-bottom: 12px; font-family: Georgia, serif; line-height: 1; }
.testimonial-text { font-size: 14px; color: var(--ink-mid); line-height: 1.7; margin-bottom: 20px; }
.testimonial-author { font-size: 14px; font-weight: 700; color: var(--ink); }
.testimonial-role { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }

/* ── FOOTER ── */
.lp-footer { background: linear-gradient(135deg, #f5f3ff 0%, #eff6ff 100%); border-top: 1.5px solid #e0e7ff; padding: 40px 0 24px; }
.lp-footer .container { }
.footer-top { display: flex; justify-content: space-between; align-items: flex-start; padding-bottom: 24px; border-bottom: 1px solid #ddd6fe; margin-bottom: 20px; }
.footer-brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-head); font-weight: 800; font-size: 17px; color: var(--ink); letter-spacing: .06em; }
.footer-brand img { height: 32px; width: 32px; border-radius: 8px; object-fit: cover; }
.footer-brand-desc { font-size: 13px; color: var(--ink-soft); margin-top: 8px; max-width: 240px; line-height: 1.6; }
.footer-links { display: flex; gap: 24px; }
.footer-links a { font-size: 13.5px; color: var(--ink-mid); text-decoration: none; transition: color .15s; }
.footer-links a:hover { color: var(--primary); }
.footer-bottom { display: flex; justify-content: space-between; align-items: center; }
.footer-copy { font-size: 12.5px; color: var(--ink-soft); }
.footer-heart { font-size: 12.5px; color: var(--ink-soft); }

/* ── FACE MODAL ── */
.face-modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; display: flex; align-items: center; justify-content: center; }
.face-modal { background: white; padding: 2rem; border-radius: 14px; width: 400px; max-width: 90%; text-align: center; }
.face-modal h3 { margin-top: 0; margin-bottom: 0.5rem; font-family: var(--font-head); font-size: 1.5rem; color: var(--ink);}
.face-modal p { color: var(--ink-soft); font-size: 14px; margin-bottom: 1rem;}
.camera-container { margin: 1.5rem 0; width: 100%; aspect-ratio: 4/3; background: #000; border-radius: 8px; overflow: hidden; }
.camera-container video { width: 100%; height: 100%; object-fit: cover; transform: scaleX(-1); }
.face-modal-actions { display: flex; justify-content: center; gap: 1rem; }
.btn-sec { padding:.55rem 1.1rem;border-radius:8px;font-size:.85rem;font-weight:600; cursor:pointer;text-decoration:none;border:none;transition:all .2s;display:inline-flex;align-items:center;gap:.4rem; }
.btn-sec-teal { background:#d1fae5;color:#065f46; }
.btn-sec-teal:hover { background:#a7f3d0; }
.btn-sec-danger { background:#fef2f2;color:#dc2626; }
.btn-sec-danger:hover { background:#fee2e2; }

/* ── POSTULER MODAL ── */
.postuler-overlay { position: fixed; inset: 0; background: rgba(15,14,23,.55); backdrop-filter: blur(4px); z-index: 200; display: none; align-items: center; justify-content: center; padding: 20px; }
.postuler-overlay.open { display: flex; }
.postuler-modal { background: white; border-radius: 20px; width: 100%; max-width: 600px; overflow: hidden; box-shadow: 0 24px 80px rgba(15,14,23,.22); animation: modalIn .25s cubic-bezier(.22,1,.36,1) both; max-height: 90vh; display: flex; flex-direction: column; }
@keyframes modalIn { from { opacity:0; transform:scale(.96) translateY(12px); } to { opacity:1; transform:none; } }
.modal-header { background: linear-gradient(135deg, #059669 0%, #047857 100%); padding: 24px 28px; display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
.modal-job-avatar { width: 48px; height: 48px; border-radius: 12px; background: rgba(255,255,255,.2); color: white; display: flex; align-items: center; justify-content: center; font-family: var(--font-head); font-size: 15px; font-weight: 800; flex-shrink: 0; }
.modal-job-info { flex: 1; }
.modal-job-title { font-family: var(--font-head); font-size: 18px; font-weight: 800; color: white; margin-bottom: 2px; }
.modal-job-meta { font-size: 13px; color: rgba(255,255,255,.75); }
.modal-close { width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,.15); border: none; color: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .15s; flex-shrink: 0; }
.modal-close:hover { background: rgba(255,255,255,.25); }
.modal-stepper { display: flex; align-items: center; gap: 0; padding: 0 28px; background: linear-gradient(135deg, #059669 0%, #047857 100%); padding-bottom: 20px; }
.modal-step { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; position: relative; }
.modal-step-num { width: 32px; height: 32px; border-radius: 50%; border: 2.5px solid rgba(255,255,255,.4); color: rgba(255,255,255,.7); font-family: var(--font-head); font-size: 13px; font-weight: 800; display: flex; align-items: center; justify-content: center; background: transparent; transition: all .2s; position: relative; z-index: 1; }
.modal-step.active .modal-step-num { background: white; color: #059669; border-color: white; box-shadow: 0 0 0 4px rgba(255,255,255,.2); }
.modal-step.done .modal-step-num { background: rgba(255,255,255,.9); color: #059669; border-color: rgba(255,255,255,.9); }
.modal-step-label { font-size: 11px; font-weight: 600; color: rgba(255,255,255,.65); }
.modal-step.active .modal-step-label { color: white; }
.modal-step-line { position: absolute; top: 16px; left: 50%; width: 100%; height: 2px; background: rgba(255,255,255,.25); z-index: 0; }
.modal-step.done .modal-step-line { background: rgba(255,255,255,.7); }
.modal-step:last-child .modal-step-line { display: none; }
.modal-body { padding: 28px; overflow-y: auto; flex: 1; }
.modal-panel { display: none; }
.modal-panel.active { display: block; }
.modal-field-group { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
.modal-field { margin-bottom: 16px; }
.modal-field-group .modal-field { margin-bottom: 0; }
.modal-label { display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: var(--ink-soft); margin-bottom: 7px; }
.modal-input { width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: 10px; font-size: 14px; font-family: var(--font-body); color: var(--ink); background: var(--bg); outline: none; transition: border-color .18s, box-shadow .18s; }
.modal-input:focus { border-color: #059669; background: white; box-shadow: 0 0 0 3px rgba(5,150,105,.1); }
.modal-input::placeholder { color: #c8d0de; }
.modal-textarea { width: 100%; padding: 11px 14px; border: 1.5px solid var(--border); border-radius: 10px; font-size: 14px; font-family: var(--font-body); color: var(--ink); background: var(--bg); outline: none; min-height: 100px; resize: vertical; transition: border-color .18s, box-shadow .18s; }
.modal-textarea:focus { border-color: #059669; background: white; box-shadow: 0 0 0 3px rgba(5,150,105,.1); }
.modal-upload { border: 2px dashed var(--border); border-radius: 10px; padding: 18px; text-align: center; cursor: pointer; transition: border-color .15s, background .15s; }
.modal-upload:hover { border-color: #059669; background: #f0fdf4; }
.modal-upload-icon { font-size: 20px; margin-bottom: 6px; }
.modal-upload-text { font-size: 13px; color: var(--ink-soft); }
.modal-upload-link { color: #059669; font-weight: 600; }
.modal-upload input[type=file] { display: none; }
.modal-recap { background: #f8faff; border: 1.5px solid #e0e7ff; border-radius: 12px; padding: 14px 16px; display: flex; align-items: flex-start; gap: 12px; margin-top: 16px; }
.modal-recap-icon { font-size: 18px; flex-shrink: 0; }
.modal-recap-text { font-size: 13px; color: var(--ink-mid); line-height: 1.5; }
.modal-recap-text strong { color: var(--ink); }
.modal-checkbox-row { display: flex; align-items: flex-start; gap: 10px; margin: 16px 0; }
.modal-checkbox-row input { width: 15px; height: 15px; margin-top: 2px; accent-color: #059669; cursor: pointer; flex-shrink: 0; }
.modal-checkbox-row label { font-size: 13px; color: var(--ink-soft); line-height: 1.5; cursor: pointer; }
.modal-footer { padding: 16px 28px 24px; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); flex-shrink: 0; }
.modal-btn-back { background: none; border: none; font-size: 14px; font-weight: 600; color: var(--ink-mid); cursor: pointer; padding: 9px 16px; border-radius: 8px; transition: background .15s; }
.modal-btn-back:hover { background: var(--bg); }
.modal-btn-next { display: inline-flex; align-items: center; gap: 8px; background: #059669; color: white; border: none; padding: 11px 24px; border-radius: 10px; font-size: 14px; font-weight: 700; font-family: var(--font-body); cursor: pointer; transition: all .18s; }
.modal-btn-next:hover { background: #047857; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(5,150,105,.28); }
.modal-btn-submit { display: inline-flex; align-items: center; gap: 8px; background: var(--primary); color: white; border: none; padding: 11px 24px; border-radius: 10px; font-size: 14px; font-weight: 700; font-family: var(--font-body); cursor: pointer; transition: all .18s; }
.modal-btn-submit:hover { background: var(--primary-d); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(79,70,229,.28); }
.modal-success { text-align: center; padding: 20px 0; }
.modal-success-icon { font-size: 48px; margin-bottom: 16px; }
.modal-success-title { font-family: var(--font-head); font-size: 22px; font-weight: 800; color: var(--ink); margin-bottom: 8px; }
.modal-success-sub { font-size: 14px; color: var(--ink-soft); line-height: 1.6; }
@media (max-width: 900px) {
  .container { padding: 0 12px; }
  .hero-inner { grid-template-columns: 1fr; padding: 24px 12px 32px; min-height: auto; gap: 32px; }
  .hero::after { display: none; }
  .culture-grid, .culture-cards, .stats-header { grid-template-columns: 1fr; }
  .stats-grid { grid-template-columns: 1fr 1fr; }
  .jobs-grid { grid-template-columns: 1fr 1fr; }
  .testimonials-grid { grid-template-columns: 1fr; }
  .process-steps { grid-template-columns: 1fr; gap: 24px; }
  .process-steps::before { display: none; }
  .faq-grid { grid-template-columns: 1fr; }
  .lp-nav-inner { padding: 0 12px; }
  .culture-section, .stats-section, .section, .process-section, .faq-section, .testimonials-section { padding: 24px 0; }
  .lp-footer { padding: 24px 0 16px; }
  .footer-top { flex-direction: column; gap: 24px; }
}
@media (max-width: 600px) {
  .stats-grid { grid-template-columns: 1fr; }
  .jobs-grid { grid-template-columns: 1fr; }
  .nav-links { display: none; }
  .login-card { padding: 26px 18px 22px; border-radius: 20px; }
}
</style>


{# ══════════════════════════════════════════
   HERO
══════════════════════════════════════════ #}
<section class="hero">

  <div class="hero-inner">
  <div class="hero-copy">
    <div class="hero-pill">
      <span class="hero-pill-dot"></span>
      {{ postesOuverts }} poste{{ postesOuverts > 1 ? 's' : '' }} ouvert{{ postesOuverts > 1 ? 's' : '' }} · recrutement actif
    </div>

    <h1 class="hero-title">
      Le travail,<br><em>repensé</em> <span class="accent">avec</span><br>Humania.
    </h1>

    <p class="hero-desc">
      Une plateforme RH humaine, des projets qui ont du sens et une équipe qui mise vraiment sur vous. Rejoignez l'aventure.
    </p>

    <div class="hero-actions">
      <a href="#offres" class="btn-hero-primary">
        Voir les {{ postesOuverts }} offres
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#culture" class="btn-hero-secondary">
        Notre culture
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </a>
    </div>

    <div class="hero-stats">
      <div>
        <div class="hero-stat-num">{{ totalOffres }}</div>
        <div class="hero-stat-label">Offres actives</div>
      </div>
      <div>
        <div class="hero-stat-num">{{ tauxSatisfaction }}%</div>
        <div class="hero-stat-label">Candidats satisfaits</div>
      </div>
      <div>
        <div class="hero-stat-num">{{ delaiMoyen }}j</div>
        <div class="hero-stat-label">Délai moyen</div>
      </div>
    </div>
  </div>

  {# ── Login card ── #}
  <div class="hero-form-col" id="login-form">
    <div class="login-card">

      <div class="status-badge">
        <span class="status-dot"></span>
        Espace professionnel sécurisé
      </div>

      <h2 class="card-title">Bon retour 👋</h2>
      <p class="card-sub">Saisissez vos identifiants pour accéder à votre tableau de bord.</p>

      {% for msg in app.flashes('success') %}
        <div class="alert alert-success"><span class="alert-icon">✅</span><span>{{ msg }}</span></div>
      {% endfor %}

      {% if error %}
        <div class="alert alert-danger">
          <span class="alert-icon">🚫</span>
          <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
        </div>
      {% endif %}

      {% if lockout_remaining %}
        <div class="alert alert-danger">
          <span class="alert-icon">⏱</span>
          <span>Compte bloqué temporairement. Réessayez dans <strong id="lockout-timer">{{ lockout_remaining }}</strong>s.</span>
        </div>
        <div class="lockout-bar">
          <div class="lockout-bar-inner" style="--secs:{{ lockout_remaining }}"></div>
        </div>
      {% endif %}

      {% if login_attempts > 0 and not lockout_remaining %}
        <div class="attempt-row">
          {% for i in 1..max_attempts %}
            <div class="att-dot {{ i <= login_attempts ? 'used' : '' }}"></div>
          {% endfor %}
          <span class="att-label">{{ max_attempts - login_attempts }} tentative(s) restante(s)</span>
        </div>
      {% endif %}

      <form method="post" action="{{ path('app_login') }}" data-turbo="false" id="loginForm" novalidate>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="form-field">
          <label class="form-label" for="email">Adresse email</label>
          <div class="input-wrap">
            <span class="input-ico">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,12 2,6"/></svg>
            </span>
            <input type="email" id="email" name="_username" value="{{ last_username }}" placeholder="vous@entreprise.tn" autocomplete="email" required autofocus>
          </div>
        </div>

        <div class="form-field">
          <div class="label-row">
            <label class="form-label" for="password">Mot de passe</label>
            <a href="{{ path('app_forgot_password') }}" class="forgot-link">Oublié ?</a>
          </div>
          <div class="input-wrap">
            <span class="input-ico">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <input type="password" id="password" name="_password" placeholder="••••••••••" autocomplete="current-password" required>
            <button type="button" class="pw-toggle" id="togglePw" tabindex="-1" aria-label="Afficher mot de passe">
              <svg id="eyeIco" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="remember-row">
          <input type="checkbox" id="remember_me" name="_remember_me">
          <label for="remember_me">Se souvenir de moi pendant 30 jours</label>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn" {% if lockout_remaining %}disabled{% endif %}>
          <span id="btnText">Se connecter</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10,17 15,12 10,7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
        </button>
      </form>

      <div class="divider">ou continuer avec</div>

      <a href="{{ path('connect_google') }}" class="btn-google">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Continuer avec Google
      </a>

      <button type="button" class="btn-face" onclick="openFaceLoginModal()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
        Se connecter avec le visage
      </button>

    </div>

    <div class="card-security">
      <span class="sec-item">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Chiffrement SSL
      </span>
      <span class="sec-item">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
        Anti brute-force
      </span>
      <span class="sec-item">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        MFA disponible
      </span>
    </div>
  </div>
  </div>{# end hero-inner #}

</section>

{# ══════════════════════════════════════════
   NOTRE CULTURE (statique)
══════════════════════════════════════════ #}
<section class="culture-section" id="culture">
  <div class="container">
  <div class="culture-grid">
    <div class="culture-copy">
      <div class="section-tag">Notre culture</div>
      <h2 class="section-title">On construit une entreprise <em>où l'on a envie</em> de revenir lundi.</h2>
      <p style="font-size:14.5px;color:var(--ink-soft);line-height:1.7;margin-top:16px;">
        Pas de buzzwords, pas de ping-pong dans le couloir. Juste des humains qui se font confiance, livrent du concret et apprennent en continu.
      </p>
      <div class="culture-tags">
        <span class="culture-tag">Hybride 3j/semaine</span>
        <span class="culture-tag">Budget formation 2 000 TND/an</span>
        <span class="culture-tag">Stock options</span>
        <span class="culture-tag">32 jours de congés</span>
        <span class="culture-tag">Mutuelle premium</span>
      </div>
    </div>
    <div class="culture-cards">
      <div class="culture-card c1">
        <div class="culture-card-icon">🔥</div>
        <div class="culture-card-title">Impact d'abord</div>
        <div class="culture-card-desc">Petites équipes, gros projets. Vous décidez, vous livrez, vous mesurez.</div>
      </div>
      <div class="culture-card c2">
        <div class="culture-card-icon">🤍</div>
        <div class="culture-card-title">Culture du soin</div>
        <div class="culture-card-desc">Onboarding sur 30 jours, mentor dédié, feedbacks réguliers et bienveillants.</div>
      </div>
      <div class="culture-card c3">
        <div class="culture-card-icon">☕</div>
        <div class="culture-card-title">Slow tech</div>
        <div class="culture-card-desc">Pas de réunions le mercredi. Du temps pour penser, écrire et coder en profondeur.</div>
      </div>
      <div class="culture-card c4">
        <div class="culture-card-icon">⚡</div>
        <div class="culture-card-title">Apprentissage</div>
        <div class="culture-card-desc">Conférences, livres, certifs : on prend le budget et le temps qu'il faut.</div>
      </div>
    </div>
  </div>
  </div>{# end container #}
</section>

{# ══════════════════════════════════════════
   HUMANIA EN CHIFFRES
══════════════════════════════════════════ #}
<section class="stats-section">
  <div class="container">
  <div class="stats-header">
    <div>
      <div class="section-tag">Humania en chiffres</div>
      <h2 class="section-title">Des résultats <em>concrets</em>, pas des promesses.</h2>
    </div>
    <p style="font-size:14.5px;color:var(--ink-soft);line-height:1.7;max-width:380px;">
      Depuis 2019, nous accompagnons les talents et les entreprises à travers la Tunisie, le Maghreb et l'Europe.
    </p>
  </div>

  <div class="stats-grid">
    <div class="stat-card s1">
      <div class="stat-top">
        <div class="stat-icon i1">👥</div>
        <span class="stat-trend">↗ en hausse</span>

<script>
// Données initiales des offres
const initialOffres = {{ offres|json_encode|raw }};

// ── Fonction pour afficher les offres dans la grille ──
function displayOffres(offres) {
  const jobsGrid = document.getElementById('jobsGrid');
  const colors = ['#4F46E5','#06b6d4','#8b5cf6','#f59e0b','#22c55e','#ef4444','#ec4899'];
  
  if (!offres || offres.length === 0) {
    jobsGrid.innerHTML = '<p style="color:var(--ink-soft);grid-column:1/-1;text-align:center;padding:40px 0;">Aucune offre disponible pour le moment.</p>';
    return;
  }
  
  let html = '';
  offres.forEach(function(offre, index) {
    const initiales = (offre.titre || '').split(' ').map(w => w[0] || '').join('').toUpperCase().slice(0,2);
    const couleur = colors[index % colors.length];
    const estOuvert = offre.statut === 'Ouvert';
    const estUrgent = offre.priorite === 1 || offre.priorite === 'Haute';
    
    html += `
      <div class="job-card">
        <div class="job-card-top">
          <div class="job-avatar" style="background:${couleur}">${initiales || 'JD'}</div>
          <div class="job-badges">
            <span class="badge ${estOuvert ? 'badge-green' : 'badge-red'}">
              Mission ${offre.typeContrat || 'CDI'} · ${estOuvert ? 'Ouvert' : 'Fermé'}
            </span>
            ${estUrgent && estOuvert ? '<span class="badge badge-orange">Urgent</span>' : ''}
          </div>
        </div>
        <div class="job-title">${escapeHtml(offre.titre || 'Poste')}</div>
        <div class="job-meta">
          ${offre.dateCloture ? `<span>📅 Clôture : ${offre.dateCloture}</span>` : ''}
          ${offre.experienceRequise ? `<span>⏱ ${offre.experienceRequise}+ ans</span>` : ''}
          ${offre.niveauEtudeRequis ? `<span>🎓 ${offre.niveauEtudeRequis}</span>` : ''}
        </div>
        <div class="job-tags">
          ${offre.competencesRequises ? offre.competencesRequises.split(',').slice(0,4).map(comp => `<span class="job-tag">${escapeHtml(comp.trim())}</span>`).join('') : ''}
        </div>
        <div class="job-footer">
          <div>
            ${offre.salaire ? `<div class="job-salary">${new Intl.NumberFormat('fr-FR').format(offre.salaire)} TND <span>${(offre.typeContrat === 'Stage' || offre.typeContrat === 'stage') ? '/mois' : '/an'}</span></div>` : ''}
            ${offre.nombreEmploye ? `<div style="font-size:11px;color:var(--ink-soft)">${offre.nombreEmploye} poste(s) disponible(s)</div>` : ''}
          </div>
          ${estOuvert ? `<button type="button" class="btn-apply" onclick='openPostulerModal(${JSON.stringify({...offre, _couleur: couleur}).replace(/'/g, "\\'")})'>Postuler à cette offre <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>` : '<span class="btn-apply-ghost">Fermé</span>'}
        </div>
      </div>
    `;
  });
  
  jobsGrid.innerHTML = html;
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/[&<>]/g, function(m) {
    if (m === '&') return '&amp;';
    if (m === '<') return '&lt;';
    if (m === '>') return '&gt;';
    return m;
  });
}

// ── Filtrage des offres (côté client) ──
function filterOffres(filterValue) {
  let filteredOffres = [...initialOffres];
  
  switch(filterValue) {
    case 'ouvert':
      filteredOffres = filteredOffres.filter(o => o.statut === 'Ouvert');
      break;
    case 'cdi':
      filteredOffres = filteredOffres.filter(o => o.typeContrat === 'CDI');
      break;
    case 'cdd':
      filteredOffres = filteredOffres.filter(o => o.typeContrat === 'CDD');
      break;
    case 'stage':
      filteredOffres = filteredOffres.filter(o => o.typeContrat === 'Stage' || o.typeContrat === 'stage');
      break;
    default:
      // 'all' - garder toutes les offres
      break;
  }
  
  displayOffres(filteredOffres);
}

// ── Initialisation des filtres ──
document.addEventListener('DOMContentLoaded', function() {
  // Afficher toutes les offres au chargement
  displayOffres(initialOffres);
  
  // Initialiser les filtres
  const filterBtns = document.querySelectorAll('.job-tab');
  
  filterBtns.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      // Mettre à jour la classe active
      filterBtns.forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      
      // Filtrer les offres
      const filterValue = this.getAttribute('data-filter');
      filterOffres(filterValue);
    });
  });
});

// ── Password toggle
document.getElementById('togglePw').addEventListener('click', function () {
  var inp = document.getElementById('password');
  var showing = inp.type === 'text';
  inp.type = showing ? 'password' : 'text';
  document.getElementById('eyeIco').innerHTML = showing
    ? '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'
    : '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/>';
});

// ── Lockout countdown
{% if lockout_remaining %}
(function () {
  var el = document.getElementById('lockout-timer');
  if (!el) return;
  var t = parseInt(el.textContent);
  var iv = setInterval(function () {
    t--;
    if (t <= 0) { clearInterval(iv); location.reload(); return; }
    el.textContent = t;
  }, 1000);
})();
{% endif %}

// ── FAQ accordion
document.querySelectorAll('.faq-item').forEach(function(item) {
  item.addEventListener('click', function() {
    var isOpen = this.classList.contains('open');
    document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); i.querySelector('.faq-ico').textContent = '+'; });
    if (!isOpen) {
      this.classList.add('open');
      this.querySelector('.faq-ico').textContent = '−';
    }
  });
});

// ── reCAPTCHA v3 + form submit
(function() {
  var form = document.getElementById('loginForm');
  var btn  = document.getElementById('submitBtn');
  var txt  = document.getElementById('btnText');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (btn.disabled) return;
    btn.disabled = true;
    txt.textContent = 'Vérification…';

    grecaptcha.ready(function () {
      grecaptcha.execute('{{ recaptcha_site_key }}', { action: 'login' }).then(function (token) {
        var inp = form.querySelector('input[name="g-recaptcha-response"]');
        if (!inp) {
          inp = document.createElement('input');
          inp.type = 'hidden';
          inp.name = 'g-recaptcha-response';
          form.appendChild(inp);
        }
        inp.value = token;
        txt.textContent = 'Connexion…';
        form.submit();
      }).catch(function () {
        btn.disabled = false;
        txt.textContent = 'Se connecter';
        alert('Erreur reCAPTCHA. Veuillez réessayer.');
      });
    });
  });

  document.querySelectorAll('a[href^="#"]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
})();

// ── Face login
let loginVideoStream = null;
function openFaceLoginModal() {
  document.getElementById('faceLoginModal').style.display = 'flex';
  navigator.mediaDevices.getUserMedia({ video: true })
    .then(function(stream) { loginVideoStream = stream; document.getElementById('loginVideoElement').srcObject = stream; })
    .catch(function(err) { alert("Erreur caméra : " + err); closeFaceLoginModal(); });
}
function closeFaceLoginModal() {
  document.getElementById('faceLoginModal').style.display = 'none';
  if (loginVideoStream) { loginVideoStream.getTracks().forEach(t => t.stop()); loginVideoStream = null; }
}
function loginWithFace() {
  const video = document.getElementById('loginVideoElement');
  const canvas = document.getElementById('loginCanvasElement');
  const btn = document.getElementById('loginCaptureBtn');
  canvas.width = video.videoWidth; canvas.height = video.videoHeight;
  canvas.getContext('2d').drawImage(video, 0, 0);
  const base64Image = canvas.toDataURL('image/jpeg');
  btn.disabled = true; btn.innerText = "Identification...";
  fetch('{{ path("app_login_face") }}', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
    body: JSON.stringify({ image: base64Image })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success && data.redirect) { window.location.href = data.redirect; }
    else { alert(data.message || "Erreur de connexion."); btn.disabled = false; btn.innerText = "S'identifier"; }
  })
  .catch(() => { alert("Erreur réseau."); btn.disabled = false; btn.innerText = "S'identifier"; });
}

// ── Postuler Modal ──────────────────────────────────────────────────────
let postulerStep = 1;
let postulerData = {};

function shadeColor(hex, percent) {
  var num = parseInt(hex.replace('#',''), 16);
  var r = Math.min(255, Math.max(0, (num >> 16) + percent));
  var g = Math.min(255, Math.max(0, ((num >> 8) & 0xff) + percent));
  var b = Math.min(255, Math.max(0, (num & 0xff) + percent));
  return '#' + ((1 << 24) | (r << 16) | (g << 8) | b).toString(16).slice(1);
}

function openPostulerModal(offre) {
  postulerData = offre;
  postulerStep = 1;
  var initials = (offre.titre || '').split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2);
  document.getElementById('modalAvatar').textContent = initials || 'JD';
  document.getElementById('modalTitle').textContent = 'Postuler — ' + (offre.titre || 'Poste');
  var meta = offre.typeContrat || 'CDI';
  if (offre.experienceRequise) meta += ' · ' + offre.experienceRequise + '+ ans';
  if (offre.salaire) meta += ' · ' + new Intl.NumberFormat('fr-FR').format(offre.salaire) + ' TND/' + ((offre.typeContrat === 'Stage' || offre.typeContrat === 'stage') ? 'mois' : 'an');
  document.getElementById('modalMeta').textContent = meta;

  // Appliquer la couleur de l'avatar de l'offre
  var c = offre._couleur || '#4F46E5';
  var cDark = shadeColor(c, -20);
  var gradient = 'linear-gradient(135deg, ' + c + ' 0%, ' + cDark + ' 100%)';
  document.getElementById('modalHeader').style.background = gradient;
  document.getElementById('modalStepper').style.background = gradient;
  // Stocker la couleur pour les boutons et numéros
  window._modalColor = c;
  window._modalColorDark = cDark;

  // Injecter couleur dynamique pour focus inputs et checkbox
  var styleTag = document.getElementById('_modalDynStyle');
  if (!styleTag) { styleTag = document.createElement('style'); styleTag.id = '_modalDynStyle'; document.head.appendChild(styleTag); }
  styleTag.textContent = [
    '.modal-input:focus { border-color:' + c + ' !important; box-shadow: 0 0 0 3px ' + c + '22 !important; }',
    '.modal-textarea:focus { border-color:' + c + ' !important; box-shadow: 0 0 0 3px ' + c + '22 !important; }',
    '.modal-upload:hover { border-color:' + c + ' !important; }',
    '.modal-upload-link { color:' + c + ' !important; }',
    '.modal-checkbox-row input { accent-color:' + c + ' !important; }',
    '.modal-btn-next:hover { background:' + cDark + ' !important; box-shadow: 0 6px 20px ' + c + '55 !important; }',
  ].join('\n');
  
  // Réinitialiser les champs
  document.getElementById('mp_prenom').value = '';
  document.getElementById('mp_nom').value = '';
  document.getElementById('mp_email').value = '';
  document.getElementById('mp_tel').value = '';
  document.getElementById('mp_ville').value = '';
  document.getElementById('mp_exp').value = '';
  document.getElementById('mp_formation').value = '';
  document.getElementById('mp_linkedin').value = '';
  document.getElementById('mp_motivation').value = '';
  document.getElementById('mp_dispo').value = '';
  document.getElementById('mp_salaire').value = '';
  document.getElementById('mp_cv').value = '';
  document.getElementById('mp_rgpd').checked = false;
  var uploadLabel = document.querySelector('#cvUploadLabel .modal-upload-text');
  if (uploadLabel) uploadLabel.textContent = 'Cliquez pour téléverser votre CV Parcourir';
  document.getElementById('p1error').style.display = 'none';
  document.getElementById('p2error').style.display = 'none';
  document.getElementById('p3error').style.display = 'none';
  
  showPostulerStep(1);
  document.getElementById('postulerOverlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

function closePostulerModal() {
  document.getElementById('postulerOverlay').classList.remove('open');
  document.body.style.overflow = '';
  postulerStep = 1;
  postulerData = {};
}

function handleOverlayClick(e) {
  if (e.target === document.getElementById('postulerOverlay')) closePostulerModal();
}

function showPostulerStep(step) {
  postulerStep = step;
  var mc = window._modalColor || '#4F46E5';
  var mcDark = window._modalColorDark || shadeColor(mc, -20);

  [1,2,3,4].forEach(function(i) {
    var p = document.getElementById('mpanel' + i);
    if (p) p.classList.toggle('active', i === step);
  });
  [1,2,3].forEach(function(i) {
    var s = document.getElementById('mstep' + i);
    var n = document.getElementById('mnum' + i);
    s.classList.remove('active','done');
    if (i < step) {
      s.classList.add('done');
      n.innerHTML = '✓';
      n.style.background = 'rgba(255,255,255,.9)';
      n.style.color = mc;
      n.style.borderColor = 'rgba(255,255,255,.9)';
    } else if (i === step) {
      s.classList.add('active');
      n.textContent = i;
      n.style.background = 'white';
      n.style.color = mc;
      n.style.borderColor = 'white';
      n.style.boxShadow = '0 0 0 4px rgba(255,255,255,.2)';
    } else {
      n.textContent = i;
      n.style.background = 'transparent';
      n.style.color = 'rgba(255,255,255,.7)';
      n.style.borderColor = 'rgba(255,255,255,.4)';
      n.style.boxShadow = '';
    }
  });
  var btnBack = document.getElementById('modalBtnBack');
  var btnNext = document.getElementById('modalBtnNext');
  var cancelAnnuler = document.getElementById('cancelAnnuler');
  var footer = document.getElementById('modalFooter');
  if (step === 4) { footer.style.display = 'none'; return; }
  footer.style.display = 'flex';
  if (step === 1) { btnBack.style.display = 'none'; cancelAnnuler.style.display = 'inline'; }
  else { btnBack.style.display = 'inline-flex'; cancelAnnuler.style.display = 'none'; }
  if (step === 3) {
    btnNext.innerHTML = 'Envoyer ma candidature <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20,6 9,17 4,12"/></svg>';
    btnNext.style.background = mc;
    var prenom = document.getElementById('mp_prenom').value;
    var nom = document.getElementById('mp_nom').value;
    var email = document.getElementById('mp_email').value;
    var exp = document.getElementById('mp_exp').value;
    document.getElementById('modalRecapText').innerHTML =
      '<strong>' + (prenom+' '+nom).trim() + '</strong> · ' + email + ' · ' + (exp||'—') + " d'expérience";
  } else {
    btnNext.innerHTML = 'Continuer <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>';
    btnNext.style.background = mc;
  }
  btnNext.disabled = false;
}

function postulerNext() {
  if (postulerStep === 1) {
    var ok = document.getElementById('mp_prenom').value.trim() &&
             document.getElementById('mp_nom').value.trim() &&
             document.getElementById('mp_email').value.trim();
    document.getElementById('p1error').style.display = ok ? 'none' : 'block';
    if (ok) showPostulerStep(2);
  } else if (postulerStep === 2) {
    var ok = document.getElementById('mp_exp').value.trim();
    document.getElementById('p2error').style.display = ok ? 'none' : 'block';
    if (ok) showPostulerStep(3);
  } else if (postulerStep === 3) {
    var ok = document.getElementById('mp_rgpd').checked;
    document.getElementById('p3error').style.display = ok ? 'none' : 'block';
    if (ok) submitPostuler();
  }
}

function postulerPrev() { if (postulerStep > 1) showPostulerStep(postulerStep - 1); }

function updateCvLabel(input) {
  if (input.files && input.files[0])
    document.querySelector('#cvUploadLabel .modal-upload-text').textContent = '📎 ' + input.files[0].name;
}

function submitPostuler() {
  var btn = document.getElementById('modalBtnNext');
  var err = document.getElementById('p3error');
  if (err) err.style.display = 'none';
  btn.disabled = true; 
  btn.textContent = 'Envoi en cours...';
  
  var fd = new FormData();
  fd.append('poste_externe_id', postulerData.id);
  fd.append('prenom', document.getElementById('mp_prenom').value);
  fd.append('nom', document.getElementById('mp_nom').value);
  fd.append('email', document.getElementById('mp_email').value);
  fd.append('telephone', document.getElementById('mp_tel').value);
  fd.append('ville', document.getElementById('mp_ville').value);
  fd.append('experience', document.getElementById('mp_exp').value);
  fd.append('formation', document.getElementById('mp_formation').value);
  fd.append('linkedin', document.getElementById('mp_linkedin').value);
  fd.append('motivation', document.getElementById('mp_motivation').value);
  fd.append('disponibilite', document.getElementById('mp_dispo').value);
  fd.append('salaire_pretendu', document.getElementById('mp_salaire').value);
  fd.append('rgpd', document.getElementById('mp_rgpd').checked ? '1' : '0');
  
  var cv = document.getElementById('mp_cv');
  if (cv.files && cv.files[0]) fd.append('cv', cv.files[0]);
  
  fetch('{{ path("app_candidature_submit") }}', {
    method: 'POST', 
    body: fd,
    headers: { 'X-Requested-With': 'XMLHttpRequest' }
  })
  .then(function(response) {
    return response.json().then(function(data) {
      return { ok: response.ok, data: data };
    });
  })
  .then(data => {
    if (data.ok && data.data && data.data.success) {
      showPostulerStep(4);
      return;
    }

    var message = (data.data && data.data.message) ? data.data.message : 'Échec de sauvegarde en base de données.';
    btn.disabled = false;
    btn.innerHTML = 'Envoyer ma candidature <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20,6 9,17 4,12"/></svg>';
    if (err) {
      err.textContent = message;
      err.style.display = 'block';
    } else {
      alert(message);
    }
  })
  .catch(function(error) {
    console.error('Erreur:', error);
    btn.disabled = false;
    btn.innerHTML = 'Envoyer ma candidature <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20,6 9,17 4,12"/></svg>';
    if (err) {
      err.textContent = 'Erreur réseau lors de l’envoi de la candidature.';
      err.style.display = 'block';
    } else {
      alert('Erreur réseau lors de l’envoi de la candidature.');
    }
  });
}
</script>


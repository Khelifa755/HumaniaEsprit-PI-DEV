{% extends "base.html.twig" %}

{% block title %}Mot de passe oublié - Humania{% endblock %}

{% block body %}
<div class="login-wrapper">
    <div class="login-left">
        <div class="login-brand">
            <div class="brand-logo"><span class="brand-h">H</span></div>
            <span class="brand-name">HUMANIA</span>
        </div>
        <div class="login-hero">
            <h2><strong>Réinitialisez</strong></h2>
            <h2 class="hero-accent">votre mot de passe.</h2>
            <div class="hero-line"></div>
            <p class="hero-sub">Suivez les étapes pour récupérer l'accès à votre compte en toute sécurité.</p>
        </div>
        <div class="steps-indicator">
            <div class="step-dot {% if step >= 1 %}active{% endif %}"><span>1</span><label>Email</label></div>
            <div class="step-line {% if step >= 2 %}active{% endif %}"></div>
            <div class="step-dot {% if step >= 2 %}active{% endif %}"><span>2</span><label>Code OTP</label></div>
            <div class="step-line {% if step >= 3 %}active{% endif %}"></div>
            <div class="step-dot {% if step >= 3 %}active{% endif %}"><span>3</span><label>Nouveau MDP</label></div>
        </div>
        <div class="deco-circle deco-circle-1"></div>
        <div class="deco-circle deco-circle-2"></div>
    </div>

    <div class="login-right">
        <div class="login-card">

            {# ── STEP 1: Enter email ── #}
            {% if step == 1 %}
                <h1 class="login-title">Mot de passe oublié</h1>
                <p class="login-sub">Saisissez votre email pour recevoir un code de vérification.</p>

                {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

                <form method="post" data-turbo="false">
                    <input type="hidden" name="action" value="send_otp">
                    <div class="form-field">
                        <label for="email">Adresse email</label>
                        <div class="input-group">
                            <span class="input-prefix">✉</span>
                            <input type="email" id="email" name="email" required autofocus
                                   placeholder="vous@entreprise.com" value="{{ email }}">
                        </div>
                    </div>
                    <button type="submit" class="btn-primary-full">Envoyer le code →</button>
                </form>

                <div class="back-link-row">
                    <a href="{{ path('app_login') }}" class="back-link">← Retour à la connexion</a>
                </div>
            {% endif %}

            {# ── STEP 2: Verify OTP ── #}
            {% if step == 2 %}
                <h1 class="login-title">Code de vérification</h1>
                <p class="login-sub">Un code à 6 chiffres a été envoyé à <strong>{{ email }}</strong>. Il expire dans 10 minutes.</p>

                {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
                {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}

                <form method="post" id="otp-form" data-turbo="false">
                    <input type="hidden" name="action" value="verify_otp">
                    <div class="form-field">
                        <label>Code OTP</label>
                        <div class="otp-inputs">
                            {% for i in 1..6 %}
                                <input type="text" class="otp-digit" maxlength="1" pattern="[0-9]"
                                       inputmode="numeric" autocomplete="one-time-code">
                            {% endfor %}
                        </div>
                        <input type="hidden" name="otp" id="otp-hidden">
                    </div>
                    <button type="submit" class="btn-primary-full">Vérifier le code →</button>
                </form>

                <div class="resend-row">
                    <form method="post" style="display:inline;" data-turbo="false">
                        <input type="hidden" name="action" value="resend_otp">
                        <button type="submit" class="btn-link">Renvoyer le code</button>
                    </form>
                    <span class="sep">·</span>
                    <form method="post" style="display:inline;" data-turbo="false">
                        <input type="hidden" name="action" value="back_to_step1">
                        <button type="submit" class="btn-link">Changer d'email</button>
                    </form>
                </div>
            {% endif %}

            {# ── STEP 3: New password ── #}
            {% if step == 3 %}
                <h1 class="login-title">Nouveau mot de passe</h1>
                <p class="login-sub">Choisissez un mot de passe sécurisé d'au moins 6 caractères.</p>

                {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}

                <form method="post" data-turbo="false">
                    <input type="hidden" name="action" value="reset_password">
                    <div class="form-field">
                        <label for="new_password">Nouveau mot de passe</label>
                        <div class="input-group">
                            <span class="input-prefix">🔑</span>
                            <input type="password" id="new_password" name="new_password"
                                   required placeholder="Minimum 6 caractères" minlength="6">
                        </div>
                    </div>
                    <div class="form-field">
                        <label for="confirm_password">Confirmer le mot de passe</label>
                        <div class="input-group">
                            <span class="input-prefix">🔑</span>
                            <input type="password" id="confirm_password" name="confirm_password"
                                   required placeholder="Répétez le mot de passe">
                        </div>
                    </div>
                    <button type="submit" class="btn-primary-full">Réinitialiser →</button>
                </form>
            {% endif %}

        </div>
    </div>
</div>

<script>
// OTP digit auto-advance
document.querySelectorAll('.otp-digit').forEach(function(input, idx, all) {
    input.addEventListener('input', function() {
        this.value = this.value.replace(/[^0-9]/g, '').slice(-1);
        if (this.value && idx < all.length - 1) all[idx + 1].focus();
        updateHidden();
    });
    input.addEventListener('keydown', function(e) {
        if (e.key === 'Backspace' && !this.value && idx > 0) all[idx - 1].focus();
    });
});

function updateHidden() {
    var code = '';
    document.querySelectorAll('.otp-digit').forEach(function(i){ code += i.value; });
    var h = document.getElementById('otp-hidden');
    if (h) h.value = code;
}

var form = document.getElementById('otp-form');
if (form) form.addEventListener('submit', function() { updateHidden(); });
</script>

<style>
body { margin:0; padding:0; display:flex; min-height:100vh; background:#f0f0f8; font-family:'Segoe UI',system-ui,sans-serif; }

.login-wrapper { display:flex; width:100%; min-height:100vh; }

.login-left {
    flex: 1 1 42%;
    background: #f5f4ff;
    padding: 2.5rem 3rem;
    display: flex; flex-direction: column; gap: 2rem;
    position: relative; overflow: hidden;
}

.login-brand { display:flex; align-items:center; gap:.75rem; }
.brand-logo { width:52px;height:52px;background:linear-gradient(135deg,#7c3aed,#a855f7);border-radius:14px;display:flex;align-items:center;justify-content:center; }
.brand-h { color:white;font-size:1.8rem;font-weight:800; }
.brand-name { font-size:1.3rem;font-weight:800;color:#1e1b4b;letter-spacing:2px; }

.login-hero h2 { margin:0;font-size:2.5rem;color:#1e1b4b;line-height:1.1; }
.hero-accent { color:#7c3aed!important; }
.hero-line { display:flex;gap:6px;margin:.8rem 0 1rem; }
.hero-line::before,.hero-line::after { content:'';height:3px;border-radius:2px;background:#7c3aed; }
.hero-line::before { width:40px; }
.hero-line::after  { width:20px;opacity:.5; }
.hero-sub { color:#6b7280;font-size:.95rem;line-height:1.6; }

.steps-indicator {
    display: flex; align-items: center; gap: 0; margin-top: auto;
    padding: 1.5rem;
    background: white; border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
}

.step-dot {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.step-dot span {
    width: 32px; height: 32px; border-radius: 50%;
    background: #e5e7eb; color: #9ca3af;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: .85rem;
    transition: all .3s;
}
.step-dot.active span { background: #7c3aed; color: white; }
.step-dot label { font-size: .72rem; color: #9ca3af; white-space: nowrap; }
.step-dot.active label { color: #7c3aed; font-weight: 600; }

.step-line { flex:1; height:2px; background:#e5e7eb; margin:0 6px; transition:background .3s; }
.step-line.active { background:#7c3aed; }

.deco-circle { position:absolute;border-radius:50%;border:40px solid rgba(124,58,237,.06);pointer-events:none; }
.deco-circle-1 { width:320px;height:320px;top:-80px;right:-80px; }
.deco-circle-2 { width:240px;height:240px;bottom:60px;right:20px;border-width:30px; }

.login-right { flex:1 1 58%;display:flex;align-items:center;justify-content:center;padding:2rem;background:white; }
.login-card { width:100%;max-width:420px; }
.login-title { font-size:1.9rem;font-weight:800;color:#111827;margin:0 0 .4rem; }
.login-sub { color:#6b7280;font-size:.9rem;margin:0 0 1.5rem; }

.alert { padding:.8rem 1rem;border-radius:8px;font-size:.88rem;margin-bottom:1rem; }
.alert-danger  { background:#fef2f2;color:#b91c1c;border:1px solid #fecaca; }
.alert-success { background:#f0fdf4;color:#166534;border:1px solid #bbf7d0; }

.form-field { margin-bottom:1.2rem; }
.form-field label { display:block;font-size:.88rem;font-weight:600;color:#374151;margin-bottom:.5rem; }

.input-group { position:relative;display:flex;align-items:center; }
.input-prefix { position:absolute;left:.9rem;font-size:1rem;color:#9ca3af;pointer-events:none; }
.input-group input {
    width:100%;padding:.8rem 1rem .8rem 2.6rem;
    border:1.5px solid #e5e7eb;border-radius:10px;
    font-size:.95rem;color:#111827;background:#fafafa;
    outline:none;transition:border-color .2s,box-shadow .2s;box-sizing:border-box;
}
.input-group input:focus { border-color:#7c3aed;background:white;box-shadow:0 0 0 3px rgba(124,58,237,.12); }

/* OTP digits */
.otp-inputs { 
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem 0;
}
.otp-digit {
    width: 48px;
    height: 48px;
    text-align: center;
    padding: 0;
    border: 2px solid #e5e7eb;
    border-radius: 8px;
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    outline: none;
    transition: all 0.2s;
    background: white;
}
.otp-digit:hover {
    border-color: #d1d5db;
}
.otp-digit:focus { 
    border-color: #7c3aed;
    box-shadow: 0 0 0 3px rgba(124,58,237,.12);
    background: white;
}

.btn-primary-full {
    width:100%;padding:.9rem;
    background:linear-gradient(135deg,#7c3aed,#9333ea);
    color:white;border:none;border-radius:10px;
    font-size:1rem;font-weight:700;cursor:pointer;
    transition:opacity .2s,transform .15s;margin-top:.5rem;
}
.btn-primary-full:hover { opacity:.92;transform:translateY(-1px); }

.back-link-row { text-align:center;margin-top:1.2rem; }
.back-link { color:#7c3aed;text-decoration:none;font-size:.88rem;font-weight:600; }
.back-link:hover { text-decoration:underline; }

.resend-row { display:flex;align-items:center;justify-content:center;gap:.6rem;margin-top:1rem; }
.btn-link { background:none;border:none;color:#7c3aed;font-size:.88rem;font-weight:600;cursor:pointer;padding:0; }
.btn-link:hover { text-decoration:underline; }
.sep { color:#9ca3af; }

@media(max-width:768px){ .login-left{display:none;} .login-right{flex:1;} }
</style>
{% endblock %}

		<script>
			function toggleSection(header) {
const arrow = header.querySelector('.nav-section-arrow');
const content = header.nextElementSibling;
content.classList.toggle('collapsed');
arrow.classList.toggle('collapsed');
}

// Keep track of the last non-social app page so social header can return here.
(function () {
try {
var currentPath = "{{ app.request.pathinfo|e('js') }}";
if (currentPath && ! currentPath.startsWith('/social')) {
localStorage.setItem('lastSidebarPage', window.location.href);
}
} catch (e) {}
})();
		</script>

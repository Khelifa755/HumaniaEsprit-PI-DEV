{% extends 'base.html.twig' %}

{% block title %}Tableau de bord RH — Humania{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --blue:    #3b82f6;
        --green:   #10b981;
        --orange:  #f59e0b;
        --purple:  #8b5cf6;
        --red:     #ef4444;
        --slate-800: #1e293b;
        --slate-600: #475569;
        --slate-400: #94a3b8;
        --slate-200: #e2e8f0;
        --slate-100: #f1f5f9;
        --white: #ffffff;
        --shadow: 0 1px 3px rgba(0,0,0,.08);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #f8fafc;
        color: var(--slate-800);
    }

    .dashboard-wrapper {
        max-width: 1400px;
        margin: 0 auto;
        padding: 32px 24px;
    }

    /* ═══ HEADER ═══ */
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 32px;
    }
    .dashboard-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: var(--slate-800);
    }
    .dashboard-header p {
        font-size: 14px;
        color: var(--slate-600);
        margin-top: 4px;
    }
    .export-buttons {
        display: flex;
        gap: 12px;
    }
    .btn-export {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: 1.5px solid;
        transition: all .2s;
        text-decoration: none;
        position: relative;
    }
    .btn-export:disabled,
    .btn-export.loading {
        opacity: .65;
        cursor: not-allowed;
        pointer-events: none;
    }
    .btn-excel {
        background: var(--green);
        color: white;
        border-color: var(--green);
    }
    .btn-excel:hover { background: #059669; }
    .btn-pdf {
        background: white;
        color: var(--slate-600);
        border-color: var(--slate-200);
    }
    .btn-pdf:hover { background: var(--slate-100); }

    /* Spinner inline */
    .spinner {
        display: none;
        width: 14px; height: 14px;
        border: 2px solid rgba(255,255,255,.4);
        border-top-color: white;
        border-radius: 50%;
        animation: spin .6s linear infinite;
    }
    .btn-pdf .spinner { border-color: rgba(0,0,0,.2); border-top-color: var(--slate-600); }
    .btn-export.loading .spinner { display: inline-block; }
    .btn-export.loading .btn-icon { display: none; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ═══ GRILLE STATS ═══ */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }
    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: var(--shadow);
        border-top: 4px solid;
        position: relative;
        overflow: hidden;
    }
    .stat-card.blue   { border-color: var(--blue); }
    .stat-card.orange { border-color: var(--orange); }
    .stat-card.green  { border-color: var(--green); }
    .stat-card.purple { border-color: var(--purple); }

    .stat-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 24px;
        margin-bottom: 16px;
    }
    .stat-icon.blue   { background: #dbeafe; }
    .stat-icon.orange { background: #fef3c7; }
    .stat-icon.green  { background: #d1fae5; }
    .stat-icon.purple { background: #ede9fe; }

    .stat-label  { font-size: 13px; color: var(--slate-600); margin-bottom: 8px; }
    .stat-value  { font-size: 32px; font-weight: 700; color: var(--slate-800); }
    .stat-footer {
        margin-top: 12px; padding-top: 12px;
        border-top: 1px solid var(--slate-100);
        font-size: 12px; color: var(--slate-500);
    }

    /* ═══ GRAPHIQUES ═══ */
    .charts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
        margin-bottom: 32px;
    }
    .chart-card {
        background: white;
        border-radius: 12px;
        padding: 24px;
        box-shadow: var(--shadow);
    }
    .chart-card h3 {
        font-size: 16px; font-weight: 700;
        color: var(--slate-800); margin-bottom: 20px;
    }
    .chart-container { height: 300px; position: relative; }

    /* ═══ BOTTOM GRILLE ═══ */
    .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    /* ═══ EFFECTIF LIST ═══ */
    .effectif-list { display: flex; flex-direction: column; gap: 16px; }
    .effectif-item {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid var(--slate-100);
    }
    .effectif-item:last-child { border-bottom: none; }
    .effectif-label {
        display: flex; align-items: center; gap: 12px;
        font-size: 14px; color: var(--slate-600);
    }
    .color-dot { width: 12px; height: 12px; border-radius: 50%; }
    .effectif-value { font-size: 24px; font-weight: 700; color: var(--slate-800); }
    .effectif-total {
        margin-top: 20px; padding: 16px;
        background: #f0f4ff; border-radius: 8px;
        display: flex; justify-content: space-between; align-items: center;
    }
    .effectif-total-label { font-size: 14px; font-weight: 600; color: #5a67d8; }
    .effectif-total-value { font-size: 28px; font-weight: 700; color: #5a67d8; }

    /* ═══ BAR CHART ═══ */
    .bar-chart {
        display: flex; align-items: flex-end;
        justify-content: space-around;
        height: 280px; gap: 16px; padding: 20px 0;
    }
    .bar-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .bar {
        width: 100%; background: #f97316;
        border-radius: 6px 6px 0 0;
        transition: all .3s; cursor: pointer;
    }
    .bar:hover { background: #ea580c; transform: translateY(-4px); }
    .bar-label { font-size: 11px; color: var(--slate-600); font-weight: 600; }

    @media (max-width: 1200px) {
        .stats-grid  { grid-template-columns: repeat(2, 1fr); }
        .charts-grid { grid-template-columns: 1fr; }
        .bottom-grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}

{# ════════════════════════════════════════════════════════════
   Données JSON embarquées pour les exports JS
   (évite de re-fetcher les données depuis le front)
════════════════════════════════════════════════════════════ #}
<script id="dashboard-data" type="application/json">
{
    "absencesDuMois":    {{ absencesDuMois|json_encode|raw }},
    "tauxAbsenteisme":   {{ tauxAbsenteisme|json_encode|raw }},
    "enAttente":         {{ enAttente|json_encode|raw }},
    "arretsMaladie":     {{ arretsMaladie|json_encode|raw }},
    "evolutionAbsences": {{ evolutionAbsences|json_encode|raw }},
    "repartitionParType":{{ repartitionParType|json_encode|raw }},
    "topDepartements":   {{ topDepartements|json_encode|raw }},
    "effectifParStatut": {{ effectifParStatut|json_encode|raw }}
}
</script>

<div class="dashboard-wrapper">

    {# ═══ HEADER ═══ #}
    <div class="dashboard-header">
        <div>
            <h1>📊 Tableau de bord RH</h1>
            <p>Vue d'ensemble de l'absentéisme de l'entreprise</p>
        </div>
        <div class="export-buttons">
            <button id="btn-excel" class="btn-export btn-excel" onclick="exportExcel()">
                <span class="btn-icon">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                    </svg>
                </span>
                <span class="spinner"></span>
                Export Excel
            </button>
            <button id="btn-pdf" class="btn-export btn-pdf" onclick="exportPDF()">
                <span class="btn-icon">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
                    </svg>
                </span>
                <span class="spinner"></span>
                Export PDF
            </button>
        </div>
    </div>

    {# ═══ STATS CARDS ═══ #}
    <div class="stats-grid">
        <div class="stat-card blue">
            <div class="stat-icon blue">📅</div>
            <div class="stat-label">Absences du mois</div>
            <div class="stat-value">{{ absencesDuMois }}</div>
            <div class="stat-footer">✓ Demandes approuvées</div>
        </div>
        <div class="stat-card orange">
            <div class="stat-icon orange">📊</div>
            <div class="stat-label">Taux d'absentéisme</div>
            <div class="stat-value">{{ tauxAbsenteisme }}% <small style="font-size:14px">(ann.)</small></div>
            <div class="stat-footer">⚠️ Moyenne entreprise</div>
        </div>
        <div class="stat-card green">
            <div class="stat-icon green">⏰</div>
            <div class="stat-label">En attente</div>
            <div class="stat-value">{{ enAttente }}</div>
            <div class="stat-footer">⚡ Demandes à valider</div>
        </div>
        <div class="stat-card purple">
            <div class="stat-icon purple">🏥</div>
            <div class="stat-label">Arrêts > 15 jours</div>
            <div class="stat-value">{{ arretsMaladie }}</div>
            <div class="stat-footer">💊 Arrêts maladie</div>
        </div>
    </div>

    {# ═══ GRAPHIQUES ═══ #}
    <div class="charts-grid">
        <div class="chart-card">
            <h3>Évolution des absences</h3>
            <div class="chart-container">
                <canvas id="chartEvolution"></canvas>
            </div>
        </div>
        <div class="chart-card">
            <h3>Répartition par type</h3>
            <div class="chart-container">
                <canvas id="chartRepartition"></canvas>
            </div>
        </div>
    </div>

    {# ═══ BOTTOM ROW ═══ #}
    <div class="bottom-grid">
        <div class="chart-card">
            <h3>Top 5 départements - Demandes</h3>
            <div class="bar-chart">
                {% for dept in topDepartements %}
                    <div class="bar-item">
                        <div class="bar" style="height: {{ (dept.count / topDepartements[0].count * 100) }}%;"></div>
                        <div class="bar-label">{{ dept.nom }}</div>
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="chart-card">
            <h3>Effectif par statut</h3>
            <div class="effectif-list">
                {% for item in effectifParStatut %}
                    <div class="effectif-item">
                        <div class="effectif-label">
                            <span class="color-dot" style="background: {{ item.color }};"></span>
                            {{ item.label }}
                        </div>
                        <div class="effectif-value">{{ item.count }}</div>
                    </div>
                {% endfor %}
            </div>
            <div class="effectif-total">
                <span class="effectif-total-label">Effectif total</span>
                <span class="effectif-total-value">{{ effectifParStatut|map(e => e.count)|reduce((a, b) => a + b) }}</span>
            </div>
        </div>
    </div>

</div>

{# ═══ LIBRAIRIES ═══ #}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
{# SheetJS pour l'export Excel #}
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
{# jsPDF + AutoTable pour l'export PDF #}
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>

<script>
// ═══════════════════════════════════════════════════════════
//  Données du dashboard
// ═══════════════════════════════════════════════════════════
const DATA = JSON.parse(document.getElementById('dashboard-data').textContent);

// ─── Date d'export ────────────────────────────────────────
const TODAY = new Date().toLocaleDateString('fr-FR', {
    day: '2-digit', month: '2-digit', year: 'numeric'
});

// ═══════════════════════════════════════════════════════════
//  Charts Chart.js
// ═══════════════════════════════════════════════════════════
const ctxEvolution = document.getElementById('chartEvolution').getContext('2d');
new Chart(ctxEvolution, {
    type: 'line',
    data: {
        labels: DATA.evolutionAbsences.map(e => e.mois),
        datasets: [{
            label: "Nombre d'absences",
            data: DATA.evolutionAbsences.map(e => e.count),
            borderColor: '#f97316',
            backgroundColor: 'rgba(249,115,22,0.1)',
            tension: 0.4, fill: true,
            pointRadius: 6,
            pointBackgroundColor: '#f97316',
            pointBorderColor: '#fff',
            pointBorderWidth: 2,
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
    }
});

const ctxRepartition = document.getElementById('chartRepartition').getContext('2d');
new Chart(ctxRepartition, {
    type: 'doughnut',
    data: {
        labels: DATA.repartitionParType.map(e => e.label),
        datasets: [{
            data: DATA.repartitionParType.map(e => e.count),
            backgroundColor: [
                '#f97316','#3b82f6','#10b981','#8b5cf6',
                '#ef4444','#f59e0b','#06b6d4','#ec4899'
            ],
            borderWidth: 2,
            borderColor: '#fff'
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: {
                position: 'right',
                labels: { padding: 15, font: { size: 12 } }
            }
        }
    }
});

// ═══════════════════════════════════════════════════════════
//  EXPORT EXCEL — SheetJS
// ═══════════════════════════════════════════════════════════
function exportExcel() {
    const btn = document.getElementById('btn-excel');
    btn.classList.add('loading');

    setTimeout(() => {
        try {
            const wb = XLSX.utils.book_new();

            // ── Feuille 1 : Résumé ──────────────────────────────
            const wsResume = XLSX.utils.aoa_to_sheet([
                ['Tableau de bord RH — HUMANIA', '', ''],
                ['Exporté le', TODAY, ''],
                [],
                ['Indicateur', 'Valeur', ''],
                ['Absences du mois',     DATA.absencesDuMois,  ''],
                ["Taux d'absentéisme",   DATA.tauxAbsenteisme + '%', ''],
                ['Demandes en attente',  DATA.enAttente,       ''],
                ['Arrêts maladie >15j',  DATA.arretsMaladie,   ''],
            ]);
            // Largeurs colonnes
            wsResume['!cols'] = [{ wch: 28 }, { wch: 18 }, { wch: 10 }];
            XLSX.utils.book_append_sheet(wb, wsResume, 'Résumé');

            // ── Feuille 2 : Évolution des absences ──────────────
            const aoa2 = [['Mois', 'Nombre d\'absences']];
            DATA.evolutionAbsences.forEach(e => aoa2.push([e.mois, e.count]));
            const wsEvolution = XLSX.utils.aoa_to_sheet(aoa2);
            wsEvolution['!cols'] = [{ wch: 14 }, { wch: 22 }];
            XLSX.utils.book_append_sheet(wb, wsEvolution, 'Évolution');

            // ── Feuille 3 : Répartition par type ────────────────
            const aoa3 = [['Type', 'Nombre']];
            DATA.repartitionParType.forEach(e => aoa3.push([e.label, e.count]));
            const wsRepartition = XLSX.utils.aoa_to_sheet(aoa3);
            wsRepartition['!cols'] = [{ wch: 24 }, { wch: 12 }];
            XLSX.utils.book_append_sheet(wb, wsRepartition, 'Répartition');

            // ── Feuille 4 : Top départements ────────────────────
            const aoa4 = [['Département', 'Demandes']];
            DATA.topDepartements.forEach(e => aoa4.push([e.nom, e.count]));
            const wsDept = XLSX.utils.aoa_to_sheet(aoa4);
            wsDept['!cols'] = [{ wch: 20 }, { wch: 12 }];
            XLSX.utils.book_append_sheet(wb, wsDept, 'Départements');

            // ── Feuille 5 : Effectif par statut ─────────────────
            const aoa5 = [['Statut', 'Effectif']];
            DATA.effectifParStatut.forEach(e => aoa5.push([e.label, e.count]));
            const wsEffectif = XLSX.utils.aoa_to_sheet(aoa5);
            wsEffectif['!cols'] = [{ wch: 22 }, { wch: 12 }];
            XLSX.utils.book_append_sheet(wb, wsEffectif, 'Effectif');

            // ── Téléchargement ───────────────────────────────────
            XLSX.writeFile(wb, `rapport_rh_${TODAY.replace(/\//g, '-')}.xlsx`);
        } catch (err) {
            alert('Erreur lors de la génération Excel : ' + err.message);
        }
        btn.classList.remove('loading');
    }, 100);
}

// ═══════════════════════════════════════════════════════════
//  EXPORT PDF — jsPDF + AutoTable
// ═══════════════════════════════════════════════════════════
function exportPDF() {
    const btn = document.getElementById('btn-pdf');
    btn.classList.add('loading');

    setTimeout(() => {
        try {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });

            const ORANGE  = [249, 115, 22];
            const SLATE8  = [30,  41, 59];
            const SLATE4  = [148, 163, 184];
            const WHITE   = [255, 255, 255];
            const BGLIGHT = [248, 250, 252];

            // ── Bandeau header ────────────────────────────────
            doc.setFillColor(...ORANGE);
            doc.rect(0, 0, 210, 28, 'F');
            doc.setTextColor(...WHITE);
            doc.setFontSize(18);
            doc.setFont('helvetica', 'bold');
            doc.text('Tableau de bord RH — HUMANIA', 14, 13);
            doc.setFontSize(9);
            doc.setFont('helvetica', 'normal');
            doc.text('Vue d\'ensemble de l\'absentéisme · Exporté le ' + TODAY, 14, 22);

            let y = 36;

            // ── KPI cards (4 blocs) ───────────────────────────
            const kpis = [
                { label: 'Absences du mois',     value: String(DATA.absencesDuMois),           sub: 'Approuvées' },
                { label: "Taux d'absentéisme",   value: DATA.tauxAbsenteisme + '%',             sub: 'Annuel' },
                { label: 'En attente',            value: String(DATA.enAttente),                sub: 'À valider' },
                { label: 'Arrêts > 15 jours',     value: String(DATA.arretsMaladie),            sub: 'Maladie' },
            ];
            const colW = 43, gap = 3, startX = 14;
            kpis.forEach((kpi, i) => {
                const x = startX + i * (colW + gap);
                doc.setFillColor(...BGLIGHT);
                doc.roundedRect(x, y, colW, 24, 3, 3, 'F');
                doc.setDrawColor(220, 220, 220);
                doc.roundedRect(x, y, colW, 24, 3, 3, 'S');
                // Valeur
                doc.setTextColor(...SLATE8);
                doc.setFontSize(18);
                doc.setFont('helvetica', 'bold');
                doc.text(kpi.value, x + colW / 2, y + 12, { align: 'center' });
                // Label
                doc.setFontSize(7);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(...SLATE4);
                doc.text(kpi.label, x + colW / 2, y + 18, { align: 'center' });
                doc.setFontSize(6.5);
                doc.text(kpi.sub, x + colW / 2, y + 22, { align: 'center' });
            });
            y += 32;

            // ── Section Évolution ─────────────────────────────
            _sectionTitle(doc, 'Évolution des absences', y, ORANGE, SLATE8);
            y += 8;
            doc.autoTable({
                startY: y,
                head: [['Mois', 'Nombre d\'absences']],
                body: DATA.evolutionAbsences.map(e => [e.mois, e.count]),
                styles: { fontSize: 9, cellPadding: 3 },
                headStyles: { fillColor: ORANGE, textColor: WHITE, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: BGLIGHT },
                margin: { left: 14, right: 14 },
                tableWidth: 90,
            });
            y = doc.lastAutoTable.finalY + 8;

            // ── Section Répartition par type ──────────────────
            _sectionTitle(doc, 'Répartition par type d\'absence', y, ORANGE, SLATE8);
            y += 8;
            doc.autoTable({
                startY: y,
                head: [['Type', 'Nombre']],
                body: DATA.repartitionParType.map(e => [e.label, e.count]),
                styles: { fontSize: 9, cellPadding: 3 },
                headStyles: { fillColor: ORANGE, textColor: WHITE, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: BGLIGHT },
                margin: { left: 14, right: 14 },
                tableWidth: 110,
            });
            y = doc.lastAutoTable.finalY + 8;

            // ── Nouvelle page si besoin ────────────────────────
            if (y > 220) { doc.addPage(); y = 16; }

            // ── Section Top départements ──────────────────────
            _sectionTitle(doc, 'Top départements — Demandes', y, ORANGE, SLATE8);
            y += 8;
            doc.autoTable({
                startY: y,
                head: [['Département', 'Demandes']],
                body: DATA.topDepartements.map(e => [e.nom, e.count]),
                styles: { fontSize: 9, cellPadding: 3 },
                headStyles: { fillColor: ORANGE, textColor: WHITE, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: BGLIGHT },
                margin: { left: 14, right: 14 },
                tableWidth: 110,
            });
            y = doc.lastAutoTable.finalY + 8;

            // ── Section Effectif par statut ───────────────────
            _sectionTitle(doc, 'Effectif par statut', y, ORANGE, SLATE8);
            y += 8;
            const totalEffectif = DATA.effectifParStatut.reduce((a, b) => a + b.count, 0);
            doc.autoTable({
                startY: y,
                head: [['Statut', 'Effectif']],
                body: [
                    ...DATA.effectifParStatut.map(e => [e.label, e.count]),
                    ['TOTAL', totalEffectif],
                ],
                styles: { fontSize: 9, cellPadding: 3 },
                headStyles: { fillColor: ORANGE, textColor: WHITE, fontStyle: 'bold' },
                alternateRowStyles: { fillColor: BGLIGHT },
                bodyStyles: {},
                didParseCell: function(data) {
                    // Mettre la ligne total en gras
                    if (data.row.index === DATA.effectifParStatut.length) {
                        data.cell.styles.fontStyle = 'bold';
                        data.cell.styles.fillColor = [240, 244, 255];
                        data.cell.styles.textColor = [90, 103, 216];
                    }
                },
                margin: { left: 14, right: 14 },
                tableWidth: 110,
            });

            // ── Footer pied de page ───────────────────────────
            const pageCount = doc.internal.getNumberOfPages();
            for (let i = 1; i <= pageCount; i++) {
                doc.setPage(i);
                doc.setFontSize(7);
                doc.setTextColor(...SLATE4);
                doc.text(
                    `HUMANIA — Rapport RH · ${TODAY} · Page ${i}/${pageCount}`,
                    105, 292, { align: 'center' }
                );
            }

            // ── Téléchargement ────────────────────────────────
            doc.save(`rapport_rh_${TODAY.replace(/\//g, '-')}.pdf`);
        } catch (err) {
            alert('Erreur lors de la génération PDF : ' + err.message);
        }
        btn.classList.remove('loading');
    }, 100);
}

// Utilitaire titre de section
function _sectionTitle(doc, text, y, orange, slate) {
    doc.setFillColor(...orange);
    doc.rect(14, y, 3, 6, 'F');
    doc.setTextColor(...slate);
    doc.setFontSize(11);
    doc.setFont('helvetica', 'bold');
    doc.text(text, 20, y + 5);
    doc.setFont('helvetica', 'normal');
}
</script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Modifier l'absence — Humania{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --primary: #f59e0b;
        --primary-dark: #d97706;
        --primary-light: #fef3c7;
        --primary-bg: #fffbeb;
        --secondary: #667eea;
        --secondary-dark: #5a67d8;
        --success: #10b981;
        --danger: #ef4444;
        --warning: #f59e0b;
        --gray-900: #111827;
        --gray-800: #1f2937;
        --gray-700: #374151;
        --gray-600: #4b5563;
        --gray-500: #6b7280;
        --gray-400: #9ca3af;
        --gray-300: #d1d5db;
        --gray-200: #e5e7eb;
        --gray-100: #f3f4f6;
        --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1);
        --radius: 16px;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: 'Inter', 'DM Sans', 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #fef3c7 0%, #f0f4ff 100%);
        min-height: 100vh;
    }

    .page-wrapper {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 24px;
        animation: fadeIn 0.4s ease-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Breadcrumb */
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .breadcrumb a {
        color: var(--secondary);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s;
    }

    .breadcrumb a:hover {
        color: var(--secondary-dark);
        text-decoration: underline;
    }

    .breadcrumb span {
        color: var(--gray-400);
    }

    /* Header */
    .page-header {
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border-radius: 24px;
        padding: 32px 36px;
        margin-bottom: 28px;
        box-shadow: 0 20px 35px -10px rgba(245, 158, 11, 0.35);
        position: relative;
        overflow: hidden;
    }

    .page-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
    }

    .page-header h1 {
        font-size: 28px;
        font-weight: 800;
        color: white;
        letter-spacing: -0.5px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .page-header p {
        font-size: 14px;
        color: rgba(255, 255, 255, 0.85);
        margin-top: 8px;
    }

    /* Info badge */
    .info-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255, 255, 255, 0.2);
        padding: 6px 14px;
        border-radius: 40px;
        font-size: 12px;
        font-weight: 500;
        margin-top: 16px;
    }

    /* Form Card */
    .form-card {
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
        border: 1px solid rgba(245, 158, 11, 0.2);
        transition: transform 0.2s;
    }

    .form-card-header {
        background: linear-gradient(to right, var(--primary-bg), #fff7ed);
        padding: 22px 28px;
        border-bottom: 2px solid #fed7aa;
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .form-card-header svg {
        background: var(--primary);
        border-radius: 12px;
        padding: 8px;
        color: white;
    }

    .form-card-header h2 {
        font-size: 18px;
        font-weight: 700;
        color: var(--gray-800);
    }

    .form-card-header p {
        font-size: 12px;
        color: var(--gray-500);
        margin-top: 2px;
    }

    .form-body {
        padding: 32px 28px;
    }

    /* Grid layouts */
    .form-grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .form-grid-3 {
        display: grid;
        grid-template-columns: 1fr auto 1fr auto;
        gap: 16px;
        align-items: end;
        margin-bottom: 24px;
    }

    .form-grid-4 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group.full-width {
        grid-column: span 2;
    }

    .form-group label {
        font-size: 11px;
        font-weight: 700;
        color: var(--gray-500);
        letter-spacing: 1px;
        text-transform: uppercase;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        border: 1.5px solid var(--gray-200);
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 14px;
        color: var(--gray-800);
        background: white;
        outline: none;
        transition: all 0.2s ease;
        font-family: inherit;
        width: 100%;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    }

    .form-group input[readonly] {
        background: var(--gray-100);
        cursor: not-allowed;
    }

    /* Time group */
    .time-group {
        display: flex;
        align-items: center;
        gap: 12px;
        background: white;
        border: 1.5px solid var(--gray-200);
        border-radius: 12px;
        padding: 4px 12px;
        transition: all 0.2s;
    }

    .time-group:focus-within {
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.1);
    }

    .time-group select {
        border: none !important;
        padding: 10px 4px !important;
        font-size: 16px !important;
        font-weight: 600 !important;
        background: transparent !important;
        width: 65px !important;
        text-align: center;
        cursor: pointer;
    }

    .time-group select:focus {
        box-shadow: none !important;
    }

    .time-sep {
        font-size: 20px;
        font-weight: 700;
        color: var(--primary);
    }

    /* Arrow */
    .arrow-sep {
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: var(--gray-300);
        padding-bottom: 12px;
    }

    /* Duration display */
    .duration-input {
        background: linear-gradient(135deg, #fef3c7, #fffbeb) !important;
        color: #b45309 !important;
        font-weight: 700 !important;
        border-color: #fed7aa !important;
        text-align: center;
        font-size: 16px !important;
    }

    /* Stat cards */
    .stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 28px;
        padding: 20px;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
        border-radius: 20px;
    }

    .stat-card {
        text-align: center;
        padding: 12px;
        background: white;
        border-radius: 14px;
        box-shadow: var(--shadow-sm);
    }

    .stat-value {
        font-size: 28px;
        font-weight: 800;
        color: var(--primary-dark);
    }

    .stat-label {
        font-size: 11px;
        color: var(--gray-500);
        margin-top: 4px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Status badge */
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 40px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-approved {
        background: #d1fae5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .status-pending {
        background: #fef3c7;
        color: #b45309;
        border: 1px solid #fde68a;
    }

    .status-rejected {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fca5a5;
    }

    /* Error messages */
    .form-error {
        font-size: 11px;
        color: var(--danger);
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Actions */
    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid var(--gray-200);
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: transparent;
        border: 1.5px solid var(--gray-300);
        border-radius: 12px;
        color: var(--gray-600);
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-cancel:hover {
        background: var(--gray-100);
        border-color: var(--gray-400);
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
        transition: all 0.2s;
    }

    .btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(245, 158, 11, 0.4);
    }

    /* Hidden fields */
    .hidden-field {
        display: none !important;
    }

    /* Alert messages */
    .alert {
        padding: 14px 20px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 13px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-success {
        background: #ecfdf5;
        color: #059669;
        border: 1px solid #a7f3d0;
    }

    .alert-error {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fca5a5;
    }

    /* Responsive */
    @media (max-width: 768px) {
        .page-wrapper {
            padding: 20px 16px;
        }

        .page-header {
            padding: 24px 20px;
        }

        .page-header h1 {
            font-size: 22px;
        }

        .form-grid-2,
        .form-grid-3,
        .form-grid-4,
        .stats-row {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .form-grid-3 .arrow-sep {
            display: none;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-submit {
            justify-content: center;
        }

        .form-body {
            padding: 20px;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">

    {# Breadcrumb #}
    <div class="breadcrumb">
        <a href="{{ path('app_absence_index') }}">
            <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M3 10L12 3L21 10V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V10Z"/>
                <polyline points="3 10 12 3 21 10"/>
                <path d="M12 22V12"/>
            </svg>
            Mes Absences
        </a>
        <span>›</span>
        <span>Modifier</span>
    </div>

    {# Header #}
    <div class="page-header">
        <h1>
            <svg width="28" height="28" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <path d="M20 14.66V20a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h5.34"/>
                <polygon points="18 2 22 6 12 16 8 16 8 12 18 2"/>
            </svg>
            Modifier l'absence
        </h1>
        <p>Mettez à jour les informations de votre demande d'autorisation</p>
        <div class="info-badge">
            <svg width="14" height="14" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            Tous les champs marqués * sont obligatoires
        </div>
    </div>

    {# Flash messages #}
    {% for msg in app.flashes('success') %}
        <div class="alert alert-success">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <polyline points="20 6 9 17 4 12"/>
            </svg>
            {{ msg }}
        </div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="alert alert-error">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            {{ msg }}
        </div>
    {% endfor %}

    {# Formulaire #}
    <div class="form-card">
        <div class="form-card-header">
            <svg width="32" height="32" fill="none" stroke="white" stroke-width="1.5" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
            </svg>
            <div>
                <h2>Modifier la demande d'autorisation</h2>
                <p>Modifiez les informations ci-dessous et validez</p>
            </div>
        </div>

        <div class="form-body">
            {{ form_start(form, {'attr': {'id': 'editForm', 'novalidate': 'novalidate'}}) }}

            {# Champs cachés #}
            <div class="hidden-field">{{ form_widget(form.utilisateurId) }}</div>
            <div class="hidden-field">{{ form_widget(form.dureeMinutes, {'attr': {'id': 'duree_minutes'}}) }}</div>
            <div class="hidden-field">{{ form_widget(form.nbrJours, {'attr': {'id': 'nbr_jours_hidden'}}) }}</div>
            <div class="hidden-field">{{ form_widget(form.dateFin, {'attr': {'id': 'editDateFin'}}) }}</div>

            {# Statistiques #}
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-value" id="jours_display">{{ absence.nbrJours ?? 0 }}</div>
                    <div class="stat-label">Jours de congé</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value" id="duree_display">
                        {% if absence.heureDebut and absence.heureFin %}
                            {{ absence.heureDebut }} → {{ absence.heureFin }}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                    <div class="stat-label">Horaires</div>
                </div>
                <div class="stat-card">
                    <div class="stat-value">{{ absence.dateDebut ? absence.dateDebut|date('Y') : '—' }}</div>
                    <div class="stat-label">Année</div>
                </div>
            </div>

            {# Ligne 1 : Date #}
            <div class="form-grid-2">
                <div class="form-group">
                    <label>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                            <line x1="16" y1="2" x2="16" y2="6"/>
                            <line x1="8" y1="2" x2="8" y2="6"/>
                            <line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        Date *
                    </label>
                    {{ form_widget(form.dateDebut, {'attr': {'id': 'editDateDebut', 'onchange': 'syncDateFin()', 'class': 'date-input'}}) }}
                    {% if form.dateDebut.vars.errors|length > 0 %}
                        <span class="form-error">⚠️ {{ form_errors(form.dateDebut) }}</span>
                    {% endif %}
                </div>
            </div>

            {# Ligne 2 : Heures #}
            <div class="form-grid-3">
                <div class="form-group">
                    <label>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        Heure début *
                    </label>
                    <input type="time" id="editHeureDebut" name="heureDebut" value="{{ absence.heureDebut }}" 
                           class="time-input" onchange="calculerDuree()" oninput="calculerDuree()" step="60">
                </div>
                <div class="arrow-sep">
                    <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
                <div class="form-group">
                    <label>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        Heure fin *
                    </label>
                    <input type="time" id="editHeureFin" name="heureFin" value="{{ absence.heureFin }}" 
                           class="time-input" onchange="calculerDuree()" oninput="calculerDuree()" step="60">
                </div>
                <div class="form-group">
                    <label>⏱️ Durée calculée</label>
                    <input type="text" id="dureeDisplay" readonly class="duration-input" 
                           value="{% if absence.heureDebut and absence.heureFin %}{{ absence.heureDebut }} → {{ absence.heureFin }}{% else %}—{% endif %}">
                </div>
            </div>

            {# Ligne 3 : Statut, Type, Motif #}
            <div class="form-grid-4">
                <div class="form-group">
                    <label>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                        Statut *
                    </label>
                    {{ form_widget(form.statut, {'attr': {'class': 'status-select'}}) }}
                    {% if form.statut.vars.errors|length > 0 %}
                        <span class="form-error">⚠️ {{ form_errors(form.statut) }}</span>
                    {% endif %}
                </div>

                <div class="form-group">
                    <label>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                            <line x1="16" y1="21" x2="16" y2="5"/>
                            <line x1="8" y1="21" x2="8" y2="5"/>
                            <line x1="2" y1="11" x2="22" y2="11"/>
                        </svg>
                        Type d'autorisation *
                    </label>
                    {{ form_widget(form.typeAbsenceId, {'attr': {'class': 'type-select'}}) }}
                    {% if form.typeAbsenceId.vars.errors|length > 0 %}
                        <span class="form-error">⚠️ {{ form_errors(form.typeAbsenceId) }}</span>
                    {% endif %}
                </div>

                <div class="form-group full-width">
                    <label>
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        Motif (optionnel)
                    </label>
                    {{ form_widget(form.motif, {'attr': {'placeholder': 'Raison de l\'absence...', 'rows': 2}}) }}
                </div>
            </div>

            {# Actions #}
            <div class="form-actions">
                <a href="{{ path('app_absence_index') }}" class="btn-cancel">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18"/>
                        <line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                    Annuler
                </a>
                <button type="submit" class="btn-submit">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                        <polyline points="17 21 17 13 7 13 7 21"/>
                        <polyline points="7 3 7 8 15 8"/>
                    </svg>
                    Enregistrer les modifications
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    // Synchroniser la date de fin avec la date de début
    function syncDateFin() {
        const dateDebut = document.getElementById('editDateDebut');
        const dateFin = document.getElementById('editDateFin');
        
        if (dateDebut && dateFin && dateDebut.value) {
            dateFin.value = dateDebut.value;
        }
        
        // Recalculer les jours
        calculerDuree();
    }

    // Calculer la durée entre les heures
    function calculerDuree() {
        const heureDebut = document.getElementById('editHeureDebut');
        const heureFin = document.getElementById('editHeureFin');
        const dureeDisplay = document.getElementById('dureeDisplay');
        const joursDisplay = document.getElementById('jours_display');
        const dureeMinutesHidden = document.getElementById('duree_minutes');
        const nbrJoursHidden = document.getElementById('nbr_jours_hidden');
        const dateDebut = document.getElementById('editDateDebut');
        const dateFin = document.getElementById('editDateFin');
        
        if (!heureDebut || !heureFin || !dureeDisplay) return;
        
        const h1 = heureDebut.value;
        const h2 = heureFin.value;
        
        if (h1 && h2) {
            // Calculer la différence en minutes
            const toMinutes = (time) => {
                const [h, m] = time.split(':').map(Number);
                return (h * 60) + (m || 0);
            };
            
            const debutMin = toMinutes(h1);
            const finMin = toMinutes(h2);
            const diffMin = finMin - debutMin;
            
            if (diffMin > 0) {
                const heures = Math.floor(diffMin / 60);
                const minutes = diffMin % 60;
                let dureeTexte = '';
                
                if (heures > 0) {
                    dureeTexte = heures + 'h';
                    if (minutes > 0) dureeTexte += minutes;
                } else {
                    dureeTexte = minutes + 'min';
                }
                
                dureeDisplay.value = dureeTexte;
                dureeDisplay.style.background = '#fef3c7';
                dureeDisplay.style.color = '#b45309';
                
                if (dureeMinutesHidden) dureeMinutesHidden.value = diffMin;
            } else {
                dureeDisplay.value = '❌ Fin avant début';
                dureeDisplay.style.background = '#fee2e2';
                dureeDisplay.style.color = '#dc2626';
                if (dureeMinutesHidden) dureeMinutesHidden.value = 0;
            }
        }
        
        // Calculer le nombre de jours
        if (dateDebut && dateFin && dateDebut.value && dateFin.value && joursDisplay) {
            const debut = new Date(dateDebut.value);
            const fin = new Date(dateFin.value);
            
            if (fin >= debut) {
                const diffTime = Math.abs(fin - debut);
                const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24)) + 1;
                joursDisplay.textContent = diffDays;
                if (nbrJoursHidden) nbrJoursHidden.value = diffDays;
            } else {
                joursDisplay.textContent = '0';
                if (nbrJoursHidden) nbrJoursHidden.value = 0;
            }
        }
    }

    // Initialiser au chargement
    document.addEventListener('DOMContentLoaded', function() {
        syncDateFin();
        calculerDuree();
        
        // Ajouter les écouteurs d'événements
        const dateDebut = document.getElementById('editDateDebut');
        const dateFinInput = document.getElementById('editDateFin');
        const heureDebut = document.getElementById('editHeureDebut');
        const heureFin = document.getElementById('editHeureFin');
        
        if (dateDebut) dateDebut.addEventListener('change', calculerDuree);
        if (dateFinInput) dateFinInput.addEventListener('change', calculerDuree);
        if (heureDebut) heureDebut.addEventListener('change', calculerDuree);
        if (heureFin) heureFin.addEventListener('change', calculerDuree);
    });
</script>
{% endblock %}